<Project>

  <!-- 上游 Core 的 NoWarn 是硬赋值（<NoWarn>IDE1006,CS1591</NoWarn>），会覆盖 Directory.Build.props 里
       追加的 NoWarn，导致 M0 门禁①"dotnet build 0 警告"无法满足。Directory.Build.targets 在项目文件之后
       导入，这里再追加一次。自有项目不追加：它们靠 TreatWarningsAsErrors 把任何警告变成错误。 -->
  <PropertyGroup Condition="!$(MSBuildProjectName.StartsWith('CkanUI'))">
    <NoWarn>$(NoWarn);NU1701;NU1901;NU1902;NU1903;NU1904;SYSLIB0050</NoWarn>
    <WarningsNotAsErrors>SYSLIB0050;NU1901;NU1902;NU1903;NU1904;$(WarningsNotAsErrors)</WarningsNotAsErrors>
  </PropertyGroup>

  <Target Name="DisableTesthostParentProcessQuery" BeforeTargets="GenerateBuildRuntimeConfigurationFiles">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="MSTest.EnableParentProcessQuery" />
      <RuntimeHostConfigurationOption Include="MSTest.EnableParentProcessQuery" Value="false" />
    </ItemGroup>
  </Target>

</Project>
