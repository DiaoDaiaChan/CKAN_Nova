      "default": "RealismOverhaul",
      "risk": "high",
      "requiresRestart": true,
      "label": "当前使用的配置档案名（引用 KerbalismConfig/Profiles 下的档案，改动可能整套玩法不兼容）"
    },
    {
      "file": "settings",
      "key": "UseSamplingSunFactor",
      "type": "bool",
      "default": "true",
      "risk": "medium",
      "requiresRestart": true,
      "label": "太阳辐射是否按采样系数计算（3.18 起生效）"
    },
    {
      "file": "settings",
      "key": "Reliability",
