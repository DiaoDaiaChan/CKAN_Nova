{
  "schemaVersion": 1,
  "id": "kerbalism",
  "name": "Kerbalism",
  "homepage": "https://github.com/Kerbalism/Kerbalism",
  "docUrl": "https://github.com/Kerbalism/Kerbalism/wiki",
  "match": {
    "ckanIdentifiers": [
      "Kerbalism"
    ],
    "paths": [
      "GameData/KerbalismConfig/Settings.cfg"
    ],
    "caseInsensitive": true
  },
  "modVersionRange": [
    ">=3.0"
  ],
  "files": [
    {
      "id": "settings",
      "path": "GameData/KerbalismConfig/Settings.cfg",
      "layout": "node",
      "rootNode": "Kerbalism",
      "mode": "editable",
      "onMissing": "readonly",
      "lineEnding": "preserve",
      "separator": " = ",
      "label": "Settings.cfg"
    }
  ],
  "descriptionFromComment": true,
  "unlisted": "preserve",
