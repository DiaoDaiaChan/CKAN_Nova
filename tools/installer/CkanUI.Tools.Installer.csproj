<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CkanUISetup</AssemblyName>
    <RootNamespace>CkanUI.Tools.Installer</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>../../src/CkanUI.App/Assets/ckan.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PayloadZip Condition="'$(PayloadZip)' == ''">payload.zip</PayloadZip>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
