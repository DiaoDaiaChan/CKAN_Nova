{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CKAN UI mod config adapter（依据 docs/plan/15-mod-config-adapters.md §4.1/§4.2）",
  "description": "adapters/<modId>/adapter.json 的兜底 schema。docs/design/adapter.schema.json 存在时由 H-08 优先使用它。",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "match",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://"
    },
    "docUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "match": {
      "type": "object",
      "required": [
        "ckanIdentifiers"
      ],
      "properties": {
        "ckanIdentifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "caseInsensitive": {
          "type": "boolean"
        },
        "resolveByInstalledFiles": {
          "type": "boolean"
        }
      }
    },
    "modVersionRange": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "layout",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "type": "string",
            "enum": [
              "node",
              "flat"
            ]
          },
          "rootNode": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "editable",
              "readonly"
            ]
          },
          "onMissing": {
            "type": "string",
            "enum": [
              "create-from-template",
              "error",
              "readonly"
            ]
          },
          "template": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "descriptionFromComment": {
      "type": "boolean"
    },
    "groups": {
      "type": "object"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "key",
          "type"
        ],
        "properties": {
          "file": {
            "type": "integer"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "bool",
              "int",
              "float",
              "enum",
              "string",
              "path",
              "color",
              "keybinding",
              "list",
              "readonly"
            ]
          },
          "values": {
            "type": "array"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "requiresRestart": {
            "type": "boolean"
          },
          "pattern": {
            "type": "string"
          }
        }
      }
    },
    "unlisted": {
      "type": "string",
      "enum": [
        "preserve",
        "hide",
        "mark-unknown"
      ]
    }
  }
}
