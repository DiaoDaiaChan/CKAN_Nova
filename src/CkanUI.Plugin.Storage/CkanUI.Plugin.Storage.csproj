<Project Sdk="Microsoft.NET.Sdk">

  <!-- 首方内置插件：多实例存储管理（GameData / CKAN / 配置档占用总览 + 配置档硬链接去重）。
       只引用契约程序集：插件不得引用 CkanUI.App / CkanUI.Services，页面才能在可卸载 ALC 里构造。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CkanUI.Plugin.Storage</RootNamespace>
    <AssemblyName>CkanUI.Plugin.Storage</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CkanUI.Services.Abstractions/CkanUI.Services.Abstractions.csproj" />
  </ItemGroup>

</Project>
