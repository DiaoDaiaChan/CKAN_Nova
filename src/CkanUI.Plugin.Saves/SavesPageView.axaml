<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.Ui.Theming"
             xmlns:icons="using:CkanUI.Ui.Icons"
             xmlns:ui="using:CkanUI.Ui.Tables"
             x:Class="CkanUI.Plugin.Saves.SavesPageView"
             x:CompileBindings="False">
  <!-- 存档工作台（13 篇 §7 / 03 篇 §14 / 06 篇 E1）：存档列表 + 诊断列表 + 校验与格式化。
       颜色一律走 Tokens.axaml 的语义 token，间距一律 4 的倍数。
       视觉规范：卡片/工具条/空态/错误条/骨架屏统一复用 FluentStyles 的 Ckan* 类。 -->
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="{DynamicResource CkanRowHeight}" />
    </Style>
    <!--
      存档列表里，组头也是「首行 item」的一部分。
      为了避免选中组内首行时高亮蔓延到组头或组间间距上，将 ListBoxItem 的高亮设为透明，
      由行内容容器 Border.SavesRowContent 专门承担悬停与选中高亮；
      自带的 Rectangle#SelectionIndicator 予以隐藏。
    -->
    <Style Selector="ListBox.SaveList ListBoxItem">
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.SaveList ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.SaveList ListBoxItem:selected /template/ Rectangle#SelectionIndicator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.SaveList ListBoxItem Border.SavesRowContent">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.SaveList ListBoxItem:pointerover Border.SavesRowContent">
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="ListBox.SaveList ListBoxItem:selected Border.SavesRowContent">
      <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
    </Style>
    <Style Selector="ListBox.SaveList ListBoxItem:selected:pointerover Border.SavesRowContent">
      <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
    </Style>
    <!-- 工具条上的过滤勾选项：与日志页的 facet 芯片同一种观感（24px 行高，caption 字号） -->
    <Style Selector="CheckBox.facet">
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui_NavRail_Saves}" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_SavesPage_Header_Tip}">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
        </StackPanel>
        <TextBlock Text="{DynamicResource Ui_SavesPage_Subtitle}" Classes="CkanCaption" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SavesDirectoryText}" Classes="CkanCaption"
                   IsVisible="{Binding !ShowNoInstanceState}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="{Binding InstanceText}" HorizontalAlignment="Right" Classes="CkanCaption" />
        <Border Classes="CkanBadge" HorizontalAlignment="Right"
                IsVisible="{Binding !ShowNoInstanceState}">
          <TextBlock Text="{Binding CountText}" />
        </Border>
      </StackPanel>
    </Grid>

    <!-- 工具条 -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card" IsVisible="{Binding !ShowNoInstanceState}">
      <WrapPanel Orientation="Horizontal">
        <Button Content="{DynamicResource Ui_SettingsPage_Reload}" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsIdle}" Classes="CkanPrimary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_SavesPage_Refresh_Tip}" />
        <Button Content="{DynamicResource Ui_Common_Validate}" Command="{Binding ValidateCommand}"
                IsEnabled="{Binding CanValidate}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_SavesPage_Validate_Tip}" />
        <Button Content="{DynamicResource Ui_SavesPage_FormatToCopy}" Command="{Binding FormatCopyCommand}"
                IsEnabled="{Binding CanFormatCopy}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_SavesPage_FormatToCopy_Tip}" />
        <Button Content="{DynamicResource Ui_SavesPage_RewriteInPlace}" Command="{Binding FormatInPlaceCommand}"
                IsEnabled="{Binding CanFormatInPlace}" Classes="CkanDanger" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_SavesPage_RewriteInPlace_Tip}" />
        <Button Content="编辑内容…" Click="OnOpenWorkbench" IsEnabled="{Binding HasSelection}"
                Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="打开 SFS 工作台：按分区浏览存档内容，就地改值 / 复制 / 删除块（写前自动留快照）" />
        <Button Content="{DynamicResource Ui_Common_ShowInFolder}" Command="{Binding OpenFolderCommand}"
                IsEnabled="{Binding CanOpenFolder}" Classes="CkanGhost"
                ToolTip.Tip="{DynamicResource Ui_SavesPage_OpenFolder_Tip}" />
        <Rectangle Width="1" Height="18" Margin="4,0,12,0" VerticalAlignment="Center"
                   Fill="{DynamicResource CkanBorderBrush}"
                   IsVisible="{Binding HasStockSaves}" />
        <CheckBox Classes="facet" Content="{Binding StockToggleText}"
                  IsChecked="{Binding ShowStockSaves, Mode=TwoWay}"
                  IsVisible="{Binding HasStockSaves}"
                  ToolTip.Tip="{DynamicResource Ui_SavesPage_StockSaves_Tip}" />
      </WrapPanel>
    </Border>

    <!-- 页面级错误条（03 篇 §8 D-03） -->
    <Border Grid.Row="2" Margin="0,12,0,0" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0"
                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="Medium"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                     IsVisible="{Binding HasErrorDetail}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="{DynamicResource Ui_Common_Retry}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"
                  Classes="CkanSmall" ToolTip.Tip="{DynamicResource Ui_SavesPage_Refresh_Tip}" />
          <Button Content="{DynamicResource Ui_Cmd_Shortcuts_Close}" Command="{Binding ClearErrorCommand}" Classes="CkanSmall" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体：左列表 + 右诊断 -->
    <Grid Grid.Row="3" ColumnDefinitions="*,6,380" Margin="0,12,0,0">

      <!-- 存档列表 -->
      <Border Grid.Column="0" Classes="CkanCard" Padding="0"
              IsVisible="{Binding HasRows}">
        <Grid RowDefinitions="Auto,*">
          <!--
            这里不能用可横向滚动的 ScrollViewer：它用无限宽测量子元素，star 列会退化成 Auto，
            长槽位名把整张表撑到视口之外（体积列因此永远看不见）。列已经压到 6 列，
            所以直接禁用横向滚动，让 star 列拿到真实宽度、TextTrimming 生效。
          -->
          <ScrollViewer Grid.Row="0" Grid.RowSpan="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                        IsVisible="{Binding HasRows}">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Padding="10,7"
                      Background="{DynamicResource CkanSubtleBackgroundBrush}"
                      BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="2.1*,1*,52,60,124">
                  <TextBlock Grid.Column="0" Text="{DynamicResource Ui_SavesPage_ColSlot}" Classes="CkanCaption" />
                  <TextBlock Grid.Column="1" Text="{DynamicResource Ui_Common_Title}" Classes="CkanCaption" />
                  <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Common_Mode}" Classes="CkanCaption" />
                  <TextBlock Grid.Column="3" Text="{DynamicResource Ui_Common_Version}" Classes="CkanCaption" />
                  <TextBlock Grid.Column="4" Text="{DynamicResource Ui_SavesPage_ColInGameTime}" Classes="CkanCaption" />
                </Grid>
              </Border>

              <!-- 筛选/排序/拖动列宽由 ListTableTools 补：表头 5 列（槽位/标题/模式/版本/游戏内时间），
                   `展示路径~排序路径` 让时间与版本列按原始值排序而不是字典序。 -->
              <ListBox Grid.Row="1" Classes="SaveList" ItemsSource="{Binding Rows}" Padding="4"
                       ui:ListTableTools.Enabled="True"
                       ui:ListTableTools.Columns="SlotDisplay~SlotName,TitleText,ModeText,VersionText~GameVersion,UniversalTimeText~UniversalTime"
                       SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                       DoubleTapped="OnSaveListDoubleTapped"
                       BorderThickness="0" Background="Transparent">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="编辑存档内容…" Click="OnOpenWorkbench" IsEnabled="{Binding HasSelection}" />
                    <MenuItem Header="在文件资源管理器中打开所在目录" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding CanOpenFolder}" />
                    <Separator />
                    <MenuItem Header="格式化为副本" Command="{Binding FormatCopyCommand}" IsEnabled="{Binding CanFormatCopy}" />
                    <MenuItem Header="就地重写格式化" Command="{Binding FormatInPlaceCommand}" IsEnabled="{Binding CanFormatInPlace}" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <!--
                        文件夹组头：只在每组首行上方画一次。不插异类行，保持 ListBox 单一类型与虚拟化。
                        采用卡片式圆角容器与主色强调条，显著增强文件夹分类的层级与视觉区隔。
                      -->
                      <Border IsVisible="{Binding IsGroupStart}"
                              Classes="SavesFolderHeader"
                              Background="{DynamicResource CkanCardBackgroundBrush}"
                              BorderBrush="{DynamicResource CkanCardBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="10,6"
                              Margin="0,10,0,4"
                              ToolTip.Tip="{Binding FolderText}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                          <!-- 主色垂直强调色条 -->
                          <Border Grid.Column="0"
                                  Width="3" Height="14"
                                  CornerRadius="1.5"
                                  Background="{DynamicResource CkanPrimaryBrush}"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                          <!-- 文件夹矢量图标 -->
                          <icons:GlyphIcon Grid.Column="1"
                                           Glyph="Folder"
                                           Size="14"
                                           Foreground="{DynamicResource CkanPrimaryBrush}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                          <!-- 文件夹名称 -->
                          <TextBlock Grid.Column="2" Text="{Binding FolderText}" TextTrimming="CharacterEllipsis"
                                     FontWeight="SemiBold"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                          <!-- 存档计数徽章 -->
                          <Border Grid.Column="3"
                                  Classes="CkanBadge"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0">
                            <TextBlock Text="{Binding GroupSubtitle}" />
                          </Border>
                        </Grid>
                      </Border>
                      <Border Classes="SavesRowContent" Padding="8,0">
                        <Grid ColumnDefinitions="2.1*,1*,52,60,124"
                              MinHeight="{DynamicResource CkanRowHeight}">
                            <!--
                            横向 StackPanel 会以无限宽测量子元素，TextTrimming 永远不会生效，
                            长槽位名会直接压到「标题」列上；用 Grid 的 star 列把宽度约束住。
                            飞船数 / 资金 / 修改时间 / 快照数已搬到右侧详情面板：9 列定宽在 1000px 窗口下
                            必须横向滚动才看得见，把低频列让给详情面板后列表在默认宽度下就能读全。
                          -->
                          <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,8,0"
                                ToolTip.Tip="{Binding SlotText}">
                            <!-- 分组时的层级缩进指示器：缩进 16px 并展示文件小图标，一眼识别归属关系 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" IsVisible="{Binding IsGrouped}">
                              <Border Width="16" />
                              <icons:GlyphIcon Glyph="File" Size="12"
                                               Foreground="{DynamicResource CkanTextTertiaryBrush}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- 分组时文件夹已写在组头上，首列只显示尾段，长备份名才有地方放 -->
                            <TextBlock Grid.Column="1" Text="{Binding SlotDisplay}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                            <Border Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Classes="CkanBadge" IsVisible="{Binding IsStock}">
                              <TextBlock Text="{DynamicResource Ui_SavesPage_ColStock}" />
                            </Border>
                            <Border Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Classes="CkanBadge Info" IsVisible="{Binding IsBackupItem}">
                              <TextBlock Text="{Binding KindText}" />
                            </Border>
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding TitleText}" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                     ToolTip.Tip="{Binding TitleText}"
                                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                          <TextBlock Grid.Column="2" Text="{Binding ModeText}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                          <TextBlock Grid.Column="3" Text="{Binding VersionText}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     FontSize="{DynamicResource CkanFontSizeCaption}"
                                     ToolTip.Tip="{Binding VersionText}"
                                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                          <!-- 体积列已移到右侧详情面板：留在这里会把「游戏内时间」挤成省略号 -->
                          <TextBlock Grid.Column="4" Text="{Binding UniversalTimeText}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding UniversalTimeText}"
                                     FontSize="{DynamicResource CkanFontSizeCaption}"
                                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </ScrollViewer>

        </Grid>
      </Border>

      <!-- 分割条（GridSplitter） -->
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" Margin="0,10" ZIndex="5" Cursor="SizeWestEast"
                    IsVisible="{Binding HasRows}" />

      <!-- 右侧：选中存档详情 + 诊断列表 -->
      <Border Grid.Column="2" Classes="CkanCard stagger-card"
              MinWidth="280" MaxWidth="600"
              IsVisible="{Binding HasRows}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

          <StackPanel Grid.Row="0" Spacing="4" IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding SelectionTitle}" Classes="CkanCardTitle"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Classes="CkanCaption" />
            <TextBlock Text="{Binding SelectionTimeText}" TextWrapping="Wrap" Classes="CkanCaption" />
            <!-- 低频列（飞船 / 资金 / 修改时间 / 快照 / 体积）从表格搬到这里：列表因此不再需要横向滚动 -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="2" Margin="0,4,0,2">
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{DynamicResource Ui_SavesPage_ColVessels}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                <TextBlock Text="{Binding SelectedRow.VesselCountText}" Classes="CkanCaption" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{DynamicResource Ui_SavesPage_ColFunds}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                <TextBlock Text="{Binding SelectedRow.FundsText}" Classes="CkanCaption" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{DynamicResource Ui_Common_Size}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                <TextBlock Text="{Binding SelectedRow.SizeText}" Classes="CkanCaption" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{DynamicResource Ui_Common_Snapshot}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                <TextBlock Text="{Binding SelectedRow.SnapshotCountText}" Classes="CkanCaption" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{DynamicResource Ui_Common_ModifiedTime}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                <TextBlock Text="{Binding SelectedRow.TimeText}" Classes="CkanCaption" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SelectionPath}" TextWrapping="Wrap"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextTertiaryBrush}" />

            <!-- 快捷主操作条：直接在此处编辑存档或打开目录 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
              <Button Grid.Column="0" Content="编辑存档内容…" Click="OnOpenWorkbench" Classes="CkanPrimary"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      ToolTip.Tip="打开 SFS 工作台：修改资金/科技/声望、展开块树、修改字段、一键救援乘员" />
              <Button Grid.Column="1" Content="{DynamicResource Ui_Common_ShowInFolder}" Command="{Binding OpenFolderCommand}"
                      Classes="CkanSecondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      ToolTip.Tip="{DynamicResource Ui_SavesPage_OpenFolder_Tip}" />
            </Grid>
          </StackPanel>

          <Border Grid.Row="1" Margin="0,8,0,0" Height="1"
                  Background="{DynamicResource CkanBorderBrush}"
                  IsVisible="{Binding HasSelection}" />

          <!-- 标题与统计各占一行：并排时那串「节点 / 键值 / 行 / 深度」会把标题挤成「校验通…」 -->
          <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="2"
                      IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding DiagnosticsHeader}" Classes="CkanCardTitle"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SelectionStatsText}" Classes="CkanCaption"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanTextTertiaryBrush}" />
          </StackPanel>

          <ListBox Grid.Row="3" Margin="0,4,0,0" ItemsSource="{Binding Diagnostics}"
                   BorderThickness="0" Background="Transparent" Padding="0,2"
                   IsVisible="{Binding HasDiagnostics}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="IsHitTestVisible" Value="False" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="0,4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- 严重级别用语义徽章，高对比度下也不靠颜色深浅区分 -->
                    <Border Classes="CkanBadge Danger" IsVisible="{Binding IsError}">
                      <TextBlock Text="{Binding SeverityText}" />
                    </Border>
                    <Border Classes="CkanBadge Warning" IsVisible="{Binding IsWarning}">
                      <TextBlock Text="{Binding SeverityText}" />
                    </Border>
                    <Border Classes="CkanBadge Info" IsVisible="{Binding IsInfo}">
                      <TextBlock Text="{Binding SeverityText}" />
                    </Border>
                    <TextBlock Text="{Binding Code}" Classes="CkanCaption" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LocationText}" Classes="CkanCaption" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                             FontSize="{DynamicResource CkanFontSizeBody}"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <TextBlock Text="{Binding SnippetText}" IsVisible="{Binding HasSnippet}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             ToolTip.Tip="{Binding SnippetText}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 校验通过：没有发现问题 -->
          <Border Grid.Row="3" IsVisible="{Binding ShowDiagnosticsEmpty}" Padding="8">
            <StackPanel Spacing="8">
              <Border Classes="CkanBadge Success" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource Ui_Common_ValidationPassed}" />
              </Border>
              <TextBlock Text="{Binding DiagnosticsEmptyText}" TextWrapping="Wrap"
                         VerticalAlignment="Top"
                         FontSize="{DynamicResource CkanFontSizeBody}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="4" Text="{Binding LastOutcomeText}" Margin="0,8,0,0"
                     IsVisible="{Binding HasLastOutcome}"
                     TextWrapping="Wrap" Classes="CkanCaption" />

          <!-- 未选择存档时的引导占位 -->
          <Border Grid.Row="0" Grid.RowSpan="5" IsVisible="{Binding !HasSelection}"
                  Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="280">
              <TextBlock Text="{DynamicResource Ui_Saves_NoSelection}"
                         Classes="CkanCardTitle"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Text="{DynamicResource Ui_SavesPage_SelectSaveHint}"
                         Classes="CkanCaption"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="{DynamicResource CkanTextTertiaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <!-- 空态（页面级）：还没有选择实例 / 这个实例还没有存档 -->
      <Border Grid.Column="0" Grid.ColumnSpan="3" Classes="CkanEmptyStateCard Elevated"
              Margin="0" IsVisible="{Binding ShowNoInstanceState}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
          <Border Classes="CkanIconTile Lg Muted" HorizontalAlignment="Center">
            <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" />
          </Border>
          <TextBlock Text="{DynamicResource Ui_SavesPage_NoInstanceTitle}" HorizontalAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <TextBlock Text="{Binding NoInstanceStateHint}" TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <Button Content="{DynamicResource Ui_ModConfigPage_GoToInstancesPage}" Classes="CkanSecondary" HorizontalAlignment="Center"
                  Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                  CommandParameter="instances"
                  ToolTip.Tip="{DynamicResource Ui_SavesPage_SelectInstanceFirst_Tip}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="0" Grid.ColumnSpan="3" Classes="CkanEmptyStateCard Elevated"
              Margin="0" IsVisible="{Binding ShowEmptyState}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
          <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
            <PathIcon Data="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z" />
          </Border>
          <TextBlock Text="{Binding EmptyStateTitle}" HorizontalAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <TextBlock Text="{Binding EmptyStateHint}" TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <Button Content="{Binding EmptyStateActionText}" Command="{Binding OpenFolderCommand}"
                  Classes="CkanSecondary" HorizontalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_SavesPage_OpenSavesDir_Tip}" />
        </StackPanel>
      </Border>

      <!-- 有存档、但全是自带存档且被过滤器收起：不能说"这个实例还没有存档" -->
      <Border Grid.Column="0" Grid.ColumnSpan="3" Classes="CkanEmptyStateCard Elevated"
              Margin="0" IsVisible="{Binding ShowStockOnlyState}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
          <Border Classes="CkanIconTile Lg Muted" HorizontalAlignment="Center">
            <PathIcon Data="M3 4h18l-7 8v6l-4 2v-8L3 4z" />
          </Border>
          <TextBlock Text="{Binding StockOnlyTitle}" HorizontalAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <TextBlock Text="{Binding StockOnlyHint}" TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <Button Content="{Binding StockOnlyActionText}" Command="{Binding RevealStockSavesCommand}"
                  Classes="CkanSecondary" HorizontalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_SavesPage_IncludeStock_Tip}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="4" Classes="CkanPageFooter" Margin="0,8,0,0">
    <Grid ColumnDefinitions="Auto,*">
      <TextBlock Grid.Column="0" Text="{Binding SavesDirectoryText}" Classes="CkanCaption"
                 IsVisible="{Binding !ShowNoInstanceState}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="12,0,0,0" Classes="CkanCaption"
                 IsVisible="{Binding !ShowNoInstanceState}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Grid>
    </Border>

    <!-- 进行中遮罩（03 篇 §10：非模态操作条）：无行时骨架屏，有行时进度条 -->
    <Border Grid.RowSpan="5" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Grid>
        <StackPanel IsVisible="{Binding !HasRows}" IsHitTestVisible="False"
                    app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="180" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasRows}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>