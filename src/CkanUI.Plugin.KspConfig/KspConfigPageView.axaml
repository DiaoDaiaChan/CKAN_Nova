<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CkanUI.Plugin.KspConfig"
             x:Class="CkanUI.Plugin.KspConfig.KspConfigPageView"
             x:CompileBindings="False">

  <UserControl.Styles>
    <!-- 列表容器是 ListBox（自带虚拟化）：把行容器的默认内边距/选中/悬停底色全部抹平，视觉与裸 ItemsControl 一致。 -->
    <Style Selector="ListBox.KspConfigList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.KspConfigList ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.KspConfigList ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.KspTabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.KspTabs ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="{DynamicResource CkanPagePadding}">

    <!-- 页头：标题 + 说明 + 路径摘要与语言 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="KSP 游戏原生配置" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Border Classes="CkanBadge" Background="{DynamicResource CkanSurface2Brush}" Margin="4,0,0,0">
            <TextBlock Text="settings.cfg" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource CkanAccentBrush}" />
          </Border>
        </StackPanel>
        <TextBlock Text="直接读取并修改 KSP 原生 settings.cfg 配置文件，提取 Squad 官方语言包 (dictionary.cfg) 对应的汉化标签与描述。"
                   Classes="CkanCaption" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
          <TextBlock Text="{Binding FilePath, StringFormat='文件: {0}'}" Classes="CkanCaption" FontSize="11" />
          <TextBlock Text="{Binding Language, StringFormat='语言: {0}'}" Classes="CkanCaption" FontSize="11" />
          <Border Classes="CkanBadge" IsVisible="{Binding HasBackup}">
            <TextBlock Text="已备份 (.bak)" FontSize="11" Foreground="{DynamicResource CkanSuccessBrush}" />
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- 右侧：未保存状态与保存统计 -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" HorizontalAlignment="Right">
        <Border Classes="CkanBadge" IsVisible="{Binding HasUnsavedChanges}" Background="{DynamicResource CkanWarningBrushMedium}">
          <TextBlock Text="{Binding ModifiedCount, StringFormat='已修改 {0} 项'}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanWarningBrush}" />
        </Border>
      </StackPanel>
    </Grid>

    <!-- 工具条：搜索 + 仅看已改 + 分类切换 + 动作按钮 -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card" Margin="0,0,0,8">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <!-- 搜索框 -->
          <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                   Classes="CkanSearchBox"
                   Width="240" Margin="0,0,8,0"
                   PlaceholderText="搜索键名、中文名称或描述..." />
          <Button Content="清除" Command="{Binding ClearSearchCommand}" Classes="CkanGhost" Margin="0,0,12,0" />

          <!-- 仅显示已修改 -->
          <CheckBox Content="仅看已改" IsChecked="{Binding ShowOnlyModified, Mode=TwoWay}" Margin="0,0,12,0" />

          <!-- 重新载入 -->
          <Button Content="重新加载" Command="{Binding ReloadCommand}"
                  IsEnabled="{Binding !IsLoading}" Classes="CkanSecondary" Margin="0,0,8,0" />

          <!-- 放弃修改 -->
          <Button Content="放弃修改" Command="{Binding DiscardChangesCommand}"
                  IsEnabled="{Binding HasUnsavedChanges}" Classes="CkanGhost" Margin="0,0,8,0" />

          <!-- 保存修改 -->
          <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding HasUnsavedChanges}" Classes="CkanPrimary" Margin="0,0,8,0" />

          <!-- 恢复备份 -->
          <Button Content="恢复备份 (.bak)" Command="{Binding RestoreBackupCommand}"
                  IsEnabled="{Binding HasBackup}" Classes="CkanGhost" Margin="0,0,8,0" />
        </WrapPanel>

        <!-- 分类选择 Tab 栏 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ListBox Classes="KspTabs"
                   ItemsSource="{Binding Tabs}"
                   SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Header}" FontSize="12" VerticalAlignment="Center" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- 状态反馈区 -->
    <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,8">
      <Border IsVisible="{Binding HasStatus}" Classes="CkanInfoBanner" Margin="0,0,0,4">
        <TextBlock Text="{Binding StatusText}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextPrimaryBrush}" />
      </Border>
    </StackPanel>

    <!-- 表头栏：对齐各列标题，建立清晰视觉锚点 -->
    <Border Grid.Row="3" Classes="CkanCard" Background="{DynamicResource CkanSurface2Brush}"
            Padding="14,6" Margin="0,0,0,4" CornerRadius="{DynamicResource CkanCornerRadiusSmall}">
      <Grid ColumnDefinitions="*,180,240,64">
        <TextBlock Grid.Column="0" Text="配置项名称 / 官方说明" Classes="CkanCaption" FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="配置键名 / 官方词条" Classes="CkanCaption" FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="设定值" Classes="CkanCaption" FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="操作" Classes="CkanCaption" FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 列表区：高信息密度紧凑设置项列表 -->
    <ListBox Grid.Row="4" Classes="KspConfigList"
             ItemsSource="{Binding FilteredItems}"
             Background="Transparent" BorderThickness="0" Padding="0"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="CkanCard" Margin="0,0,0,3" Padding="14,6" CornerRadius="{DynamicResource CkanCornerRadiusSmall}">
              <Grid ColumnDefinitions="*,180,240,64" VerticalAlignment="Center">

                <!-- 第 0 列：配置项名称与说明 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="CkanBadge" IsVisible="{Binding IsCommon}" Background="{DynamicResource CkanAccentBrush}" Padding="4,1">
                      <TextBlock Text="常用" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Classes="CkanBadge" IsVisible="{Binding IsModified}" Background="{DynamicResource CkanWarningBrushMedium}">
                      <TextBlock Text="已修改" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CkanWarningBrush}" />
                    </Border>
                  </StackPanel>

                  <!-- 描述/说明（紧凑单行呈现） -->
                  <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                             Classes="CkanCaption" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource CkanTextTertiaryBrush}"
                             ToolTip.Tip="{Binding Description}" />

                  <!-- 原始值与当前值对比提示 -->
                  <TextBlock Text="{Binding OriginalValue, StringFormat='原始值: {0}'}"
                             IsVisible="{Binding IsModified}"
                             Classes="CkanCaption" FontSize="10" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                </StackPanel>

                <!-- 第 1 列：配置键名与官方词条 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                  <Border Classes="CkanBadge" Background="{DynamicResource CkanSurface2Brush}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Key}" FontSize="10" FontFamily="Consolas,DejaVu Sans Mono,monospace"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Key}" />
                  </Border>
                  <Border Classes="CkanBadge" IsVisible="{Binding HasLocKey}" Background="{DynamicResource CkanSurface3Brush}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding LocKey}" FontSize="9"
                               Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                  </Border>
                </StackPanel>

                <!-- 第 2 列：类型专用编辑控件（按类型唯一显示，不再所有控件挤在一起） -->
                <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">

                  <!-- 布尔型开关 -->
                  <ToggleSwitch IsVisible="{Binding IsBoolean}"
                                IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                OnContent="开" OffContent="关"
                                Margin="0" Padding="0"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />

                  <!-- 预设选项下拉框 -->
                  <ComboBox IsVisible="{Binding IsPreset}"
                            ItemsSource="{Binding Options}"
                            SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                            Width="210" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <!-- 浮点型滑块 + 数值显示 -->
                  <StackPanel IsVisible="{Binding IsFloat}" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Slider Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                            Value="{Binding DoubleValue, Mode=TwoWay}"
                            Width="140" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DoubleValue, StringFormat='{}{0:F2}'}"
                               Width="48" TextAlignment="Right" VerticalAlignment="Center"
                               FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="12" />
                  </StackPanel>

                  <!-- 整数型微调输入 -->
                  <TextBox IsVisible="{Binding IsInteger}"
                           Text="{Binding IntegerValue, Mode=TwoWay}"
                           Width="120" VerticalAlignment="Center" TextAlignment="Center"
                           FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="12" />

                  <!-- 字符串型单行文本框 -->
                  <TextBox IsVisible="{Binding IsText}"
                           Text="{Binding TextValue, Mode=TwoWay}"
                           Width="210" VerticalAlignment="Center" FontSize="12" />
                </Grid>

                <!-- 第 3 列：重置等操作 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Classes="CkanGhost CkanSmall"
                          Command="{Binding ResetCommand}"
                          IsEnabled="{Binding IsModified}"
                          ToolTip.Tip="恢复为读盘时的原始值"
                          Padding="6,3">
                    <TextBlock Text="重置" FontSize="11" />
                  </Button>
                </StackPanel>

              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

  </Grid>
</UserControl>
