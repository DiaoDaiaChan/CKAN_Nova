<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CkanUI.Plugin.KspConfig"
             xmlns:cfg="using:CkanUI.Services.Abstractions.KspConfig"
             xmlns:ui="using:CkanUI.Ui.Icons"
             x:Class="CkanUI.Plugin.KspConfig.KspConfigPageView"
             x:CompileBindings="True"
             x:DataType="vm:KspConfigPageViewModel">

  <UserControl.Styles>
    <!-- 分类页签：胶囊底 + 计数角标；选中才上强调色，未选中就是一排安静的过滤器。 -->
    <Style Selector="ListBox.KspTabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.KspTabs ListBoxItem">
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusPill}" />
    </Style>
    <Style Selector="ListBox.KspTabs ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CkanLayerRecessedBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusPill}" />
    </Style>
    <Style Selector="ListBox.KspTabs ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CkanLayerElevatedBrush}" />
    </Style>
    <Style Selector="ListBox.KspTabs ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
    </Style>
    <Style Selector="ListBox.KspTabs ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="{DynamicResource CkanPagePadding}">

    <!-- 页头：标题 + 说明 + 路径摘要与语言 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="KSP 游戏原生配置" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Border Classes="CkanBadge">
            <TextBlock Text="settings.cfg" FontSize="11" />
          </Border>
          <Border Classes="CkanBadge Success" IsVisible="{Binding HasBackup}" ToolTip.Tip="同目录存在 settings.cfg.bak，随时可回滚">
            <TextBlock Text="已备份" FontSize="11" />
          </Border>
        </StackPanel>
        <TextBlock Text="直接读取并修改 KSP 原生 settings.cfg，中文名与说明取自 Squad 官方 dictionary.cfg。"
                   Classes="CkanCaption" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding FilePath}" Classes="CkanCaption" FontSize="11" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Language, StringFormat='语言 {0}'}" Classes="CkanCaption" FontSize="11" />
        </StackPanel>
      </StackPanel>

      <!-- 右侧：未保存状态 -->
      <Border Grid.Column="1" Classes="CkanBadge Warning" IsVisible="{Binding HasUnsavedChanges}"
              VerticalAlignment="Center" ToolTip.Tip="点「保存修改」写入 settings.cfg 并刷新备份">
        <TextBlock Text="{Binding ModifiedCount, StringFormat='未保存 {0} 项'}" />
      </Border>
    </Grid>

    <!-- 工具条：搜索 + 动作 + 分类页签 + 计数 -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card" Padding="10,8" Margin="0,0,0,6">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
        <WrapPanel Grid.Row="0" Orientation="Horizontal">
          <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                   Classes="CkanSearchBox"
                   Width="240" Margin="0,0,6,0"
                   PlaceholderText="搜索键名、中文名称或描述..." />
          <Button Content="清除" Command="{Binding ClearSearchCommand}" Classes="CkanGhost" Margin="0,0,10,0"
                  IsEnabled="{Binding HasSearchText}" />
          <CheckBox Content="仅看已改" IsChecked="{Binding ShowOnlyModified, Mode=TwoWay}" Margin="0,0,12,0" />
          <Button Content="重新加载" Command="{Binding LoadConfigCommand}"
                  IsEnabled="{Binding !IsLoading}" Classes="CkanSecondary" Margin="0,0,6,0" />
          <Button Content="放弃修改" Command="{Binding DiscardChangesCommand}"
                  IsEnabled="{Binding HasUnsavedChanges}" Classes="CkanGhost" Margin="0,0,6,0" />
          <Button Content="{Binding SaveButtonText}" Command="{Binding SaveConfigCommand}"
                  IsEnabled="{Binding HasUnsavedChanges}" Classes="CkanPrimary" Margin="0,0,6,0" />
          <Button Content="恢复备份" Command="{Binding RestoreBackupCommand}"
                  IsEnabled="{Binding HasBackup}" Classes="CkanGhost"
                  ToolTip.Tip="用 settings.cfg.bak 覆盖当前 settings.cfg" />
        </WrapPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
          <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ListBox Classes="KspTabs"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:KspConfigCategoryTabViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ui:GlyphIcon Glyph="{Binding Icon}" Size="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Count}" FontSize="10" VerticalAlignment="Center" Opacity="0.65" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>

          <TextBlock Grid.Column="1" Text="{Binding VisibleCountText}"
                     Classes="CkanCaption" FontSize="11" Margin="10,0,0,0"
                     VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>

    <!-- 状态反馈：没有话要说的时候整行不占高度 -->
    <Border Grid.Row="2" Classes="CkanStatusStrip" Margin="0,0,0,6" IsVisible="{Binding HasStatus}">
      <TextBlock Text="{Binding StatusMessage}" Classes="CkanCaption" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- 表体：按分类分节，版式对齐设置页（分组标题 + 平铺行 + 右对齐编辑槽）。
         空列表时换成说明卡，不留一片空白。 -->
    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding !HasEmptyResult}">
      <ItemsControl ItemsSource="{Binding Sections}" Margin="0,0,14,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KspConfigSectionViewModel">
            <StackPanel Margin="0,0,0,14">

              <!-- 分组标题：设置页同款——小图标 + 加粗标题 + 灰计数，不画卡片不铺底色 -->
              <StackPanel Classes="KspSectionHeader" Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
                <ui:GlyphIcon Glyph="{Binding Icon}" Size="14" VerticalAlignment="Center"
                              Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Classes="KspSectionTitle" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource CkanTextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Count}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KspSettingItemViewModel">
                    <Border Classes="KspRow" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource CkanHairlineBrush}" Padding="0,6">
                      <Grid ColumnDefinitions="*,240,96" VerticalAlignment="Center">

                        <!-- 名称 / 说明 / 原值线索：名称列固定 200，说明占剩余宽度 -->
                        <Grid Grid.Column="0" ColumnDefinitions="200,*,Auto" Margin="0,0,16,0"
                              VerticalAlignment="Center">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Classes="CkanBadge Accent" IsVisible="{Binding IsCommon}" Padding="5,0">
                              <TextBlock Text="常用" FontSize="10" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                       LineHeight="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource CkanTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Key}" />
                          </StackPanel>

                          <TextBlock Grid.Column="1" Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                     Classes="CkanCaption" FontSize="11" LineHeight="14" Margin="10,0,0,0"
                                     VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource CkanTextTertiaryBrush}"
                                     ToolTip.Tip="{Binding Description}" />

                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                      VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Classes="CkanBadge Warning" IsVisible="{Binding IsModified}" Padding="5,0">
                              <TextBlock Text="已修改" FontSize="10" />
                            </Border>
                            <TextBlock Text="{Binding OriginalValue, StringFormat='原值 {0}'}"
                                       IsVisible="{Binding IsModified}" FontSize="10"
                                       Foreground="{DynamicResource CkanTextTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Key}" IsVisible="{Binding IsModified}" FontSize="9"
                                       FontFamily="Consolas,DejaVu Sans Mono,monospace"
                                       Foreground="{DynamicResource CkanTextTertiaryBrush}"
                                       VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding LocKey}" />
                          </StackPanel>
                        </Grid>

                        <!-- 编辑控件槽：固定 240，与设置页的编辑器列同宽；各类型互斥显示 -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">

                          <!-- 设置页同款：只留开关本体，不带 On/Off 文案——文案在 240 的槽里会被裁掉 -->
                          <ToggleSwitch IsVisible="{Binding IsBoolean}"
                                        IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                        OnContent="" OffContent=""
                                        MinHeight="24" Height="24" Margin="0" Padding="0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" />

                          <ComboBox IsVisible="{Binding IsPreset}"
                                    ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                    MinHeight="24" Height="24" Padding="8,0" VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="cfg:KspOptionEntry">
                                <TextBlock Text="{Binding Label}" FontSize="12" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>

                          <Grid IsVisible="{Binding IsFloat}" ColumnDefinitions="*,48" VerticalAlignment="Center">
                            <Slider Grid.Column="0" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                    Value="{Binding DoubleValue, Mode=TwoWay}"
                                    Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DoubleValue, StringFormat='{}{0:F2}'}"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="11"
                                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                          </Grid>

                          <TextBox IsVisible="{Binding IsInteger}"
                                   Text="{Binding IntegerValue, Mode=TwoWay}"
                                   Width="110" MinHeight="24" Height="24" Padding="6,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" TextAlignment="Center"
                                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                                   FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="12" />

                          <TextBox IsVisible="{Binding IsText}"
                                   Text="{Binding TextValue, Mode=TwoWay}"
                                   MinHeight="24" Height="24" Padding="8,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Stretch" FontSize="12"
                                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}" />
                        </Grid>

                        <!-- 动作槽：固定 96，右对齐，与设置页的辅助按钮位一致 -->
                        <Button Grid.Column="2" Classes="CkanGhost CkanSmall"
                                Command="{Binding ResetCommand}"
                                IsEnabled="{Binding IsModified}"
                                ToolTip.Tip="恢复为读盘时的原始值"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,2" FontSize="11"
                                Content="重置" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="3" Classes="CkanEmptyStateCard Flat" IsVisible="{Binding HasEmptyResult}"
            VerticalAlignment="Top" Margin="0,8,0,0" Padding="16,12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ui:GlyphIcon Glyph="Check" Size="18" VerticalAlignment="Top" />
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding EmptyResultText}" Classes="CkanCaption" TextWrapping="Wrap" />
          <Button Content="清除筛选条件" Command="{Binding ResetFiltersCommand}"
                  Classes="CkanGhost" HorizontalAlignment="Left" Padding="8,2" FontSize="11" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
