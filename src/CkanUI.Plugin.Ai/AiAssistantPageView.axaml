<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CkanUI.Plugin.Ai"
             xmlns:md="using:CkanUI.Plugin.Ai.Markdown"
             x:Class="CkanUI.Plugin.Ai.AiAssistantPageView"
             x:CompileBindings="False">
  <!--
    第三方式插件页：只依赖 Avalonia 与 CkanUI.Services.Abstractions，因此这里
    用宿主 App 级资源 token（Ckan*）与样式类，不引用任何宿主控件程序集。
  -->
  <UserControl.Resources>
    <DataTemplate x:Key="AiMessageTemplate">
      <Border Classes="ai-bubble" Classes.user="{Binding IsUser}">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding Role}"
                       Classes="CkanCaption"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </Grid>
          <SelectableTextBlock Text="{Binding Text}"
                               IsVisible="{Binding IsUser}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <md:AiMarkdownView MarkdownText="{Binding Text}"
                             IsVisible="{Binding !IsUser}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AiTraceTemplate">
      <Border Classes="ai-trace" Classes.failed="{Binding !Ok}">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Header}"
                     Classes="CkanCaption"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <TextBlock Text="{Binding ResultPreview}"
                     Classes="CkanCaption"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.ai-workspace">
      <Setter Property="Background" Value="{DynamicResource CkanCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusMedium}" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.ai-bubble">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MaxWidth" Value="760" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="{DynamicResource CkanMutedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusMedium}" />
    </Style>
    <Style Selector="Border.ai-bubble.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
    </Style>
    <Style Selector="Border.ai-dialogue-card">
      <Setter Property="Background" Value="{DynamicResource CkanCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusMedium}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.ai-trace">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
      <Setter Property="Background" Value="{DynamicResource CkanLayerRecessedBrush}" />
    </Style>
    <Style Selector="Border.ai-trace.failed">
      <Setter Property="Background" Value="{DynamicResource CkanWarningBrush}" />
    </Style>
    <Style Selector="TextBlock.ai-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.ai-quick-chip">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusMedium}" />
      <Setter Property="Background" Value="{DynamicResource CkanMutedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.ai-quick-chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="{DynamicResource CkanPagePadding}">

    <!-- ── 标题 + 状态与模型胶囊 ────────────────────────────────────────── -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Column="0" Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="AI 助手" Classes="CkanPageTitle" />
          <Border Background="{DynamicResource CkanAccentSubtleBrush}"
                  CornerRadius="10"
                  Padding="8,2"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentModelSummary}"
                       Classes="CkanCaption"
                       Foreground="{DynamicResource CkanAccentBrush}" />
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}"
                   Classes="CkanCaption"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource CkanTextTertiaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Border Background="{DynamicResource CkanWarningBrush}"
                CornerRadius="10"
                Padding="8,3"
                IsVisible="{Binding IsBusy}">
          <TextBlock Text="思考与工具调用中…"
                     Classes="CkanCaption"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        </Border>
      </StackPanel>
    </Grid>

    <!-- ── 错误条 ──────────────────────────────────────────────────────── -->
    <Border Grid.Row="1"
            Classes="CkanInfoBanner Danger"
            IsVisible="{Binding HasError}"
            Margin="0,0,0,10">
      <TextBlock Text="{Binding ErrorText}"
                 Classes="CkanCaption"
                 TextWrapping="Wrap" />
    </Border>

    <!-- ── 工作区（对话流与空状态切换） ──────────────────────────────────── -->
    <Border Grid.Row="2" Classes="ai-workspace" Margin="0,0,0,10">
      <Panel>
        <!-- 空状态：欢迎引导卡与快捷指令 Chips -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsEmpty}">
          <StackPanel MaxWidth="680"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="16"
                      Margin="16,32">
            <Border Width="56"
                    Height="56"
                    CornerRadius="28"
                    Background="{DynamicResource CkanAccentSubtleBrush}"
                    BorderBrush="{DynamicResource CkanAccentBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
              <TextBlock Text="✨"
                         FontSize="26"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="CKAN 智能助手"
                         FontSize="20"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="支持全模组检索、依赖与冲突诊断、MCP 在线搜索、图形公式渲染与界面智能控制。"
                         Classes="CkanCaption"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>

            <Separator Background="{DynamicResource CkanCardBorderBrush}" Margin="0,8" />

            <TextBlock Text="💡 点击快捷指令立即体验："
                       Classes="CkanCaption"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextTertiaryBrush}" />

            <WrapPanel Orientation="Horizontal">
              <Button Classes="ai-quick-chip"
                      Command="{Binding QuickPromptCommand}"
                      CommandParameter="推荐几个常用的 KSP 必备画质和视觉增强模组，并说明依赖关系。">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="🔍" />
                  <TextBlock Text="推荐画质与环境增强模组" />
                </StackPanel>
              </Button>
              <Button Classes="ai-quick-chip"
                      Command="{Binding QuickPromptCommand}"
                      CommandParameter="诊断当前 KSP 实例已安装模组的状态，检查是否有兼容性或冲突问题。">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="⚠️" />
                  <TextBlock Text="诊断当前实例模组依赖与冲突" />
                </StackPanel>
              </Button>
              <Button Classes="ai-quick-chip"
                      Command="{Binding QuickPromptCommand}"
                      CommandParameter="帮我将应用界面切换为深色模式，并把模组列表过滤为 visual 相关的模组。">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="🎨" />
                  <TextBlock Text="切换深色主题并筛选模组" />
                </StackPanel>
              </Button>
              <Button Classes="ai-quick-chip"
                      Command="{Binding QuickPromptCommand}"
                      CommandParameter="查看当前激活的 KSP 实例版本与安装路径，并列出推荐的常用工具。">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="🚀" />
                  <TextBlock Text="查看当前实例状态与必备工具" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 对话消息列表 -->
        <ScrollViewer x:Name="MessageScroll"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasMessages}">
          <StackPanel Spacing="4">
            <ItemsControl ItemsSource="{Binding Messages}"
                          ItemTemplate="{StaticResource AiMessageTemplate}" />

            <!-- 思考中气泡 -->
            <Border Classes="ai-bubble"
                    IsVisible="{Binding IsBusy}"
                    Background="{DynamicResource CkanLayerRecessedBrush}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="⏳" />
                <TextBlock Text="AI 正在思考分析并调用工具…"
                           Classes="CkanCaption"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>

    <!-- ── 工具轨迹（折叠） ────────────────────────────────────────────── -->
    <Expander Grid.Row="3"
              Margin="0,0,0,10"
              HorizontalAlignment="Stretch"
              IsVisible="{Binding HasToolTraces}"
              IsExpanded="{Binding IsToolTraceExpanded, Mode=TwoWay}">
      <Expander.Header>
        <TextBlock Text="{Binding ToolTraceSummary}" Classes="CkanCaption" FontWeight="SemiBold" />
      </Expander.Header>
      <ItemsControl ItemsSource="{Binding ToolTraces}"
                    ItemTemplate="{StaticResource AiTraceTemplate}"
                    Margin="0,4,0,0" />
    </Expander>

    <!-- ── 现代统一对话框 ──────────────────────────────────────────────── -->
    <Border Grid.Row="4" Classes="ai-dialogue-card" Margin="0,0,0,10">
      <Grid RowDefinitions="*,Auto">
        <!-- 文本输入框 -->
        <TextBox Grid.Row="0"
                 x:Name="InputTextBox"
                 Text="{Binding DraftText, Mode=TwoWay}"
                 PlaceholderText="输入问题或控制指令… (Enter 发送，Shift+Enter 换行)"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="56"
                 MaxHeight="140"
                 BorderThickness="0"
                 Background="Transparent"
                 VerticalContentAlignment="Top"
                 VerticalAlignment="Stretch" />

        <!-- 对话框底栏：提示与操作按钮组 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,6,0,0">
          <TextBlock Grid.Column="0"
                     Text="Enter 发送 · Shift+Enter 换行"
                     Classes="CkanCaption"
                     FontSize="11"
                     Foreground="{DynamicResource CkanTextTertiaryBrush}"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="清空"
                    Classes="CkanGhost"
                    Command="{Binding ClearCommand}"
                    ToolTip.Tip="清空历史对话与工具轨迹" />
            <Button Content="停止"
                    Classes="CkanSecondary"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding IsBusy}"
                    ToolTip.Tip="停止当前生成" />
            <Button Content="发送"
                    Classes="CkanPrimary"
                    Command="{Binding SendCommand}"
                    ToolTip.Tip="发送当前内容 (Enter)" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- ── 统一控件与设置面板（图3） ──────────────────────────────────── -->
    <Expander Grid.Row="5" Header="AI 模型与环境设置">
      <StackPanel Spacing="10" Margin="0,6,0,0">
        <!-- 基础配置与端点 -->
        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" Classes="ai-label" />
          <TextBox Grid.Row="0"
                   Grid.Column="1"
                   Text="{Binding BaseUrl, Mode=TwoWay}"
                   PlaceholderText="http://host:port/v1" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="模型名称" Classes="ai-label" Margin="0,6,0,0" />
          <TextBox Grid.Row="1"
                   Grid.Column="1"
                   Text="{Binding Model, Mode=TwoWay}"
                   Margin="0,6,0,0" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" Classes="ai-label" Margin="0,6,0,0" />
          <TextBox Grid.Row="2"
                   Grid.Column="1"
                   Text="{Binding ApiKey, Mode=TwoWay}"
                   PasswordChar="●"
                   PlaceholderText="保存后由 DPAPI 加密落到磁盘，内存里才存明文"
                   Margin="0,6,0,0" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="MCP 命令" Classes="ai-label" Margin="0,6,0,0" />
          <TextBox Grid.Row="3"
                   Grid.Column="1"
                   Text="{Binding McpCommand, Mode=TwoWay}"
                   PlaceholderText="留空表示自动探测或使用 WebSearch 降级；例：uvx search-mcp"
                   Margin="0,6,0,0" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="MCP 参数" Classes="ai-label" Margin="0,6,0,0" />
          <TextBox Grid.Row="4"
                   Grid.Column="1"
                   Text="{Binding McpArgsText, Mode=TwoWay}"
                   PlaceholderText="空格分隔；留空使用默认探测参数"
                   Margin="0,6,0,0" />
        </Grid>

        <!-- 操作按钮与路径 -->
        <Grid ColumnDefinitions="*,Auto">
          <WrapPanel Grid.Column="0" Orientation="Horizontal">
            <Button Content="保存配置"
                    Classes="CkanPrimary"
                    Command="{Binding SaveSettingsCommand}"
                    Margin="0,0,8,0" />
            <Button Content="测试连通性"
                    Classes="CkanSecondary"
                    Command="{Binding TestConnectionCommand}"
                    Margin="0,0,8,0" />
            <Button Content="恢复默认"
                    Classes="CkanGhost"
                    Command="{Binding ResetSettingsCommand}"
                    Margin="0,0,8,0" />
          </WrapPanel>
          <TextBlock Grid.Column="1"
                     Text="{Binding SettingsPath}"
                     Classes="CkanCaption"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource CkanTextTertiaryBrush}" />
        </Grid>
      </StackPanel>
    </Expander>
  </Grid>
</UserControl>