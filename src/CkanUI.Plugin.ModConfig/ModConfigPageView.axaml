<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:CkanUI.Plugin.ModConfig"
             x:Class="CkanUI.Plugin.ModConfig.ModConfigPageView"
             x:CompileBindings="False">
  <UserControl.Resources>
    <!-- 取色字段的色块预览：十六进制文本 → 画刷（解析不了就是透明，行内有文字说明兜底）。 -->
    <conv:HexColorToBrushConverter x:Key="HexColorToBrush" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui_ModConfig_PageTitle}" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_ModConfigPage_Header_Tip}">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
          <!-- 模式切换：适配器配置 / 通用配置 -->
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
            <Button Content="{DynamicResource Ui_ModConfig_TabAdapters}"
                    Command="{Binding SelectAdapterModeCommand}"
                    Classes="CkanChip"
                    Classes.Active="{Binding IsAdapterMode}" />
            <Button Content="{DynamicResource Ui_ModConfig_TabGeneric}"
                    Command="{Binding SelectGenericModeCommand}"
                    Classes="CkanChip"
                    Classes.Active="{Binding IsGenericMode}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{DynamicResource Ui_ModConfigPage_Subtitle}"
                   Classes="CkanCaption" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Column="1" Classes="CkanBadge" VerticalAlignment="Center" Margin="12,0,0,0"
              IsVisible="{Binding HasInstanceSummary}">
        <TextBlock Text="{Binding InstanceSummaryText}" TextWrapping="Wrap" MaxWidth="380" />
      </Border>
    </Grid>

    <!-- KSP 运行中警示（15 篇 §5：运行时只警示 + 写盘二次确认，不粗暴禁写） -->
    <Border Grid.Row="1" IsVisible="{Binding ShowGameRunningWarning}"
            Classes="CkanInfoBanner Warning"
            Margin="0,0,0,8">
      <TextBlock Text="{Binding GameRunningWarningText}"
                 TextWrapping="Wrap"
                 Classes="CkanCaption"
                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
    </Border>

    <!-- 错误提示区（保存失败、读盘失败都落在这里） -->
    <Border Grid.Row="2" IsVisible="{Binding HasError}"
            Classes="CkanInfoBanner Danger"
            Margin="0,0,0,8">
      <TextBlock Text="{Binding ErrorText}"
                 TextWrapping="Wrap"
                 Classes="CkanCaption"
                 Foreground="{DynamicResource CkanDangerBrush}" />
    </Border>

    <!-- 工具条：搜索 + 仅看已改 + 刷新（仅适配器模式） -->
    <Border Grid.Row="3" Classes="CkanToolbar stagger-card" IsVisible="{Binding IsAdapterMode}">
      <StackPanel Spacing="0">
      <WrapPanel Orientation="Horizontal">
        <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                 Classes="CkanSearchBox"
                 Width="240" Margin="0,0,8,0"
                 PlaceholderText="{DynamicResource Ui_ModConfigPage_Filter_Placeholder}"
                 ToolTip.Tip="{DynamicResource Ui_ModConfigPage_Filter_Tip}" />
        <Button Content="{DynamicResource Ui_Common_Clear}" Command="{Binding ClearSearchCommand}" Classes="CkanGhost" Margin="0,0,12,0" />
        <CheckBox Content="{DynamicResource Ui_ModConfigPage_ModifiedOnly}" IsChecked="{Binding OnlyModified, Mode=TwoWay}" Margin="0,0,12,0"
                  ToolTip.Tip="{DynamicResource Ui_ModConfigPage_ModifiedOnly_Tip}" />
        <Button Content="{DynamicResource Ui_Common_Refresh}" Command="{Binding LoadCommand}"
                IsEnabled="{Binding CanLoad}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_ModConfigPage_Refresh_Tip}" />
        <Button Content="{DynamicResource Ui_ModConfigPage_ReloadAdapters}" Command="{Binding ReloadAdaptersCommand}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_ModConfigPage_ReloadAdapters_Tip}" />
        <Button Content="{DynamicResource Ui_ModConfigPage_ImportAdapter}" Command="{Binding ImportAdapterCommand}"
                IsVisible="{Binding CanImportAdapter}" Classes="CkanPrimary" Margin="0,0,12,0"
                ToolTip.Tip="{DynamicResource Ui_ModConfigPage_ImportAdapter_Tip}" />
        <TextBlock Text="{Binding VisibleCountText}" VerticalAlignment="Center" Margin="0,0,12,0"
                   Classes="CkanCaption" />
      </WrapPanel>

      <!-- 状态句单独一行：和按钮同排时长句会把工具条挤成两段 -->
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,6,0,0"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextTertiaryBrush}" />
      </StackPanel>
    </Border>

    <!-- 左：mod 卡片列表；右：字段行（仅适配器模式） -->
    <Grid Grid.Row="4" ColumnDefinitions="340,*" Margin="0,12,0,0" IsVisible="{Binding IsAdapterMode}">

      <Border Grid.Column="0" Classes="CkanCard stagger-card" Padding="4">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Padding="10,8"
                  BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{DynamicResource Ui_ModConfigPage_ModWithAdapterHeader}"
                         FontWeight="SemiBold"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding ModCountText}"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextTertiaryBrush}" />
            </Grid>
          </Border>

          <ListBox Grid.Row="1" ItemsSource="{Binding Mods}"
                   SelectedItem="{Binding SelectedMod, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent"
                   IsVisible="{Binding HasMods}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                    <TextBlock Text="{Binding VersionText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Text="{Binding WarningText}"
                               IsVisible="{Binding HasWarning}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanWarningBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <Border Classes="CkanBadge Accent">
                      <TextBlock Text="{Binding BadgeText}"
                                 FontSize="{DynamicResource CkanFontSizeCaption}" />
                    </Border>
                    <TextBlock Text="{Binding ModifiedText}"
                               IsVisible="{Binding HasModified}"
                               HorizontalAlignment="Right"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanWarningBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="1" Classes="CkanEmptyStateCard Flat" Padding="16,24"
                  IsVisible="{Binding ShowEmptyState}">
            <StackPanel Spacing="10" VerticalAlignment="Center" MaxWidth="260">
              <Border Classes="CkanIconTile Muted" HorizontalAlignment="Left">
                <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
              </Border>
              <TextBlock Text="{DynamicResource Ui_ModConfigPage_NoConfigsTitle}"
                         TextWrapping="Wrap"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="{DynamicResource Ui_ModConfigPage_NoConfigsSubtitle}"
                         TextWrapping="Wrap"
                         Classes="CkanCaption" />
              <Button Content="{DynamicResource Ui_ModConfigPage_GoToInstancesPage}"
                      Classes="CkanSecondary CkanSmall"
                      HorizontalAlignment="Left"
                      Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                      CommandParameter="instances"
                      ToolTip.Tip="{DynamicResource Ui_ModConfigPage_SelectInstanceFirst_Tip}" />
            </StackPanel>
          </Border>

          <!-- 底部：无适配器的 mod 计数 + 已加载适配器清单 -->
          <Border Grid.Row="2" Padding="10,8"
                  BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding AdapterlessText}"
                         IsVisible="{Binding HasAdapterless}"
                         TextWrapping="Wrap"
                         Classes="CkanCaption" />
              <TextBlock Text="{Binding AdapterListTitle}"
                         IsVisible="{Binding HasAdapters}"
                         FontWeight="SemiBold"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              <ItemsControl ItemsSource="{Binding Adapters}" IsVisible="{Binding HasAdapters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis"
                                 Classes="CkanCaption" />
                      <TextBlock Grid.Column="1" Text="{Binding SourceText}"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- 右：选中 mod 的字段 -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="16,0,0,0">
        <Border Grid.Row="0" Padding="0,0,0,10" IsVisible="{Binding !IsSelectionEmpty}"
                BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding HeaderTitleText}"
                       FontSize="{DynamicResource CkanFontSizeHeading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBlock Text="{Binding HeaderStateText}"
                       IsVisible="{Binding HasSelection}"
                       Classes="CkanCaption" />
            <TextBlock Text="{Binding SelectedWarningText}"
                       IsVisible="{Binding HasSelectedWarning}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanWarningBrush}" />
          </StackPanel>
        </Border>

        <!-- 空态放在滚动区之外：滚动区里的内容无法垂直居中 -->
        <Border Grid.Row="1"
                Classes="CkanEmptyStateCard Elevated stagger-card" Padding="24,28"
                IsVisible="{Binding IsSelectionEmpty}">
          <Grid>
            <Border Classes="CkanEmptyStateGlow" />
            <StackPanel Spacing="12" MaxWidth="360" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
                <PathIcon Data="M4 4h16v2H4V4zm0 5h16v2H4V9zm0 5h10v2H4v-2zm0 5h7v2H4v-2z" />
              </Border>
              <TextBlock Text="{DynamicResource Ui_ModConfig_NoModSelected}" FontSize="{DynamicResource CkanFontSizeSubtitle}"
                         FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="{Binding NoSelectionHintText}"
                         TextWrapping="Wrap" TextAlignment="Center"
                         Classes="CkanCaption" />
              <!-- 两张入口卡：空态不该只有一句"没选中"，要给得出去的下一步 -->
              <Button Classes="CkanGuide" HorizontalAlignment="Stretch"
                      Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                      CommandParameter="mods"
                      ToolTip.Tip="{DynamicResource Ui_ModConfigPage_SelectModFirst_Tip}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <Border Classes="CkanIconTile">
                      <PathIcon Data="M4 5h16v2H4V5zm0 6h16v2H4v-2zm0 6h10v2H4v-2z" />
                    </Border>
                    <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_ModConfigPage_PickModTitle}" />
                    <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_ModConfigPage_PickModSubtitle}" />
                  </StackPanel>
                  <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="8,0,0,0"
                            Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
                </Grid>
              </Button>
              <Button Classes="CkanGuide" HorizontalAlignment="Stretch"
                      Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                      CommandParameter="instances"
                      ToolTip.Tip="{DynamicResource Ui_ModConfigPage_InstanceMustBeReady_Tip}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <Border Classes="CkanIconTile Muted">
                      <PathIcon Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                    </Border>
                    <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_ModConfigPage_InstanceNotReadyTitle}" />
                    <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_ModConfigPage_InstanceNotReadySubtitle}" />
                  </StackPanel>
                  <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="8,0,0,0"
                            Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" IsVisible="{Binding !IsSelectionEmpty}">
          <StackPanel Spacing="12">

            <!-- 字段分组：标题来自 // #### 分节注释（无标题的组不画表头） -->
            <ItemsControl ItemsSource="{Binding FieldGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="6" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Title}"
                               IsVisible="{Binding HasTitle}"
                               FontWeight="SemiBold"
                               Classes="CkanSectionTitle"
                               Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="10,8" Margin="0,3"
                                  Classes="CkanCard">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                              <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2">
                                <TextBlock Text="{Binding Label}"
                                           TextWrapping="Wrap"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                                <TextBlock Text="{Binding CommentText}"
                                           IsVisible="{Binding HasComment}"
                                           TextWrapping="Wrap"
                                           Classes="CkanCaption" />
                              </StackPanel>

                              <!-- 右上：风险/重启标记 + 编辑控件（按 EditorKind 选一个显示） -->
                              <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                          VerticalAlignment="Center">
                                <TextBlock Text="{Binding RiskText}"
                                           IsVisible="{Binding HasRisk}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource CkanFontSizeCaption}"
                                           Foreground="{DynamicResource CkanWarningBrush}" />
                                <TextBlock Text="{Binding RestartText}"
                                           IsVisible="{Binding HasRestartMark}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource CkanFontSizeCaption}"
                                           Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                                <CheckBox Content="{DynamicResource Ui_Common_On}" IsVisible="{Binding ShowToggle}"
                                          IsChecked="{Binding IsToggleOn, Mode=TwoWay}"
                                          MinWidth="72" />
                                <ComboBox IsVisible="{Binding ShowDropdown}"
                                          ItemsSource="{Binding Choices}"
                                          SelectedItem="{Binding EditValue, Mode=TwoWay}"
                                          MinWidth="160"
                                          PlaceholderText="{DynamicResource Ui_Common_NotSet}" />
                                <TextBox IsVisible="{Binding ShowTextEditor}"
                                         Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnEditorKeyDown"
                                         AcceptsReturn="{Binding IsMultilineEditor}"
                                         MinWidth="200" MaxWidth="320"
                                         TextWrapping="Wrap"
                                         PlaceholderText="{DynamicResource Ui_Common_NotSet}" />
                                <!-- 路径字段的「浏览…」：挑到目录就填进草稿，取消保留原值。 -->
                                <Button Classes="CkanGhost CkanSmall"
                                        Content="{DynamicResource Ui_Common_Browse}"
                                        Command="{Binding BrowseCommand}"
                                        IsVisible="{Binding CanBrowse}"
                                        ToolTip.Tip="{DynamicResource Ui_ModConfigPage_BrowseDir_Tip}" />
                                <!-- 取色字段：色块预览 + 十六进制文本（写法不受限，识别不了仍按原文写入）。 -->
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding ShowColorEditor}">
                                  <Border Width="24" Height="24"
                                          CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource CkanBorderBrush}"
                                          Background="{Binding ColorPreviewHex, Converter={StaticResource HexColorToBrush}}"
                                          ToolTip.Tip="{Binding ColorPreviewHex}" />
                                  <TextBox Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           KeyDown="OnEditorKeyDown"
                                           MinWidth="140" MaxWidth="200"
                                           PlaceholderText="#RRGGBB" />
                                </StackPanel>
                                <!-- 按键字段：可直接输入键名，也可按住 Ctrl/Alt 再按键捕获。 -->
                                <TextBox IsVisible="{Binding ShowKeyCapture}"
                                         Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnKeyCaptureKeyDown"
                                         MinWidth="160" MaxWidth="220"
                                         PlaceholderText="Ctrl+K"
                                         ToolTip.Tip="{DynamicResource Ui_ModConfigPage_KeyCapture_Tip}" />
                                <TextBlock Text="{Binding ValueText}"
                                           IsVisible="{Binding ShowReadOnlyValue}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           MaxWidth="320" TextWrapping="Wrap"
                                           Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                              </StackPanel>

                              <!-- 说明行（只读原因 / 颜色写法 / 按键捕获提示）：三块互斥，同一时刻最多一块可见。 -->
                              <TextBlock Grid.Column="1" Grid.Row="1"
                                         Text="{Binding ReadOnlyNote}"
                                         IsVisible="{Binding HasReadOnlyNote}"
                                         HorizontalAlignment="Right"
                                         MaxWidth="360" TextWrapping="Wrap"
                                         FontSize="{DynamicResource CkanFontSizeCaption}"
                                         Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                              <TextBlock Grid.Column="1" Grid.Row="1"
                                         Text="{Binding ColorNote}"
                                         IsVisible="{Binding HasColorNote}"
                                         HorizontalAlignment="Right"
                                         MaxWidth="360" TextWrapping="Wrap"
                                         FontSize="{DynamicResource CkanFontSizeCaption}"
                                         Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                              <TextBlock Grid.Column="1" Grid.Row="1"
                                         Text="{Binding KeyCaptureHint}"
                                         IsVisible="{Binding HasKeyCaptureHint}"
                                         HorizontalAlignment="Right"
                                         MaxWidth="360" TextWrapping="Wrap"
                                         FontSize="{DynamicResource CkanFontSizeCaption}"
                                         Foreground="{DynamicResource CkanTextTertiaryBrush}" />

                              <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                                          Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Key}"
                                           FontSize="{DynamicResource CkanFontSizeCaption}"
                                           Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                                <TextBlock Text="{Binding HintText}"
                                           IsVisible="{Binding HasHint}"
                                           FontSize="{DynamicResource CkanFontSizeCaption}"
                                           Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                                <TextBlock Text="{DynamicResource Ui_ModConfigPage_ModifiedTag}"
                                           IsVisible="{Binding IsModified}"
                                           FontSize="{DynamicResource CkanFontSizeCaption}"
                                           Foreground="{DynamicResource CkanWarningBrush}" />
                                <TextBlock Text="{DynamicResource Ui_ModConfigPage_PendingSaveTag}"
                                           IsVisible="{Binding HasPendingChange}"
                                           FontSize="{DynamicResource CkanFontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource CkanAccentBrush}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- 通用配置模式主体 -->
    <Grid Grid.Row="4" ColumnDefinitions="340,*" Margin="0,12,0,0" IsVisible="{Binding IsGenericMode}">
      <!-- 左：cfg 配置文件列表 -->
      <Border Grid.Column="0" Classes="CkanCard stagger-card" Padding="4">
        <Grid RowDefinitions="Auto,*,Auto">
          <!-- 搜索框与刷新 -->
          <StackPanel Grid.Row="0" Margin="4,4,4,8" Spacing="6">
            <TextBox Text="{Binding Generic.SearchText, Mode=TwoWay}"
                     Classes="CkanSearchBox"
                     PlaceholderText="{DynamicResource Ui_ModConfigGeneric_SearchPlaceholder}" />
            <CheckBox Content="{DynamicResource Ui_ModConfigGeneric_WideScan}"
                      IsChecked="{Binding Generic.WideScan, Mode=TwoWay}"
                      ToolTip.Tip="{DynamicResource Ui_ModConfigGeneric_WideScanTip}" />
            <TextBlock Text="{Binding Generic.HiddenWideCountText}"
                       IsVisible="{Binding Generic.HasHiddenWideCandidates}"
                       Classes="CkanCaption" TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanTextTertiaryBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Generic.FileCountText}"
                         Classes="CkanCaption" VerticalAlignment="Center" Margin="4,0,0,0" />
              <Button Grid.Column="1" Content="{DynamicResource Ui_Common_Refresh}"
                      Command="{Binding Generic.ScanCommand}"
                      Classes="CkanSecondary" />
            </Grid>
          </StackPanel>

          <!-- 文件列表 -->
          <ListBox Grid.Row="1" ItemsSource="{Binding Generic.FilteredFiles}"
                   SelectedItem="{Binding Generic.SelectedFile, Mode=TwoWay}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="6,4">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding MetaText}" Classes="CkanCaption" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 底部状态 -->
          <TextBlock Grid.Row="2" Text="{Binding Generic.StatusText}"
                     Classes="CkanCaption" Margin="8,6"
                     TextWrapping="Wrap" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
        </Grid>
      </Border>

      <!-- 右：选中的 cfg 字段编辑区域 -->
      <Grid Grid.Column="1" Margin="12,0,0,0" RowDefinitions="Auto,*,Auto">
        <!-- 未选中提示 -->
        <Border Grid.Row="1" Classes="CkanCard" Padding="32"
                IsVisible="{Binding !Generic.HasSelectedFile}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="{DynamicResource Ui_ModConfigPage_PickModTitle}"
                       Classes="CkanSubhead" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Ui_ModConfigGeneric_DiscoveredFiles}"
                       Classes="CkanCaption" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- 选中文件的顶栏操作条 -->
        <Border Grid.Row="0" Classes="CkanToolbar" Padding="12,8" Margin="0,0,0,8"
                IsVisible="{Binding Generic.HasSelectedFile}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Generic.SelectedTitle}" Classes="CkanSubhead" VerticalAlignment="Center" />
                <Border Classes="CkanBadge" IsVisible="{Binding Generic.IsReadonly}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Generic.ReadonlyReason}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Generic.SelectedSubtitle}" Classes="CkanCaption"
                         Foreground="{DynamicResource CkanTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="{DynamicResource Ui_ModConfigGeneric_Revert}"
                      Command="{Binding Generic.RevertCommand}"
                      IsEnabled="{Binding Generic.CanRevert}"
                      Classes="CkanDanger" />
              <Button Content="{DynamicResource Ui_Common_Save}"
                      Command="{Binding Generic.SaveCommand}"
                      IsEnabled="{Binding Generic.CanSave}"
                      Classes="CkanPrimary" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 键值行列表 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding Generic.HasSelectedFile}">
          <ItemsControl ItemsSource="{Binding Generic.Rows}" Margin="0,0,8,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="0">
                  <!-- 节点换层分隔头 -->
                  <Border IsVisible="{Binding IsBoundary}" Padding="6,10,6,4" Margin="0,6,0,2">
                    <TextBlock Text="{Binding NodeHeaderText}" FontWeight="Bold" Classes="CkanCaption"
                               Foreground="{DynamicResource CkanAccentBrush}" />
                  </Border>

                  <Border Classes="CkanCard" Margin="0,2,0,4" Padding="12,8">
                    <Grid ColumnDefinitions="260,*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding NodePath}" />
                        <TextBlock Text="{Binding NodePath}" Classes="CkanCaption"
                                   Foreground="{DynamicResource CkanTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Comment}" Classes="CkanCaption"
                                   Foreground="{DynamicResource CkanTextTertiaryBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasComment}" />
                      </StackPanel>

                      <!-- 编辑控件：bool 显示 CheckBox，其他显示 TextBox -->
                      <Panel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox IsVisible="{Binding IsBoolean}"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEdit}" />
                        <TextBox IsVisible="{Binding !IsBoolean}"
                                 Text="{Binding ValueText, Mode=TwoWay}"
                                 IsReadOnly="{Binding !CanEdit}"
                                 Classes="CkanSearchBox" />
                      </Panel>

                      <!-- 改动标记 -->
                      <Border Grid.Column="2" Classes="CkanBadge Warning"
                              IsVisible="{Binding IsModified}"
                              VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{DynamicResource Ui_ModConfigGeneric_ModifiedTag}" />
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 错误提示 -->
        <Border Grid.Row="2" Classes="CkanInfoBanner Warning"
                IsVisible="{Binding Generic.HasError}" Margin="0,8,0,0">
          <TextBlock Text="{Binding Generic.ErrorText}" Classes="CkanCaption" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Grid>

    <!-- 底部动作条：改动计数 + 保存/放弃/恢复快照 + 逐文件失败说明 -->
    <Border Grid.Row="5" IsVisible="{Binding ShowActionBar}"
            Classes="CkanCard"
            Margin="0,12,0,0" Padding="12,10">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ModifiedBarText}" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,16,0"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding CanSave}" Classes="CkanPrimary" Margin="0,0,8,0"
                  ToolTip.Tip="{DynamicResource Ui_ModConfigPage_Save_Tip}" />
          <Button Content="{DynamicResource Ui_ModConfigPage_DiscardChanges}" Command="{Binding DiscardPendingCommand}"
                  IsEnabled="{Binding CanDiscardPending}" Classes="CkanDanger" Margin="0,0,8,0" />
          <Button Content="{Binding RestoreButtonText}" Command="{Binding RestoreBackupsCommand}"
                  IsEnabled="{Binding CanRestoreBackups}" Classes="CkanSecondary"
                  ToolTip.Tip="{DynamicResource Ui_ModConfigPage_DiscardChanges_Tip}" />
        </WrapPanel>
        <TextBlock Text="{Binding BackupHintText}" IsVisible="{Binding HasBackups}"
                   TextWrapping="Wrap"
                   Classes="CkanCaption" />
        <TextBlock Text="{Binding WriteNoteText}"
                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="760"
                   Classes="CkanCaption" />
        <StackPanel IsVisible="{Binding HasSaveFailures}" Spacing="2" Margin="0,2,0,0">
          <TextBlock Text="{Binding SaveFailureTitle}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <ItemsControl ItemsSource="{Binding SaveFailures}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanDangerBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
