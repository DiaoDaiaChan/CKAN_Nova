<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CkanUI.Services</RootNamespace>
    <AssemblyName>CkanUI.Services</AssemblyName>
    <!-- Lifecycle/PlatformMemory.cs 用 [LibraryImport]（源生成 P/Invoke）接 psapi 的 EmptyWorkingSet；
         源生成器产出的代码本身带 unsafe 块，需要本项目开启 AllowUnsafeBlocks（SYSLIB1062）。
         只影响编译开关，不引入新的非托管代码，也没有新增依赖。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CkanCoreProject)" />
    <ProjectReference Include="../CkanUI.Services.Abstractions/CkanUI.Services.Abstractions.csproj" />
    <ProjectReference Include="../CkanUI.Core/CkanUI.Core.csproj" />
    <ProjectReference Include="../CkanUI.Localization/CkanUI.Localization.csproj" />
    <ProjectReference Include="../CkanUI.ModText/CkanUI.ModText.csproj" />
    <ProjectReference Include="../CkanUI.Sfs/CkanUI.Sfs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="log4net" />
  </ItemGroup>

</Project>
