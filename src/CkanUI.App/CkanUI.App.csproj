<Project Sdk="Microsoft.NET.Sdk">

  <!-- M6 / PKG-03：版本号唯一真源在同目录 Version.props，本文件不写版本号。
       放在项目目录而不是仓库根，是因为根层条目由 verify-layout H-01 白名单管（不复用 build/ 目录）；
       也因此只有本项目导入它，不会波及其它 11 个项目与上游 CKAN 的构建参数。 -->
  <Import Project="$(MSBuildThisFileDirectory)Version.props" Condition="Exists('$(MSBuildThisFileDirectory)Version.props')" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CkanUI.App</RootNamespace>
    <AssemblyName>CkanUI</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- M6 / PKG-02：exe 内嵌图标，资源管理器与任务栏显示品牌图标（16/24/32/48/64/128/256 七档）。
         图标由 tools/icon-gen 按 Resources/Tokens.axaml 的配色现场生成，改令牌后重跑该工具即可。 -->
    <ApplicationIcon>Assets/ckan.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- UI-02：虚拟化表格控件（列定义/列宽持久化需要它，ListBox 只能凑合） -->
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CkanUI.ViewModels/CkanUI.ViewModels.csproj" />
    <ProjectReference Include="../CkanUI.Services/CkanUI.Services.csproj" />
    <ProjectReference Include="../CkanUI.Services.Abstractions/CkanUI.Services.Abstractions.csproj" />
    <ProjectReference Include="../CkanUI.Controls/CkanUI.Controls.csproj" />
    <ProjectReference Include="../CkanUI.Platform/CkanUI.Platform.csproj" />
    <ProjectReference Include="../CkanUI.Core/CkanUI.Core.csproj" />
    <ProjectReference Include="../CkanUI.Localization/CkanUI.Localization.csproj" />
    <ProjectReference Include="../CkanUI.ModText/CkanUI.ModText.csproj" />
    <!-- 宿主与首方插件共用的 UI 基元（缩略图转换器、骨架屏），见 docs/design/plugins.md §11.11。 -->
    <ProjectReference Include="../CkanUI.Ui/CkanUI.Ui.csproj" />
    <!-- 02/16 篇插件试点：内置插件只参与构建，不作为程序集引用（ReferenceOutputAssembly=false）
         —— 宿主不该在编译期看见插件类型，插件也不该被钉死在宿主的加载顺序里；
         运行期由下面 CopyBundledPlugins 把 dll 拷进 $(OutDir)plugins\，交给 PluginService 自带的
         BundledDirectory（AppContext.BaseDirectory/plugins）去发现。 -->
    <ProjectReference Include="../CkanUI.Plugin.Performance/CkanUI.Plugin.Performance.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <!-- 模组翻译页解耦为插件（docs/design/plugins.md §11.9）：同一个打包通道，多个插件就在这里并列加行。 -->
    <ProjectReference Include="../CkanUI.Plugin.ModText/CkanUI.Plugin.ModText.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <!-- 实例分节内嵌页签（存档 / 资产三页 / KSP 设置，docs/design/plugins.md §11.11）：
         同一打包通道。停用其中一个只影响它自己的页签，宿主不会因为少一个页面就起不来。 -->
    <ProjectReference Include="../CkanUI.Plugin.Saves/CkanUI.Plugin.Saves.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../CkanUI.Plugin.Assets/CkanUI.Plugin.Assets.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../CkanUI.Plugin.KspConfig/CkanUI.Plugin.KspConfig.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <!-- Mod 配置页解耦为插件（docs/design/plugins.md §11.11）：模组分节的 modconfig 槽位由插件补回。 -->
    <ProjectReference Include="../CkanUI.Plugin.ModConfig/CkanUI.Plugin.ModConfig.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <!-- AI 助手（docs/design/ai-assistant.md）：同一个打包通道；它自己带聊天页与工具循环，
         宿主只提供 IRepositoryService / IRegistryService / INavigationService 的只读桥。 -->
    <ProjectReference Include="../CkanUI.Plugin.Ai/CkanUI.Plugin.Ai.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- 02 篇 §2：随包分发日志配置，覆盖 Core 传递过来的同名 log4net.xml -->
    <Content Include="log4net.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 16 篇 §7：语言包随包分发（i18n/packs），磁盘版本优先于内嵌版本，便于用户替换译文 -->
    <Content Include="../../i18n/packs/*.json" Link="i18n/packs/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- M6 / PKG-02：便携包按 19 篇 §2 的目录布局随包带 assets\（图标源文件与未来的主题资源）。
         CopyToPublishDirectory 与 CopyToOutputDirectory 一起显式写：只写后者时 publish 是否带上
         取决于 SDK 的默认继承规则，显式声明才不受 SDK 行为变化影响。 -->
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 内置插件（随包首方插件）落盘：走 GetTargetPath 问被引用工程要真实产物路径，
       不手拼 bin\$(Configuration)\$(TargetFramework) —— 插件工程的 TFM 一改，手拼路径就会静默拷不到东西，
       而"插件不见了"在运行期只表现为插件页少一个页签，很难追。
       只拷 dll 与同名 pdb：Avalonia 与插件契约由宿主提供，插件目录里再放一份就是两个 ALC 各持一份类型。 -->
  <Target Name="CopyBundledPlugins" AfterTargets="Build" DependsOnTargets="_CollectBundledPlugins" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_BundledPluginFile)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
  </Target>

  <!-- 出包（docs/ops/release.md 用 dotnet publish 自包含）走的是 PublishDir 而不是 OutDir，
       所以 publish 之后再补一份；两条路都拷，缺哪条都表现为"发布出去的包里没有性能页签"。 -->
  <Target Name="CopyBundledPluginsOnPublish" AfterTargets="Publish" DependsOnTargets="_CollectBundledPlugins" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_BundledPluginFile)" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="true" />
  </Target>

  <!-- 注意：这两个目标必须用 DependsOnTargets 调用本目标，不能用 <CallTarget>。
       CallTarget 会给被调目标开一个新的属性/项作用域，里面产出的 @(_BundledPluginFile) 回到调用方就是空集，
       Copy 于是拷 0 个文件、构建还照样成功——"插件目录永远是空的"这种坑只在运行期表现为少一个页签。 -->
  <Target Name="_CollectBundledPlugins">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../CkanUI.Plugin.Performance/CkanUI.Plugin.Performance.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledPluginAssembly" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)../CkanUI.Plugin.ModText/CkanUI.Plugin.ModText.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledPluginAssembly" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)../CkanUI.Plugin.KspConfig/CkanUI.Plugin.KspConfig.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledPluginAssembly" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)../CkanUI.Plugin.ModConfig/CkanUI.Plugin.ModConfig.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledPluginAssembly" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)../CkanUI.Plugin.Assets/CkanUI.Plugin.Assets.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledPluginAssembly" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)../CkanUI.Plugin.Saves/CkanUI.Plugin.Saves.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledPluginAssembly" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)../CkanUI.Plugin.Ai/CkanUI.Plugin.Ai.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledPluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <_BundledPluginFile Include="@(_BundledPluginAssembly)" />
      <_BundledPluginFile Include="@(_BundledPluginAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
                          Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
  </Target>

</Project>