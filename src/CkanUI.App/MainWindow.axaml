<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CkanUI.ViewModels"
        xmlns:local="using:CkanUI.App"
        xmlns:conv="using:CkanUI.App.Converters"
        xmlns:ops="using:CkanUI.App.Views.Operations"
        xmlns:logs="using:CkanUI.App.Views.Logs"
        xmlns:views="using:CkanUI.App.Views"
        x:Class="CkanUI.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">
  <Window.DataTemplates>
    <local:ViewLocator />
  </Window.DataTemplates>

  <Window.KeyBindings>
    <!-- 侧栏折叠：Ctrl+B 是主流编辑器/IDE 的肌肉记忆；Alt+左/右 = 前进后退。 -->
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleNavCollapsedCommand}" />
    <KeyBinding Gesture="Alt+Left" Command="{Binding BackCommand}" />
    <KeyBinding Gesture="Alt+Right" Command="{Binding ForwardCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!--
      侧栏收起态（宽度 250 → 68，20 篇 P-02 的「工作区优先」）：
      宽度过渡走动效 token，关掉动效时 Duration=0 直接跳变（无障碍要求）。
    -->
    <Style Selector="Border#NavPanel">
      <Setter Property="Width" Value="250" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#NavPanel.Collapsed">
      <Setter Property="Width" Value="68" />
    </Style>
    <Style Selector="Border#NavPanel.Collapsed TextBlock.NavLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#NavPanel.Collapsed Button.CkanIcon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="Border#NavPanel.Collapsed StackPanel#NavFooterActions">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border#NavPanel.Collapsed ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border#NavPanel.Collapsed Button#AboutIconButton">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Panel>
    <!--
      背景层（20 篇 P-06 / THM-05）：纯色或渐变走 BackgroundLayer 的画笔，图片走 BackgroundImage，
      平铺也走 BackgroundLayer（ImageBrush）。四个控件都不吃鼠标事件，内容层整体压在它们之上。
      高对比度下整块被 BackgroundHost 清空（THM-10 优先）。
    -->
    <Panel IsHitTestVisible="False">
      <Border x:Name="BackgroundLayer" />
      <Image x:Name="BackgroundImage" Stretch="UniformToFill" />
      <Border x:Name="BackgroundDim" Opacity="0" />
      <Border x:Name="BackgroundScrim"
              Opacity="0"
              Background="{DynamicResource CkanSurfaceBackgroundBrush}" />
    </Panel>

    <Grid ColumnDefinitions="Auto,*">
      <!-- Fluent 侧边导航栏（可收起为图标栏） -->
      <Border x:Name="NavPanel"
              Grid.Column="0"
              Classes.Collapsed="{Binding IsNavCollapsed}"
              Background="{DynamicResource CkanSidebarBackgroundBrush}"
              BorderBrush="{DynamicResource CkanBorderBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <!-- 顶栏：应用徽标（名称与折叠按钮在展开时才出现） -->
          <Grid DockPanel.Dock="Top" x:Name="NavHeader" ColumnDefinitions="Auto,Auto" Margin="16,28,16,14">
            <!-- 品牌图标 -->
            <Border Width="30" Height="30"
                    CornerRadius="8"
                    Background="{DynamicResource CkanAccentBrush}">
              <TextBlock Text="C"
                         Foreground="{DynamicResource CkanTextInverseBrush}"
                         FontWeight="Bold"
                         FontSize="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1"
                       Classes="NavLabel"
                       Text="CKAN"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}"
                       FontSize="{DynamicResource CkanFontSizeTitle}"
                       FontWeight="SemiBold" />
          </Grid>

          <!-- 底部：关于入口 + 侧栏折叠开关 -->
          <Border DockPanel.Dock="Bottom" Padding="10,8,10,12">
            <StackPanel x:Name="NavFooterActions" Orientation="Horizontal" Spacing="6">
              <Button Content="关于"
                      Click="OnAboutClick"
                      IsVisible="{Binding IsNavExpanded}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                      Padding="10,7"
                      FontSize="{DynamicResource CkanFontSizeCaption}" />
              <Button x:Name="AboutIconButton"
                      Classes="CkanIcon"
                      Content="?"
                      Click="OnAboutClick"
                      IsVisible="{Binding IsNavCollapsed}"
                      ToolTip.Tip="关于"
                      FontSize="{DynamicResource CkanFontSizeBody}" />
              <Button Classes="CkanIcon"
                      Content="{Binding NavToggleGlyph}"
                      Command="{Binding ToggleNavCollapsedCommand}"
                      ToolTip.Tip="{Binding NavToggleToolTip}"
                      HorizontalAlignment="Center"
                      FontSize="{DynamicResource CkanFontSizeSubtitle}" />
            </StackPanel>
          </Border>

          <!-- 导航项列表 -->
          <ListBox x:Name="NavList"
                   ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   Margin="8,4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Grid ColumnDefinitions="4,24,Auto" Margin="0,2">
                  <!-- Fluent 风格激活指示器 -->
                  <Rectangle Grid.Column="0"
                             Classes="navIndicator"
                             Fill="{DynamicResource CkanAccentBrush}"
                             RadiusX="2" RadiusY="2"
                             Width="3" Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
                  <PathIcon Grid.Column="1"
                            Data="{Binding Glyph, Converter={x:Static conv:NavGlyphToGeometryConverter.Instance}}"
                            Width="16" Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Classes="NavLabel"
                             Text="{Binding Title}"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"
                             TextTrimming="CharacterEllipsis"
                             FontSize="{DynamicResource CkanFontSizeBody}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 主工作区与状态栏 -->
      <DockPanel Grid.Column="1" LastChildFill="True">
        <!--
          顶部现代一体化标题拖拽区：左侧放前进/后退（贴近内容，鼠标移动距离最短），
          中间是窗口标题，右侧 150px 留给原生系统按钮避让。
        -->
        <Grid DockPanel.Dock="Top" Height="34" Background="Transparent" ColumnDefinitions="Auto,Auto,*,150">
          <Button Grid.Column="0"
                  Classes="CkanIcon"
                  Content="←"
                  Command="{Binding BackCommand}"
                  IsEnabled="{Binding CanGoBack}"
                  ToolTip.Tip="{Binding BackToolTip}"
                  Width="26" Height="26" MinWidth="0" Padding="0"
                  Margin="10,0,2,0" />
          <Button Grid.Column="1"
                  Classes="CkanIcon"
                  Content="→"
                  Command="{Binding ForwardCommand}"
                  IsEnabled="{Binding CanGoForward}"
                  ToolTip.Tip="{Binding ForwardToolTip}"
                  Width="26" Height="26" MinWidth="0" Padding="0"
                  Margin="0,0,4,0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding Title}"
                     Foreground="{DynamicResource CkanTextTertiaryBrush}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     VerticalAlignment="Center"
                     Margin="8,0,8,0"
                     TextTrimming="CharacterEllipsis"
                     IsHitTestVisible="False" />
        </Grid>

        <!-- 状态栏：左状态文案、右实例与版本号 -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource CkanStatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource CkanBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
          <DockPanel LastChildFill="True">
            <TextBlock x:Name="StatusVersionText"
                       DockPanel.Dock="Right"
                       Foreground="{DynamicResource CkanTextTertiaryBrush}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>

        <!--
          底部日志抽屉（14 篇 §4.1 / UI-LOG-01）：跨页面常驻，收起时只留一条标题条。
          半屏高度由代码按窗口实际尺寸算（MainWindow.UpdateLogDrawerHeight）——Avalonia 绑定
          做不了数值缩放，写死像素在高 DPI 下要么挡掉整个工作区，要么只剩一行。
          先声明的 Dock=Bottom 贴得更低，所以抽屉落在状态栏之上。
        -->
        <Border x:Name="LogDrawerHost"
                DockPanel.Dock="Bottom"
                IsVisible="{Binding LogDrawer, Converter={x:Static ObjectConverters.IsNotNull}}">
          <logs:LogDrawerView DataContext="{Binding LogDrawer}" />
        </Border>
        <!-- 页面切换动画在代码里按动效 token 装配（CrossFade.Duration 不是 Avalonia 属性，绑不了资源） -->
        <TransitioningContentControl x:Name="PageHost" Content="{Binding CurrentPage}" />
      </DockPanel>

      <!-- 操作队列浮层 -->
      <Grid Grid.Column="0" Grid.ColumnSpan="2"
            IsVisible="{Binding HasOperationQueue}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="10">
        <ops:OperationQueueOverlayView DataContext="{Binding OperationQueue}" />
      </Grid>

      <!--
        命令面板（UI-27）：常驻最外层，自带遮罩与键位。这里刻意不写 IsVisible 绑定 ——
        外壳的 x:DataType 是 ShellViewModel，编译期绑定找不到面板的 IsOpen 会直接编译失败；
        视图自己的根 Grid 已经绑了 IsOpen，收起时不参与命中测试，点击会穿透到外壳。
      -->
      <views:CommandPaletteView x:Name="CommandPaletteHost" ZIndex="20" />
    </Grid>
  </Panel>
</Window>
