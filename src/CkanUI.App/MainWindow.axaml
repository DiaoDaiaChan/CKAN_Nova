<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CkanUI.ViewModels"
        xmlns:local="using:CkanUI.App"
        xmlns:ops="using:CkanUI.App.Views.Operations"
        x:Class="CkanUI.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">
  <Window.DataTemplates>
    <local:ViewLocator />
  </Window.DataTemplates>

  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Background="{DynamicResource CkanSidebarBackgroundBrush}">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="16,20,16,12">
          <TextBlock Grid.Column="0"
                     Text="CKAN"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}"
                     FontSize="{DynamicResource CkanFontSizeTitle}"
                     FontWeight="SemiBold" />
          <!-- 前进/后退（F-25）：历史由 INavigationService 维护，按钮只反映可用性。 -->
          <Button Grid.Column="1"
                  Content="←"
                  Command="{Binding BackCommand}"
                  IsEnabled="{Binding CanGoBack}"
                  ToolTip.Tip="{Binding BackToolTip}"
                  Padding="8,2"
                  Margin="0,0,4,0"
                  MinWidth="0" />
          <Button Grid.Column="2"
                  Content="→"
                  Command="{Binding ForwardCommand}"
                  IsEnabled="{Binding CanGoForward}"
                  ToolTip.Tip="{Binding ForwardToolTip}"
                  Padding="8,2"
                  MinWidth="0" />
        </Grid>
        <!-- 帮助与关于（12 篇 F-55）：关于框由 code-behind 建窗，VM 只提供数据与命令。 -->
        <Button DockPanel.Dock="Bottom"
                Content="关于"
                Click="OnAboutClick"
                Margin="16,8,16,12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                FontSize="{DynamicResource CkanFontSizeCaption}" />
        <ListBox x:Name="NavList"
                 ItemsSource="{Binding NavItems}"
                 SelectionChanged="OnNavSelectionChanged"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="8,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <TextBlock Text="{Binding Title}" Padding="4,6" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1" LastChildFill="True">
      <Border DockPanel.Dock="Bottom"
              Background="{DynamicResource CkanStatusBarBackgroundBrush}"
              BorderBrush="{DynamicResource CkanBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="12,6">
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}"
                   FontSize="{DynamicResource CkanFontSizeCaption}" />
      </Border>
      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>

    <!-- 操作队列浮层（UI-08）：覆盖在整窗最上层，不参与页面布局。 -->
    <Grid Grid.Column="0" Grid.ColumnSpan="2"
          IsVisible="{Binding HasOperationQueue}"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Panel.ZIndex="10">
      <ops:OperationQueueOverlayView DataContext="{Binding OperationQueue}" />
    </Grid>
  </Grid>
</Window>
