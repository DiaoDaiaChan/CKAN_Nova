<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CkanUI.ViewModels"
        xmlns:local="using:CkanUI.App"
        xmlns:ops="using:CkanUI.App.Views.Operations"
        x:Class="CkanUI.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">
  <Window.DataTemplates>
    <local:ViewLocator />
  </Window.DataTemplates>

  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Background="{DynamicResource CkanSidebarBackgroundBrush}">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top"
                   Text="CKAN"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}"
                   FontSize="{DynamicResource CkanFontSizeTitle}"
                   FontWeight="SemiBold"
                   Margin="16,20,16,12" />
        <ListBox x:Name="NavList"
                 ItemsSource="{Binding NavItems}"
                 SelectionChanged="OnNavSelectionChanged"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="8,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <TextBlock Text="{Binding Title}" Padding="4,6" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1" LastChildFill="True">
      <Border DockPanel.Dock="Bottom"
              Background="{DynamicResource CkanStatusBarBackgroundBrush}"
              BorderBrush="{DynamicResource CkanBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="12,6">
        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}"
                   FontSize="{DynamicResource CkanFontSizeCaption}" />
      </Border>
      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>

    <!-- 操作队列浮层（UI-08）：覆盖在整窗最上层，不参与页面布局。 -->
    <Grid Grid.Column="0" Grid.ColumnSpan="2"
          IsVisible="{Binding HasOperationQueue}"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Panel.ZIndex="10">
      <ops:OperationQueueOverlayView DataContext="{Binding OperationQueue}" />
    </Grid>
  </Grid>
</Window>
