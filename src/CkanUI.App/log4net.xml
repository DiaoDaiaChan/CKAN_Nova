<?xml version="1.0" encoding="utf-8" ?>
<!-- 新 UI 随包分发的日志配置（02 篇 §2）。
     LoggingSetup.Initialize() 会先把 CWD 设为程序目录再读取本文件，Core 的 Logging.Initialize 随后发现已配置即跳过。
     落盘位置与 Core 的 AppDataPath 一致（%LocalAppData%/CKAN），用 envFolderPath 而不是 ${LOCALAPPDATA}，
     因为后者在 Linux/macOS 上不存在。 -->
<log4net>
  <appender name="CkanFile" type="log4net.Appender.RollingFileAppender">
    <!-- __CKAN_LOG_DIR__ 由 CkanUI.Services.Logging.LoggingSetup 在配置前替换为 CKANPathUtils.AppDataPath。
         不要写成 log4net 的 ${ENVVAR}：跨平台环境变量名不同，且解析失败时 log4net 只记内部日志、
         不抛异常，结果是整份配置静默失效、日志全部丢失。 -->
    <file value="__CKAN_LOG_DIR__/CKAN.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="1MB" />
    <maxSizeRollBackups value="30" />
    <staticLogFileName value="true" />
    <!-- MinimalLock：允许旧版 GUI / CLI 同时写同一个文件 -->
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss} [%thread] %level %logger - %message%newline%exception" />
    </layout>
  </appender>

  <root>
    <level value="INFO" />
    <appender-ref ref="CkanFile" />
  </root>
</log4net>
