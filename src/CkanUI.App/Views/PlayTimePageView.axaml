<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.App.Theming"
             x:Class="CkanUI.App.Views.PlayTimePageView"
             x:CompileBindings="False">

  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
    </Style>

    <Style Selector="Rectangle.SelectionBar">
      <Setter Property="Width" Value="3" />
      <Setter Property="RadiusX" Value="1.5" />
      <Setter Property="RadiusY" Value="1.5" />
      <Setter Property="Fill" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="2,4" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected Rectangle.SelectionBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Ui_NavRail_PlayTime}" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <Button Classes="CkanHelper" VerticalAlignment="Center"
                ToolTip.Tip="{DynamicResource Ui_PlayTimePage_Header_Tip}">
          <PathIcon Data="{StaticResource CkanIconHelp}" />
        </Button>
      </StackPanel>
      <TextBlock Text="{DynamicResource Ui_PlayTimePage_Subtitle}"
                 Classes="CkanCaption" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 页首指标：三枚常驻指标卡，空数据时按 0 显示，避免整页只剩一片空白 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
      <Border Classes="CkanStatCard stagger-card" MinWidth="176">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource Ui_PlayTimePage_TotalPlayTime}" Classes="CkanEyebrow" />
          <TextBlock Text="{Binding TotalHoursText}" Classes="CkanNumeric"
                     FontSize="{DynamicResource CkanFontSizeHeading}"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        </StackPanel>
      </Border>
      <Border Classes="CkanStatCard stagger-card" MinWidth="176">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource Ui_PlayTimePage_RegisteredInstances}" Classes="CkanEyebrow" />
          <TextBlock Text="{Binding InstanceCountText}" Classes="CkanNumeric"
                     FontSize="{DynamicResource CkanFontSizeHeading}"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        </StackPanel>
      </Border>
      <Border Classes="CkanStatCard stagger-card" MinWidth="240">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource Ui_PlayTimePage_LongestSingleInstance}" Classes="CkanEyebrow" />
          <TextBlock Text="{Binding LongestInstanceText}" TextTrimming="CharacterEllipsis"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 工具栏：空态下整条收起，避免一整行只放一个禁用按钮 -->
    <Border Grid.Row="2" Classes="CkanToolbar" IsVisible="{Binding !ShowEmptyState}">
      <WrapPanel Orientation="Horizontal">
        <Button Content="{DynamicResource Ui_PlayTimePage_ResetPlayTime}" Command="{Binding ResetCommand}" IsEnabled="{Binding CanReset}"
                Classes="CkanDanger"
                AutomationProperties.Name="{DynamicResource Ui_PlayTimePage_ResetPlayTime_A11y}"
                ToolTip.Tip="{DynamicResource Ui_PlayTimePage_ResetPlayTime_Tip}" />
      </WrapPanel>
    </Border>

    <!-- 错误横幅 -->
    <Border Grid.Row="3" Classes="CkanInfoBanner" Margin="0,12,0,0"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding !!ErrorText}">
      <Grid ColumnDefinitions="Auto,*">
        <PathIcon Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,10,0"
                  Foreground="{DynamicResource CkanDangerBrush}"
                  VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ErrorText}"
                   FontSize="{DynamicResource CkanFontSizeBody}"
                   FontWeight="Medium"
                   Foreground="{DynamicResource CkanDangerBrush}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 主列表区与空状态 -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <!-- 数据卡片表格 -->
      <Border Classes="CkanCard" Padding="0" IsVisible="{Binding !ShowEmptyState}">
        <Grid RowDefinitions="Auto,*">
          <!-- 列头（保留 16px 滚动条留白，对齐下方数据行） -->
          <Border Grid.Row="0" Padding="12,9"
                  Background="{DynamicResource CkanSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,180,120,16">
              <TextBlock Grid.Column="0" Text="{DynamicResource Ui_InstanceForm_InstanceName}" Classes="CkanCaption" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{DynamicResource Ui_PlayTimePage_PlayTimeHours}" Classes="CkanCaption" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Common_Action}" Classes="CkanCaption" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0" />
            </Grid>
          </Border>

          <!-- 数据行 -->
          <ListBox x:Name="PlayTimeList" Grid.Row="1" ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                   Padding="0" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,180,120,16" Margin="12,0" MinHeight="{DynamicResource CkanRowHeight}">
                  <Rectangle Grid.ColumnSpan="3" Classes="SelectionBar" />
                  <TextBlock Grid.Column="0" Text="{Binding InstanceName}"
                             VerticalAlignment="Center" FontWeight="Medium"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Hours}"
                             IsVisible="{Binding !IsEditing}"
                             Classes="CkanNumeric"
                             FontSize="{DynamicResource CkanFontSizeBody}"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <TextBox Grid.Column="1" Text="{Binding EditText, Mode=TwoWay}"
                           IsVisible="{Binding IsEditing}"
                           KeyDown="OnRowKeyDown"
                           CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                           VerticalAlignment="Center"
                           Padding="6,4" />
                  <Button Grid.Column="2" Content="{DynamicResource Ui_Common_Edit}"
                          Command="{Binding $parent[ListBox].DataContext.BeginEditCommand}"
                          CommandParameter="{Binding}"
                          Classes="CkanSecondary CkanSmall"
                          ToolTip.Tip="{DynamicResource Ui_PlayTimePage_EditHours_Tip}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 空状态 -->
      <Border Classes="CkanEmptyStateCard" IsVisible="{Binding ShowEmptyState}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
          <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
            <PathIcon Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" />
          </Border>
          <TextBlock Text="{DynamicResource Ui_PlayTimePage_EmptyTitle}" HorizontalAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource Ui_PlayTimePage_EmptySubtitle}"
                     TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="{DynamicResource Ui_PlayTimePage_SelectInstance}"
                    Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                    CommandParameter="instances"
                    Classes="CkanSecondary" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="5" Classes="CkanPageFooter" Margin="0,10,0,0"
            IsVisible="{Binding HasStatus}">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes="CkanCaption" />
    </Border>
  </Grid>
</UserControl>
