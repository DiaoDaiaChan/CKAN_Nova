<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.App.Theming"
             x:Class="CkanUI.App.Views.ContentPageView"
             x:CompileBindings="False">
  <!-- 内容预览页（F-29 / UI-03）：可折叠树形结构展示 ZIP 内目录与文件；支持未缓存时下载、复制路径、定位目录。
       颜色与圆角严格遵循 Tokens.axaml 语义资源，无硬编码字面量。
       视觉规范：卡片/工具条/空态/错误条/骨架屏统一复用 FluentStyles 的 Ckan* 类。 -->
  <UserControl.Styles>
    <!-- 树节点：键盘焦点可见（全局已有 focus-visible），这里补齐基线避免布局跳动 -->
    <Style Selector="TreeViewItem">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="内容预览" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <Button Classes="CkanHelper" VerticalAlignment="Center"
                ToolTip.Tip="直接读取 ZIP 中央目录结构与文件大小，无需将整个归档解压至磁盘。">
          <PathIcon Data="{StaticResource CkanIconHelp}" />
        </Button>
      </StackPanel>
      <TextBlock Text="归档内目录与文件清单" Classes="CkanCaption" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 工具栏 -->
    <Border Grid.Row="1" Margin="0,0,0,12" Classes="CkanToolbar stagger-card">
      <WrapPanel Orientation="Horizontal">
        <Button Content="预览 / 刷新" Command="{Binding PreviewCommand}"
                Classes="CkanPrimary" Margin="0,0,8,0"
                ToolTip.Tip="重新读取 ZIP 目录" />
        <Button Content="下载到缓存" Command="{Binding DownloadCommand}"
                Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="若尚未缓存，下载模组 ZIP 到本地缓存" />
        <Button Content="复制路径" Command="{Binding CopyPathCommand}"
                Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="复制当前选中项的相对路径" />
        <Button Content="打开 ZIP 所在目录" Command="{Binding OpenDirectoryCommand}"
                Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="在系统文件管理器中打开缓存 ZIP 所在文件夹" />
        <Button Content="取消" Command="{Binding CancelCommand}"
                Classes="CkanDanger" Margin="0,0,8,0"
                IsVisible="{Binding CanCancel}"
                ToolTip.Tip="取消当前正在进行的操作" />
      </WrapPanel>
    </Border>

    <!-- 页面级错误条：与仓库页保持同一范式（CkanInfoBanner + 语义底色 + 图标 + 重试/关闭） -->
    <Border Grid.Row="2" Margin="0,0,0,12" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0"
                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="Medium"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                     IsVisible="{Binding ErrorDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanDangerBrush}" Opacity="0.85" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="重试" Command="{Binding RetryCommand}" Classes="CkanSmall"
                  ToolTip.Tip="重新读取 ZIP 目录" />
          <Button Content="关闭" Command="{Binding ClearErrorCommand}" Classes="CkanSmall" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 树形内容与空状态区域 -->
    <Grid Grid.Row="3" ColumnDefinitions="*,8,340">
      <!-- 可折叠树 -->
      <Border Grid.Column="0" Classes="CkanCard stagger-card" Padding="6" IsVisible="{Binding HasNodes}">
        <TreeView ItemsSource="{Binding RootNodes}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                  BorderThickness="0" Background="Transparent">
          <TreeView.Styles>
            <Style Selector="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}">
              <Grid ColumnDefinitions="*,Auto" MinHeight="{DynamicResource CkanRowHeight}" Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding KindText}"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="CkanNumeric"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           VerticalAlignment="Center" Margin="16,0,8,0" />
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" IsVisible="{Binding HasNodes}" />

      <!-- 右栏：选中条目详情（包内路径 / 类型 / 未压缩大小） -->
      <Border Grid.Column="2" Classes="CkanCard stagger-card" IsVisible="{Binding HasNodes}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Padding="0,0,0,10" Margin="0,0,0,10"
                  BorderBrush="{DynamicResource CkanHairlineBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="选中条目" Classes="CkanSectionTitle" />
          </Border>
          <StackPanel Grid.Row="1" Spacing="12" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="2">
              <TextBlock Text="名称" Classes="CkanEyebrow" />
              <SelectableTextBlock Text="{Binding SelectedNode.Name}" TextWrapping="Wrap"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="类型与大小" Classes="CkanEyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding SelectedNode.KindText}" Classes="CkanNumeric" />
                <TextBlock Text="{Binding SelectedNode.SizeText}" Classes="CkanNumeric"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="包内路径" Classes="CkanEyebrow" />
              <SelectableTextBlock Text="{Binding SelectedNode.RelativePath}" TextWrapping="Wrap"
                                   FontFamily="Consolas, Menlo, monospace"
                                   FontSize="{DynamicResource CkanFontSizeCaption}"
                                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="16" IsVisible="{Binding !HasSelection}">
            <Border Classes="CkanIconTile Muted" HorizontalAlignment="Center">
              <PathIcon Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
            </Border>
            <TextBlock Text="还没有选中条目" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBlock Text="在左侧目录树点选任意文件或文件夹，即可查看包内路径与未压缩大小。"
                       Classes="CkanCaption" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 空状态：图标 + 一句解释 + 一个主操作 -->
      <Border Grid.Column="0" Grid.ColumnSpan="3" Classes="CkanEmptyStateCard Elevated stagger-card" Margin="0"
              IsVisible="{Binding ShowEmptyState}">
        <Grid>
          <Border Classes="CkanEmptyStateGlow" />
          <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                      MaxWidth="440">
            <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
              <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
            </Border>
            <TextBlock Text="{Binding EmptyText}" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBlock Text="回到本页即可查看包内目录与大小。"
                       TextAlignment="Center" TextWrapping="Wrap" Classes="CkanCaption" />
            <Button Content="前往模组页" Classes="CkanSecondary" HorizontalAlignment="Center"
                    Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                    CommandParameter="mods"
                    ToolTip.Tip="在「模组」页选中一个 mod，ZIP 目录会在这里展开" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- 页脚：状态栏与总计 -->
    <Border Grid.Row="4" Classes="CkanPageFooter" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding StatusText}" Classes="CkanCaption"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                  Margin="12,0,0,0" IsVisible="{Binding HasNodes}">
        <TextBlock Text="未压缩大小合计：" Classes="CkanCaption" />
        <TextBlock Text="{Binding TotalText}" Classes="CkanNumeric"
                   FontSize="{DynamicResource CkanFontSizeCaption}" />
      </StackPanel>
    </Grid>
    </Border>

    <!-- 进行中遮罩：无数据走首屏骨架屏，有数据走进度条（同一时刻只有一个脉动元素） -->
    <Border Grid.RowSpan="5" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Grid>
        <StackPanel IsVisible="{Binding !HasNodes}" IsHitTestVisible="False"
                    app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="180" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasNodes}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="14" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding StatusText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
