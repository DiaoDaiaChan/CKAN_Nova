<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mods="using:CkanUI.ViewModels.Pages.Mods"
                x:Class="CkanUI.App.Views.Mods.ModsSearchPanelView"
                x:CompileBindings="True"
                x:DataType="mods:ModsSearchPanelViewModel">
  <!-- 组合搜索面板（12 篇 F-20/F-21 / UI-14，对齐上游 EditModSearchDetails）：
       18 个字段（12 文本 + 6 三态）逐项填写，条件之间是 AND；生成的语法文本实时显示在底部。
       容器与控件样式统一复用 FluentStyles 的 CkanSubtleCard / CkanSmall / CkanCaption。 -->
  <Border Classes="CkanSubtleCard view-layer is-active" Padding="10,8">
    <StackPanel Spacing="8">

      <!-- 标题行 + 清空条件 -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui_ModsSearchPanel_Title}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}"
                     ToolTip.Tip="{DynamicResource Ui_ModsSearchPanel_Help_Tip}" />
          <TextBlock Text="{DynamicResource Ui_ModsSearchPanel_HelpText}"
                     Classes="CkanCaption" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="{DynamicResource Ui_ModsSearchPanel_ClearConditions}"
                Command="{Binding ClearAllCommand}"
                IsEnabled="{Binding HasActiveFilters}"
                Classes="CkanSmall"
                ToolTip.Tip="{DynamicResource Ui_ModsSearchPanel_ClearConditions_Tip}" />
      </Grid>

      <!-- 18 个字段：文本 / 三态 -->
      <ItemsControl ItemsSource="{Binding Fields}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="mods:ModsSearchFieldViewModel">
            <StackPanel Width="168" Margin="0,0,8,8" Spacing="3">
              <TextBlock Text="{Binding Label}" Classes="CkanCaption" />
              <TextBox Text="{Binding Text, Mode=TwoWay}"
                       MinHeight="30"
                       PlaceholderText="{Binding Hint}"
                       IsVisible="{Binding IsText}"
                       ToolTip.Tip="{Binding Hint}" />
              <ComboBox SelectedIndex="{Binding StateIndex, Mode=TwoWay}"
                        MinHeight="30"
                        IsVisible="{Binding IsState}"
                        ToolTip.Tip="{Binding Hint}">
                <ComboBoxItem Content="{DynamicResource Ui_Common_Any}"/>
                <ComboBoxItem Content="{DynamicResource Ui_Common_Yes}"/>
                <ComboBoxItem Content="{DynamicResource Ui_Common_No}"/>
              </ComboBox>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 生成的查询文本：让用户看得见「点选条件」与「敲语法」是同一件事 -->
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="{DynamicResource Ui_ModsSearchPanel_CurrentConditions}" Classes="CkanCaption" VerticalAlignment="Center" />
        <SelectableTextBlock Grid.Column="1"
                             Text="{Binding Preview}"
                             Classes="CkanCaption"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
