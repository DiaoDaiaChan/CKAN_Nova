<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:CkanUI.App.Views.Dialogs.InstanceDialogs"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="CkanUI.App.Views.InstancesPageView"
             x:CompileBindings="False"
             KeyDown="OnRootKeyDown">
  <!-- 实例页：工具条 + 左列表 + 右详情 + 状态栏 + 遮罩/表单覆盖层。 -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="16,14,16,12">

    <!-- 顶部命令栏：FluentAvalonia 官方 FACommandBar——高频操作常显，低频操作自动收进溢出菜单 -->
    <Border Grid.Row="0" Padding="4,2" CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            Background="{DynamicResource CkanCardBackgroundBrush}"
            BorderBrush="{DynamicResource CkanCardBorderBrush}"
            BorderThickness="1">
      <ui:FACommandBar DefaultLabelPosition="Right" ItemsAlignment="Left" OverflowButtonVisibility="Auto"
                       Background="Transparent" BorderThickness="0">
        <ui:FACommandBar.PrimaryCommands>
          <ui:FACommandBarButton IconSource="Add" Label="添加实例" Command="{Binding AddCommand}"
                                 ToolTip.Tip="选择一个 KSP 安装目录并注册为实例" />
          <ui:FACommandBarButton IconSource="Download" Label="从 Steam 库导入" Command="{Binding ImportFromSteamCommand}"
                                 ToolTip.Tip="扫描 Steam 库中的 KSP 安装目录" />
          <ui:FACommandBarButton IconSource="Refresh" Label="刷新" Command="{Binding RefreshCommand}"
                                 ToolTip.Tip="重新扫描实例列表（F5）" />
          <ui:FACommandBarSeparator />
          <ui:FACommandBarButton IconSource="Accept" Label="设为当前" Command="{Binding SwitchCommand}"
                                 IsEnabled="{Binding CanSwitchSelected}"
                                 ToolTip.Tip="切换当前游戏实例（不可并发）" />
          <ui:FACommandBarButton IconSource="Play" Label="启动游戏" Command="{Binding LaunchCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="{Binding LaunchToolTip}" />
        </ui:FACommandBar.PrimaryCommands>
        <ui:FACommandBar.SecondaryCommands>
          <ui:FACommandBarButton IconSource="Copy" Label="克隆此实例" Command="{Binding BeginCloneCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="复制该实例的游戏目录为新实例" />
          <ui:FACommandBarButton IconSource="Rename" Label="重命名" Command="{Binding BeginRenameCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="只改实例记录中的名称" />
          <ui:FACommandBarButton IconSource="OpenFolder" Label="打开游戏目录" Command="{Binding OpenFolderCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="在文件管理器中打开游戏目录" />
          <ui:FACommandBarButton IconSource="Edit" Label="编辑启动命令" Command="{Binding EditCommandsCommand}"
                                 IsEnabled="{Binding CanEditCommands}" ToolTip.Tip="编辑该实例的启动命令列表（F-06）" />
          <ui:FACommandBarSeparator />
          <ui:FACommandBarButton IconSource="Repair" Label="实例自检" Command="{Binding DiagnoseCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="只读检查锁、注册表与版本兼容性（F-08）" />
          <ui:FACommandBarButton IconSource="Delete" Label="遗忘此实例" Command="{Binding ForgetCommand}"
                                 IsEnabled="{Binding CanForgetSelected}" ToolTip.Tip="只移除实例记录，不会删除游戏文件" />
        </ui:FACommandBar.SecondaryCommands>
      </ui:FACommandBar>
    </Border>

    <!-- 错误条：异常与失败统一收口到页面文本 -->
    <Border Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0"
            Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource CkanDangerBrush}"
                     FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ErrorDetail}" Foreground="{DynamicResource CkanDangerBrush}" Opacity="0.85"
                     FontSize="{DynamicResource CkanFontSizeCaption}" TextWrapping="Wrap" IsVisible="{Binding HasErrorDetail}" MaxHeight="48" />
        </StackPanel>
        <Button Grid.Column="2" Content="关闭" Command="{Binding ClearErrorCommand}"
                Classes="CkanSmall" Margin="12,0,0,0"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 主体：左列表 Card + 右详情 Card -->
    <Grid Grid.Row="1" ColumnDefinitions="*,6,380" Margin="0,10,0,0">

      <Border Grid.Column="0"
              Classes="stagger-card"
              RenderTransform="translate(0px, 0px)"
              Background="{DynamicResource CkanCardBackgroundBrush}"
              BorderBrush="{DynamicResource CkanCardBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <!-- 列头 -->
          <Border Grid.Row="0" Padding="8,8"
                  Background="{DynamicResource CkanSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource CkanBorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="3,*,120,90,140,90">
              <TextBlock Grid.Column="1" Text="名称" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Grid.Column="2" Text="游戏版本" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Grid.Column="3" Text="模组数" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Grid.Column="4" Text="锁定" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Grid.Column="5" Text="状态" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </Grid>
          </Border>

          <!--
            实例列表（虚拟化，整表替换）。
            与下方空状态同处 Grid.Row="1"：两层都在可视化树里，只切 .view-layer 的 is-active，
            隐藏层的 IsHitTestVisible 同步为 false，鼠标事件穿透到可见层 —— 不用 IsVisible 硬切。
          -->
          <ListBox x:Name="InstancesList" Grid.Row="1"
                   Classes="view-layer"
                   Classes.is-active="{Binding !ShowEmptyState}"
                   IsHitTestVisible="{Binding !ShowEmptyState}"
                   ItemsSource="{Binding Rows}"
                   SelectionChanged="OnRowSelectionChanged"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="3,*,120,90,140,90" Height="32">
                  <!-- 当前实例绿色指示竖条 -->
                  <Border Grid.Column="0" Width="3" Margin="0,4" CornerRadius="1.5"
                          Background="{DynamicResource CkanSuccessBrush}" IsVisible="{Binding IsCurrent}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="6,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" />
                    <Border Classes="CkanBadge Accent" IsVisible="{Binding IsDefault}">
                      <TextBlock Text="默认" />
                    </Border>
                    <!-- 异常态：目录不存在 -->
                    <Border Classes="CkanBadge Danger" IsVisible="{Binding IsPathMissing}">
                      <TextBlock Text="⚠ 目录不存在" />
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding VersionText}" VerticalAlignment="Center" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <TextBlock Grid.Column="3" Text="{Binding ModuleCountText}" VerticalAlignment="Center" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <TextBlock Grid.Column="4" Text="{Binding LockText}" VerticalAlignment="Center" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <TextBlock Grid.Column="5" Text="{Binding CurrentText}" VerticalAlignment="Center" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空状态：与列表同格叠放，激活时盖住列表。 -->
          <Border Grid.Row="1"
                  Classes="view-layer"
                  Classes.is-active="{Binding ShowEmptyState}"
                  IsHitTestVisible="{Binding ShowEmptyState}"
                  Background="{DynamicResource CkanCardBackgroundBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="440" Margin="24">
              <Border Width="56" Height="56" CornerRadius="28"
                      Background="{DynamicResource CkanAccentSubtleBrush}"
                      HorizontalAlignment="Center">
                <PathIcon Width="26" Height="26"
                          Foreground="{DynamicResource CkanAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" />
              </Border>
              <TextBlock Text="{Binding EmptyStateTitle}" FontSize="{DynamicResource CkanFontSizeTitle}"
                         FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="{Binding EmptyStateHint}" Foreground="{DynamicResource CkanTextSecondaryBrush}"
                         TextWrapping="Wrap" TextAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="{Binding EmptyStateActionText}" Command="{Binding AddCommand}"
                        Classes="CkanPrimary"
                        Padding="16,6" />
                <Button Content="自动查找（Steam 库）" Command="{Binding ImportFromSteamCommand}"
                        Classes="CkanSecondary"
                        Padding="16,6" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

      <!-- 详情面板 Card -->
      <Border Grid.Column="2" Padding="16"
              Classes="stagger-card"
              RenderTransform="translate(0px, 0px)"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
              Background="{DynamicResource CkanCardBackgroundBrush}"
              BorderBrush="{DynamicResource CkanCardBorderBrush}"
              BorderThickness="1">
        <Grid>
          <!-- 状态 A：未选择实例时的极简引导（不发灰的按钮墙，只留一句话）。 -->
          <StackPanel Classes="view-layer"
                      Classes.is-active="{Binding !HasSelection}"
                      IsHitTestVisible="False"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Spacing="10"
                      MaxWidth="240">
            <Border Width="48" Height="48" CornerRadius="24"
                    Background="{DynamicResource CkanSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center">
              <PathIcon Width="20" Height="20"
                        Foreground="{DynamicResource CkanTextTertiaryBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z" />
            </Border>
            <TextBlock Text="未选择实例" FontWeight="SemiBold" FontSize="{DynamicResource CkanFontSizeSubtitle}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="在左侧列表中选择一个实例，即可查看详情或启动游戏"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <!-- 状态 B：选中实例后的详情与操作。 -->
          <ScrollViewer Classes="view-layer"
                        Classes.is-active="{Binding HasSelection}"
                        IsHitTestVisible="{Binding HasSelection}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding SelectionTitle}" FontSize="{DynamicResource CkanFontSizeSubtitle}"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectionRoleText}" FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextTertiaryBrush}" />
            <Separator Margin="0,4" Background="{DynamicResource CkanBorderBrush}" Height="1" />
            <TextBlock Text="{Binding SelectionVersionText, StringFormat='游戏版本：{0}'}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBlock Text="{Binding SelectionModuleText, StringFormat='已装模组：{0}'}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBlock Text="{Binding SelectionLockText, StringFormat='锁状态：{0}'}" TextWrapping="Wrap" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBlock Text="{Binding SelectionPath, StringFormat='游戏目录：{0}'}" TextWrapping="Wrap" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBlock Text="{Binding SelectionPathStatus}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanDangerBrush}" />
            <Separator Margin="0,6" Background="{DynamicResource CkanBorderBrush}" Height="1" />
            <StackPanel Spacing="8">
              <!-- 主操作：常显两个，其余收进官方 FAMenuFlyout -->
              <Grid ColumnDefinitions="*,8,Auto">
                <Button Grid.Column="0" Content="启动游戏" Command="{Binding LaunchCommand}"
                        IsEnabled="{Binding CanOpenSelected}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Classes="CkanPrimary"
                        ToolTip.Tip="{Binding LaunchToolTip}" />
                <Button Grid.Column="2" Content="更多操作" Classes="CkanSecondary" HorizontalContentAlignment="Center">
                  <Button.Flyout>
                    <ui:FAMenuFlyout Placement="Bottom">
                      <ui:FAMenuFlyoutItem Text="设为当前实例" IconSource="Accept"
                                          Command="{Binding SwitchCommand}" />
                      <ui:FAMenuFlyoutItem Text="克隆此实例" IconSource="Copy"
                                          Command="{Binding BeginCloneCommand}" />
                      <ui:FAMenuFlyoutItem Text="重命名此实例" IconSource="Rename"
                                          Command="{Binding BeginRenameCommand}" />
                      <ui:FAMenuFlyoutItem Text="打开游戏目录" IconSource="OpenFolder"
                                          Command="{Binding OpenFolderCommand}" />
                      <ui:FAMenuFlyoutItem Text="编辑启动命令" IconSource="Edit"
                                          Command="{Binding EditCommandsCommand}" />
                      <ui:FAMenuFlyoutSeparator />
                      <ui:FAMenuFlyoutItem Text="遗忘此实例" IconSource="Delete"
                                          Command="{Binding ForgetCommand}" />
                    </ui:FAMenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </StackPanel>
            <!-- 实例自检与故障处置（F-08）：锁探测 / 强制解锁 / 坏注册表隔离 -->
            <Separator Margin="0,6" Background="{DynamicResource CkanBorderBrush}" Height="1" />
            <StackPanel Spacing="6">
              <TextBlock Text="实例自检" FontSize="{DynamicResource CkanFontSizeCaption}" FontWeight="SemiBold"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <Button Content="自检（锁与注册表）" Command="{Binding DiagnoseCommand}"
                      IsEnabled="{Binding CanOpenSelected}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Classes="CkanSecondary" Padding="10,6"
                      ToolTip.Tip="只读检查：实例是否被锁定、registry.json 能否解析、CKAN 与游戏版本是否过旧" />
              <TextBlock Text="{Binding DiagnosisSummary}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              <ItemsControl ItemsSource="{Binding RepairIssues}" IsVisible="{Binding HasRepairIssues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,3" Padding="8,6" CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                            Background="{DynamicResource CkanSubtleBackgroundBrush}"
                            BorderBrush="{DynamicResource CkanCardBorderBrush}" BorderThickness="1">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding RepairAdvice}" IsVisible="{Binding HasRepairIssues}"
                         FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource CkanAccentBrush}" />
              <Button Content="强制解锁（游戏未运行）" Command="{Binding ForceUnlockCommand}"
                      IsEnabled="{Binding CanForceUnlock}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Classes="CkanDanger" Padding="10,6"
                      ToolTip.Tip="删除 CKAN/registry.locked 并把操作写入本地记录；不会动注册表、模组与存档" />
              <Button Content="隔离损坏的注册表" Command="{Binding QuarantineRegistryCommand}"
                      IsEnabled="{Binding CanQuarantineRegistry}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Classes="CkanSecondary" Padding="10,6"
                      ToolTip.Tip="把解析不了的 registry.json 改名成 registry.json.corrupt-时间戳（内容保留）" />
            </StackPanel>
            <Separator Margin="0,6" Background="{DynamicResource CkanBorderBrush}" Height="1" />
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource CkanTextTertiaryBrush}"
                       FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- 状态栏：计数 / 当前实例 / 启动阶段 / 精简模式与「恢复数据」出口 / 主状态文案 -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0,10,0,0">
      <TextBlock Grid.Column="0" Text="{Binding CountText}" FontSize="12"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding CurrentSummary}" FontSize="12" Margin="14,0,0,0"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
      <Border Grid.Column="2" Classes="CkanBadge Success" Margin="14,0,0,0" IsVisible="{Binding IsLaunchActive}">
        <TextBlock Text="{Binding LaunchPhaseText}" />
      </Border>
      <Border Grid.Column="3" Classes="CkanBadge Warning" Margin="8,0,0,0" IsVisible="{Binding IsTrimMode}"
              ToolTip.Tip="{Binding TrimModeHint}">
        <TextBlock Text="{Binding TrimModeText}" />
      </Border>
      <Button Grid.Column="4" Classes="CkanGhost CkanSmall" Content="恢复数据" Margin="8,0,0,0"
              Command="{Binding RestoreTrimModeCommand}" IsVisible="{Binding IsTrimMode}"
              ToolTip.Tip="{Binding TrimModeHint}" />
      <TextBlock Grid.Column="5" Text="{Binding StatusText}" FontSize="12" Margin="14,0,0,0"
                 Foreground="{DynamicResource CkanTextTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Grid>

    <!-- 内联表单覆盖层 -->
    <Border Grid.RowSpan="3" IsVisible="{Binding HasForm}" Background="{DynamicResource CkanScrimBrush}">
      <ContentControl Content="{Binding Form}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <dialogs:InstanceFormPanel />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>

    <!-- 启动命令编辑覆盖层 -->
    <Border Grid.RowSpan="3" IsVisible="{Binding HasCommandsPanel}" Background="{DynamicResource CkanScrimBrush}">
      <ContentControl Content="{Binding CommandsPanel}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <dialogs:LaunchCommandsPanel />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>

    <!-- 切换遮罩 -->
    <Border Grid.RowSpan="3" IsVisible="{Binding IsBusy}" Background="{DynamicResource CkanBlockingScrimBrush}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="360">
        <ProgressBar IsIndeterminate="True" Width="240" />
        <TextBlock Text="{Binding BusyText}" FontSize="14" HorizontalAlignment="Center"
                   Foreground="{DynamicResource CkanTextInverseBrush}" TextWrapping="Wrap"
                   TextAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
