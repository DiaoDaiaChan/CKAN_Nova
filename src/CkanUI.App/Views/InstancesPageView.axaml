<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:CkanUI.App.Views.Dialogs.InstanceDialogs"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="CkanUI.App.Views.InstancesPageView"
             x:CompileBindings="False"
             KeyDown="OnRootKeyDown">
  <!-- 实例页：工具条 + 左列表 + 右详情 + 状态栏 + 遮罩/表单覆盖层。 -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="16,14,16,12">

    <!-- 页头 + 顶部命令栏：FluentAvalonia 官方 FACommandBar——高频操作常显，低频操作自动收进溢出菜单 -->
    <StackPanel Grid.Row="0" Spacing="12">
    <StackPanel Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Ui_InstancesPage_Title}" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <Button Classes="CkanHelper" VerticalAlignment="Center"
                ToolTip.Tip="{DynamicResource Ui_InstancesPage_Header_Tip}">
          <PathIcon Data="{StaticResource CkanIconHelp}" />
        </Button>
      </StackPanel>
      <TextBlock Text="{DynamicResource Ui_InstancesPage_Subtitle}" Classes="CkanCaption" TextWrapping="Wrap" />
    </StackPanel>
    <Border Padding="4,2" CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            Background="{DynamicResource CkanCardBackgroundBrush}"
            BorderBrush="{DynamicResource CkanCardBorderBrush}"
            BorderThickness="1"
            IsVisible="{Binding !ShowEmptyState}">
      <ui:FACommandBar DefaultLabelPosition="Right" ItemsAlignment="Left" OverflowButtonVisibility="Auto"
                       Background="Transparent" BorderThickness="0">
        <ui:FACommandBar.PrimaryCommands>
          <ui:FACommandBarButton IconSource="Add" Label="{DynamicResource Ui_Instances_EmptyAction}" Command="{Binding AddCommand}"
                                 ToolTip.Tip="{DynamicResource Ui_InstancesPage_AddDirectory_Tip}" />
          <ui:FACommandBarButton IconSource="Download" Label="{DynamicResource Ui_Instances_SteamDialogTitle}" Command="{Binding ImportFromSteamCommand}"
                                 ToolTip.Tip="{DynamicResource Ui_InstancesPage_ScanSteam_Tip}" />
          <ui:FACommandBarButton IconSource="Refresh" Label="{DynamicResource Ui_Common_Refresh}" Command="{Binding RefreshCommand}"
                                 ToolTip.Tip="{DynamicResource Ui_InstancesPage_Refresh_Tip}" />
          <ui:FACommandBarSeparator />
          <ui:FACommandBarButton IconSource="Accept" Label="{DynamicResource Ui_InstancesPage_SetCurrentShort}" Command="{Binding SwitchCommand}"
                                 IsEnabled="{Binding CanSwitchSelected}"
                                 ToolTip.Tip="{DynamicResource Ui_InstancesPage_SetCurrent_Tip}" />
          <ui:FACommandBarButton IconSource="Play" Label="{DynamicResource Ui_InstancesPage_LaunchGame}" Command="{Binding LaunchCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="{Binding LaunchToolTip}" />
        </ui:FACommandBar.PrimaryCommands>
        <ui:FACommandBar.SecondaryCommands>
          <ui:FACommandBarButton IconSource="Copy" Label="{DynamicResource Ui_InstancesPage_CloneInstance}" Command="{Binding BeginCloneCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="{DynamicResource Ui_InstancesPage_Clone_Tip}" />
          <ui:FACommandBarButton IconSource="Rename" Label="{DynamicResource Ui_InstancesPage_RenameShort}" Command="{Binding BeginRenameCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="{DynamicResource Ui_InstancesPage_Rename_Tip}" />
          <ui:FACommandBarButton IconSource="OpenFolder" Label="{DynamicResource Ui_InstancesPage_OpenGameDir}" Command="{Binding OpenFolderCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="{DynamicResource Ui_InstancesPage_OpenDirectory_Tip}" />
          <ui:FACommandBarButton IconSource="Edit" Label="{DynamicResource Ui_InstancesPage_EditLaunchCommands}" Command="{Binding EditCommandsCommand}"
                                 IsEnabled="{Binding CanEditCommands}" ToolTip.Tip="{DynamicResource Ui_InstancesPage_EditLaunchCmds_Tip}" />
          <ui:FACommandBarSeparator />
          <ui:FACommandBarButton IconSource="Repair" Label="{DynamicResource Ui_InstancesPage_InstanceAuditTitle}" Command="{Binding DiagnoseCommand}"
                                 IsEnabled="{Binding CanOpenSelected}" ToolTip.Tip="{DynamicResource Ui_InstancesPage_SelfCheck_Tip}" />
          <ui:FACommandBarButton IconSource="Delete" Label="{DynamicResource Ui_InstancesPage_ForgetInstance}" Command="{Binding ForgetCommand}"
                                 IsEnabled="{Binding CanForgetSelected}" ToolTip.Tip="{DynamicResource Ui_InstancesPage_Forget_Tip}" />
        </ui:FACommandBar.SecondaryCommands>
      </ui:FACommandBar>
    </Border>
    </StackPanel>

    <!-- 错误条：异常与失败统一收口到页面文本 -->
    <Border Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0"
            Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource CkanDangerBrush}"
                     FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ErrorDetail}" Foreground="{DynamicResource CkanDangerBrush}" Opacity="0.85"
                     FontSize="{DynamicResource CkanFontSizeCaption}" TextWrapping="Wrap" IsVisible="{Binding HasErrorDetail}" MaxHeight="48" />
        </StackPanel>
        <Button Grid.Column="2" Content="{DynamicResource Ui_Cmd_Shortcuts_Close}" Command="{Binding ClearErrorCommand}"
                Classes="CkanSmall" Margin="12,0,0,0"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 主体：非空时显示「左列表 + 详情」，空状态时全宽居中展示引导卡片 -->
    <Grid Grid.Row="1" Margin="0,10,0,0">
      <!--
        空状态：真正的欢迎面板（不是一片黑）。三段式 —— 图标+标题+一句说明、三条可点击的入口卡片、
        最后才是主操作按钮。旧的实现只用了 view-layer 的 Opacity 互斥，两层同时参与布局与绘制，
        于是"空状态文案"和"实例表格"直接叠在一起（Page 07 的严重重叠 Bug）。
        现在改成严格互斥的 IsVisible，同一时刻只有一层存在于视觉树里。
      -->
      <Border Classes="CkanEmptyStateCard Elevated view-layer"
              Classes.is-active="{Binding ShowEmptyState}"
              IsHitTestVisible="{Binding ShowEmptyState}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              MaxWidth="820"
              Padding="0"
              ClipToBounds="True">
        <Panel>
          <Border Classes="CkanEmptyStateGlow" CornerRadius="{DynamicResource CkanCornerRadiusLarge}" />
          <StackPanel Spacing="18" Margin="30,28">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
                <PathIcon Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" />
              </Border>
              <TextBlock Text="{Binding EmptyStateTitle}" FontSize="{DynamicResource CkanFontSizeHeading}"
                         FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="{Binding EmptyStateHint}" Foreground="{DynamicResource CkanTextSecondaryBrush}"
                         TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
            </StackPanel>

            <!-- 三条入口卡片：把"黑洞"填成可选动作，每张都能直接点 -->
            <Grid ColumnDefinitions="*,10,*,10,*">
              <Button Grid.Column="0" Classes="CkanGuide" Command="{Binding ImportFromSteamCommand}"
                      ToolTip.Tip="{DynamicResource Ui_InstancesPage_ScanSteamCard_Tip}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="7">
                    <Border Classes="CkanIconTile">
                      <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" />
                    </Border>
                    <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_Instances_SteamDialogTitle}" />
                    <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_InstancesPage_ScanSteamCardSubtitle}" />
                  </StackPanel>
                  <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="8,0,0,0"
                            Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
                </Grid>
              </Button>
              <Button Grid.Column="2" Classes="CkanGuide" Command="{Binding AddCommand}"
                      ToolTip.Tip="{DynamicResource Ui_InstancesPage_AddManualCard_Tip}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="7">
                    <Border Classes="CkanIconTile">
                      <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                    </Border>
                    <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_InstancesPage_AddManual}" />
                    <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_ModsPage_KnownPathHint}" />
                  </StackPanel>
                  <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="8,0,0,0"
                            Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
                </Grid>
              </Button>
              <Button Grid.Column="4" Classes="CkanGuide" Command="{Binding RefreshCommand}"
                      ToolTip.Tip="{DynamicResource Ui_InstancesPage_RefreshListCard_Tip}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="7">
                    <Border Classes="CkanIconTile Muted">
                      <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                    </Border>
                    <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_InstancesPage_RefreshList}" />
                    <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_InstancesPage_RefreshListCardSubtitle}" />
                  </StackPanel>
                  <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="8,0,0,0"
                            Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
                </Grid>
              </Button>
            </Grid>

            <Button Content="{Binding EmptyStateActionText}" Command="{Binding AddCommand}"
                    Classes="CkanPrimary"
                    HorizontalAlignment="Center"
                    Padding="18,7" />
          </StackPanel>
        </Panel>
      </Border>

      <!-- 非空主体：左列表 Card + 右详情 Card -->
      <Grid ColumnDefinitions="*,6,380" Classes="view-layer"
            Classes.is-active="{Binding !ShowEmptyState}"
            IsHitTestVisible="{Binding !ShowEmptyState}">
        <Border Grid.Column="0"
                Classes="stagger-card"
                RenderTransform="translate(0px, 0px)"
                Background="{DynamicResource CkanCardBackgroundBrush}"
                BorderBrush="{DynamicResource CkanCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <!-- 列头 -->
            <Border Grid.Row="0" Padding="8,8"
                    Background="{DynamicResource CkanSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource CkanBorderBrush}"
                    BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="3,*,104,64,104,84">
                <TextBlock Grid.Column="1" Text="{DynamicResource Ui_Common_Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Common_GameVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{DynamicResource Ui_DownloadStatsPage_ModCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="{DynamicResource Ui_InstancesPage_LockedBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="5" Text="{DynamicResource Ui_Common_Status}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              </Grid>
            </Border>

            <!-- 实例列表（虚拟化，整表替换） -->
            <ListBox x:Name="InstancesList" Grid.Row="1"
                     ItemsSource="{Binding Rows}"
                     SelectionChanged="OnRowSelectionChanged"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="3,*,104,64,104,84" Height="32">
                    <!-- 当前实例绿色指示竖条 -->
                    <Border Grid.Column="0" Width="3" Margin="0,4" CornerRadius="1.5"
                            Background="{DynamicResource CkanSuccessBrush}" IsVisible="{Binding IsCurrent}" />
                    <!-- 名称要能省略号截断：横向 StackPanel 会以无限宽测量子元素，TextTrimming 永远不会生效。 -->
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center" Margin="6,0">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Name}"
                                 VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,6,0" />
                      <Border Grid.Column="1" Classes="CkanBadge Accent" IsVisible="{Binding IsDefault}" Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource Ui_InstancesPage_DefaultBadge}" />
                      </Border>
                      <!-- 异常态：目录不存在 -->
                      <Border Grid.Column="2" Classes="CkanBadge Danger" IsVisible="{Binding IsPathMissing}">
                        <TextBlock Text="{DynamicResource Ui_InstancesPage_DirectoryMissingBadge}" />
                      </Border>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding VersionText}" VerticalAlignment="Center" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding ModuleCountText}" VerticalAlignment="Center" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding LockText}" VerticalAlignment="Center" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="{Binding CurrentText}" VerticalAlignment="Center" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" ResizeDirection="Columns"
                      VerticalAlignment="Stretch" Margin="0,10" ZIndex="5" Cursor="SizeWestEast" />

        <!-- 详情面板 Card -->
        <Border Grid.Column="2" Padding="16"
              Classes="stagger-card"
              RenderTransform="translate(0px, 0px)"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
              Background="{DynamicResource CkanCardBackgroundBrush}"
              BorderBrush="{DynamicResource CkanCardBorderBrush}"
              BorderThickness="1">
        <Grid>
          <!-- 状态 A：未选择实例时的极简引导（不发灰的按钮墙，只留一句话）。 -->
          <StackPanel Classes="view-layer"
                      Classes.is-active="{Binding !HasSelection}"
                      IsHitTestVisible="{Binding !HasSelection}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Spacing="10"
                      MaxWidth="240">
            <Border Width="48" Height="48" CornerRadius="24"
                    Background="{DynamicResource CkanSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center">
              <PathIcon Width="20" Height="20"
                        Foreground="{DynamicResource CkanTextTertiaryBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z" />
            </Border>
            <TextBlock Text="{DynamicResource Ui_Instances_SelectionNone}" FontWeight="SemiBold" FontSize="{DynamicResource CkanFontSizeSubtitle}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Ui_InstancesPage_SelectInstanceHint}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <!-- 状态 B：选中实例后的详情与操作。 -->
          <ScrollViewer Classes="view-layer"
                        Classes.is-active="{Binding HasSelection}"
                        IsHitTestVisible="{Binding HasSelection}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding SelectionTitle}" FontSize="{DynamicResource CkanFontSizeSubtitle}"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectionRoleText}" FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextTertiaryBrush}" />
            <Separator Margin="0,4" Background="{DynamicResource CkanBorderBrush}" Height="1" />
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Text="{DynamicResource Ui_InstancesPage_SelectionGameVersion}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Text="{Binding SelectionVersionText}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Text="{DynamicResource Ui_InstancesPage_SelectionInstalledMods}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Text="{Binding SelectionModuleText}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Text="{DynamicResource Ui_InstancesPage_SelectionLockStatus}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Text="{Binding SelectionLockText}" TextWrapping="Wrap" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Text="{DynamicResource Ui_InstancesPage_SelectionGamePath}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <TextBlock Text="{Binding SelectionPath}" TextWrapping="Wrap" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding SelectionPathStatus}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanDangerBrush}" />
            <Separator Margin="0,6" Background="{DynamicResource CkanBorderBrush}" Height="1" />
            <StackPanel Spacing="8">
              <!-- 主操作：常显两个，其余收进官方 FAMenuFlyout -->
              <Grid ColumnDefinitions="*,8,Auto">
                <Button Grid.Column="0" Content="{DynamicResource Ui_InstancesPage_LaunchGame}" Command="{Binding LaunchCommand}"
                        IsEnabled="{Binding CanOpenSelected}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Classes="CkanPrimary"
                        ToolTip.Tip="{Binding LaunchToolTip}" />
                <Button Grid.Column="2" Content="{DynamicResource Ui_InstancesPage_MoreActions}" Classes="CkanSecondary" HorizontalContentAlignment="Center">
                  <Button.Flyout>
                    <ui:FAMenuFlyout Placement="Bottom">
                      <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_InstancesPage_SetAsCurrent}" IconSource="Accept"
                                          Command="{Binding SwitchCommand}" />
                      <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_InstancesPage_CloneInstance}" IconSource="Copy"
                                          Command="{Binding BeginCloneCommand}" />
                      <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_InstancesPage_RenameInstance}" IconSource="Rename"
                                          Command="{Binding BeginRenameCommand}" />
                      <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_InstancesPage_OpenGameDir}" IconSource="OpenFolder"
                                          Command="{Binding OpenFolderCommand}" />
                      <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_InstancesPage_EditLaunchCommands}" IconSource="Edit"
                                          Command="{Binding EditCommandsCommand}" />
                      <ui:FAMenuFlyoutSeparator />
                      <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_InstancesPage_ForgetInstance}" IconSource="Delete"
                                          Command="{Binding ForgetCommand}" />
                    </ui:FAMenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </StackPanel>
            <!-- 实例自检与故障处置（F-08）：锁探测 / 强制解锁 / 坏注册表隔离 -->
            <Separator Margin="0,6" Background="{DynamicResource CkanBorderBrush}" Height="1" />
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource Ui_InstancesPage_InstanceAuditTitle}" FontSize="{DynamicResource CkanFontSizeCaption}" FontWeight="SemiBold"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <Button Content="{DynamicResource Ui_InstancesPage_SelfCheckBtn}" Command="{Binding DiagnoseCommand}"
                      IsEnabled="{Binding CanOpenSelected}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Classes="CkanSecondary" Padding="10,6"
                      ToolTip.Tip="{DynamicResource Ui_InstancesPage_AuditReadOnly_Tip}" />
              <TextBlock Text="{Binding DiagnosisSummary}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              <ItemsControl ItemsSource="{Binding RepairIssues}" IsVisible="{Binding HasRepairIssues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,3" Padding="8,6" CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                            Background="{DynamicResource CkanSubtleBackgroundBrush}"
                            BorderBrush="{DynamicResource CkanCardBorderBrush}" BorderThickness="1">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding RepairAdvice}" IsVisible="{Binding HasRepairIssues}"
                         FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource CkanAccentBrush}" />
              <Button Content="{DynamicResource Ui_InstancesPage_ForceUnlock}" Command="{Binding ForceUnlockCommand}"
                      IsEnabled="{Binding CanForceUnlock}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Classes="CkanDanger" Padding="10,6"
                      ToolTip.Tip="{DynamicResource Ui_InstancesPage_ForceUnlock_Tip}" />
              <Button Content="{DynamicResource Ui_Instances_IsolateTitle}" Command="{Binding QuarantineRegistryCommand}"
                      IsEnabled="{Binding CanQuarantineRegistry}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Classes="CkanSecondary" Padding="10,6"
                      ToolTip.Tip="{DynamicResource Ui_InstancesPage_RecoverData_Tip}" />
            </StackPanel>
            <Separator Margin="0,6" Background="{DynamicResource CkanBorderBrush}" Height="1" />
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource CkanTextTertiaryBrush}"
                       FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
      </Grid>
    </Grid>

    <!-- 状态栏：计数 / 当前实例 / 启动阶段 / 精简模式与「恢复数据」出口 / 主状态文案 -->
    <Border Grid.Row="2" Classes="CkanPageFooter" Margin="0,12,0,0"
            IsVisible="{Binding !ShowEmptyState}">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
      <TextBlock Grid.Column="0" Text="{Binding CountText}" FontSize="12"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding CurrentSummary}" FontSize="12" Margin="14,0,0,0"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
      <Border Grid.Column="2" Classes="CkanBadge Success" Margin="14,0,0,0" IsVisible="{Binding IsLaunchActive}">
        <TextBlock Text="{Binding LaunchPhaseText}" />
      </Border>
      <Border Grid.Column="3" Classes="CkanBadge Warning" Margin="8,0,0,0" IsVisible="{Binding IsTrimMode}"
              ToolTip.Tip="{Binding TrimModeHint}">
        <TextBlock Text="{Binding TrimModeText}" />
      </Border>
      <Button Grid.Column="4" Classes="CkanGhost CkanSmall" Content="{DynamicResource Ui_InstancesPage_RecoverData}" Margin="8,0,0,0"
              Command="{Binding RestoreTrimModeCommand}" IsVisible="{Binding IsTrimMode}"
              ToolTip.Tip="{Binding TrimModeHint}" />
      <TextBlock Grid.Column="5" Text="{Binding StatusText}" FontSize="12" Margin="14,0,0,0"
                 Foreground="{DynamicResource CkanTextTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Grid>
    </Border>

    <!-- 内联表单覆盖层 -->
    <Border Grid.RowSpan="3" IsVisible="{Binding HasForm}" Background="{DynamicResource CkanScrimBrush}">
      <ContentControl Content="{Binding Form}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <dialogs:InstanceFormPanel />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>

    <!-- 启动命令编辑覆盖层 -->
    <Border Grid.RowSpan="3" IsVisible="{Binding HasCommandsPanel}" Background="{DynamicResource CkanScrimBrush}">
      <ContentControl Content="{Binding CommandsPanel}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <dialogs:LaunchCommandsPanel />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>

    <!-- 切换遮罩 -->
    <Border Grid.RowSpan="3" IsVisible="{Binding IsBusy}" Background="{DynamicResource CkanBlockingScrimBrush}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="360">
        <ProgressBar IsIndeterminate="True" Width="240" />
        <TextBlock Text="{Binding BusyText}" FontSize="14" HorizontalAlignment="Center"
                   Foreground="{DynamicResource CkanTextInverseBrush}" TextWrapping="Wrap"
                   TextAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
