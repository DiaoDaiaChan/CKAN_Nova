<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:CkanUI.App.Converters"
             x:Class="CkanUI.App.Views.Assets.ShipsPageView"
             x:CompileBindings="False">
  <!-- 飞船工作台（assets-workbench 篇 §3）：载具列表 + 缩略图预览 + 改名/复制/删除。
       颜色一律走 Tokens.axaml 的语义 token；卡片/工具条/空态/错误条复用 FluentStyles 的 Ckan* 类。 -->
  <UserControl.Resources>
    <conv:PathToThumbnailConverter x:Key="Thumb" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="{DynamicResource CkanRowHeight}" />
    </Style>
    <!-- 选中行左侧 3px 强调条（沿用存档页与导航栏的做法） -->
    <Style Selector="Rectangle.SelectionBar">
      <Setter Property="Width" Value="3" />
      <Setter Property="RadiusX" Value="1.5" />
      <Setter Property="RadiusY" Value="1.5" />
      <Setter Property="Fill" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="2,6" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected Rectangle.SelectionBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="{DynamicResource CkanPagePadding}" Background="Transparent">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{DynamicResource Ui_NavRail_Ships}" Classes="CkanPageTitle"
                 VerticalAlignment="Center" />
      <Border Grid.Column="1" Classes="CkanBadge" VerticalAlignment="Center"
              IsVisible="{Binding HasStatus}">
        <TextBlock Text="{Binding StatusText}" />
      </Border>
    </Grid>

    <!-- 工具条 -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card" Margin="0,12,0,0">
      <WrapPanel Orientation="Horizontal">
        <Button Content="{DynamicResource Ui_Common_Refresh}" Command="{Binding RefreshCommand}"
                Classes="CkanPrimary" Margin="0,0,8,0" IsEnabled="{Binding !IsBusy}" />
        <Button Content="{DynamicResource Ui_Assets_Action_Import}" Command="{Binding ImportCommand}"
                Classes="CkanSecondary" Margin="0,0,8,0" IsEnabled="{Binding !IsBusy}" />
        <Button Content="{DynamicResource Ui_Assets_Action_Rename}" Command="{Binding RenameCommand}"
                Classes="CkanGhost" Margin="0,0,8,0"
                IsEnabled="{Binding SelectedCraft, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Content="{DynamicResource Ui_Assets_Action_Duplicate}" Command="{Binding DuplicateCommand}"
                Classes="CkanGhost" Margin="0,0,8,0"
                IsEnabled="{Binding SelectedCraft, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Content="{DynamicResource Ui_Assets_Action_OpenFolder}" Command="{Binding OpenFolderCommand}"
                Classes="CkanGhost" Margin="0,0,8,0"
                IsEnabled="{Binding SelectedCraft, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Content="{DynamicResource Ui_Assets_Action_Delete}" Command="{Binding DeleteCommand}"
                Classes="CkanDanger"
                IsEnabled="{Binding SelectedCraft, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </WrapPanel>
    </Border>

    <!-- 页面级错误条 -->
    <Border Grid.Row="2" Margin="0,12,0,0" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*">
        <PathIcon Grid.Column="0" Data="{StaticResource CkanIconHelp}" Width="18" Height="18"
                  Margin="0,0,12,0" Foreground="{DynamicResource CkanDangerBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="Medium"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                     IsVisible="{Binding ErrorDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体：左列表 + 右详情 -->
    <Grid Grid.Row="3" ColumnDefinitions="*,6,340" Margin="0,12,0,0">

      <Border Grid.Column="0" Classes="CkanCard" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Padding="10,7"
                  Background="{DynamicResource CkanSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="52,2*,72,84,44,44,68,108">
              <TextBlock Grid.Column="0" Text="" Classes="CkanCaption" />
              <TextBlock Grid.Column="1" Text="{DynamicResource Ui_Common_Name}" Classes="CkanCaption" />
              <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Assets_Column_Kind}" Classes="CkanCaption" />
              <TextBlock Grid.Column="3" Text="{DynamicResource Ui_Common_Version}" Classes="CkanCaption" />
              <TextBlock Grid.Column="4" Text="{DynamicResource Ui_Assets_Column_Parts}" Classes="CkanCaption" />
              <TextBlock Grid.Column="5" Text="{DynamicResource Ui_Assets_Column_Stages}" Classes="CkanCaption" />
              <TextBlock Grid.Column="6" Text="{DynamicResource Ui_Common_Size}" Classes="CkanCaption" />
              <TextBlock Grid.Column="7" Text="{DynamicResource Ui_Common_ModifiedTime}" Classes="CkanCaption" />
            </Grid>
          </Border>

          <ListBox Grid.Row="1" ItemsSource="{Binding Crafts}" Padding="4"
                   SelectedItem="{Binding SelectedCraft, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="52,2*,72,84,44,44,68,108" MinHeight="{DynamicResource CkanRowHeight}">
                  <Rectangle Grid.ColumnSpan="8" Classes="SelectionBar" />
                  <Border Grid.Column="0" Width="40" Height="24" CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                          Background="{DynamicResource CkanSubtleBackgroundBrush}"
                          VerticalAlignment="Center" ClipToBounds="True">
                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource Thumb}, ConverterParameter=96}"
                           Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                             ToolTip.Tip="{Binding FilePath}"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding KindLabel}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <TextBlock Grid.Column="3" Text="{Binding VersionText}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <TextBlock Grid.Column="4" Text="{Binding PartCountText}" VerticalAlignment="Center"
                             Classes="CkanNumeric" />
                  <TextBlock Grid.Column="5" Text="{Binding StageCountText}" VerticalAlignment="Center"
                             Classes="CkanNumeric" />
                  <TextBlock Grid.Column="6" Text="{Binding SizeText}" VerticalAlignment="Center"
                             Classes="CkanNumeric" />
                  <TextBlock Grid.Column="7" Text="{Binding ModifiedText}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

      <!-- 右侧详情 -->
      <Border Grid.Column="2" Classes="CkanCard stagger-card" MinWidth="300">
        <Grid>
          <StackPanel Spacing="8"
                      IsVisible="{Binding SelectedCraft, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Height="168" CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
                    Background="{DynamicResource CkanSubtleBackgroundBrush}" ClipToBounds="True">
              <Image Source="{Binding SelectedCraft.ThumbnailPath, Converter={StaticResource Thumb}}"
                     Stretch="Uniform" />
            </Border>
            <TextBlock Text="{Binding SelectedCraft.Name}" Classes="CkanCardTitle"
                       TextTrimming="CharacterEllipsis" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Ui_Assets_Column_Kind}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCraft.KindLabel}" Classes="CkanCaption" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Ui_Common_Version}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCraft.VersionText}" Classes="CkanCaption" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Ui_Assets_Column_Parts}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCraft.PartCountText}" Classes="CkanCaption" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Ui_Assets_Column_Stages}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCraft.StageCountText}" Classes="CkanCaption" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Ui_Common_Size}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCraft.SizeText}" Classes="CkanCaption" />
              <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Ui_Common_ModifiedTime}" Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedCraft.ModifiedText}" Classes="CkanCaption" />
            </Grid>
            <TextBlock Text="{Binding SelectedCraft.FilePath}" TextWrapping="Wrap"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextTertiaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource Ui_Assets_Action_Rename}" Command="{Binding RenameCommand}"
                      Classes="CkanSecondary" />
              <Button Content="{DynamicResource Ui_Assets_Action_OpenFolder}" Command="{Binding OpenFolderCommand}"
                      Classes="CkanGhost" />
            </StackPanel>
          </StackPanel>

          <!-- 未选择 -->
          <Border Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding SelectedCraft, Converter={x:Static ObjectConverters.IsNull}}">
            <Border Classes="CkanIconTile Lg Muted">
              <PathIcon Data="M12 2 4 7v10l8 5 8-5V7l-8-5zm0 2.3 6 3.7-6 3.8-6-3.8 6-3.7z" />
            </Border>
          </Border>
        </Grid>
      </Border>

      <!-- 空态：这个实例还没有载具 -->
      <Border Grid.Column="0" Grid.ColumnSpan="3" Classes="CkanEmptyStateCard Elevated" Margin="0"
              IsVisible="{Binding ShowEmptyState}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
          <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
            <PathIcon Data="M12 2 4 7v10l8 5 8-5V7l-8-5zm0 2.3 6 3.7-6 3.8-6-3.8 6-3.7z" />
          </Border>
          <TextBlock Text="{DynamicResource Ui_Assets_Empty_Ships}" HorizontalAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <Button Content="{DynamicResource Ui_Assets_Action_Import}" Command="{Binding ImportCommand}"
                  Classes="CkanSecondary" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 进行中 -->
    <Border Grid.RowSpan="4" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
        <ProgressBar IsIndeterminate="True" Width="240" />
        <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="{DynamicResource CkanFontSizeBody}"
                   Foreground="{DynamicResource CkanTextInverseBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
