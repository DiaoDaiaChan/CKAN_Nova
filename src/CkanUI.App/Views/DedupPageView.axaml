<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.App.Theming"
             x:Class="CkanUI.App.Views.DedupPageView"
             x:CompileBindings="False">
  <!-- 跨实例去重页（规格 F-41 / 03 篇 UI-21 / INT-09）：实例多选 + 扫描 + 分组表格 + 预演/执行。
       全部颜色走 Tokens.axaml 的语义 token，间距一律 4 的倍数；默认预演，写盘必须经过两次确认。
       视觉规范：卡片/工具条/空态/错误条/骨架屏统一复用 FluentStyles 的 Ckan* 类。 -->
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="{DynamicResource CkanRowHeight}" />
    </Style>
    <Style Selector="ListBoxItem.noBar">
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <!-- 选中行左侧 3px 强调条（沿用导航栏 navIndicator 的做法） -->
    <Style Selector="Rectangle.SelectionBar">
      <Setter Property="Width" Value="3" />
      <Setter Property="RadiusX" Value="1.5" />
      <Setter Property="RadiusY" Value="1.5" />
      <Setter Property="Fill" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="2,6" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected Rectangle.SelectionBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Ui_NavRail_Dedup}" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <Button Classes="CkanHelper" VerticalAlignment="Center"
                ToolTip.Tip="{DynamicResource Ui_DedupPage_Header_Tip}">
          <PathIcon Data="{StaticResource CkanIconHelp}" />
        </Button>
      </StackPanel>
      <TextBlock Text="{DynamicResource Ui_DedupPage_Subtitle}"
                 Classes="CkanCaption" TextWrapping="Wrap" />

      <!-- 四步向导：勾实例 → 扫描 → 核对 → 写盘，让人知道下一步做什么 -->
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" VerticalAlignment="Center">
        <Border Classes="CkanStepDot"><TextBlock Text="1" /></Border>
        <TextBlock Text="{DynamicResource Ui_DedupPage_StepSelect}" Classes="CkanStepLabel" VerticalAlignment="Center" />
        <TextBlock Text="›" Classes="CkanStepArrow" VerticalAlignment="Center" />
        <Border Classes="CkanStepDot"><TextBlock Text="2" /></Border>
        <TextBlock Text="{DynamicResource Ui_DedupPage_StepScan}" Classes="CkanStepLabel" VerticalAlignment="Center" />
        <TextBlock Text="›" Classes="CkanStepArrow" VerticalAlignment="Center" />
        <Border Classes="CkanStepDot"><TextBlock Text="3" /></Border>
        <TextBlock Text="{DynamicResource Ui_DedupPage_StepReview}" Classes="CkanStepLabel" VerticalAlignment="Center" />
        <TextBlock Text="›" Classes="CkanStepArrow" VerticalAlignment="Center" />
        <Border Classes="CkanStepDot"><TextBlock Text="4" /></Border>
        <TextBlock Text="{DynamicResource Ui_DedupPage_StepExecute}" Classes="CkanStepLabel" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <!-- 工具条：预演开关 + 最小尺寸 + 扫描 / 执行 -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card">
      <WrapPanel Orientation="Horizontal">
        <Button Content="{DynamicResource Ui_DedupPage_RefreshInstances}" Command="{Binding RefreshInstancesCommand}"
                IsEnabled="{Binding IsIdle}" Classes="CkanGhost" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_DedupPage_RefreshInstances_Tip}" />
        <Button Content="{DynamicResource Ui_DedupPage_ToggleAll}" Command="{Binding ToggleAllCommand}"
                Classes="CkanGhost" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_DedupPage_ToggleAll_Tip}" />
        <TextBlock Text="{DynamicResource Ui_DedupPage_MinSizeKiB}" VerticalAlignment="Center" Margin="4,0,4,0" Classes="CkanCaption" />
        <TextBox Text="{Binding MinimumFileSizeKiB, Mode=TwoWay}" Width="80" Margin="0,0,8,0"
                 VerticalAlignment="Center"
                 ToolTip.Tip="{DynamicResource Ui_DedupPage_MinSize_Tip}" />
        <CheckBox Content="{DynamicResource Ui_DedupPage_DryRun}" IsChecked="{Binding DryRun, Mode=TwoWay}"
                  Margin="0,0,12,0" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_DedupPage_DryRun_Tip}" />
        <Button Content="{DynamicResource Ui_DedupPage_Scan}" Command="{Binding ScanCommand}"
                IsEnabled="{Binding CanScan}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_DedupPage_Scan_Tip}" />
        <Button Content="{Binding ExecuteText}" Command="{Binding ExecuteCommand}"
                IsEnabled="{Binding CanExecute}" Classes="CkanPrimary"
                ToolTip.Tip="{DynamicResource Ui_DedupPage_Execute_Tip}" />
      </WrapPanel>
    </Border>

    <!-- 实例多选 -->
    <Border Grid.Row="2" Margin="0,12,0,0" Classes="CkanSubtleCard stagger-card">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{DynamicResource Ui_DedupPage_SelectedInstances}" Classes="CkanCaption" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding SelectionText}" Margin="12,0,0,0"
                     Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeCaption}"
                     VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Instances}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,12,4"
                        VerticalAlignment="Center"
                        Content="{Binding DisplayName}"
                        ToolTip.Tip="{Binding GameDir}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- 页面级错误条 -->
    <Border Grid.Row="3" Margin="0,12,0,0" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0"
                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="Medium"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                     IsVisible="{Binding HasErrorDetail}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="{DynamicResource Ui_Common_Retry}" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}"
                  Classes="CkanSmall" ToolTip.Tip="{DynamicResource Ui_DedupPage_Rescan_Tip}" />
          <Button Content="{DynamicResource Ui_Cmd_Shortcuts_Close}" Command="{Binding ClearErrorCommand}" Classes="CkanSmall" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 统计条 + 执行前提示 -->
    <Border Grid.Row="4" Margin="0,12,0,0" Classes="CkanSubtleCard stagger-card">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding StatsText}" Classes="CkanCaption"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding DryRunHint}" Margin="12,0,0,0"
                     Classes="CkanCaption" Foreground="{DynamicResource CkanTextSecondaryBrush}"
                     VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </Grid>
        <!-- 容量对比：释放前 → 释放后，比例条给"能省多少"一个体感 -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4,0,0"
              IsVisible="{Binding HasOccupancy}">
          <TextBlock Grid.Column="0" Text="{Binding OccupiedText}" Classes="CkanNumeric"
                     FontSize="{DynamicResource CkanFontSizeCaption}" VerticalAlignment="Center"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Height="6"
                       Value="{Binding ReclaimPercent}" VerticalAlignment="Center"
                       CornerRadius="{DynamicResource CkanCornerRadiusPill}"
                       ToolTip.Tip="{Binding ReclaimPercentText}" />
          <TextBlock Grid.Column="2" Text="{Binding DedupedText}" Classes="CkanNumeric"
                     FontSize="{DynamicResource CkanFontSizeCaption}" VerticalAlignment="Center"
                     Foreground="{DynamicResource CkanAccentBrush}" />
        </Grid>
        <TextBlock Text="{Binding ConfirmHintText}" TextWrapping="Wrap"
                   FontSize="{DynamicResource CkanFontSizeCaption}" FontWeight="Medium"
                   Foreground="{DynamicResource CkanWarningBrush}"
                   IsVisible="{Binding HasGroups}" />
        <TextBlock Text="{Binding UnsupportedHint}" TextWrapping="Wrap"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanWarningBrush}"
                   IsVisible="{Binding !IsSupported}" />
      </StackPanel>
    </Border>

    <!-- 结果区：左分组表格，右组内文件 + 执行结果 -->
    <Grid Grid.Row="5" Margin="0,12,0,0" ColumnDefinitions="*,6,380"
          IsVisible="{Binding HasGroups}">
      <Border Grid.Column="0" Classes="CkanCard" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="12,7" Background="{DynamicResource CkanSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,90,90,110,16">
              <TextBlock Grid.Column="0" Text="{DynamicResource Ui_DedupPage_HashHeader}" Classes="CkanCaption" />
              <TextBlock Grid.Column="1" Text="{DynamicResource Ui_DedupPage_FileCount}" Classes="CkanCaption" />
              <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Common_Size}" Classes="CkanCaption" />
              <TextBlock Grid.Column="3" Text="{DynamicResource Ui_DedupPage_Reclaimable}" Classes="CkanCaption" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Groups}" Padding="0"
                   SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,90,90,110,16" Margin="12,0" MinHeight="{DynamicResource CkanRowHeight}">
                  <Rectangle Grid.ColumnSpan="4" Classes="SelectionBar" />
                  <!-- 哈希定宽、实例名占剩余宽度：横向 StackPanel 会以无限宽测量，实例名截断不生效。 -->
                  <Grid Grid.Column="0" ColumnDefinitions="88,*" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Grid.Column="0" Text="{Binding HashText}" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding InstanceNamesText}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  </Grid>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileCount}" Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeCaption}" />
                    <TextBlock Text="{DynamicResource Ui_DedupPage_FilesUnit}" FontSize="{DynamicResource CkanFontSizeCaption}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <TextBlock Grid.Column="3" Text="{Binding ReclaimableText}" VerticalAlignment="Center"
                             Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeCaption}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 分割条（GridSplitter） -->
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />

      <Grid Grid.Column="2" MinWidth="280" MaxWidth="600" RowDefinitions="Auto,*,Auto,*">
        <TextBlock Grid.Row="0" Text="{DynamicResource Ui_DedupPage_GroupFilesHeader}"
                   Classes="CkanCaption" TextWrapping="Wrap" Margin="0,0,0,6" />
        <Border Grid.Row="1" Classes="CkanCard" Padding="0"
                IsVisible="{Binding HasSelectedGroup}">
          <ListBox ItemsSource="{Binding SelectedGroupFiles}" Padding="4"
                   BorderThickness="0" Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="BorderThickness" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" MinHeight="{DynamicResource CkanRowHeight}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <Border Grid.Row="1" Classes="CkanCard" IsVisible="{Binding !HasSelectedGroup}">
          <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
            <Border Classes="CkanIconTile Muted" HorizontalAlignment="Center">
              <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
            </Border>
            <TextBlock Text="{DynamicResource Ui_DedupPage_NoGroupSelectedTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource Ui_DedupPage_NoGroupSelectedSubtitle}"
                       Classes="CkanCaption" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" />
          </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{DynamicResource Ui_DedupPage_ExecutionResult}" Margin="0,12,0,6"
                   IsVisible="{Binding HasResults}" Classes="CkanCardTitle" />
        <Border Grid.Row="3" Classes="CkanCard" Padding="0"
                IsVisible="{Binding HasResults}">
          <ListBox ItemsSource="{Binding Results}" Padding="4"
                   BorderThickness="0" Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="BorderThickness" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,72,68" MinHeight="{DynamicResource CkanRowHeight}">
                  <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                    <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding OutcomeText}" VerticalAlignment="Center"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding FreedText}" VerticalAlignment="Center"
                             Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeCaption}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Grid>

    <!-- 空状态：扫描过但没发现重复 -->
    <Border Grid.Row="5" Margin="0,12,0,0" Classes="CkanEmptyStateCard"
            IsVisible="{Binding ShowEmptyState}"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="480">
        <Border Classes="CkanIconTile Lg Success" HorizontalAlignment="Center">
          <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
        </Border>
        <TextBlock Text="{Binding EmptyStateTitle}" HorizontalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        <TextBlock Text="{Binding EmptyStateHint}" TextWrapping="Wrap" TextAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeBody}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <Button Content="{DynamicResource Ui_DedupPage_Rescan}" Command="{Binding ScanCommand}"
                IsEnabled="{Binding CanScan}"
                Classes="CkanPrimary" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 未扫描 / 无实例时的占位：避免结果区留出一整屏空白 -->
    <Border Grid.Row="5" Margin="0,12,0,0" Classes="CkanEmptyStateCard Flat"
            IsVisible="{Binding ShowInitialState}"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="10" MaxWidth="420" HorizontalAlignment="Center">
        <Border Classes="CkanIconTile Lg Muted" HorizontalAlignment="Center">
          <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
        </Border>
        <TextBlock Text="{DynamicResource Ui_DedupPage_NoResultsTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        <TextBlock Text="{DynamicResource Ui_DedupPage_NoResultsSubtitle}"
                   TextWrapping="Wrap" TextAlignment="Center" Classes="CkanCaption" />
      </StackPanel>
    </Border>

    <Border Grid.Row="5" Margin="0,12,0,0" Classes="CkanEmptyStateCard Flat"
            IsVisible="{Binding ShowNoInstance}"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="10" MaxWidth="420" HorizontalAlignment="Center">
        <Border Classes="CkanIconTile Lg Muted" HorizontalAlignment="Center">
          <PathIcon Data="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2z" />
        </Border>
        <TextBlock Text="{DynamicResource Ui_DedupPage_NeedTwoInstancesTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        <Button Content="{DynamicResource Ui_DedupPage_AddInstance}" HorizontalAlignment="Center" Classes="CkanPrimary"
                Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                CommandParameter="instances" />
      </StackPanel>
    </Border>

    <!-- 状态栏 -->
    <Border Grid.Row="6" Classes="CkanPageFooter" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="CkanCaption"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

    </Grid>
    </Border>

    <!-- 进行中遮罩：未出结果时走骨架屏，已有分组时走进度条（同一时刻只有一个脉动元素） -->
    <Border Grid.RowSpan="7" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Grid>
        <StackPanel IsVisible="{Binding !HasGroups}" IsHitTestVisible="False"
                    app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="180" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasGroups}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
