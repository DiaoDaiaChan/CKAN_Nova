<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.App.Theming"
             xmlns:modsViews="using:CkanUI.App.Views.Mods"
             xmlns:dialogs="using:CkanUI.App.Views.Dialogs"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="CkanUI.App.Views.ModsPageView"
             x:CompileBindings="False"
             KeyDown="OnRootKeyDown">

  <!-- 模组页（04 篇 §3 / 12 篇 F-32 / UI-11）：顶部工具条 + 左侧虚拟化表格 + 右侧详情 + 底部状态栏。
       视觉规范：卡片/工具条/空态/骨架屏统一复用 FluentStyles 的 Ckan* 类，颜色只走 Tokens.axaml 的语义 token。 -->
  <UserControl.Styles>
    <!-- DataGrid 主题：在本视图内单独引入 -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- 行基线：全局 :focus-visible 会给行加 2px 边框，这里把基线厚度压到 0，保证行高与列宽不因焦点跳变 -->
    <Style Selector="DataGridRow">
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 空状态不再套卡片：表格容器让出背景与描边，只留表头与居中的引导内容。 -->
    <Style Selector="Border.CkanCard.is-empty">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页面标题与主操作：极简高效，释放垂直死区 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Ui_ManageMods_Title}" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <ui:FAInfoBadge Value="{Binding VisibleCount}"
                        IsVisible="{Binding HasInstance}"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CkanAccentBrush}"
                        ToolTip.Tip="{DynamicResource Ui_ModsPage_FilterCount_Tip}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <!-- 紧凑/标准密度切换 -->
        <Button Command="{Binding ToggleDensityCommand}"
                Classes="CkanSecondary" Padding="8,4" VerticalAlignment="Center"
                IsVisible="{Binding HasInstance}"
                ToolTip.Tip="{DynamicResource Ui_Settings_Item_Density}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Width="11" Height="11" Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
            <TextBlock Text="{Binding DensityButtonText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- 详情面板显隐开关 (Ctrl+I) -->
        <ToggleButton IsChecked="{Binding IsDetailsPaneVisible, Mode=TwoWay}"
                      Classes="CkanSecondary" Padding="8,4" VerticalAlignment="Center"
                      IsVisible="{Binding HasInstance}"
                      ToolTip.Tip="{DynamicResource Ui_ModsPage_ToggleDetails_Tip}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Width="11" Height="11" Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM13 7h4v10h-4z" />
            <TextBlock Text="{DynamicResource Ui_Common_Details}" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
        <!-- 应用变更 -->
        <Button Command="{Binding ApplyChangesCommand}"
                Classes="CkanPrimary" Padding="12,4" VerticalAlignment="Center"
                IsVisible="{Binding HasInstance}"
                ToolTip.Tip="{DynamicResource Ui_ModsPage_ApplyChanges_Tip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="12" Height="12"
                      Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" />
            <TextBlock Text="{DynamicResource Ui_ModsPage_ApplyChanges}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Fluent v2 工具条：单行超紧凑布局 + 折叠筛选抽屉，最大化表格有效显示面积 -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card" Margin="0"
            IsVisible="{Binding HasInstance}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <WrapPanel Grid.Column="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
            <!-- 搜索框 -->
            <TextBox x:Name="SearchBox" Width="260"
                     Classes="CkanSearchBox"
                     AutomationProperties.Name="{DynamicResource Ui_ModsPage_SearchMods_A11y}"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Ui_ModsPage_Search_Placeholder}"
                     KeyDown="OnSearchKeyDown">
              <TextBox.InnerRightContent>
                <Button Classes="CkanIcon" Command="{Binding ClearSearchTextCommand}"
                        Margin="0,0,4,0"
                        IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="{DynamicResource Ui_ModsPage_ClearSearch_Tip}"
                        AutomationProperties.Name="{DynamicResource Ui_LogPage_ClearSearch}" Focusable="False">
                  <PathIcon Width="11" Height="11"
                            Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Button>
              </TextBox.InnerRightContent>
            </TextBox>

            <!-- 状态与兼容性筛选下拉菜单 -->
            <DropDownButton Classes="CkanSecondary" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Ui_ModsPage_FilterStatus_Tip}"
                            AutomationProperties.Name="{DynamicResource Ui_ModsPage_StatusFilter}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Width="12" Height="12" Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" />
                <TextBlock Text="{DynamicResource Ui_ModsPage_StatusFilter}" VerticalAlignment="Center" />
              </StackPanel>
              <DropDownButton.Flyout>
                <ui:FAMenuFlyout Placement="BottomEdgeAlignedLeft">
                  <ui:FAMenuFlyoutSubItem Text="{DynamicResource Ui_DownloadStats_DimensionInstalled}" IconSource="Filter">
                    <MenuItem Header="{DynamicResource Ui_ManageMods_FilterAll}" Click="OnInstallFilterClick" Tag="0" />
                    <MenuItem Header="{DynamicResource Ui_ManageMods_FilterInstalled}" Click="OnInstallFilterClick" Tag="1" />
                    <MenuItem Header="{DynamicResource Ui_ManageMods_FilterNotInstalled}" Click="OnInstallFilterClick" Tag="2" />
                    <MenuItem Header="{DynamicResource Ui_ManageMods_FilterUpgradeable}" Click="OnInstallFilterClick" Tag="3" />
                  </ui:FAMenuFlyoutSubItem>
                  <ui:FAMenuFlyoutSubItem Text="{DynamicResource Ui_Settings_Section_Compatibility}" IconSource="Accept">
                    <MenuItem Header="{DynamicResource Ui_ManageMods_FilterAll}" Click="OnCompatibilityFilterClick" Tag="0" />
                    <MenuItem Header="{DynamicResource Ui_ManageMods_FilterCompatibleOnly}" Click="OnCompatibilityFilterClick" Tag="1" />
                    <MenuItem Header="{DynamicResource Ui_ManageMods_FilterIncompatibleOnly}" Click="OnCompatibilityFilterClick" Tag="2" />
                  </ui:FAMenuFlyoutSubItem>
                  <ui:FAMenuFlyoutSeparator />
                  <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_Common_ResetFilter}" IconSource="Refresh"
                                       Command="{Binding ResetFiltersCommand}" />
                </ui:FAMenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>

            <!-- 排序下拉菜单 -->
            <DropDownButton Classes="CkanSecondary" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Ui_ModsPage_SortBy_Tip}"
                            AutomationProperties.Name="{DynamicResource Ui_ModsPage_SortBy_Tip}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Width="12" Height="12" Data="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" />
                <TextBlock Text="{DynamicResource Ui_Common_Sort}" VerticalAlignment="Center" />
              </StackPanel>
              <DropDownButton.Flyout>
                <ui:FAMenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="{DynamicResource Ui_Common_Name}" Click="OnSortColumnClick" Tag="0" />
                  <MenuItem Header="{DynamicResource Ui_Common_Identifier}" Click="OnSortColumnClick" Tag="1" />
                  <MenuItem Header="{DynamicResource Ui_ModsPage_ColInstalledVersion}" Click="OnSortColumnClick" Tag="2" />
                  <MenuItem Header="{DynamicResource Ui_ModsPage_ColLatestVersion}" Click="OnSortColumnClick" Tag="3" />
                  <MenuItem Header="{DynamicResource Ui_ModPackEditor_LabelAuthor}" Click="OnSortColumnClick" Tag="4" />
                  <MenuItem Header="{DynamicResource Ui_DownloadStatsPage_Downloads}" Click="OnSortColumnClick" Tag="5" />
                  <MenuItem Header="{DynamicResource Ui_Common_Size}" Click="OnSortColumnClick" Tag="6" />
                  <MenuItem Header="{DynamicResource Ui_ModsPage_ColInstallStatus}" Click="OnSortColumnClick" Tag="7" />
                  <Separator />
                  <MenuItem Header="{DynamicResource Ui_ModsPage_SortDirection_Tip}" Command="{Binding ToggleSortCommand}" />
                </ui:FAMenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>

            <!-- 排序方向按钮 -->
            <Button Classes="CkanSecondary" VerticalAlignment="Center" Padding="8,4"
                    Command="{Binding ToggleSortDirectionCommand}"
                    ToolTip.Tip="{DynamicResource Ui_ModsPage_SortDirection_Tip}"
                    AutomationProperties.Name="{DynamicResource Ui_ModsPage_SortDirection_A11y}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Width="11" Height="11" Data="M0 8l6-6 6 6z"
                          IsVisible="{Binding SortAscending}" />
                <PathIcon Width="11" Height="11" Data="M12 8l-6 6-6-6z"
                          IsVisible="{Binding !SortAscending}" />
              </StackPanel>
            </Button>

            <!-- 分类与标签折叠筛选开关（将冗余的两整行胶囊收入抽屉） -->
            <ToggleButton Classes="CkanSecondary"
                          IsChecked="{Binding IsFiltersExpanded, Mode=TwoWay}"
                          VerticalAlignment="Center" Padding="8,4"
                          ToolTip.Tip="展开/收起分类与标签筛选面板">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Width="11" Height="11" Data="M3 4h18v2H3V4zm3 7h12v2H6v-2zm5 7h2v2h-2v-2z" />
                <TextBlock Text="分类与标签" VerticalAlignment="Center" />
                <Ellipse Width="6" Height="6" Fill="{DynamicResource CkanAccentBrush}"
                         IsVisible="{Binding HasActiveCategoryOrLabelFilter}"
                         VerticalAlignment="Center" Margin="2,0,0,0" />
              </StackPanel>
            </ToggleButton>

            <!-- 组合搜索面板开关（F-20/F-21） -->
            <ToggleButton Classes="CkanPill"
                          Content="{Binding SearchPanel.SummaryText}"
                          IsChecked="{Binding SearchPanel.IsExpanded}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{DynamicResource Ui_ModsPage_ToggleSearchPanel_Tip}"
                          AutomationProperties.Name="{Binding SearchPanel.SummaryText}" />

            <!-- 重置筛选按钮：只在有筛选生效时动态展现，不占冗余常驻位置 -->
            <Button Classes="CkanGhost"
                    Content="{DynamicResource Ui_Common_ResetFilter}"
                    Command="{Binding ResetFiltersCommand}"
                    IsVisible="{Binding HasActiveFilters}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{DynamicResource Ui_ModsPage_ClearAllFilters_Tip}" />

            <!-- 插件工具项（12 篇 F-17）：没有插件声明时整块不占位。 -->
            <ItemsControl VerticalAlignment="Center" IsVisible="{Binding HasPluginTools}"
                          ItemsSource="{Binding PluginTools}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Title}" Command="{Binding ExecuteCommand}"
                          IsEnabled="{Binding !IsBusy}" Classes="CkanSmall"
                          ToolTip.Tip="{Binding ToolTipText}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </WrapPanel>

          <!-- 右侧操作：刷新仓库与全部更新 -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
            <Button Classes="CkanSecondary"
                    Command="{Binding RefreshRepositoriesCommand}"
                    ToolTip.Tip="{DynamicResource Ui_ModsPage_RefreshRepos_Tip}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Width="12" Height="12"
                          Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                <TextBlock Text="{DynamicResource Ui_ModsPage_RefreshRepos}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="CkanSecondary"
                    Command="{Binding UpdateAllCommand}"
                    ToolTip.Tip="{DynamicResource Ui_ModsPage_UpdateAll_Tip}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Width="12" Height="12"
                          Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                <TextBlock Text="{DynamicResource Ui_ModsPage_UpdateAll}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- 折叠抽屉：核心分类与标签组（按需展开，默认收起，极大腾出垂直视觉空间） -->
        <Border Classes="CkanSubtleCard" Padding="8,6" Margin="0,2,0,0"
                IsVisible="{Binding IsFiltersExpanded}">
          <StackPanel Spacing="6">
            <!-- 核心分类筛选行 -->
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="核心分类：" Classes="CkanCaption" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding CategoryChips}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="CkanChip"
                            Classes.Active="{Binding IsActive}"
                            Command="{Binding ToggleCommand}"
                            Content="{Binding ButtonText}"
                            Margin="0,0,4,2"
                            ToolTip.Tip="{Binding StateText}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Grid.Column="2" Content="清除分类" Command="{Binding ClearCategoryFilterCommand}"
                      Classes="CkanSmall" ToolTip.Tip="清除当前选中的分类筛选"
                      IsVisible="{Binding HasCategoryFilter}" VerticalAlignment="Center" />
            </Grid>

            <!-- 标签组筛选行 -->
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasLabelService}">
              <TextBlock Grid.Column="0" Text="{DynamicResource Ui_ModsPage_LabelGroups}" Classes="CkanCaption" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding LabelFilters}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="CkanChip"
                            Classes.Active="{Binding IsActive}"
                            Command="{Binding ToggleCommand}"
                            Content="{Binding DisplayText}"
                            Margin="0,0,4,2"
                            ToolTip.Tip="{Binding ColorHex}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Content="{DynamicResource Ui_ModsPage_ClearLabelFilter}" Command="{Binding ResetLabelFiltersCommand}"
                        Classes="CkanSmall" ToolTip.Tip="{DynamicResource Ui_ModsPage_ClearLabelFilter_Tip}" />
                <Button Content="{DynamicResource Ui_ModsPage_ManageLabels}" Command="{Binding ManageLabelsCommand}"
                        Classes="CkanSmall"
                        ToolTip.Tip="{DynamicResource Ui_ModsPage_ManageLabels_Tip}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 组合搜索面板（F-20/F-21）：DataContext 换成面板自身，展开状态与字段都在面板里 -->
        <modsViews:ModsSearchPanelView
            DataContext="{Binding SearchPanel}"
            Classes="view-layer"
            Classes.is-active="{Binding IsExpanded}"
            IsVisible="{Binding IsExpanded}" />
      </StackPanel>
    </Border>

    <!-- 主体区域：左侧表格 Card + 右侧详情 Card；详情卡折叠时表格自动吃满 100% 宽度 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0"
          IsVisible="{Binding !ShowEmptyState}">

      <!-- 左侧模组列表 Card -->
      <Border Grid.Column="0" Classes="CkanCard stagger-card" Padding="0" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="ModsGrid"
                    ItemsSource="{Binding Rows}"
                    IsVisible="{Binding HasInstance}"
                    SelectionChanged="OnRowSelectionChanged"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    CanUserResizeColumns="True"
                    HeadersVisibility="Column"
                    GridLinesVisibility="None"
                    RowHeight="{DynamicResource CkanRowHeight}"
                    BorderThickness="0"
                    Background="Transparent">
            <!-- 右键上下文菜单 -->
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{DynamicResource Ui_ModsPage_CtxReinstall}" Command="{Binding ReinstallSelectedCommand}" IsEnabled="{Binding CanReinstallSelected}" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui_ModsPage_CtxCopyModId}" Command="{Binding CopySelectedIdentifierCommand}" />
                <MenuItem Header="{DynamicResource Ui_ModsPage_CtxCopyDownloadUrl}" Command="{Binding CopySelectedDownloadUrlCommand}" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui_ModsPage_CtxOpenHomepage}" Command="{Binding OpenSelectedHomepageCommand}" IsEnabled="{Binding CanOpenHomepage}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <!-- 行首：已装状态指示条 + 变更集复选框 -->
              <DataGridTemplateColumn Header="{DynamicResource Ui_Common_CheckCol}" Width="38" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Border Width="3" Margin="0,4" CornerRadius="1.5" HorizontalAlignment="Left"
                              Background="{DynamicResource CkanSuccessBrush}" IsVisible="{Binding IsInstalled}" />
                      <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                Click="OnSelectionCheckBoxClick"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip.Tip="{DynamicResource Ui_ModsPage_ToggleChange_Tip}" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 名称 + 语义徽章 -->
              <DataGridTemplateColumn Header="{DynamicResource Ui_Common_Name}" Width="280">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <!-- 名称要能省略号截断：横向 StackPanel 以无限宽测量子元素，TextTrimming 会失效。 -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center" Margin="6,0">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Name}"
                                 VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,6,0" />
                      <Border Grid.Column="1" Classes="CkanBadge Accent" IsVisible="{Binding ShowUpdateBadge}" Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource Ui_ModsPage_TagUpdateAvailable}" />
                      </Border>
                      <Border Grid.Column="2" Classes="CkanBadge" IsVisible="{Binding ShowAutoBadge}" Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource Ui_ModsPage_TagAutoInstalled}" />
                      </Border>
                      <Border Grid.Column="3" Classes="CkanBadge Info" IsVisible="{Binding ShowDependencyBadge}" Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource Ui_ModsPage_TagDependency}" />
                      </Border>
                      <Border Grid.Column="4" Classes="CkanBadge Warning" IsVisible="{Binding ShowIncompatibleBadge}">
                        <TextBlock Text="{DynamicResource Ui_ModsPage_TagIncompatible}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="{DynamicResource Ui_ManageMods_FilterInstalled}" Width="90"
                                  Binding="{Binding InstalledVersionText}" />
              <DataGridTextColumn Header="{DynamicResource Ui_ModsPage_TagLatest}" Width="90"
                                  Binding="{Binding LatestVersionText}" />
              <DataGridTextColumn Header="{DynamicResource Ui_ModPackEditor_LabelAuthor}" Width="140"
                                  Binding="{Binding AuthorText}" />
              <DataGridTextColumn Header="{DynamicResource Ui_DownloadStatsPage_Downloads}" Width="80"
                                  Binding="{Binding DownloadText}" />
              <DataGridTextColumn Header="分类" Width="140"
                                  Binding="{Binding CategoryBadgeText}" />
              <DataGridTextColumn Header="{DynamicResource Ui_DownloadStats_DimensionTags}" Width="180"
                                  Binding="{Binding TagsText}" />
              <DataGridTextColumn Header="{DynamicResource Ui_Common_Size}" Width="70"
                                  Binding="{Binding SizeText}" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- 空状态已上提到页面层（见下方 Grid.Row=2 的 ColumnSpan 卡），不再嵌在表格卡里 -->
        </Grid>
      </Border>

      <!-- 拖拽分割条：仅当详情面板可见时生效 -->
      <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" Margin="0,10" ZIndex="5" Cursor="SizeWestEast"
                    IsVisible="{Binding IsDetailsPaneVisible}" />

      <!-- 右侧模组详情面板（F-26）：历史选择 + 标签组快开 + 四页签富详情，支持一键折叠收起 -->
      <Border Grid.Column="2" Classes="CkanCard stagger-card" Width="400" MinWidth="320" MaxWidth="640"
              IsVisible="{Binding IsDetailsPaneVisible}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="0,0,0,8" Margin="0,0,0,6"
                  BorderBrush="{DynamicResource CkanHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Command="{Binding GoBackSelectionCommand}"
                        IsEnabled="{Binding CanGoBackSelection}"
                        Classes="CkanSmall"
                        Padding="8,4"
                        ToolTip.Tip="{DynamicResource Ui_ModsPage_PrevSelected_Tip}"
                        AutomationProperties.Name="{DynamicResource Ui_ModsPage_PrevSelected_Tip}">
                  <PathIcon Width="11" Height="11" Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
                </Button>
                <Button Command="{Binding GoForwardSelectionCommand}"
                        IsEnabled="{Binding CanGoForwardSelection}"
                        Classes="CkanSmall"
                        Padding="8,4"
                        ToolTip.Tip="{DynamicResource Ui_ModsPage_NextSelected_Tip}"
                        AutomationProperties.Name="{DynamicResource Ui_ModsPage_NextSelected_Tip}">
                  <PathIcon Width="11" Height="11" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasLabelService}">
                  <ToggleButton Classes="CkanPill"
                                Classes.is-active="{Binding DetailIsFavourite}"
                                Content="{DynamicResource Ui_ManageMods_LabelFavourite}"
                                Command="{Binding ToggleFavouriteCommand}"
                                ToolTip.Tip="{DynamicResource Ui_ModsPage_ToggleFavorite_Tip}" />
                  <ToggleButton Classes="CkanPill"
                                Classes.is-active="{Binding DetailIsHidden}"
                                Content="{DynamicResource Ui_ManageMods_LabelHidden}"
                                Command="{Binding ToggleHiddenCommand}"
                                ToolTip.Tip="{DynamicResource Ui_ModsPage_ToggleHidden_Tip}" />
                  <ToggleButton Classes="CkanPill"
                                Classes.is-active="{Binding DetailIsHeld}"
                                Content="{DynamicResource Ui_ManageMods_LabelHeld}"
                                Command="{Binding ToggleHeldCommand}"
                                ToolTip.Tip="{DynamicResource Ui_ModsPage_ToggleHoldVersion_Tip}" />
                </StackPanel>
                <Button Classes="CkanIcon" Command="{Binding ToggleDetailsPaneCommand}"
                        Margin="4,0,0,0"
                        ToolTip.Tip="{DynamicResource Ui_ModsPage_CollapseDetails_Tip}"
                        AutomationProperties.Name="{DynamicResource Ui_ModsPage_CollapseDetails_Name}">
                  <PathIcon Width="11" Height="11"
                            Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <dialogs:ModDetailsView DataContext="{Binding Details}" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- 空状态：页面层独立卡，跨满整行，避免右列 400px 在空态下留出死区。
         无实例时走"欢迎面板"三段式（图标+标题+入口卡片），把整片黑洞填成可选动作。 -->
    <Border Grid.Row="2" Classes="CkanEmptyStateCard Elevated stagger-card" Margin="0,12,0,0"
            IsVisible="{Binding ShowEmptyState}">
      <Panel>
        <Border Classes="CkanEmptyStateGlow" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="760" Margin="24,20">
        <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
          <Panel>
            <PathIcon IsVisible="{Binding HasInstance}"
                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
            <PathIcon IsVisible="{Binding !HasInstance}"
                      Data="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2zm12.5-1.5 3 3-1.4 1.4-1.6-1.6-1.6 1.6-1.4-1.4 3-3z" />
          </Panel>
        </Border>
        <TextBlock Text="{Binding EmptyStateTitle}" HorizontalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock Text="{Binding EmptyStateHint}" Classes="CkanCaption"
                   TextWrapping="Wrap" TextAlignment="Center" />
        <ItemsControl ItemsSource="{Binding ActiveFilterChips}" HorizontalAlignment="Center"
                      IsVisible="{Binding HasInstance}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="CkanBadge" Margin="3">
                <TextBlock Text="{Binding}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Content="{DynamicResource Ui_ModsPage_ClearFiltersBtn}" Command="{Binding ResetFiltersCommand}"
                  Classes="CkanSecondary" IsVisible="{Binding HasInstance}" />
          <Button Content="{DynamicResource Ui_Common_RefreshNow}" Command="{Binding RefreshRepositoriesCommand}"
                  Classes="CkanPrimary" IsVisible="{Binding CanRefreshFromEmptyState}" />
          <Button Content="{DynamicResource Ui_DedupPage_AddInstance}"
                  Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                  CommandParameter="instances"
                  Classes="CkanPrimary" IsVisible="{Binding !HasInstance}" />
        </StackPanel>

        <!-- 三条入口卡片：只在"没有实例"时出现，第一次打开就有明确的下一步 -->
        <Grid ColumnDefinitions="*,10,*,10,*" IsVisible="{Binding !HasInstance}"
              HorizontalAlignment="Stretch" Margin="0,4,0,0">
          <Button Grid.Column="0" Classes="CkanGuide"
                  Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                  CommandParameter="instances"
                  ToolTip.Tip="{DynamicResource Ui_ModsPage_ImportSteamHint_Tip}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="7">
                <Border Classes="CkanIconTile">
                  <PathIcon Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" />
                </Border>
                <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_ModsPage_ScanSteamTitle}" />
                <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_ModsPage_ScanSteamSubtitle}" />
              </StackPanel>
              <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="8,0,0,0"
                        Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
            </Grid>
          </Button>
          <Button Grid.Column="2" Classes="CkanGuide"
                  Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                  CommandParameter="instances"
                  ToolTip.Tip="{DynamicResource Ui_ModsPage_AddManualHint_Tip}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="7">
                <Border Classes="CkanIconTile">
                  <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                </Border>
                <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_ModsPage_AddManualTitle}" />
                <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_ModsPage_KnownPathHint}" />
              </StackPanel>
              <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="8,0,0,0"
                        Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
            </Grid>
          </Button>
          <Button Grid.Column="4" Classes="CkanGuide"
                  Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                  CommandParameter="modpacks"
                  ToolTip.Tip="{DynamicResource Ui_ModsPage_ImportPackHint_Tip}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="7">
                <Border Classes="CkanIconTile Muted">
                  <PathIcon Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm0 2.5L18.5 9H14V4.5zM6 20V4h6v6h6v10H6z" />
                </Border>
                <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_ModsPage_ImportPackTitle}" />
                <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_ModsPage_ImportPackSubtitle}" />
              </StackPanel>
              <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="8,0,0,0"
                        Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
            </Grid>
          </Button>
        </Grid>
        </StackPanel>
      </Panel>
    </Border>

    <!-- 底部状态与操作栏：紧凑边距，释放更多垂直表格高度 -->
    <Border Grid.Row="3" Classes="CkanPageFooter" Margin="0,6,0,0" Padding="10,6"
            IsVisible="{Binding HasInstance}">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="CkanCaption"
                 Foreground="{DynamicResource CkanTextTertiaryBrush}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding DownloadSummary}" Classes="CkanCaption" VerticalAlignment="Center"
                   Margin="0,0,4,0" />
        <Button Command="{Binding PreviewChangesCommand}" Classes="CkanSecondary">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="12" Height="12" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
            <TextBlock Text="{DynamicResource Ui_ModsPage_PreviewChanges}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ReviewChangesCommand}" Classes="CkanPrimary">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="12" Height="12" Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" />
            <TextBlock Text="{DynamicResource Ui_ModsPage_GoToChangesPage}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    </Border>

    <!-- 进行中遮罩：无行时骨架屏，有行时进度条（同一时刻只有一个脉动元素） -->
    <Border Grid.RowSpan="3" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Border.Transitions>
      <Grid>
        <StackPanel IsVisible="{Binding !HasRows}" IsHitTestVisible="False"
                    app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="200" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasRows}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
