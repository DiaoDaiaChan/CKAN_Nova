<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CkanUI.App.Views.ModsPageView"
             x:CompileBindings="False"
             KeyDown="OnRootKeyDown">

  <!-- DataGrid 主题：App.axaml 没有全局包含，这里在本视图内单独引入（DataGrid 目前仅本页使用）。 -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- 标签组开关（F-24）：未选中用中性面色，选中用强调色；颜色只取 Tokens.axaml 的 Ckan* 语义 brush。 -->
    <Style Selector="Button.labelChip">
      <Setter Property="Background" Value="{DynamicResource CkanSurfaceBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.labelChip.active">
      <Setter Property="Background" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CkanAccentTextBrush}" />
    </Style>

    <!-- 详情面板里的三组常用标签开关（收藏 / 隐藏 / 锁定版本）。 -->
    <Style Selector="Button.labelToggle">
      <Setter Property="Background" Value="{DynamicResource CkanSurfaceBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.labelToggle.active">
      <Setter Property="Background" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CkanAccentTextBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <!-- 工具条（03 篇 §3.1）：搜索、过滤下拉、排序、刷新、应用 -->
    <Border Grid.Row="0" Padding="8" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBox x:Name="SearchBox"
                 Grid.Column="0"
                 MinWidth="220"
                 VerticalAlignment="Center"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="搜索模组：名称 / @作者 / tag: / is:installed / -否定"
                 KeyDown="OnSearchKeyDown" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="清空" Command="{Binding ClearSearchTextCommand}"
                ToolTip.Tip="清空搜索（Esc）" />
        <ComboBox Grid.Column="2" Margin="12,0,0,0" MinWidth="110" VerticalAlignment="Center"
                  SelectedIndex="{Binding InstallFilterIndex, Mode=TwoWay}"
                  ToolTip.Tip="安装状态过滤">
          <ComboBoxItem>全部</ComboBoxItem>
          <ComboBoxItem>已装</ComboBoxItem>
          <ComboBoxItem>未装</ComboBoxItem>
          <ComboBoxItem>有更新</ComboBoxItem>
        </ComboBox>
        <ComboBox Grid.Column="3" Margin="8,0,0,0" MinWidth="110" VerticalAlignment="Center"
                  SelectedIndex="{Binding CompatibilityFilterIndex, Mode=TwoWay}"
                  ToolTip.Tip="兼容性过滤（默认仅兼容）">
          <ComboBoxItem>全部</ComboBoxItem>
          <ComboBoxItem>仅兼容</ComboBoxItem>
          <ComboBoxItem>仅不兼容</ComboBoxItem>
        </ComboBox>
        <ComboBox Grid.Column="4" Margin="8,0,0,0" MinWidth="120" VerticalAlignment="Center"
                  SelectedIndex="{Binding SortColumnIndex, Mode=TwoWay}"
                  ToolTip.Tip="排序依据">
          <ComboBoxItem>名称</ComboBoxItem>
          <ComboBoxItem>标识符</ComboBoxItem>
          <ComboBoxItem>已装版本</ComboBoxItem>
          <ComboBoxItem>最新版本</ComboBoxItem>
          <ComboBoxItem>作者</ComboBoxItem>
          <ComboBoxItem>下载量</ComboBoxItem>
          <ComboBoxItem>体积</ComboBoxItem>
          <ComboBoxItem>已装状态</ComboBoxItem>
        </ComboBox>
        <Button Grid.Column="5" Margin="6,0,0,0" Content="↑↓" Command="{Binding ToggleSortCommand}"
                ToolTip.Tip="切换升序 / 降序" />
        <Button Grid.Column="6" Margin="12,0,0,0" Content="刷新仓库"
                Command="{Binding RefreshRepositoriesCommand}"
                ToolTip.Tip="联网刷新仓库索引（Ctrl+R）" />
        <Button Grid.Column="7" Margin="6,0,0,0" Content="全量更新"
                Command="{Binding UpdateAllCommand}"
                ToolTip.Tip="勾选所有可更新模组（F-32）" />
        <Button Grid.Column="8" Margin="6,0,0,0" Content="应用变更"
                Command="{Binding ApplyChangesCommand}"
                ToolTip.Tip="审查并应用当前变更集（F-32）" />

        <!-- 标签组筛选（F-24）：多选为"或"（命中任一选中标签即通过），每个开关自带命令。
             未接线 ILabelService 时整行隐藏，不影响既有布局。 -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9" Margin="0,8,0,0"
                Padding="6,4" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource CkanBorderBrush}"
                IsVisible="{Binding HasLabelService}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="标签组" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <ItemsControl ItemsSource="{Binding LabelFilters}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="labelChip"
                          Classes.active="{Binding IsActive}"
                          Command="{Binding ToggleCommand}"
                          Content="{Binding DisplayText}"
                          Margin="0,0,4,0" Padding="8,2" FontSize="12"
                          ToolTip.Tip="{Binding ColorHex}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="清除标签筛选" FontSize="12" Padding="8,2"
                    Command="{Binding ResetLabelFiltersCommand}"
                    ToolTip.Tip="取消全部标签组筛选" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 主体：左列表 + 右详情（03 篇 §3.1） -->
    <Grid Grid.Row="1" ColumnDefinitions="*,4,360" Margin="0,8,0,0">

      <Grid Grid.Column="0">
        <!-- 虚拟化表格（03 篇 §3.2 / UI-02）：DataGrid 自带 VirtualizingStackPanel，3,000 行只实体化可见行；
             列头可拖拽改宽，列宽由 ModsPageViewModel 记忆（键见 DefaultColumnWidths）。 -->
        <DataGrid x:Name="ModsGrid"
                  ItemsSource="{Binding Rows}"
                  SelectionChanged="OnRowSelectionChanged"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeight="26"
                  BorderThickness="0">
          <!-- 右键上下文菜单（F-31 / UI-18） -->
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="重新安装" Command="{Binding ReinstallSelectedCommand}" IsEnabled="{Binding CanReinstallSelected}" />
              <Separator />
              <MenuItem Header="复制模组标识符" Command="{Binding CopySelectedIdentifierCommand}" />
              <MenuItem Header="复制下载链接" Command="{Binding CopySelectedDownloadUrlCommand}" />
              <Separator />
              <MenuItem Header="打开主页" Command="{Binding OpenSelectedHomepageCommand}" IsEnabled="{Binding CanOpenHomepage}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <!-- 行首：已装绿色竖条 + 勾选框（§3.3） -->
            <DataGridTemplateColumn Header="选" Width="32" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <Border Width="3" Margin="0,2" CornerRadius="1" HorizontalAlignment="Left"
                            Background="#2E7D32" IsVisible="{Binding IsInstalled}" />
                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                              Click="OnSelectionCheckBoxClick"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip.Tip="加入 / 移出变更集（Space）" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- 名称 + 徽章 -->
            <DataGridTemplateColumn Header="名称" Width="260">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Background="#1F6FEB" CornerRadius="3" Padding="4,0" IsVisible="{Binding ShowUpdateBadge}">
                      <TextBlock Text="↑ 更新" FontSize="11" Foreground="White" />
                    </Border>
                    <Border Background="#6E7781" CornerRadius="3" Padding="4,0" IsVisible="{Binding ShowAutoBadge}">
                      <TextBlock Text="自动" FontSize="11" Foreground="White" />
                    </Border>
                    <Border Background="#8250DF" CornerRadius="3" Padding="4,0" IsVisible="{Binding ShowDependencyBadge}">
                      <TextBlock Text="依赖" FontSize="11" Foreground="White" />
                    </Border>
                    <Border Background="#B35900" CornerRadius="3" Padding="4,0" IsVisible="{Binding ShowIncompatibleBadge}">
                      <TextBlock Text="⚠ 不兼容" FontSize="11" Foreground="White" />
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="已装" Width="90"
                                Binding="{Binding InstalledVersionText}" />
            <DataGridTextColumn Header="最新" Width="90"
                                Binding="{Binding LatestVersionText}" />
            <DataGridTextColumn Header="作者" Width="140"
                                Binding="{Binding AuthorText}" />
            <DataGridTextColumn Header="下载量" Width="80"
                                Binding="{Binding DownloadText}" />
            <DataGridTextColumn Header="标签" Width="200"
                                Binding="{Binding TagsText}" />
            <DataGridTextColumn Header="大小" Width="70"
                                Binding="{Binding SizeText}" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- 空状态（03 篇 §10） -->
        <Border IsVisible="{Binding ShowEmptyState}"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420">
            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyStateHint}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
            <ItemsControl ItemsSource="{Binding ActiveFilterChips}" HorizontalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" CornerRadius="10"
                          Padding="8,2" Margin="2">
                    <TextBlock Text="{Binding}" FontSize="12" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Content="清除过滤条件" Command="{Binding ResetFiltersCommand}" />
              <Button Content="立即刷新" Command="{Binding RefreshRepositoriesCommand}"
                      IsVisible="{Binding CanRefreshFromEmptyState}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

      <!-- 详情面板（03 篇 §3.1 / 06 篇 UI-03 骨架） -->
      <Border Grid.Column="2" Padding="12" CornerRadius="6"
              Background="{DynamicResource SystemControlBackgroundListLowBrush}">
        <ScrollViewer>
          <StackPanel Spacing="6">
            <!-- 选中历史前进/后退（F-25）：在详情面板内部走，不影响左侧导航页历史。 -->
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="←"
                      Command="{Binding GoBackSelectionCommand}"
                      IsEnabled="{Binding CanGoBackSelection}"
                      ToolTip.Tip="上一个选中模组"
                      Padding="8,2" MinWidth="0" FontSize="11" />
              <Button Content="→"
                      Command="{Binding GoForwardSelectionCommand}"
                      IsEnabled="{Binding CanGoForwardSelection}"
                      ToolTip.Tip="下一个选中模组"
                      Padding="8,2" MinWidth="0" FontSize="11" />
            </StackPanel>
            <TextBlock Text="{Binding DetailName}" FontSize="18" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetailIdentifier}" FontSize="12" Opacity="0.6" />
            <TextBlock Text="{Binding DetailStatusText}" FontSize="12" Opacity="0.8" />
            <Separator Margin="0,6" />
            <TextBlock Text="{Binding DetailVersionText}" />
            <TextBlock Text="{Binding DetailAuthor, StringFormat='作者：{0}'}" />
            <TextBlock Text="{Binding DetailDownloadText, StringFormat='下载量：{0}'}" />
            <TextBlock Text="{Binding DetailSizeText, StringFormat='体积：{0}'}" />
            <TextBlock Text="{Binding DetailTagsText, StringFormat='标签：{0}'}" TextWrapping="Wrap" />

            <!-- 标签组标记（F-24）：只读标记 + 三组常用标签一键切换；未接线标签服务时整块隐藏。 -->
            <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding HasLabelService}">
              <TextBlock Text="标签组" FontSize="12"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <ItemsControl ItemsSource="{Binding DetailLabels}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource CkanSurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="8,1" Margin="0,0,4,4">
                      <TextBlock Text="{Binding Name}" FontSize="12" ToolTip.Tip="{Binding ColorHex}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding DetailLabelText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                         IsVisible="{Binding !HasDetailLabels}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="labelToggle"
                        Classes.active="{Binding DetailIsFavourite}"
                        Content="收藏"
                        Command="{Binding ToggleFavouriteCommand}"
                        ToolTip.Tip="加入 / 移出收藏标签组" />
                <Button Classes="labelToggle"
                        Classes.active="{Binding DetailIsHidden}"
                        Content="隐藏"
                        Command="{Binding ToggleHiddenCommand}"
                        ToolTip.Tip="加入 / 移出隐藏标签组（隐藏组默认不在其它过滤器里显示）" />
                <Button Classes="labelToggle"
                        Classes.active="{Binding DetailIsHeld}"
                        Content="锁定版本"
                        Command="{Binding ToggleHeldCommand}"
                        ToolTip.Tip="加入 / 移出锁定版本标签组（不参与升级）" />
              </StackPanel>
            </StackPanel>
            <Separator Margin="0,6" />
            <TextBlock Text="描述、依赖树、版本列表与主页链接将在 UI-03 完整实现。" Opacity="0.6"
                       TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding StatusText}" Opacity="0.5" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- 状态栏（03 篇 §3.1） -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">
      <TextBlock Grid.Column="0" Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" FontSize="12" Margin="12,0,0,0"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Opacity="0.7" Margin="12,0,0,0"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding DownloadSummary}" FontSize="12" VerticalAlignment="Center" />
        <Button Content="预览变更" Command="{Binding PreviewChangesCommand}" FontSize="12" Padding="8,2" />
        <Button Content="去变更集" Command="{Binding ReviewChangesCommand}" FontSize="12" Padding="8,2" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
