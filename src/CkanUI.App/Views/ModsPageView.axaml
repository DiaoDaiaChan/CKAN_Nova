<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.App.Theming"
             xmlns:modsViews="using:CkanUI.App.Views.Mods"
             xmlns:dialogs="using:CkanUI.App.Views.Dialogs"
             x:Class="CkanUI.App.Views.ModsPageView"
             x:CompileBindings="False"
             KeyDown="OnRootKeyDown">

  <!-- 模组页（04 篇 §3 / 12 篇 F-32 / UI-11）：顶部工具条 + 左侧虚拟化表格 + 右侧详情 + 底部状态栏。
       视觉规范：卡片/工具条/空态/骨架屏统一复用 FluentStyles 的 Ckan* 类，颜色只走 Tokens.axaml 的语义 token。 -->
  <UserControl.Styles>
    <!-- DataGrid 主题：在本视图内单独引入 -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- 行基线：全局 :focus-visible 会给行加 2px 边框，这里把基线厚度压到 0，保证行高与列宽不因焦点跳变 -->
    <Style Selector="DataGridRow">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页面标题与主操作：把高频操作从筛选工具条中解放出来。 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="模组管理" FontSize="{DynamicResource CkanFontSizeTitle}" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="探索、筛选并管理你的 Kerbal Space Program 模组"
                     Classes="CkanCaption" VerticalAlignment="Center" />
          <Border Background="{DynamicResource CkanAccentSubtleBrush}"
                  CornerRadius="{DynamicResource CkanCornerRadiusPill}" Padding="8,2">
            <TextBlock Text="{Binding CountText}" Classes="CkanCaption"
                       Foreground="{DynamicResource CkanAccentBrush}" />
          </Border>
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" Command="{Binding ApplyChangesCommand}"
              Classes="CkanPrimary" Padding="18,8" VerticalAlignment="Center"
              ToolTip.Tip="审查并应用当前变更集（F-32）">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Width="13" Height="13" Foreground="{DynamicResource CkanAccentTextBrush}"
                    Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" />
          <TextBlock Text="应用变更" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- 顶部工具条：用 WrapPanel 承载，窄窗口自动换行而不是横向溢出。 -->
    <Border Grid.Row="1" Classes="CkanToolbar" Margin="0,16,0,0">
      <StackPanel Spacing="8">

        <WrapPanel Orientation="Horizontal">
          <TextBox x:Name="SearchBox" Width="360" Margin="0,0,8,0"
                   Classes="CkanSearchBox"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="搜索模组：名称 / @作者 / tag: / is:installed / -否定"
                   KeyDown="OnSearchKeyDown" />

          <Button Command="{Binding ClearSearchTextCommand}"
                  Classes="CkanGhost" Margin="0,0,8,0"
                  ToolTip.Tip="清空搜索（Esc）">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Width="11" Height="11" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
              <TextBlock Text="清空" FontSize="{DynamicResource CkanFontSizeCaption}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- 组合搜索面板开关（F-20/F-21）：逐字段填写，生成同一套搜索语法 -->
          <Button Content="{Binding SearchPanel.SummaryText}"
                  Command="{Binding SearchPanel.ToggleExpandedCommand}"
                  Classes="CkanSecondary" Margin="0,0,8,0"
                  ToolTip.Tip="展开 / 收起组合搜索面板（18 个字段逐项筛选）" />

          <ComboBox Margin="0,0,8,0" MinWidth="110" VerticalAlignment="Center"
                    SelectedIndex="{Binding InstallFilterIndex, Mode=TwoWay}"
                    ToolTip.Tip="安装状态过滤">
            <ComboBoxItem>全部</ComboBoxItem>
            <ComboBoxItem>已装</ComboBoxItem>
            <ComboBoxItem>未装</ComboBoxItem>
            <ComboBoxItem>有更新</ComboBoxItem>
          </ComboBox>

          <ComboBox Margin="0,0,8,0" MinWidth="115" VerticalAlignment="Center"
                    SelectedIndex="{Binding CompatibilityFilterIndex, Mode=TwoWay}"
                    ToolTip.Tip="兼容性过滤（默认仅兼容）">
            <ComboBoxItem>全部</ComboBoxItem>
            <ComboBoxItem>仅兼容</ComboBoxItem>
            <ComboBoxItem>仅不兼容</ComboBoxItem>
          </ComboBox>

          <ComboBox Margin="0,0,8,0" MinWidth="120" VerticalAlignment="Center"
                    SelectedIndex="{Binding SortColumnIndex, Mode=TwoWay}"
                    ToolTip.Tip="排序依据">
            <ComboBoxItem>名称</ComboBoxItem>
            <ComboBoxItem>标识符</ComboBoxItem>
            <ComboBoxItem>已装版本</ComboBoxItem>
            <ComboBoxItem>最新版本</ComboBoxItem>
            <ComboBoxItem>作者</ComboBoxItem>
            <ComboBoxItem>下载量</ComboBoxItem>
            <ComboBoxItem>体积</ComboBoxItem>
            <ComboBoxItem>已装状态</ComboBoxItem>
          </ComboBox>

          <Button Command="{Binding ToggleSortCommand}"
                  Classes="CkanGhost" Margin="0,0,8,0"
                  ToolTip.Tip="切换升序 / 降序">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Width="12" Height="12" Data="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" />
              <TextBlock Text="排序" FontSize="{DynamicResource CkanFontSizeCaption}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Command="{Binding RefreshRepositoriesCommand}"
                  Classes="CkanSecondary" Margin="0,0,8,0"
                  ToolTip.Tip="联网刷新仓库索引（Ctrl+R）">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="12" Height="12" Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
              <TextBlock Text="刷新仓库" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Command="{Binding UpdateAllCommand}"
                  Classes="CkanSecondary" Margin="0,0,8,0"
                  ToolTip.Tip="勾选所有可更新模组（F-32）">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="12" Height="12" Data="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" />
              <TextBlock Text="全量更新" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- 插件工具项（12 篇 F-17）：没有插件声明时整块不占位 -->
          <ItemsControl VerticalAlignment="Center" Margin="0,0,8,0"
                        IsVisible="{Binding HasPluginTools}"
                        ItemsSource="{Binding PluginTools}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Title}"
                        Command="{Binding ExecuteCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Classes="CkanSmall"
                        ToolTip.Tip="{Binding ToolTipText}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <!-- 标签组筛选行 -->
        <Border Classes="CkanSubtleCard" Padding="10,6" IsVisible="{Binding HasLabelService}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="标签组" Classes="CkanCaption" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding LabelFilters}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="CkanChip"
                          Classes.Active="{Binding IsActive}"
                          Command="{Binding ToggleCommand}"
                          Content="{Binding DisplayText}"
                          Margin="0,0,6,0"
                          ToolTip.Tip="{Binding ColorHex}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="清除标签筛选" Command="{Binding ResetLabelFiltersCommand}"
                    Classes="CkanSmall" ToolTip.Tip="取消全部标签组筛选" />
            <Button Content="管理标签..." Command="{Binding ManageLabelsCommand}"
                    Classes="CkanSmall" Margin="4,0,0,0"
                    ToolTip.Tip="打开标签组管理对话框 (F-23 / F-24)" />
          </StackPanel>
        </Border>

        <!-- 组合搜索面板（F-20/F-21）：DataContext 换成面板自身，展开状态与字段都在面板里 -->
        <modsViews:ModsSearchPanelView
            DataContext="{Binding SearchPanel}"
            Classes="view-layer"
            Classes.is-active="{Binding IsExpanded}"
            IsVisible="{Binding IsExpanded}" />
      </StackPanel>
    </Border>

    <!-- 主体区域：左侧表格 Card + 右侧详情 Card -->
    <Grid Grid.Row="2" ColumnDefinitions="*,8,400" Margin="0,12,0,0">

      <!-- 左侧模组列表 Card -->
      <Border Grid.Column="0" Classes="CkanCard" Padding="0" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="ModsGrid"
                    ItemsSource="{Binding Rows}"
                    SelectionChanged="OnRowSelectionChanged"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    CanUserResizeColumns="True"
                    HeadersVisibility="Column"
                    GridLinesVisibility="None"
                    RowHeight="{DynamicResource CkanRowHeight}"
                    BorderThickness="0"
                    Background="Transparent">
            <!-- 右键上下文菜单 -->
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="重新安装" Command="{Binding ReinstallSelectedCommand}" IsEnabled="{Binding CanReinstallSelected}" />
                <Separator />
                <MenuItem Header="复制模组标识符" Command="{Binding CopySelectedIdentifierCommand}" />
                <MenuItem Header="复制下载链接" Command="{Binding CopySelectedDownloadUrlCommand}" />
                <Separator />
                <MenuItem Header="打开主页" Command="{Binding OpenSelectedHomepageCommand}" IsEnabled="{Binding CanOpenHomepage}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <!-- 行首：已装状态指示条 + 变更集复选框 -->
              <DataGridTemplateColumn Header="选" Width="38" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Border Width="3" Margin="0,4" CornerRadius="1.5" HorizontalAlignment="Left"
                              Background="{DynamicResource CkanSuccessBrush}" IsVisible="{Binding IsInstalled}" />
                      <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                Click="OnSelectionCheckBoxClick"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip.Tip="加入 / 移出变更集（Space）" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- 名称 + 语义徽章 -->
              <DataGridTemplateColumn Header="名称" Width="280">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" />
                      <Border Classes="CkanBadge Accent" IsVisible="{Binding ShowUpdateBadge}">
                        <TextBlock Text="↑ 更新" />
                      </Border>
                      <Border Classes="CkanBadge" IsVisible="{Binding ShowAutoBadge}">
                        <TextBlock Text="自动" />
                      </Border>
                      <Border Classes="CkanBadge Info" IsVisible="{Binding ShowDependencyBadge}">
                        <TextBlock Text="依赖" />
                      </Border>
                      <Border Classes="CkanBadge Warning" IsVisible="{Binding ShowIncompatibleBadge}">
                        <TextBlock Text="⚠ 不兼容" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="已装" Width="90"
                                  Binding="{Binding InstalledVersionText}" />
              <DataGridTextColumn Header="最新" Width="90"
                                  Binding="{Binding LatestVersionText}" />
              <DataGridTextColumn Header="作者" Width="140"
                                  Binding="{Binding AuthorText}" />
              <DataGridTextColumn Header="下载量" Width="80"
                                  Binding="{Binding DownloadText}" />
              <DataGridTextColumn Header="标签" Width="180"
                                  Binding="{Binding TagsText}" />
              <DataGridTextColumn Header="大小" Width="70"
                                  Binding="{Binding SizeText}" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- 空状态 Card：图标 + 一句解释 + 当前过滤条件 + 主操作 -->
          <Border Classes="CkanEmptyStateCard" Margin="12" IsVisible="{Binding ShowEmptyState}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
              <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                      Background="{DynamicResource CkanAccentSubtleBrush}">
                <PathIcon Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="{DynamicResource CkanAccentBrush}"
                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
              </Border>
              <TextBlock Text="{Binding EmptyStateTitle}" HorizontalAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
              <TextBlock Text="{Binding EmptyStateHint}" Classes="CkanCaption"
                         TextWrapping="Wrap" TextAlignment="Center" />
              <ItemsControl ItemsSource="{Binding ActiveFilterChips}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="CkanBadge" Margin="3">
                      <TextBlock Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="清除过滤条件" Command="{Binding ResetFiltersCommand}"
                        Classes="CkanSecondary" />
                <Button Content="立即刷新" Command="{Binding RefreshRepositoriesCommand}"
                        Classes="CkanPrimary" IsVisible="{Binding CanRefreshFromEmptyState}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- 拖拽分割条 -->
      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

      <!-- 右侧模组详情面板（F-26）：历史选择 + 标签组快开 + 四页签富详情 -->
      <Border Grid.Column="2" Classes="CkanCard stagger-card">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" Margin="0,0,0,6">
            <Button Command="{Binding GoBackSelectionCommand}"
                    IsEnabled="{Binding CanGoBackSelection}"
                    Classes="CkanSmall"
                    Padding="8,4"
                    ToolTip.Tip="上一个选中模组">
              <PathIcon Width="11" Height="11" Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
            </Button>
            <Button Command="{Binding GoForwardSelectionCommand}"
                    IsEnabled="{Binding CanGoForwardSelection}"
                    Classes="CkanSmall"
                    Padding="8,4"
                    ToolTip.Tip="下一个选中模组">
              <PathIcon Width="11" Height="11" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
            </Button>
            <Button Classes="CkanChip"
                    Classes.Active="{Binding DetailIsFavourite}"
                    Content="收藏"
                    IsVisible="{Binding HasLabelService}"
                    Command="{Binding ToggleFavouriteCommand}"
                    ToolTip.Tip="加入 / 移出收藏标签组" />
            <Button Classes="CkanChip"
                    Classes.Active="{Binding DetailIsHidden}"
                    Content="隐藏"
                    IsVisible="{Binding HasLabelService}"
                    Command="{Binding ToggleHiddenCommand}"
                    ToolTip.Tip="加入 / 移出隐藏标签组（隐藏组默认不在其它过滤器里显示）" />
            <Button Classes="CkanChip"
                    Classes.Active="{Binding DetailIsHeld}"
                    Content="锁定版本"
                    IsVisible="{Binding HasLabelService}"
                    Command="{Binding ToggleHeldCommand}"
                    ToolTip.Tip="加入 / 移出锁定版本标签组（不参与升级）" />
          </WrapPanel>
          <TextBlock DockPanel.Dock="Bottom"
                     Text="{Binding StatusText}"
                     Classes="CkanCaption" Foreground="{DynamicResource CkanTextTertiaryBrush}"
                     TextWrapping="Wrap" Margin="0,6,0,0" />
          <dialogs:ModDetailsView DataContext="{Binding Details}" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- 底部状态与操作栏 -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,0">
      <TextBlock Grid.Column="0" Text="{Binding CountText}" Classes="CkanCaption" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" Classes="CkanCaption" Margin="14,0,0,0"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="CkanCaption" Margin="14,0,0,0"
                 Foreground="{DynamicResource CkanTextTertiaryBrush}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding DownloadSummary}" Classes="CkanCaption" VerticalAlignment="Center" />
        <Button Content="预览变更" Command="{Binding PreviewChangesCommand}"
                Classes="CkanSecondary" />
        <Button Content="去变更集" Command="{Binding ReviewChangesCommand}"
                Classes="CkanPrimary" />
      </StackPanel>
    </Grid>

    <!-- 进行中遮罩：无行时骨架屏，有行时进度条（同一时刻只有一个脉动元素） -->
    <Border Grid.RowSpan="3" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Border.Transitions>
      <Grid>
        <StackPanel IsVisible="{Binding !HasRows}" IsHitTestVisible="False"
                    app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="200" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasRows}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
