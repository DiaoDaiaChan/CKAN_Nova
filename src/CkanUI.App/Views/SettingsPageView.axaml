<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CkanUI.ViewModels.Pages"
             xmlns:st="using:CkanUI.ViewModels.Pages.Settings"
             xmlns:dlg="using:CkanUI.ViewModels.Dialogs"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="CkanUI.App.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

  <!-- 设置页：八组设置，改完即存（不再给每行一个「保存」按钮）。
       版式沿用 FluentAvalonia 官方的 SettingsExpander 组合：
       分组标题 + 每个设置项一个可折叠项（Header/Description 在左，编辑控件在 Footer）。 -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="{DynamicResource CkanPagePadding}">

    <!-- 页头：标题 + 状态 + 全局操作 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="改动逐项保存并读回校验；失败的项可以在顶部提示条里单独重试，放弃则回到已落盘的值。">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
        </StackPanel>
        <TextBlock Text="逐项保存的偏好设置" Classes="CkanCaption" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding StatusText}" Classes="CkanCaption" VerticalAlignment="Center" />
          <TextBlock Text="有未保存的修改" IsVisible="{Binding IsDirty}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanDangerBrush}" />
        </StackPanel>
      </StackPanel>

    </Grid>

    <!-- 全局操作：与其它页面同一条工具条位置，不再浮在标题右侧 -->
    <Border Grid.Row="1" Classes="CkanToolbar" Margin="0,0,0,8">
      <WrapPanel Orientation="Horizontal">
        <Button Content="重新读取" Classes="CkanSecondary" Margin="0,0,8,0"
                Command="{Binding ReloadCommand}" IsEnabled="{Binding !IsLoading}"
                ToolTip.Tip="重新读取 settings.json" />
        <Button Content="放弃修改" Classes="CkanGhost" Margin="0,0,8,0"
                Command="{Binding DiscardCommand}" IsEnabled="{Binding IsDirty}"
                ToolTip.Tip="丢弃当前未保存的改动，恢复为磁盘上的值" />
        <Button Content="重试失败项" Classes="CkanGhost" Margin="0,0,8,0"
                Command="{Binding RetryFailedCommand}" IsEnabled="{Binding HasRetryableFailures}"
                ToolTip.Tip="只重试上次保存失败的那些设置项" />
        <Button Content="打开配置目录" Classes="CkanGhost"
                Command="{Binding OpenConfigFolderCommand}"
                ToolTip.Tip="打开包含 settings.json 的目录" />
      </WrapPanel>
    </Border>

    <StackPanel Grid.Row="2" Spacing="8">

      <!-- 读取失败提示（不阻塞页面：其余项仍可编辑） -->
      <ui:FAInfoBar IsOpen="{Binding HasLoadError}" Severity="Error" IsClosable="False"
                    Title="设置读取失败" Message="{Binding LoadErrorText}" />

      <!-- 高对比度接管提示（20 篇 P-02）：外观行已置灰，这里说明「改了也不生效」的原因 -->
      <ui:FAInfoBar IsOpen="{Binding HasAppearanceLockNotice}" Severity="Warning" IsClosable="False"
                    Title="外观设置已被系统接管" Message="{Binding AppearanceLockNotice}" />

    </StackPanel>

    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="4" Margin="0,8,0,0">

        <TextBlock Text="正在读取设置…" IsVisible="{Binding IsLoading}" Classes="CkanCaption" Margin="0,0,0,8" />

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="st:SettingGroupViewModel">
              <StackPanel Spacing="6" Margin="0,0,0,18">

                <!-- 分组标题（官方设置页用 BodyStrong 抬一级标题层级） -->
                <TextBlock Text="{Binding Title}" Classes="CkanSectionTitle" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                           Classes="CkanCaption" TextWrapping="Wrap" Margin="0,0,0,4" />

                <!-- 标量设置项：一项一个可折叠项 -->
                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="st:SettingItemViewModel">
                      <ui:FASettingsExpander Header="{Binding DisplayName}"
                                             Description="{Binding Description}"
                                             IsEnabled="{Binding IsEnabled}"
                                             Classes="stagger-card"
                                             RenderTransform="translate(0px, 0px)"
                                             HorizontalAlignment="Stretch">
                        <ui:FASettingsExpander.Footer>
                          <StackPanel Spacing="6" HorizontalAlignment="Right">
                            <!-- 多行列表：固定三行高，不随密度压缩（否则编辑过滤器时看不全） -->
                            <TextBox Text="{Binding EditValue, Mode=TwoWay}"
                                     IsVisible="{Binding IsMultiline}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Width="380"
                                     CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                                     MinHeight="{Binding EditorMinHeight}" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                              <!-- 编辑器列固定宽度：不同 kind 的行左边缘才不会各自漂移 -->
                              <Grid Width="240" HorizontalAlignment="Right">
                              <!-- 文本 / 路径（单行） -->
                              <TextBox Text="{Binding EditValue, Mode=TwoWay}"
                                       IsVisible="{Binding IsSingleLine}"
                                       HorizontalAlignment="Stretch"
                                       CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                                       MinHeight="{DynamicResource CkanRowHeight}" />

                              <!-- 整数：数值微调器，自带范围约束与步进 -->
                              <ui:FANumberBox Value="{Binding NumericValue, Mode=TwoWay}"
                                              IsVisible="{Binding IsNumericKind}"
                                              Minimum="{Binding NumericMinimum}"
                                              Maximum="{Binding NumericMaximum}"
                                              SpinButtonPlacementMode="Inline"
                                              HorizontalAlignment="Stretch" />

                              <!-- 布尔开关：拨动即生效 -->
                              <ToggleSwitch IsVisible="{Binding IsBooleanKind}"
                                            IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                            OnContent="" OffContent=""
                                            HorizontalAlignment="Left" />

                              <!-- 单选 -->
                              <ComboBox ItemsSource="{Binding Choices}"
                                        SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                        IsVisible="{Binding IsChoiceKind}"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="{DynamicResource CkanCornerRadiusSmall}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="st:SettingChoice">
                                    <TextBlock Text="{Binding Label}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>

                              </Grid>

                              <!-- 行内辅助动作（如「打开目录」） -->
                              <Button Content="{Binding AuxiliaryLabel}"
                                      Classes="CkanGhost CkanSmall"
                                      Command="{Binding AuxiliaryCommand}"
                                      IsVisible="{Binding HasAuxiliaryAction}" />

                              <TextBlock Text="{Binding HintText}" IsVisible="{Binding HasHint}"
                                         VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"
                                         FontSize="{DynamicResource CkanFontSizeCaption}"
                                         Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                            </StackPanel>

                            <!-- 行内校验/保存失败 -->
                            <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource CkanDangerBrush}" FontSize="12" />
                            <TextBlock Text="{Binding FailureHint}" IsVisible="{Binding HasFailureHint}"
                                       TextWrapping="Wrap" HorizontalAlignment="Right"
                                       Classes="CkanCaption" />
                          </StackPanel>
                        </ui:FASettingsExpander.Footer>
                      </ui:FASettingsExpander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 认证令牌组（F-11）：增删 + 脱敏显示 -->
                <ContentControl Content="{Binding TokenEditor}" IsVisible="{Binding IsTokenGroup}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="st:AuthTokenEditorViewModel">
                      <StackPanel Spacing="8">

                        <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding NewHost, Mode=TwoWay}" PlaceholderText="主机名（如 spacedock.info）"
                                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}" />
                          <TextBox Grid.Column="1" Text="{Binding NewToken, Mode=TwoWay}" PasswordChar="●"
                                   PlaceholderText="令牌（输入时不回显）"
                                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}" />
                          <Button Grid.Column="2" Content="添加" Classes="CkanSecondary"
                                  Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" />
                        </Grid>

                        <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource CkanDangerBrush}" FontSize="12" />

                        <TextBlock Text="（尚未配置令牌）" IsVisible="{Binding IsEmpty}" Classes="CkanCaption" />

                        <ItemsControl ItemsSource="{Binding Tokens}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="st:AuthTokenItemViewModel">
                              <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="12" Margin="0,4">
                                <TextBlock Text="{Binding Host}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                  <TextBox Text="{Binding Token, Mode=TwoWay}" PasswordChar="●"
                                           PlaceholderText="输入新令牌以替换"
                                           CornerRadius="{DynamicResource CkanCornerRadiusSmall}" />
                                  <TextBlock Text="{Binding MaskedPreview}" Classes="CkanCaption" />
                                  <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                             Foreground="{DynamicResource CkanDangerBrush}" FontSize="12" />
                                  <TextBlock Text="{Binding FailureHint}" IsVisible="{Binding HasFailureHint}"
                                             TextWrapping="Wrap" Classes="CkanCaption" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                  <Button Content="保存" Classes="CkanSecondary"
                                          Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
                                  <Button Content="删除" Classes="CkanGhost"
                                          Command="{Binding RemoveCommand}" IsEnabled="{Binding !IsSaving}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- 诊断区（高级组，D-03）：只读清单 + 复制到剪贴板 -->
                <ContentControl Content="{Binding Diagnostics}" IsVisible="{Binding IsDiagnosticsGroup}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="st:SettingsDiagnosticsViewModel">
                      <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dlg:DiagnosticItem">
                              <Grid ColumnDefinitions="160,*" ColumnSpacing="12" MinHeight="{DynamicResource CkanRowHeight}">
                                <TextBlock Text="{Binding Name}" Classes="CkanCaption" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                          <Button Content="复制诊断信息" Classes="CkanGhost" Command="{Binding CopyCommand}" />
                          <TextBlock Text="{Binding CopyStatusText}" IsVisible="{Binding HasCopyStatus}"
                                     Classes="CkanCaption" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
