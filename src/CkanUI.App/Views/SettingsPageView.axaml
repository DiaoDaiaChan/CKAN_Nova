<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CkanUI.ViewModels.Pages"
             xmlns:shell="using:CkanUI.ViewModels"
             xmlns:st="using:CkanUI.ViewModels.Pages.Settings"
             xmlns:dlg="using:CkanUI.ViewModels.Dialogs"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="CkanUI.App.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

  <!-- 设置页：八组设置，改完即存（不再给每行一个「保存」按钮）。
       版式沿用 FluentAvalonia 官方的 SettingsExpander 组合：
       分组标题 + 每个设置项一个可折叠项（Header/Description 在左，编辑控件在 Footer）。 -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="{DynamicResource CkanPagePadding}">

    <!-- 页头：标题 + 状态 + 全局操作 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_SettingsPage_Header_Tip}">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
        </StackPanel>
        <TextBlock Text="{DynamicResource Ui_SettingsPage_Subtitle}" Classes="CkanCaption" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding StatusText}" Classes="CkanCaption" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource Ui_SettingsPage_UnsavedChanges}" IsVisible="{Binding IsDirty}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanDangerBrush}" />
        </StackPanel>
      </StackPanel>

    </Grid>

    <!-- 全局操作：与其它页面同一条工具条位置，不再浮在标题右侧 -->
    <Border Grid.Row="1" Classes="CkanToolbar" Margin="0,0,0,8">
      <WrapPanel Orientation="Horizontal">
        <Button Content="{DynamicResource Ui_SettingsPage_Reload}" Classes="CkanSecondary" Margin="0,0,8,0"
                Command="{Binding ReloadCommand}" IsEnabled="{Binding !IsLoading}"
                ToolTip.Tip="{DynamicResource Ui_SettingsPage_Reload_Tip}" />
        <Button Content="{DynamicResource Ui_Common_Unsaved_Discard}" Classes="CkanGhost" Margin="0,0,8,0"
                Command="{Binding DiscardCommand}" IsVisible="{Binding IsDirty}"
                ToolTip.Tip="{DynamicResource Ui_SettingsPage_Discard_Tip}" />
        <!-- 低频动作收进「更多」：工具条不再六个同权重按钮并排 -->
        <DropDownButton Classes="CkanGhost" Content="{DynamicResource Ui_Common_More}"
                        ToolTip.Tip="{DynamicResource Ui_Common_More}">
          <DropDownButton.Flyout>
            <ui:FAMenuFlyout Placement="BottomEdgeAlignedLeft">
              <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_SettingsPage_RetryFailed}"
                                  Command="{Binding RetryFailedCommand}"
                                  IsEnabled="{Binding HasRetryableFailures}" />
              <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_SettingsPage_OpenDir}"
                                  Command="{Binding OpenConfigFolderCommand}" />
              <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_NavRail_KspConfig}"
                                  Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).NavigateCommand}"
                                  CommandParameter="kspconfig" />
              <ui:FAMenuFlyoutSeparator />
              <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_SettingsPage_FirstRunWizard}"
                                  Command="{Binding OpenFirstRunWizardCommand}" />
            </ui:FAMenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </WrapPanel>
    </Border>

    <StackPanel Grid.Row="2" Spacing="8">

      <!-- 读取失败提示（不阻塞页面：其余项仍可编辑） -->
      <ui:FAInfoBar IsOpen="{Binding HasLoadError}" Severity="Error" IsClosable="False"
                    Title="{DynamicResource Ui_SettingsPage_LoadFailed_Title}" Message="{Binding LoadErrorText}" />

      <!-- 高对比度接管提示（20 篇 P-02）：外观行已置灰，这里说明「改了也不生效」的原因 -->
      <ui:FAInfoBar IsOpen="{Binding HasAppearanceLockNotice}" Severity="Warning" IsClosable="False"
                    Title="{DynamicResource Ui_SettingsPage_ThemeSystemManaged_Title}" Message="{Binding AppearanceLockNotice}" />

    </StackPanel>

    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
      <!-- 右侧留白：竖直滚动条会盖住 Auto 列尾部的 HintText / 辅助按钮，内容整体内缩 14px 兜住 -->
      <StackPanel Spacing="4" Margin="0,8,14,0">

        <TextBlock Text="{DynamicResource Ui_SettingsPage_Loading}" IsVisible="{Binding IsLoading}" Classes="CkanCaption" Margin="0,0,0,8" />

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="st:SettingGroupViewModel">
              <!-- 一组一张卡：行间只留发丝线，组与组之间靠卡片边界分开。
                   原来是整页连续发丝线，38 行连成一片，看不清哪几项属于同一组。 -->
              <Border Classes="CkanCard" Padding="0" Margin="0,0,0,16" ClipToBounds="True"
                      BorderBrush="{DynamicResource CkanBorderBrush}">
                <!-- stagger-card：入场的弹簧位移锚点（MotionSkeletonTests 要求本页保留该锚点） -->
                <StackPanel Classes="stagger-card" Spacing="0">

                  <!-- 组头：独立色带 + 左侧强调条 + 副标题字号，与下面 13px 常规字重的行标题拉开层级。
                       原来组头与行标题都是 SemiBold 主色文字、同底色，38 行扫下来分不清哪行是分组。 -->
                  <Border Padding="12,7,12,6" Background="{DynamicResource CkanAccentSubtleBrush}"
                          BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CkanBorderBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="3" Height="15" CornerRadius="1.5" VerticalAlignment="Center"
                              Background="{DynamicResource CkanAccentBrush}" />
                      <TextBlock Text="{Binding Title}" FontSize="{DynamicResource CkanFontSizeSubtitle}"
                                 FontWeight="Bold" Foreground="{DynamicResource CkanTextPrimaryBrush}"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                 Classes="CkanCaption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Description}" />
                    </StackPanel>
                  </Border>

                <!-- 标量设置项：一项一个可折叠项 -->
                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}"
                              Margin="12,0,12,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="st:SettingItemViewModel">
                      <!-- 紧凑行：左「名称 · 说明 · 提示」一行，右「240 编辑器 + 88 动作槽」，右边缘全部对齐。
                           动作槽即使没有按钮也占位，避免左右两行的控件各自漂移。 -->
                      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CkanHairlineBrush}"
                              Padding="0,3" IsEnabled="{Binding IsEnabled}">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                          <!-- 名称列固定 200：38 行的名称长短不一，若用横向 StackPanel，说明的起点会随名称宽度漂移，
                               整页看起来参差不齐。固定列宽后名称、说明、提示三列各自成一条竖线。 -->
                          <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="200,*,Auto"
                                Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding DisplayName}" />
                            <TextBlock Grid.Column="1" Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                       Classes="CkanCaption" Margin="10,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                            <TextBlock Grid.Column="2" Text="{Binding HintText}" IsVisible="{Binding HasHint}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource CkanFontSizeCaption}"
                                       Foreground="{DynamicResource CkanTextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HintText}" />
                          </Grid>
                          <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                              <!-- 编辑器列固定宽度：不同 kind 的行左边缘才不会各自漂移 -->
                              <Grid Width="240" HorizontalAlignment="Right">
                              <!-- 文本 / 路径（单行） -->
                              <TextBox Text="{Binding EditValue, Mode=TwoWay}"
                                       IsVisible="{Binding IsSingleLine}"
                                       HorizontalAlignment="Stretch"
                                       CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                                       MinHeight="{DynamicResource CkanRowHeight}" />

                              <!-- 整数：数值微调器，自带范围约束与步进 -->
                              <ui:FANumberBox Value="{Binding NumericValue, Mode=TwoWay}"
                                              IsVisible="{Binding IsNumericKind}"
                                              Minimum="{Binding NumericMinimum}"
                                              Maximum="{Binding NumericMaximum}"
                                              SpinButtonPlacementMode="Inline"
                                              HorizontalAlignment="Stretch" />

                              <!-- 布尔开关：拨动即生效；右对齐，开关右边缘与下拉/数字框对齐 -->
                              <ToggleSwitch IsVisible="{Binding IsBooleanKind}"
                                            IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                            OnContent="" OffContent=""
                                            HorizontalAlignment="Right" />

                              <!-- 单选 -->
                              <ComboBox ItemsSource="{Binding Choices}"
                                        SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                        IsVisible="{Binding IsChoiceKind}"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="{DynamicResource CkanCornerRadiusSmall}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="st:SettingChoice">
                                    <TextBlock Text="{Binding Label}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>

                              </Grid>
                            </StackPanel>

                          </StackPanel>

                          <!-- 辅助动作占固定 96px 槽位、按钮右对齐：没有按钮的行也留白，
                               所有动作按钮的右边缘落在同一条竖线上 -->
                          <Border Grid.Row="0" Grid.Column="2" Width="96" Margin="8,0,0,0"
                                  VerticalAlignment="Center">
                            <Button Content="{Binding AuxiliaryLabel}"
                                    Classes="CkanGhost CkanSmall"
                                    HorizontalAlignment="Right"
                                    Command="{Binding AuxiliaryCommand}"
                                    IsVisible="{Binding HasAuxiliaryAction}" />
                          </Border>

                          <!-- 多行列表与行内校验/失败横跨整行，不挤压右侧控件 -->
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="2" Margin="0,2,0,0">
                            <TextBox Text="{Binding EditValue, Mode=TwoWay}"
                                     IsVisible="{Binding IsMultiline}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     HorizontalAlignment="Stretch"
                                     CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                                     MinHeight="{Binding EditorMinHeight}" />
                            <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CkanDangerBrush}" FontSize="12" />
                            <TextBlock Text="{Binding FailureHint}" IsVisible="{Binding HasFailureHint}"
                                       TextWrapping="Wrap" Classes="CkanCaption" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 认证令牌组（F-11）：增删 + 脱敏显示 -->
                <ContentControl Content="{Binding TokenEditor}" IsVisible="{Binding IsTokenGroup}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="st:AuthTokenEditorViewModel">
                      <StackPanel Spacing="8" Margin="12,8,12,10">

                        <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding NewHost, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_SettingsPage_Host_Placeholder}"
                                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}" />
                          <TextBox Grid.Column="1" Text="{Binding NewToken, Mode=TwoWay}" PasswordChar="●"
                                   PlaceholderText="{DynamicResource Ui_SettingsPage_Token_Placeholder}"
                                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}" />
                          <Button Grid.Column="2" Content="{DynamicResource Ui_Common_Add}" Classes="CkanSecondary"
                                  Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" />
                        </Grid>

                        <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource CkanDangerBrush}" FontSize="12" />

                        <TextBlock Text="{DynamicResource Ui_SettingsPage_Token_None}" IsVisible="{Binding IsEmpty}" Classes="CkanCaption" />

                        <ItemsControl ItemsSource="{Binding Tokens}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="st:AuthTokenItemViewModel">
                              <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="12" Margin="0,4">
                                <TextBlock Text="{Binding Host}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                  <TextBox Text="{Binding Token, Mode=TwoWay}" PasswordChar="●"
                                           PlaceholderText="{DynamicResource Ui_SettingsPage_Token_Replace_Placeholder}"
                                           CornerRadius="{DynamicResource CkanCornerRadiusSmall}" />
                                  <TextBlock Text="{Binding MaskedPreview}" Classes="CkanCaption" />
                                  <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                             Foreground="{DynamicResource CkanDangerBrush}" FontSize="12" />
                                  <TextBlock Text="{Binding FailureHint}" IsVisible="{Binding HasFailureHint}"
                                             TextWrapping="Wrap" Classes="CkanCaption" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                  <Button Content="{DynamicResource Ui_Common_Save}" Classes="CkanSecondary"
                                          Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
                                  <Button Content="{DynamicResource Ui_Common_Delete}" Classes="CkanGhost"
                                          Command="{Binding RemoveCommand}" IsEnabled="{Binding !IsSaving}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- 诊断区（高级组，D-03）：只读清单 + 复制到剪贴板 -->
                <ContentControl Content="{Binding Diagnostics}" IsVisible="{Binding IsDiagnosticsGroup}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="st:SettingsDiagnosticsViewModel">
                      <StackPanel Spacing="8" Margin="12,8,12,10">
                        <ItemsControl ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dlg:DiagnosticItem">
                              <Grid ColumnDefinitions="160,*" ColumnSpacing="12" MinHeight="{DynamicResource CkanRowHeight}">
                                <TextBlock Text="{Binding Name}" Classes="CkanCaption" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                          <Button Content="{DynamicResource Ui_SettingsPage_CopyDiagnostics}" Classes="CkanGhost" Command="{Binding CopyCommand}" />
                          <TextBlock Text="{Binding CopyStatusText}" IsVisible="{Binding HasCopyStatus}"
                                     Classes="CkanCaption" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
