<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mods="clr-namespace:CkanUI.ViewModels.Dialogs.Mods;assembly=CkanUI.ViewModels"
             xmlns:tbl="using:CkanUI.Ui.Tables"
             x:Class="CkanUI.App.Views.ChangesPageView"
             x:CompileBindings="False"
             KeyDown="OnRootKeyDown">
  <!--
    变更集页（03 篇 §4 V-02 / 06 篇 UI-04）。
    约束（03 篇 §9 / §11）：本文件不写任何用户可见文案、不写颜色字面量；
    所有文案来自 ChangesPageViewModel，所有颜色/字号/圆角来自 Resources/Tokens.axaml 的 Ckan* token。
  -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}">

    <!-- 页头：与其它页保持同一范式（H1 + 一句副标题） -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Ui_Changeset_Title}" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <Button Classes="CkanHelper" VerticalAlignment="Center"
                ToolTip.Tip="{DynamicResource Ui_ChangesPage_Header_Tip}">
          <PathIcon Data="{StaticResource CkanIconHelp}" />
        </Button>
      </StackPanel>
      <TextBlock Text="{DynamicResource Ui_ChangesPage_Subtitle}"
                 Classes="CkanCaption" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 步骤条（03 篇 §4）：把"计算 → 核对 → 写入"压成一行，替代长句说明 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10"
                IsVisible="{Binding !ShowEmptyState}">
      <Border Classes="CkanStepDot"><TextBlock Text="1" /></Border>
      <TextBlock Text="{DynamicResource Ui_ChangesPage_StepCompute}" Classes="CkanStepLabel" />
      <TextBlock Classes="CkanStepArrow" />
      <Border Classes="CkanStepDot"><TextBlock Text="2" /></Border>
      <TextBlock Text="{DynamicResource Ui_ChangesPage_StepConflicts}" Classes="CkanStepLabel" />
      <TextBlock Classes="CkanStepArrow" />
      <Border Classes="CkanStepDot" Classes.Active="{Binding IsApplying}"><TextBlock Text="3" /></Border>
      <TextBlock Text="{DynamicResource Ui_ChangesPage_StepWrite}" Classes="CkanStepLabel" />
    </StackPanel>

    <!-- 摘要区（03 篇 §4 摘要块）：数量统计 + 预计下载体积 + 状态徽章；空集时整块收起，避免与空状态重复 -->
    <StackPanel Grid.Row="2" Spacing="12" IsVisible="{Binding !ShowEmptyState}">
    <Border Classes="CkanCard stagger-card" Padding="{DynamicResource CkanToolbarPadding}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding SummaryText}"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding DownloadText}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="CkanBadge Accent" Padding="8,3">
            <TextBlock Text="{Binding StateBadgeText}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    </StackPanel>

    <!-- 冲突区与游戏运行横幅共用一行（12 篇 F-33），纵向排列互不遮挡 -->
    <StackPanel Grid.Row="3">
    <!-- 游戏正在运行（12 篇 F-33）：不直接禁止，先给横幅与"仍要执行" -->
    <Border IsVisible="{Binding HasGameRunningWarning}"
            Margin="0,8,0,0" Padding="{DynamicResource CkanToolbarPadding}"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            Background="{DynamicResource CkanSurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource CkanWarningBrush}" BorderThickness="1">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding GameRunningTitle}"
                   FontSize="{DynamicResource CkanFontSizeSubtitle}"
                   Foreground="{DynamicResource CkanWarningBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding GameRunningHint}"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" TextWrapping="Wrap" />
        <Button Content="{Binding ApplyAnywayButtonText}"
                Command="{Binding ApplyAnywayCommand}"
                Classes="CkanSecondary"
                HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <!-- 冲突区（03 篇 §4 / §9）：红框 + 逐条文字 + 处理建议；有冲突时主按钮不可用 -->
    <Border IsVisible="{Binding HasConflicts}"
            AutomationProperties.Name="{Binding ConflictRegionName}"
            Margin="0,8,0,0" Padding="{DynamicResource CkanToolbarPadding}"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            Background="{DynamicResource CkanSurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding ConflictTitle}"
                   FontSize="{DynamicResource CkanFontSizeSubtitle}"
                   Foreground="{DynamicResource CkanDangerBrush}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding ConflictRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="mods:ConflictRowViewModel">
              <StackPanel Spacing="1" Margin="0,2">
                <TextBlock Text="{Binding Description}"
                           FontSize="{DynamicResource CkanFontSizeBody}"
                           Foreground="{DynamicResource CkanTextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ModuleText}"
                           IsVisible="{Binding HasModule}"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding ConflictHint}"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Button Content="{Binding ShowConflictDetailsButtonText}"
                  Command="{Binding ShowConflictDetailsCommand}"
                  Classes="CkanSecondary"
                  ToolTip.Tip="{DynamicResource Ui_ChangesPage_ConflictResolution_Tip}" />
          <Button Content="{Binding GoToModsButtonText}"
                  Command="{Binding GoToModsCommand}"
                  Classes="CkanSecondary" />
        </StackPanel>
      </StackPanel>
    </Border>
    </StackPanel>

    <!-- 告警区（不阻断执行，但必须显式可见） -->
    <Border Grid.Row="4" IsVisible="{Binding HasWarnings}"
            Margin="0,8,0,0" Padding="{DynamicResource CkanToolbarPadding}"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            Background="{DynamicResource CkanSurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource CkanWarningBrush}" BorderThickness="1">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding WarningTitle}"
                   FontSize="{DynamicResource CkanFontSizeSubtitle}"
                   Foreground="{DynamicResource CkanWarningBrush}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         FontSize="{DynamicResource CkanFontSizeBody}"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}"
                         TextWrapping="Wrap" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- 提示不是死胡同：缓存目录类提示才给可执行出口（E1），别的提示不误导 -->
        <TextBlock Text="{Binding WarningCacheHint}"
                   IsVisible="{Binding HasDownloadCacheWarning}"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" TextWrapping="Wrap" />
        <Button Content="{Binding OpenCacheSettingsButtonText}"
                Command="{Binding OpenDownloadCacheCommand}"
                IsVisible="{Binding HasDownloadCacheWarning}"
                Classes="CkanSecondary"
                HorizontalAlignment="Left" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- 执行结果 / 错误（03 篇 §9 双通道：颜色 + 文字） -->
    <StackPanel Grid.Row="5" Spacing="6" Margin="0,8,0,0">
      <Border IsVisible="{Binding HasResult}"
              Padding="{DynamicResource CkanToolbarPadding}"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
              Background="{DynamicResource CkanSurfaceBackgroundBrush}"
              BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="1">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding ResultTitle}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBlock Text="{Binding ResultText}"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border IsVisible="{Binding HasErrorText}"
              Padding="{DynamicResource CkanToolbarPadding}"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
              Background="{DynamicResource CkanSurfaceBackgroundBrush}"
              BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{Binding ErrorTitle}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanDangerBrush}" />
            <TextBlock Text="{Binding LastErrorText}"
                       FontSize="{DynamicResource CkanFontSizeBody}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                  Classes="CkanSmall"
                  Content="{Binding RetryButtonText}"
                  Command="{Binding RetryCommand}"
                  IsVisible="{Binding CanRetry}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- 明细表（03 篇 §4）：列头 + 虚拟化列表 + 空状态叠加 -->
    <Grid Grid.Row="6" RowDefinitions="Auto,*" Margin="0,8,0,0"
          IsVisible="{Binding !ShowEmptyState}">
      <Border Grid.Row="0" Padding="6,4"
              Background="{DynamicResource CkanStatusBarBackgroundBrush}"
              BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="3,*,80,190,64,80,72">
          <TextBlock Grid.Column="1" Text="{Binding ColumnNameHeader}" Classes="CkanCaption" />
          <TextBlock Grid.Column="2" Text="{Binding ColumnActionHeader}" Classes="CkanCaption" />
          <TextBlock Grid.Column="3" Text="{Binding ColumnVersionHeader}" Classes="CkanCaption" />
          <TextBlock Grid.Column="4" Text="{Binding ColumnOriginHeader}" Classes="CkanCaption" />
          <TextBlock Grid.Column="5" Text="{Binding ColumnSizeHeader}" Classes="CkanCaption"
                     HorizontalAlignment="Right" />
          <TextBlock Grid.Column="6" Text="{Binding ColumnOperationsHeader}" Classes="CkanCaption"
                     HorizontalAlignment="Right" />
        </Grid>
      </Border>

      <!-- 筛选/排序/拖动列宽由 ListTableTools 补：表头 7 列，首列状态条与末列操作按钮不参与。 -->
      <ListBox x:Name="ChangeList"
               Grid.Row="1"
               tbl:ListTableTools.Enabled="True"
               tbl:ListTableTools.Columns="-,Name,ActionText,FromVersionText~Data.FromVersion,OriginBadgeText,SizeText~Data.DownloadBytes,-"
               ItemsSource="{Binding Rows}"
               Background="{DynamicResource CkanSurfaceBackgroundBrush}"
               BorderThickness="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="3,*,80,190,64,80,72" Height="{DynamicResource CkanRowHeight}"
                  ToolTip.Tip="{Binding StatusText}">
              <!-- 卸载类动作的危险色竖条（配合"卸载"文字，不单靠颜色） -->
              <Border Grid.Column="0" Width="3" Margin="0,3"
                      CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                      Background="{DynamicResource CkanDangerBrush}"
                      IsVisible="{Binding IsRemoval}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}"
                         FontSize="{DynamicResource CkanFontSizeBody}" />
              <TextBlock Grid.Column="2" Text="{Binding ActionText}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}"
                         FontSize="{DynamicResource CkanFontSizeBody}" />
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding FromVersionText}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}"
                           FontSize="{DynamicResource CkanFontSizeBody}" />
                <TextBlock Text="→" VerticalAlignment="Center"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}"
                           FontSize="{DynamicResource CkanFontSizeBody}" />
                <TextBlock Text="{Binding ToVersionText}"
                           Foreground="{DynamicResource CkanTextPrimaryBrush}"
                           FontSize="{DynamicResource CkanFontSizeBody}" />
              </StackPanel>
              <!-- 来源徽章：用户 / 依赖 / 推荐 / 自动，四者只显示其一，文字始终可见 -->
              <Grid Grid.Column="4" VerticalAlignment="Center">
                <Border Classes="CkanBadge Accent"
                        HorizontalAlignment="Left" IsVisible="{Binding ShowUserBadge}">
                  <TextBlock Text="{Binding OriginBadgeText}" />
                </Border>
                <Border Classes="CkanBadge Success"
                        HorizontalAlignment="Left" IsVisible="{Binding ShowDependencyBadge}">
                  <TextBlock Text="{Binding OriginBadgeText}" />
                </Border>
                <Border Classes="CkanBadge Warning"
                        HorizontalAlignment="Left" IsVisible="{Binding ShowRecommendationBadge}">
                  <TextBlock Text="{Binding OriginBadgeText}" />
                </Border>
                <Border Classes="CkanBadge"
                        HorizontalAlignment="Left" IsVisible="{Binding ShowAutoBadge}">
                  <TextBlock Text="{Binding OriginBadgeText}" />
                </Border>
              </Grid>
              <TextBlock Grid.Column="5" Text="{Binding SizeText}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}"
                         FontSize="{DynamicResource CkanFontSizeBody}" />
              <Button Grid.Column="6" Margin="0,1" Padding="8,2"
                      Classes="CkanSmall"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      FontSize="{DynamicResource CkanFontSizeCaption}"
                      Content="{Binding RemoveButtonText}"
                      Click="OnRemoveItemClick"
                      ToolTip.Tip="{Binding StatusText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- 空状态（03 篇 §10）：页面级，不再嵌在明细表卡里（避免卡中卡） -->
    <Border Grid.Row="6" Margin="0,8,0,0"
            Classes="CkanEmptyStateCard Elevated stagger-card"
            IsVisible="{Binding ShowEmptyState}">
      <Grid>
        <Border Classes="CkanEmptyStateGlow" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="460">
          <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
            <PathIcon Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 5h-2v6l5 3 1-1.7-4-2.3V7z" />
          </Border>
          <TextBlock Text="{Binding EmptyStateTitle}"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyStateHint}"
                     Classes="CkanCaption"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <Button Content="{Binding RecomputeButtonText}" Command="{Binding RecomputeCommand}"
                  Classes="CkanSecondary"
                  HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 状态栏 + 主按钮（03 篇 §4：开始 / 取消 / 重新计算） -->
    <Border Grid.Row="7" Margin="0,8,0,0" Padding="{DynamicResource CkanToolbarPadding}"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            IsVisible="{Binding !ShowEmptyState}"
            Background="{DynamicResource CkanStatusBarBackgroundBrush}"
            AutomationProperties.Name="{Binding StatusRegionName}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
        <!-- 状态文字（双通道：状态徽章之外一定有可读文字）。整列自适应换行，不再被进度条横穿 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StateText}"
                   FontSize="{DynamicResource CkanFontSizeBody}"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Row="0" Grid.Column="1" Content="{Binding RecomputeButtonText}"
                Command="{Binding RecomputeCommand}"
                Classes="CkanSecondary"
                IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
                ToolTip.Tip="{Binding CancelHint}" />
        <Button Grid.Row="0" Grid.Column="2" Margin="6,0,0,0" Content="{Binding CancelButtonText}"
                Command="{Binding CancelCommand}"
                Classes="CkanDanger"
                IsVisible="{Binding IsApplying}" />
        <!-- 开始：Command 的 CanExecute=CanApply，冲突/失败态自动禁用（06 篇 UI-04 门禁）。
             失败态的「重试」只放在错误栏里（原因旁边那个），状态栏再放一个就是同一动作出现两次。 -->
        <Button Grid.Row="0" Grid.Column="3" Margin="6,0,0,0" Content="{Binding ApplyButtonText}"
                Command="{Binding ApplyCommand}"
                Classes="CkanPrimary"
                IsVisible="{Binding ShowApplyButton}"
                ToolTip.Tip="{Binding CancelHint}" />

        <!-- 进度行：单独一行，进度条不再压在文字上；执行结束后保留最终进度（E3） -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Spacing="4">
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsProgressVisible}">
            <TextBlock Grid.Column="0" Text="{Binding ProgressStageText}"
                       IsVisible="{Binding HasProgressStage}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                         Value="{Binding ExecutionPercent}"
                         VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding ProgressText}" MinWidth="46"
                       TextAlignment="Right" Margin="8,0,0,0"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       VerticalAlignment="Center" />
          </Grid>
          <!-- 后端实时文案：换行显示，不再被 CharacterEllipsis 截成半句 -->
          <TextBlock Text="{Binding StatusText}"
                     IsVisible="{Binding HasStatusText}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
