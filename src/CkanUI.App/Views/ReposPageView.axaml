<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.Ui.Theming"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="CkanUI.App.Views.ReposPageView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
    </Style>

    <!-- 选中行左侧 3px 强调条：沿用 NavList 的 navIndicator 做法，其它列表要自己写同类样式 -->
    <Style Selector="Rectangle.SelectionBar">
      <Setter Property="Width" Value="3" />
      <Setter Property="RadiusX" Value="1.5" />
      <Setter Property="RadiusY" Value="1.5" />
      <Setter Property="Fill" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="2,6" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected Rectangle.SelectionBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- 仓库管理页：工具条 + 有序仓库表 + 新增表单 + 状态栏。
       全部颜色走 Tokens.axaml 的语义 token。 -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui_ReposPage_Title}" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_ReposPage_Header_Tip}">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
        </StackPanel>
        <TextBlock Text="{DynamicResource Ui_ReposPage_Subtitle}"
                   Classes="CkanCaption" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Column="1" Classes="CkanBadge" VerticalAlignment="Center">
        <TextBlock Text="{Binding CountText}" />
      </Border>
    </Grid>

    <!--
      工具条：原先 8 个同权重矩形按钮一字铺开，用户一眼看不出主任务。
      现在收敛成「1 主 + 2 常用 + 1 个「更多」下拉」：高频的添加/刷新留下，
      排序与恢复这类低频且不可逆的操作收进官方 FAMenuFlyout，误触率也一起降下来。
    -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button Content="{DynamicResource Ui_ReposPage_AddRepo}" Command="{Binding BeginAddCommand}"
                  Classes="CkanPrimary"
                  IsEnabled="{Binding CanEdit}"
                  ToolTip.Tip="{DynamicResource Ui_ReposPage_AddRepo_Tip}" />
          <Button Content="{DynamicResource Ui_ReposPage_RefreshAll}" Command="{Binding RefreshAllCommand}"
                  Classes="CkanSecondary"
                  IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="{DynamicResource Ui_ReposPage_RefreshAll_Tip}" />
          <Button Content="{DynamicResource Ui_ReposPage_RefreshThis}" Command="{Binding RefreshSelectedCommand}"
                  Classes="CkanSecondary"
                  IsEnabled="{Binding CanRefreshSelected}"
                  ToolTip.Tip="{DynamicResource Ui_ReposPage_RefreshThis_Tip}" />

          <Button Content="{DynamicResource Ui_Common_More}" Classes="CkanSecondary" Margin="4,0,0,0"
                  ToolTip.Tip="{DynamicResource Ui_ReposPage_AdvancedActions_Tip}">
            <Button.Flyout>
              <ui:FAMenuFlyout Placement="Bottom">
                <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_ReposPage_MoveUpPriority}" IconSource="Up"
                                     Command="{Binding MoveUpCommand}"
                                     IsEnabled="{Binding CanMoveUpSelected}" />
                <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_ReposPage_MoveDownPriority}" IconSource="Down"
                                     Command="{Binding MoveDownCommand}"
                                     IsEnabled="{Binding CanMoveDownSelected}" />
                <ui:FAMenuFlyoutSeparator />
                <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_ReposPage_ReloadRegistry}" IconSource="Refresh"
                                     Command="{Binding ReloadCommand}"
                                     IsEnabled="{Binding IsIdle}" />
                <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_ReposPage_RestoreDefaults}" IconSource="Undo"
                                     Command="{Binding RestoreDefaultsCommand}"
                                     IsEnabled="{Binding IsIdle}" />
                <ui:FAMenuFlyoutSeparator />
                <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_ReposPage_RemoveSelected}" IconSource="Delete"
                                     Command="{Binding RemoveCommand}"
                                     IsEnabled="{Binding CanRemoveSelected}" />
              </ui:FAMenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Content="{DynamicResource Ui_ReposPage_RestoreDefaultSources}"
                  Command="{Binding RestoreDefaultsCommand}"
                  Classes="CkanGhost"
                  IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="{DynamicResource Ui_ReposPage_RestoreDefaults_Tip}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 新增表单 Card -->
    <Border Grid.Row="2" Margin="0,12,0,0" Classes="CkanCard"
            BorderBrush="{DynamicResource CkanAccentBrush}"
            IsVisible="{Binding HasForm}">
      <StackPanel Spacing="12">
        <TextBlock Text="{DynamicResource Ui_ReposPage_AddRepo}"
                   FontSize="{DynamicResource CkanFontSizeSubtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource Ui_ReposPage_RepoName}" FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBox Text="{Binding Form.Name, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_ReposPage_RepoName_Placeholder}"
                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                   Padding="10,6" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource Ui_ReposPage_RepoUrl}" FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBox Text="{Binding Form.Uri, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource Ui_ReposPage_RepoUrl_Placeholder}"
                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                   Padding="10,6" />
        </StackPanel>
        <TextBlock Text="{Binding Form.ValidationText}"
                   IsVisible="{Binding Form.HasValidation}"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanDangerBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{DynamicResource Ui_Common_Add}" Command="{Binding AddCommand}"
                  Classes="CkanPrimary" Padding="18,6" />
          <Button Content="{DynamicResource Ui_Common_Cancel}" Command="{Binding CancelAddCommand}"
                  Classes="CkanSecondary" Padding="14,6" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 页面级错误条 -->
    <Border Grid.Row="3" Margin="0,12,0,0" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     FontWeight="Medium"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                     IsVisible="{Binding HasErrorDetail}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanDangerBrush}" Opacity="0.85" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="{DynamicResource Ui_Common_Retry}" Command="{Binding RefreshAllCommand}"
                  Classes="CkanSmall"
                  ToolTip.Tip="{DynamicResource Ui_ReposPage_RefreshAll_Tip}" />
          <Button Content="{DynamicResource Ui_Cmd_Shortcuts_Close}" Command="{Binding ClearErrorCommand}"
                  Classes="CkanSmall" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 仓库表 Card -->
    <Border Grid.Row="4" Margin="0,12,0,0"
            Classes="stagger-card"
            Background="{DynamicResource CkanCardBackgroundBrush}"
            BorderBrush="{DynamicResource CkanCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <!-- 列头 -->
        <Border Grid.Row="0" Padding="14,10"
                IsVisible="{Binding HasRows}"
                Background="{DynamicResource CkanSubtleBackgroundBrush}"
                BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,2*,80,140,100">
            <TextBlock Grid.Column="0" Text="{DynamicResource Ui_Common_Name}" Classes="CkanCaption" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Ui_ReposPage_RepoUrl}" Classes="CkanCaption" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Common_Priority}" Classes="CkanCaption" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="{DynamicResource Ui_ReposPage_LastRefreshed}" Classes="CkanCaption" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="{DynamicResource Ui_Common_Status}" Classes="CkanCaption" FontWeight="SemiBold" />
          </Grid>
        </Border>

        <!-- 仓库行 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent"
                 Padding="4"
                 IsVisible="{Binding HasRows}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,2*,80,140,100" MinHeight="{DynamicResource CkanRowHeight}">
                <Rectangle Grid.ColumnSpan="5" Classes="SelectionBar" />
                <!-- 仓库名放在横向 StackPanel 里会以无限宽测量，TextTrimming 不生效 → 换成两列 Grid。 -->
                <Grid Grid.Column="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding DisplayName}"
                             VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,8,0"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <Border Grid.Column="1" Classes="CkanBadge Accent" IsVisible="{Binding ShowDefaultBadge}">
                    <TextBlock Text="{Binding DefaultText}" />
                  </Border>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Uri}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding PriorityText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding UpdatedText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding StatusText}"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <Border Classes="CkanBadge Warning" IsVisible="{Binding NeedsRefresh}"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{DynamicResource Ui_ReposPage_RefreshRequired}" />
                  </Border>
                  <TextBlock Text="{Binding FailureText}" IsVisible="{Binding HasFailure}"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding FailureText}"
                             Foreground="{DynamicResource CkanDangerBrush}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <Border Grid.Row="1" IsVisible="{Binding ShowEmptyState}"
                Classes="CkanEmptyStateCard Flat" Margin="0">
          <Grid>
            <Border Classes="CkanEmptyStateGlow" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" MaxWidth="640">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
                  <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
                </Border>
                <TextBlock Text="{Binding EmptyStateTitle}"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource CkanFontSizeHeading}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                <TextBlock Text="{Binding EmptyStateHint}" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="{DynamicResource CkanFontSizeBody}"
                           MaxWidth="420"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              </StackPanel>

              <!-- 一键预置官方安全源，是这条空状态里唯一值得当主按钮的动作 -->
              <Grid ColumnDefinitions="*,12,*">
                <Button Grid.Column="0" Classes="CkanGuide" Command="{Binding RestoreDefaultsCommand}"
                        ToolTip.Tip="{DynamicResource Ui_ReposPage_RestoreOfficial_Tip}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="7">
                      <Border Classes="CkanIconTile">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                      </Border>
                      <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_ReposPage_OfficialSourceTitle}" />
                      <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_ReposPage_OfficialSourceSubtitle}" />
                    </StackPanel>
                    <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="10,0,0,0"
                              Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
                  </Grid>
                </Button>
                <Button Grid.Column="2" Classes="CkanGuide" Command="{Binding BeginAddCommand}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="7">
                      <Border Classes="CkanIconTile Muted">
                        <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                      </Border>
                      <TextBlock Classes="GuideTitle" Text="{DynamicResource Ui_ReposPage_CustomSourceTitle}" />
                      <TextBlock Classes="GuideDesc" Text="{DynamicResource Ui_ReposPage_CustomSourceSubtitle}" />
                    </StackPanel>
                    <PathIcon Grid.Column="1" Classes="GuideArrow" Margin="10,0,0,0"
                              Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" />
                  </Grid>
                </Button>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!--
      状态条：原来两段裸灰文字直接贴在窗口边缘，像 CLI 提示符。
      现在收进 CkanStatusStrip 胶囊，选中项与最近一次操作分成两段，中间一条竖线断开。
    -->
    <Border Grid.Row="5" Classes="CkanStatusStrip" Margin="0,12,0,0"
            HorizontalAlignment="Stretch" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                    Width="12" Height="12" Margin="0,0,6,0"
                    Foreground="{DynamicResource CkanTextTertiaryBrush}"
                    VerticalAlignment="Center" />
          <TextBlock Text="{Binding SelectedDetailText}"
                     TextTrimming="CharacterEllipsis" MaxWidth="520" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Classes="Divider" />
          <TextBlock Text="{Binding StatusText}"
                     Classes="Value"
                     TextTrimming="CharacterEllipsis" MaxWidth="460" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 进行中遮罩：无数据走首屏骨架屏，有数据走进度条（同一次 IsBusy 里二选一） -->
    <Border Grid.RowSpan="6" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Grid>
        <!-- 首屏骨架屏：整块一起脉动（同一时刻只有一个脉动元素），动效关闭时保持静态 -->
        <StackPanel IsVisible="{Binding !HasRows}" IsHitTestVisible="False"
                    app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="180" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasRows}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="14" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>