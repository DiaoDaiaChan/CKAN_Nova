<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.App.Theming"
             x:Class="CkanUI.App.Views.ReposPageView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
    </Style>

    <!-- 选中行左侧 3px 强调条：沿用 NavList 的 navIndicator 做法，其它列表要自己写同类样式 -->
    <Style Selector="Rectangle.SelectionBar">
      <Setter Property="Width" Value="3" />
      <Setter Property="RadiusX" Value="1.5" />
      <Setter Property="RadiusY" Value="1.5" />
      <Setter Property="Fill" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="2,6" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected Rectangle.SelectionBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- 仓库管理页：工具条 + 有序仓库表 + 新增表单 + 状态栏。
       全部颜色走 Tokens.axaml 的语义 token。 -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="20,16"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="仓库管理" Classes="CkanPageTitle" />
        <TextBlock Text="越靠上的仓库优先级越高，同名模组以高优先级仓库的元数据为准。"
                   Classes="CkanCaption"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Column="1" Classes="CkanBadge" VerticalAlignment="Center">
        <TextBlock Text="{Binding CountText}" />
      </Border>
    </Grid>

    <!-- 工具条 Card -->
    <Border Grid.Row="1" Classes="CkanToolbar">
      <WrapPanel Orientation="Horizontal">
        <Button Content="添加仓库" Command="{Binding BeginAddCommand}"
                Classes="CkanPrimary"
                IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"
                ToolTip.Tip="填写名称与索引地址后加入列表" />
        <Button Content="移除" Command="{Binding RemoveCommand}"
                Classes="CkanSecondary"
                IsEnabled="{Binding CanRemoveSelected}" Margin="0,0,8,0"
                ToolTip.Tip="从列表移除选中的仓库（至少要保留一个）" />
        <Button Content="上移" Command="{Binding MoveUpCommand}"
                Classes="CkanSecondary"
                IsEnabled="{Binding CanMoveUpSelected}" Margin="0,0,4,0"
                ToolTip.Tip="提高选中仓库的优先级" />
        <Button Content="下移" Command="{Binding MoveDownCommand}"
                Classes="CkanSecondary"
                IsEnabled="{Binding CanMoveDownSelected}" Margin="0,0,8,0"
                ToolTip.Tip="降低选中仓库的优先级" />
        <Button Content="刷新此仓库" Command="{Binding RefreshSelectedCommand}"
                Classes="CkanSecondary"
                IsEnabled="{Binding CanRefreshSelected}" Margin="0,0,8,0"
                ToolTip.Tip="只重新下载选中仓库的索引" />
        <Button Content="刷新全部" Command="{Binding RefreshAllCommand}"
                Classes="CkanSecondary"
                IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"
                ToolTip.Tip="重新下载全部仓库的索引" />
        <Button Content="恢复默认" Command="{Binding RestoreDefaultsCommand}"
                Classes="CkanSecondary"
                IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"
                ToolTip.Tip="替换为官方默认仓库列表（需要联网）" />
        <Button Content="重新读取" Command="{Binding ReloadCommand}"
                Classes="CkanSecondary"
                IsEnabled="{Binding IsIdle}"
                ToolTip.Tip="重新读取本地注册表中的仓库列表" />
      </WrapPanel>
    </Border>

    <!-- 新增表单 Card -->
    <Border Grid.Row="2" Margin="0,12,0,0" Classes="CkanCard"
            BorderBrush="{DynamicResource CkanAccentBrush}"
            IsVisible="{Binding HasForm}">
      <StackPanel Spacing="12">
        <TextBlock Text="添加仓库"
                   FontSize="{DynamicResource CkanFontSizeSubtitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        <StackPanel Spacing="4">
          <TextBlock Text="仓库名称" FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBox Text="{Binding Form.Name, Mode=TwoWay}" PlaceholderText="例如 KSP-CKAN-mirror"
                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                   Padding="10,6" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="索引地址" FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBox Text="{Binding Form.Uri, Mode=TwoWay}"
                   PlaceholderText="例如 https://raw.githubusercontent.com/.../repositories.json"
                   CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                   Padding="10,6" />
        </StackPanel>
        <TextBlock Text="{Binding Form.ValidationText}"
                   IsVisible="{Binding Form.HasValidation}"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanDangerBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="添加" Command="{Binding AddCommand}"
                  Background="{DynamicResource CkanAccentBrush}"
                  Foreground="{DynamicResource CkanAccentTextBrush}"
                  CornerRadius="{DynamicResource CkanCornerRadiusSmall}" Padding="16,6" />
          <Button Content="取消" Command="{Binding CancelAddCommand}"
                  CornerRadius="{DynamicResource CkanCornerRadiusSmall}" Padding="14,6" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 页面级错误条 -->
    <Border Grid.Row="3" Margin="0,12,0,0" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     FontWeight="Medium"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                     IsVisible="{Binding HasErrorDetail}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanDangerBrush}" Opacity="0.85" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="重试" Command="{Binding RefreshAllCommand}"
                  Classes="CkanSmall"
                  ToolTip.Tip="重新下载全部仓库的索引" />
          <Button Content="关闭" Command="{Binding ClearErrorCommand}"
                  Classes="CkanSmall" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 仓库表 Card -->
    <Border Grid.Row="4" Margin="0,12,0,0"
            Background="{DynamicResource CkanCardBackgroundBrush}"
            BorderBrush="{DynamicResource CkanCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <!-- 列头 -->
        <Border Grid.Row="0" Padding="14,10"
                Background="{DynamicResource CkanSubtleBackgroundBrush}"
                BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,2*,80,140,100">
            <TextBlock Grid.Column="0" Text="名称" Classes="CkanCaption" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="索引地址" Classes="CkanCaption" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="优先级" Classes="CkanCaption" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="上次刷新" Classes="CkanCaption" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="状态" Classes="CkanCaption" FontWeight="SemiBold" />
          </Grid>
        </Border>

        <!-- 仓库行 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent"
                 Padding="4"
                 IsVisible="{Binding HasRows}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,2*,80,140,100" MinHeight="{DynamicResource CkanRowHeight}">
                <Rectangle Grid.ColumnSpan="5" Classes="SelectionBar" />
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" FontWeight="Medium"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <Border Classes="CkanBadge Accent" IsVisible="{Binding ShowDefaultBadge}">
                    <TextBlock Text="{Binding DefaultText}" />
                  </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Uri}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding PriorityText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding UpdatedText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding StatusText}"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <Border Classes="CkanBadge Warning" IsVisible="{Binding NeedsRefresh}"
                          HorizontalAlignment="Left">
                    <TextBlock Text="需刷新" />
                  </Border>
                  <TextBlock Text="{Binding FailureText}" IsVisible="{Binding HasFailure}"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding FailureText}"
                             Foreground="{DynamicResource CkanDangerBrush}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <Border Grid.Row="1" IsVisible="{Binding ShowEmptyState}"
                Classes="CkanEmptyStateCard" Margin="12">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="480">
            <!-- 现代空状态轻量矢量图标 -->
            <Border Width="56" Height="56" CornerRadius="28"
                    Background="{DynamicResource CkanSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center">
              <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                        Width="26" Height="26"
                        Foreground="{DynamicResource CkanTextTertiaryBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="{Binding EmptyStateTitle}"
                         HorizontalAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeSubtitle}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="{Binding EmptyStateHint}" TextWrapping="Wrap" TextAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeBody}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,4,0,0">
              <Button Content="恢复默认" Command="{Binding RestoreDefaultsCommand}"
                      Classes="CkanPrimary" Padding="16,7"
                      ToolTip.Tip="替换为官方默认仓库列表（需要联网）" />
              <Button Content="添加仓库" Command="{Binding BeginAddCommand}"
                      Classes="CkanSecondary" Padding="16,7" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 状态栏 -->
    <Grid Grid.Row="5" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
      <TextBlock Grid.Column="0" Text="{Binding SelectedDetailText}"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="12,0,0,0"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Grid>

    <!-- 进行中遮罩：无数据走首屏骨架屏，有数据走进度条（同一次 IsBusy 里二选一） -->
    <Border Grid.RowSpan="6" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Grid>
        <!-- 首屏骨架屏：整块一起脉动（同一时刻只有一个脉动元素），动效关闭时保持静态 -->
        <StackPanel IsVisible="{Binding !HasRows}" IsHitTestVisible="False"
                    app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="180" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasRows}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="14" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>