<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:CkanUI.App.Converters"
             xmlns:thumb="using:CkanUI.Ui.Converters"
             xmlns:home="using:CkanUI.ViewModels.Pages.Home"
             x:Class="CkanUI.App.Views.HomePageView"
             x:CompileBindings="False">

  <UserControl.Resources>
    <conv:NavGlyphToGeometryConverter x:Key="NavGlyph" />
    <thumb:PathToThumbnailConverter x:Key="ScreenshotThumb" />
    <!-- 概览区的两个动作图标：与 NavGlyphToGeometryConverter 同一套 24×24 路径，直接写成资源省一次查表 -->
    <StreamGeometry x:Key="HomeIconLaunch">M8 5v14l11-7z</StreamGeometry>
    <StreamGeometry x:Key="HomeIconArrow">M8 4l9 8-9 8z</StreamGeometry>
    <StreamGeometry x:Key="HomeIconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
    <StreamGeometry x:Key="HomeIconGrip">M8 6h2v2H8zm0 5h2v2H8zm0 5h2v2H8zm6-12h2v2h-2zm0 5h2v2h-2zm0 5h2v2h-2z</StreamGeometry>
    <StreamGeometry x:Key="HomeIconRemove">M6 6l12 12M18 6L6 18</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 部件外框：统一清退私有 HomeWidget，对齐系统标准 CkanCard + 拖拽交互反馈 -->
    <Style Selector="Border.CkanCard.Dragging">
      <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style Selector="Border.HomeWidgetGrip">
      <Setter Property="Cursor" Value="SizeAll" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,4,10,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    </Style>
    <Style Selector="Border.HomeWidgetGrip:pointerover">
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    </Style>

    <Style Selector="Button.HomeWidgetAction">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
    </Style>

    <!-- 截图卡片：统一继承 CkanCard 交互卡规范，支持指针悬停反馈与圆角裁剪 -->
    <Style Selector="Border.ScreenshotCard">
      <Setter Property="Width" Value="240" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.ScreenshotCard:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
    </Style>
    <Style Selector="Border.ScreenshotCard Image">
      <Setter Property="Height" Value="150" />
      <Setter Property="Stretch" Value="UniformToFill" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- 实例概览：统一为标准 CkanCard + 结构化 Grip 顶栏 + 状态圆点规范 -->
    <DataTemplate DataType="home:InstanceHomeWidgetViewModel">
      <Border Classes="CkanCard HomeWidget stagger-card" Classes.Dragging="{Binding IsDragging}" Margin="0,0,0,12">
        <StackPanel Spacing="10">
          <Border Classes="HomeWidgetGrip" ToolTip.Tip="{DynamicResource Ui_Home_WidgetDragTip}"
                  PointerPressed="OnWidgetDragPressed" PointerMoved="OnWidgetDragMoved"
                  PointerReleased="OnWidgetDragReleased" PointerCaptureLost="OnWidgetDragCaptureLost">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource HomeIconGrip}" Width="14" Height="14"
                        Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Classes="CkanSectionTitle" VerticalAlignment="Center" />
                <Border Classes="CkanBadge" IsVisible="{Binding IsPlugin}" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui_Plugin_Badge}" />
                </Border>
              </StackPanel>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" IsVisible="{Binding Page.HasInstance}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 状态指示圆点：标明当前实例就绪态（对齐图 3 规范） -->
                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource CkanSuccessBrush}"
                        VerticalAlignment="Center" Margin="0,0,2,0" />
                <TextBlock Text="{DynamicResource Ui_NavRail_Instances}" Classes="CkanEyebrow" VerticalAlignment="Center" />
                <Border Classes="CkanBadge Accent" IsVisible="{Binding Page.ShowDefaultBadge}" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui_Home_DefaultBadge}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Page.InstanceName}" Classes="CkanTitle" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Text="{Binding Page.InstanceVersionText}" Classes="CkanCaption" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Page.ModuleCountText}" Classes="CkanCaption" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Page.GameDirText}" Classes="CkanCaption" VerticalAlignment="Center"
                           MaxWidth="460" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Page.GameDirText}" />
              </StackPanel>
              <TextBlock Text="{DynamicResource Ui_Home_LockedHint}" Classes="CkanCaption"
                         Foreground="{DynamicResource CkanWarningBrush}"
                         TextWrapping="Wrap" IsVisible="{Binding Page.ShowLockedHint}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" IsVisible="{Binding Page.ShowNoInstance}">
              <TextBlock Text="{DynamicResource Ui_Home_NoInstanceTitle}" Classes="CkanTitle" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource Ui_Home_NoInstanceSubtitle}" Classes="CkanCaption" TextWrapping="Wrap" MaxWidth="620" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="16,0,0,0">
              <Button Classes="CkanPrimary" Command="{Binding Page.LaunchGameCommand}" IsVisible="{Binding Page.HasInstance}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource HomeIconLaunch}" Width="14" Height="14" />
                  <TextBlock Text="{DynamicResource Ui_Home_LaunchGame}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="CkanSecondary" Command="{Binding Page.OpenGameFolderCommand}" IsVisible="{Binding Page.HasInstance}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource HomeIconFolder}" Width="14" Height="14" />
                  <TextBlock Text="{DynamicResource Ui_Home_OpenGameFolder}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="CkanSecondary" Command="{Binding Page.NavigateCommand}" CommandParameter="kspconfig" IsVisible="{Binding Page.HasInstance}"
                      ToolTip.Tip="{DynamicResource Ui_NavRail_KspConfig}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource CkanIconSettings}" Width="14" Height="14" />
                  <TextBlock Text="{DynamicResource Ui_NavRail_KspConfig}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="CkanSecondary" Command="{Binding Page.NavigateCommand}" CommandParameter="instances">
                <TextBlock Text="{DynamicResource Ui_Home_SwitchInstance}" VerticalAlignment="Center" />
              </Button>
            </StackPanel>

            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="CkanSecondary"
                    Margin="0,12,0,0" HorizontalAlignment="Left"
                    IsVisible="{Binding Page.ShowNoInstance}"
                    Command="{Binding Page.NavigateCommand}" CommandParameter="instances">
              <TextBlock Text="{DynamicResource Ui_Home_GoToInstances}" VerticalAlignment="Center" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 快捷操作：统一为标准 CkanCard + CkanGuide 交互卡片 + CkanChip 交互胶囊 -->
    <DataTemplate DataType="home:QuickActionsHomeWidgetViewModel">
      <Border Classes="CkanCard HomeWidget stagger-card" Classes.Dragging="{Binding IsDragging}" Margin="0,0,0,12">
        <StackPanel Spacing="10">
          <Border Classes="HomeWidgetGrip" ToolTip.Tip="{DynamicResource Ui_Home_WidgetDragTip}"
                  PointerPressed="OnWidgetDragPressed" PointerMoved="OnWidgetDragMoved"
                  PointerReleased="OnWidgetDragReleased" PointerCaptureLost="OnWidgetDragCaptureLost">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Grid.Column="0" Data="{StaticResource HomeIconGrip}" Width="14" Height="14"
                        Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="CkanSectionTitle" Margin="6,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- 主操作卡：统一清退私有 HomeCard Hero，全面采用系统标准交互卡 CkanGuide（具备光圈、Lift 动效、触摸反馈） -->
          <ItemsControl ItemsSource="{Binding Page.PrimaryActions}" Margin="0,0,-12,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="CkanGuide" Command="{Binding Command}" ToolTip.Tip="{Binding Description}" Margin="0,0,12,0">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Classes="CkanIconTile">
                      <PathIcon Data="{Binding Glyph, Converter={StaticResource NavGlyph}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" Classes="GuideTitle" FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Classes="GuideDesc" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <PathIcon Grid.Column="2" Classes="GuideArrow" Data="{StaticResource HomeIconArrow}" Width="12" Height="12"
                              VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 次级入口：统一清退私有 HomeCard Chip，采用系统标准 CkanChip 交互胶囊 -->
          <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding Page.PageActions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="CkanChip" Command="{Binding Command}" Margin="0,0,8,0" ToolTip.Tip="{Binding Description}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{Binding Glyph, Converter={StaticResource NavGlyph}}" Width="14" Height="14"
                                VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Page.ToolActions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="CkanChip" Command="{Binding Command}" Margin="0,0,8,0" ToolTip.Tip="{Binding Description}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{Binding Glyph, Converter={StaticResource NavGlyph}}" Width="14" Height="14"
                                VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 最近截图：统一为标准 CkanCard 容器与标准交互截图卡 -->
    <DataTemplate DataType="home:ScreenshotsHomeWidgetViewModel">
      <Border Classes="CkanCard HomeWidget stagger-card" Classes.Dragging="{Binding IsDragging}" Margin="0,0,0,12">
        <StackPanel Spacing="10">
          <Border Classes="HomeWidgetGrip" ToolTip.Tip="{DynamicResource Ui_Home_WidgetDragTip}"
                  PointerPressed="OnWidgetDragPressed" PointerMoved="OnWidgetDragMoved"
                  PointerReleased="OnWidgetDragReleased" PointerCaptureLost="OnWidgetDragCaptureLost">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource HomeIconGrip}" Width="14" Height="14"
                        Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Classes="CkanSectionTitle" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Page.ScreenshotCountText}" Classes="CkanCaption" VerticalAlignment="Center"
                           IsVisible="{Binding Page.ShowScreenshotRail}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="CkanSecondary" Command="{Binding Page.OpenScreenshotsFolderCommand}"
                        IsVisible="{Binding Page.HasInstance}" ToolTip.Tip="{Binding Page.ScreenshotFolderText}">
                  <TextBlock Text="{DynamicResource Ui_Home_OpenScreenshotsFolder}" VerticalAlignment="Center" />
                </Button>
                <Button Classes="CkanSecondary" Command="{Binding Page.RefreshScreenshotsCommand}">
                  <TextBlock Text="{DynamicResource Ui_Home_ScreenshotRefresh}" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer x:Name="ScreenshotRail" Height="158"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                        IsVisible="{Binding Page.ShowScreenshotRail}">
            <ItemsControl ItemsSource="{Binding Page.Screenshots}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="CkanCard ScreenshotCard">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding FileName}" />
                        <TextBlock Text="{Binding CapturedText}" />
                        <TextBlock Text="{Binding SizeText}" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <Image Source="{Binding FilePath, Converter={StaticResource ScreenshotThumb}}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Classes="CkanEmptyStateCard Flat" IsVisible="{Binding Page.ShowEmptyScreenshots}"
                  Padding="20,16" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Ui_Home_EmptyScreenshotsTitle}" Classes="CkanTitle" />
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 插件提供的部件：统一使用标准 CkanCard + CkanStatCard -->
    <DataTemplate DataType="home:PluginHomeWidgetViewModel">
      <Border Classes="CkanCard HomeWidget stagger-card" Classes.Dragging="{Binding IsDragging}" Margin="0,0,0,12">
        <StackPanel Spacing="10">
          <Border Classes="HomeWidgetGrip" ToolTip.Tip="{DynamicResource Ui_Home_WidgetDragTip}"
                  PointerPressed="OnWidgetDragPressed" PointerMoved="OnWidgetDragMoved"
                  PointerReleased="OnWidgetDragReleased" PointerCaptureLost="OnWidgetDragCaptureLost">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource HomeIconGrip}" Width="14" Height="14"
                        Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Classes="CkanSectionTitle" VerticalAlignment="Center" />
                <Border Classes="CkanBadge" IsVisible="{Binding IsPlugin}" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Ui_Plugin_Badge}" />
                </Border>
                <TextBlock Text="{Binding PluginName}" Classes="CkanCaption" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Classes="CkanGhost HomeWidgetAction" Content="{DynamicResource Ui_Home_WidgetRefresh}"
                        Command="{Binding Page.RefreshWidgetsCommand}" ToolTip.Tip="{DynamicResource Ui_Home_WidgetLoadFailed}" />
                <Button Classes="CkanSecondary" Content="{DynamicResource Ui_Home_Open}"
                        Command="{Binding Page.NavigateCommand}" CommandParameter="{Binding PageKey}"
                        IsVisible="{Binding CanOpen}" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="{Binding Subtitle}" Classes="CkanCaption" TextWrapping="Wrap" IsVisible="{Binding HasSubtitle}" />
          <TextBlock Text="{Binding StatusText}" Classes="CkanCaption" IsVisible="{Binding IsLoading}" />

          <ItemsControl ItemsSource="{Binding Metrics}" IsVisible="{Binding HasMetrics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="CkanStatCard" Margin="0,0,8,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Label}" Classes="StatLabel" />
                    <TextBlock Text="{Binding Value}" Classes="StatValue" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="CkanCaption" TextWrapping="Wrap"
                               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="CkanBadge" IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Badge}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{DynamicResource Ui_Home_WidgetNoData}" Classes="CkanCaption"
                     IsVisible="{Binding ShowPlaceholder}" />
          <TextBlock Text="{Binding ErrorText}" Classes="CkanCaption" TextWrapping="Wrap"
                     Foreground="{DynamicResource CkanDangerBrush}" IsVisible="{Binding HasError}" />
          <TextBlock Text="{Binding FooterText}" Classes="CkanCaption" TextWrapping="Wrap" IsVisible="{Binding HasFooter}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- 宿主自带的数据部件（模组更新 / 安装历史 / 缓存 / 存档 / 后台任务）：统一使用标准 CkanCard + CkanStatCard -->
    <DataTemplate DataType="home:FeedHomeWidgetViewModel">
      <Border Classes="CkanCard HomeWidget stagger-card" Classes.Dragging="{Binding IsDragging}" Margin="0,0,0,12">
        <StackPanel Spacing="10">
          <Border Classes="HomeWidgetGrip" ToolTip.Tip="{DynamicResource Ui_Home_WidgetDragTip}"
                  PointerPressed="OnWidgetDragPressed" PointerMoved="OnWidgetDragMoved"
                  PointerReleased="OnWidgetDragReleased" PointerCaptureLost="OnWidgetDragCaptureLost">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Grid.Column="0" Data="{StaticResource HomeIconGrip}" Width="14" Height="14"
                        Foreground="{DynamicResource CkanTextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="CkanSectionTitle"
                         Margin="6,0,0,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Classes="CkanGhost HomeWidgetAction" Content="{DynamicResource Ui_Home_WidgetRefresh}"
                        Command="{Binding Page.RefreshWidgetsCommand}" ToolTip.Tip="{DynamicResource Ui_Home_WidgetLoadFailed}" />
                <Button Classes="CkanSecondary" Content="{DynamicResource Ui_Home_Open}"
                        Command="{Binding Page.NavigateCommand}" CommandParameter="{Binding PageKey}"
                        IsVisible="{Binding CanOpen}" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="{Binding Subtitle}" Classes="CkanCaption" TextWrapping="Wrap" IsVisible="{Binding HasSubtitle}" />
          <TextBlock Text="{Binding StatusText}" Classes="CkanCaption" IsVisible="{Binding IsLoading}" />

          <ItemsControl ItemsSource="{Binding Metrics}" IsVisible="{Binding HasMetrics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="CkanStatCard" Margin="0,0,8,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Label}" Classes="StatLabel" />
                    <TextBlock Text="{Binding Value}" Classes="StatValue" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="CkanCaption" TextWrapping="Wrap"
                               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="CkanBadge" IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Badge}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{DynamicResource Ui_Home_WidgetNoData}" Classes="CkanCaption"
                     IsVisible="{Binding ShowPlaceholder}" />
          <TextBlock Text="{Binding ErrorText}" Classes="CkanCaption" TextWrapping="Wrap"
                     Foreground="{DynamicResource CkanDangerBrush}" IsVisible="{Binding HasError}" />
          <TextBlock Text="{Binding FooterText}" Classes="CkanCaption" TextWrapping="Wrap" IsVisible="{Binding HasFooter}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <!--
    单页纵向滚动：部件板按用户顺序排列，截图带仍在同一屏内自动滚动。
    整页不铺不透明底板，背景（程序化场景 / 星空 / 自定义图）从部件之间的空隙与玻璃卡里透上来；
    页头与工具条压在背景上，靠一层轻量遮罩保证可读性，而不是把整屏刷成实心。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
    <StackPanel Margin="{DynamicResource CkanPagePadding}">

      <!--
        页头自带自定义工具：加/减部件与恢复默认。
        原来工具条独占一整张卡（标题 + 说明 + 控件三行），一进页面先压掉 70px，主页还没开始就满了；
        现在收进页头右侧，标题与副标题并成同一块，控件仍然全部在场。
      -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui_NavRail_Home}" Classes="CkanPageTitle" />
          <TextBlock Text="{DynamicResource Ui_Home_Subtitle}" Classes="CkanCaption" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding WidgetCountText}">
          <TextBlock Text="{DynamicResource Ui_Home_WidgetCustomize}" Classes="CkanCaption"
                     VerticalAlignment="Center" Margin="0,0,2,0" />
            <ComboBox Width="260" ItemsSource="{Binding AvailableWidgets}"
                      SelectedItem="{Binding SelectedAvailableWidget, Mode=TwoWay}"
                      IsVisible="{Binding HasAvailableWidgets}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Title}" />
                    <Border Classes="CkanBadge" IsVisible="{Binding IsPlugin}" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Ui_Plugin_Badge}" />
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="CkanPrimary" Command="{Binding AddSelectedWidgetCommand}"
                    Content="{DynamicResource Ui_Home_WidgetAdd}"
                    ToolTip.Tip="{DynamicResource Ui_Home_WidgetAddTip}" />
            <Button Classes="CkanSecondary" Command="{Binding ResetWidgetsCommand}"
                    Content="{DynamicResource Ui_Home_WidgetReset}"
                    ToolTip.Tip="{DynamicResource Ui_Home_WidgetResetTip}" />
        </StackPanel>
      </Grid>

      <!-- 错误条：服务层消息（第二行放技术细节），与实例页/缓存页同一套范式 -->
      <Border Margin="0,0,0,8" Classes="CkanInfoBanner"
              Background="{DynamicResource CkanDangerBackgroundBrush}"
              BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
              IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="Auto,*">
          <PathIcon Grid.Column="0" Data="{StaticResource CkanIconInfo}" Width="18" Height="18" Margin="0,1,12,0"
                    Foreground="{DynamicResource CkanDangerBrush}" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <Border Margin="0,0,0,8" Classes="CkanInfoBanner"
              Background="{DynamicResource CkanSuccessBackgroundBrush}"
              BorderBrush="{DynamicResource CkanSuccessBrush}" BorderThickness="1"
              IsVisible="{Binding HasStatus}">
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
      </Border>

      <ItemsControl x:Name="HomeWidgetsHost" ItemsSource="{Binding Widgets}" />

      <Border x:Name="HomeWidgetEmptyState" Classes="CkanEmptyStateCard Flat" IsVisible="{Binding ShowNoWidgets}"
              Padding="20,18" HorizontalAlignment="Left">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource Ui_Home_WidgetEmpty}" Classes="CkanTitle" />
          <TextBlock Text="{DynamicResource Ui_Home_WidgetEmptyHint}" Classes="CkanCaption" TextWrapping="Wrap" MaxWidth="560" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>