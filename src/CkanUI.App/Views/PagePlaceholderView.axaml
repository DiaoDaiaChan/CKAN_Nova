<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CkanUI.App.Views.PagePlaceholderView"
             x:CompileBindings="False">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
    <TextBlock Text="{Binding Title}" FontSize="24" HorizontalAlignment="Center" />
    <TextBlock Text="{DynamicResource Ui_Common_Page_Pending}" Opacity="0.8" HorizontalAlignment="Center" />
    <TextBlock Text="{DynamicResource Ui_Common_Page_ImplNote}" Opacity="0.6" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
