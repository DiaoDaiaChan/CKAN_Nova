<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.Ui.Theming"
             xmlns:ui="using:CkanUI.Ui.Tables"
             x:Class="CkanUI.App.Views.CachePageView"
             x:CompileBindings="False">
  <!-- 下载缓存管理页（规格 F-50 / F-40 / 06 篇 UI-19）：容量条 + 条目表 + 三种清理 + ZIP 灌入。
       颜色只用 Tokens.axaml 的语义 token，间距一律 4 的倍数；破坏性操作在 VM 里先 ConfirmAsync。
       视觉规范：工具条/卡片/空态/错误条/骨架屏统一复用 FluentStyles 的 Ckan* 类。 -->
  <UserControl.Styles>
    <!-- 列表行基线：焦点圈需要边框，这里补 0 基线避免布局抖动 -->
    <Style Selector="ListBoxItem">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="{DynamicResource CkanRowHeight}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Ui_NavRail_Cache}" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <Button Classes="CkanHelper" VerticalAlignment="Center"
                ToolTip.Tip="{DynamicResource Ui_CachePage_Header_Tip}">
          <PathIcon Data="{StaticResource CkanIconHelp}" />
        </Button>
      </StackPanel>
      <TextBlock Text="{DynamicResource Ui_CachePage_Subtitle}"
                 Classes="CkanCaption" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 工具条（F-50：清理到上限 / 全部清空 / 从 ZIP 灌入；F-40：ZIP 直接灌缓存） -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card">
      <WrapPanel Orientation="Horizontal">
        <Button Content="{DynamicResource Ui_Common_Refresh}" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding CanRefresh}" Classes="CkanPrimary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_CachePage_Refresh_Tip}" />
        <Button Content="{DynamicResource Ui_Settings_Auxiliary_OpenFolder}" Command="{Binding OpenCacheFolderCommand}"
                IsEnabled="{Binding CanOpenCacheFolder}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_CachePage_OpenDir_Tip}" />
        <Button Content="{DynamicResource Ui_CachePage_ResetLimit}" Command="{Binding ResetLimitCommand}"
                IsEnabled="{Binding CanResetLimit}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_CachePage_ResetLimit_Tip}" />
        <Button Content="{DynamicResource Ui_CachePage_PurgeToLimit}" Command="{Binding PurgeToLimitCommand}"
                IsEnabled="{Binding CanPurge}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_CachePage_PurgeToLimit_Tip}" />
        <Button Content="{DynamicResource Ui_CachePage_PurgeAll}" Command="{Binding PurgeAllCommand}"
                IsEnabled="{Binding CanPurge}" Classes="CkanDanger" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_CachePage_PurgeAll_Tip}" />
        <Button Content="{DynamicResource Ui_CachePage_ImportZip}" Command="{Binding ImportZipCommand}"
                IsEnabled="{Binding CanImportZip}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="{DynamicResource Ui_CachePage_ImportZip_Tip}" />
        <Button Content="{DynamicResource Ui_CachePage_DeleteSelected}" Command="{Binding DeleteSelectedCommand}"
                IsEnabled="{Binding CanDeleteSelected}" Classes="CkanDanger"
                ToolTip.Tip="{DynamicResource Ui_CachePage_DeleteSelected_Tip}" />
      </WrapPanel>
    </Border>

    <!-- 页面级错误条（03 篇 §8 D-03 / §10）：图标 + 说明 + 重试/关闭 -->
    <Border Grid.Row="2" Margin="0,12,0,0" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0"
                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="Medium"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                     IsVisible="{Binding HasErrorDetail}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="{DynamicResource Ui_Common_Retry}" Command="{Binding RefreshCommand}" Classes="CkanSmall"
                  IsEnabled="{Binding CanRefresh}" ToolTip.Tip="{DynamicResource Ui_CachePage_Refresh_Tip}" />
          <Button Content="{DynamicResource Ui_Cmd_Shortcuts_Close}" Command="{Binding ClearErrorCommand}" Classes="CkanSmall" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 容量条（F-50 验收：上限清理后容量 ≤ 上限） -->
    <Border Grid.Row="3" Margin="0,12,0,0" Classes="CkanSubtleCard">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding TotalText}" Classes="CkanNumeric"
                     FontSize="{DynamicResource CkanFontSizeHeading}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding CapacityText}" Classes="CkanCaption"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsagePercent}"
                     Height="6" CornerRadius="{DynamicResource CkanCornerRadiusPill}" IsVisible="{Binding HasLimit}" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
          <TextBlock Grid.Column="0" Text="{Binding EntryCountText}" Classes="CkanCaption"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedText}" Classes="CkanCaption"
                     Margin="12,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 条目表 -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Border Classes="CkanCard" Padding="0" IsVisible="{Binding !ShowEmptyState}">
        <Grid RowDefinitions="Auto,*">
          <!-- 列头：次要字色 + Caption 字号 -->
          <Border Grid.Row="0" Padding="14,9"
                  Background="{DynamicResource CkanSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,192,*,88,128,72">
              <TextBlock Grid.Column="0" Text="{DynamicResource Ui_Common_Select}" Width="36" Classes="CkanCaption" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{DynamicResource Ui_CachePage_Module}" Classes="CkanCaption" FontWeight="SemiBold" Margin="0,0,8,0" />
              <TextBlock Grid.Column="2" Text="{DynamicResource Ui_CachePage_FileName}" Classes="CkanCaption" FontWeight="SemiBold" Margin="0,0,8,0" />
              <TextBlock Grid.Column="3" Text="{DynamicResource Ui_Common_Size}" Classes="CkanCaption" FontWeight="SemiBold" />
              <TextBlock Grid.Column="4" Text="{DynamicResource Ui_CachePage_LastAccessed}" Classes="CkanCaption" FontWeight="SemiBold" />
              <TextBlock Grid.Column="5" Text="{DynamicResource Ui_Common_Status}" Classes="CkanCaption" FontWeight="SemiBold" />
            </Grid>
          </Border>
          <!-- 筛选/排序/拖动列宽由 ListTableTools 补：表头 6 列，首列复选框与末列状态不参与。 -->
          <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" Padding="4"
                   ui:ListTableTools.Enabled="True"
                   ui:ListTableTools.Columns="-,ModuleLabel,FileName,SizeText~Entry.SizeBytes,ModifiedText~Entry.ModifiedTimeUtc,-"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,192,*,88,128,72" MinHeight="{DynamicResource CkanRowHeight}">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Ui_CachePage_CheckItem_Tip}" />
                  <TextBlock Grid.Column="1" Text="{Binding ModuleLabel}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <!-- 文件类型图标 + 文件名：让每行先被"看见"再被"读到" -->
                  <!-- 用 star 列约束宽度：横向 StackPanel 会无限宽测量子元素，长文件名会被压进「大小」列。 -->
                  <Grid Grid.Column="2" ColumnDefinitions="Auto,*" Margin="0,0,8,0" VerticalAlignment="Center">
                    <PathIcon Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Foreground="{DynamicResource CkanTextTertiaryBrush}"
                              Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z" />
                    <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  </Grid>
                  <Border Grid.Column="3" Classes="CkanBadge" HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding SizeText}" Classes="CkanNumeric"
                               FontSize="{DynamicResource CkanFontSizeCaption}" />
                  </Border>
                  <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" VerticalAlignment="Center"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <Border Grid.Column="5" Classes="CkanBadge Warning"
                          VerticalAlignment="Center" HorizontalAlignment="Left"
                          IsVisible="{Binding IsReferenced}"
                          ToolTip.Tip="{DynamicResource Ui_CachePage_InUse_Tip}">
                    <TextBlock Text="{Binding ReferenceText}" />
                  </Border>
                  <TextBlock Grid.Column="5" Text="{DynamicResource Ui_CachePage_Unreferenced}" VerticalAlignment="Center"
                             IsVisible="{Binding !IsReferenced}"
                             Classes="CkanCaption"
                             Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 空状态（03 篇 §10）：缓存里还没有条目 -->
      <Border Classes="CkanEmptyStateCard" IsVisible="{Binding ShowEmptyState}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
          <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
            <PathIcon Data="M19 15v4H5v-4H3v4c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-4h-2zM7 9l5 5 5-5h-3V3h-4v6H7z" />
          </Border>
          <TextBlock Text="{DynamicResource Ui_CachePage_EmptyTitle}" HorizontalAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource Ui_CachePage_EmptySubtitle}"
                     ToolTip.Tip="{DynamicResource Ui_CachePage_ImportZipHint_Tip}"
                     TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <Button Content="{DynamicResource Ui_CachePage_ImportZip}" Command="{Binding ImportZipCommand}"
                  IsEnabled="{Binding CanImportZip}"
                  Classes="CkanPrimary" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="5" Classes="CkanPageFooter" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="CkanCaption"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

    </Grid>
    </Border>

    <!-- 进行中遮罩（03 篇 §10：非模态操作条）：骨架屏提示「正在读缓存」，进度条给出文字说明 -->
    <Border Grid.RowSpan="6" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Grid>
        <StackPanel IsHitTestVisible="False" app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="180" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
