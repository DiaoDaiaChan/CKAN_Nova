<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.App.Theming"
             x:Class="CkanUI.App.Views.CachePageView"
             x:CompileBindings="False">
  <!-- 下载缓存管理页（规格 F-50 / F-40 / 06 篇 UI-19）：容量条 + 条目表 + 三种清理 + ZIP 灌入。
       颜色只用 Tokens.axaml 的语义 token，间距一律 4 的倍数；破坏性操作在 VM 里先 ConfirmAsync。
       视觉规范：工具条/卡片/空态/错误条/骨架屏统一复用 FluentStyles 的 Ckan* 类。 -->
  <UserControl.Styles>
    <!-- 列表行基线：焦点圈需要边框，这里补 0 基线避免布局抖动 -->
    <Style Selector="ListBoxItem">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="{DynamicResource CkanRowHeight}" />
    </Style>
    <!-- 选中行左侧 3px 强调条（沿用导航栏 navIndicator 的做法） -->
    <Style Selector="Rectangle.SelectionBar">
      <Setter Property="Width" Value="3" />
      <Setter Property="RadiusX" Value="1.5" />
      <Setter Property="RadiusY" Value="1.5" />
      <Setter Property="Fill" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="2,6" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected Rectangle.SelectionBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="下载缓存" Classes="CkanPageTitle" />
      <TextBlock Text="安装与升级复用的 ZIP 下载缓存；清理只删最久未使用的条目，正在被已装模组使用的条目会保留。"
                 Classes="CkanCaption" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 工具条（F-50：清理到上限 / 全部清空 / 从 ZIP 灌入；F-40：ZIP 直接灌缓存） -->
    <Border Grid.Row="1" Classes="CkanToolbar">
      <WrapPanel Orientation="Horizontal">
        <Button Content="刷新" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding CanRefresh}" Classes="CkanPrimary" Margin="0,0,8,0"
                ToolTip.Tip="重新读取缓存统计与条目" />
        <Button Content="打开目录" Command="{Binding OpenCacheFolderCommand}"
                IsEnabled="{Binding CanOpenCacheFolder}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="在系统文件管理器中打开下载缓存目录" />
        <Button Content="重置上限" Command="{Binding ResetLimitCommand}"
                IsEnabled="{Binding CanResetLimit}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="将缓存容量上限重置为推荐值（2048 MiB）或无限制" />
        <Button Content="清理到上限" Command="{Binding PurgeToLimitCommand}"
                IsEnabled="{Binding CanPurge}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="从最久未修改的条目开始删除，直到不超过容量上限" />
        <Button Content="全部清空" Command="{Binding PurgeAllCommand}"
                IsEnabled="{Binding CanPurge}" Classes="CkanDanger" Margin="0,0,8,0"
                ToolTip.Tip="删除全部条目（正在使用的条目会跳过，需要确认）" />
        <Button Content="从 ZIP 灌入" Command="{Binding ImportZipCommand}"
                IsEnabled="{Binding CanImportZip}" Classes="CkanSecondary" Margin="0,0,8,0"
                ToolTip.Tip="选一个已下载的 CKAN 模块 ZIP，校验后复制进缓存" />
        <Button Content="删除选中" Command="{Binding DeleteSelectedCommand}"
                IsEnabled="{Binding CanDeleteSelected}" Classes="CkanDanger"
                ToolTip.Tip="删除勾选的条目（需要确认）" />
      </WrapPanel>
    </Border>

    <!-- 页面级错误条（03 篇 §8 D-03 / §10）：图标 + 说明 + 重试/关闭 -->
    <Border Grid.Row="2" Margin="0,12,0,0" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0"
                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}"
                  VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="Medium"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                     IsVisible="{Binding HasErrorDetail}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="重试" Command="{Binding RefreshCommand}" Classes="CkanSmall"
                  IsEnabled="{Binding CanRefresh}" ToolTip.Tip="重新读取缓存统计与条目" />
          <Button Content="关闭" Command="{Binding ClearErrorCommand}" Classes="CkanSmall" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 容量条（F-50 验收：上限清理后容量 ≤ 上限） -->
    <Border Grid.Row="3" Margin="0,12,0,0" Classes="CkanSubtleCard">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding TotalText}" Classes="CkanNumeric"
                     FontSize="{DynamicResource CkanFontSizeHeading}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding CapacityText}" Classes="CkanCaption"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsagePercent}"
                     Height="8" IsVisible="{Binding HasLimit}" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
          <TextBlock Grid.Column="0" Text="{Binding EntryCountText}" Classes="CkanCaption"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedText}" Classes="CkanCaption"
                     Margin="12,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 条目表 -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Border Classes="CkanCard" Padding="0" IsVisible="{Binding !ShowEmptyState}">
        <Grid RowDefinitions="Auto,*">
          <!-- 列头：次要字色 + Caption 字号 -->
          <Border Grid.Row="0" Padding="10,7"
                  Background="{DynamicResource CkanSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,192,*,88,128,72">
              <TextBlock Grid.Column="0" Text="选" Width="24" Classes="CkanCaption" />
              <TextBlock Grid.Column="1" Text="模块" Classes="CkanCaption" Margin="0,0,8,0" />
              <TextBlock Grid.Column="2" Text="文件名" Classes="CkanCaption" Margin="0,0,8,0" />
              <TextBlock Grid.Column="3" Text="大小" Classes="CkanCaption" />
              <TextBlock Grid.Column="4" Text="最后访问" Classes="CkanCaption" />
              <TextBlock Grid.Column="5" Text="状态" Classes="CkanCaption" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" Padding="4"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,192,*,88,128,72" MinHeight="{DynamicResource CkanRowHeight}">
                  <Rectangle Grid.ColumnSpan="6" Classes="SelectionBar" />
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip.Tip="勾选后可批量删除" />
                  <TextBlock Grid.Column="1" Text="{Binding ModuleLabel}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding FileName}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="CkanNumeric"
                             FontSize="{DynamicResource CkanFontSizeCaption}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" VerticalAlignment="Center"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <Border Grid.Column="5" Classes="CkanBadge Warning"
                          VerticalAlignment="Center" HorizontalAlignment="Left"
                          IsVisible="{Binding IsReferenced}"
                          ToolTip.Tip="正被已安装的模组使用，清理时会跳过">
                    <TextBlock Text="{Binding ReferenceText}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 空状态（03 篇 §10）：缓存里还没有条目 -->
      <Border Classes="CkanEmptyStateCard" IsVisible="{Binding ShowEmptyState}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
          <Border Width="56" Height="56" HorizontalAlignment="Center"
                  Background="{DynamicResource CkanAccentSubtleBrush}" CornerRadius="28">
            <PathIcon Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{DynamicResource CkanAccentBrush}"
                      Data="M19 15v4H5v-4H3v4c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-4h-2zM7 9l5 5 5-5h-3V3h-4v6H7z" />
          </Border>
          <TextBlock Text="下载缓存是空的" HorizontalAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <TextBlock Text="安装模组时下载的 ZIP 会缓存在这里；也可以用「从 ZIP 灌入」把已经下载好的模块包直接放进来。"
                     TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <Button Content="从 ZIP 灌入" Command="{Binding ImportZipCommand}"
                  IsEnabled="{Binding CanImportZip}"
                  Classes="CkanPrimary" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 状态栏 -->
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="CkanCaption"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding EntryCountText}" Classes="CkanNumeric"
                 FontSize="{DynamicResource CkanFontSizeCaption}" Margin="12,0,0,0"
                 VerticalAlignment="Center" />
    </Grid>

    <!-- 进行中遮罩（03 篇 §10：非模态操作条）：骨架屏提示「正在读缓存」，进度条给出文字说明 -->
    <Border Grid.RowSpan="6" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Grid>
        <StackPanel IsHitTestVisible="False" app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="180" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
