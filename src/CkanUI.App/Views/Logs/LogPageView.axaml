<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logs="using:CkanUI.ViewModels.Pages.Logs"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="CkanUI.App.Views.Logs.LogPageView"
             x:CompileBindings="False">
  <!-- 日志页（14 篇 §4.1 / 06 篇 UI-LOG-01 / §4.2 组成）。
       着色一律走 Tokens.axaml 的语义 brush：Log 专属色（Log.Text / Log.Warn / Log.Error / Log.User / Log.Highlight）
       按 §3.4 的十六进制值映射到既有 token，等 Lead 把它们上收成 Log.* 资源后本文件只需改绑定名。
       无障碍：每行前有字形前缀（! 警告 / × 错误 / » 用户），颜色永不单独承载语义。 -->
  <UserControl.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="CheckBox.facet">
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
    </Style>
    <Style Selector="ListBox.logList">
      <Setter Property="Background" Value="{DynamicResource CkanSurfaceBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- 行高固定 20px 才能让虚拟化列表的滚动位置稳定（§4.2③）；
         模板默认给 ListBoxItem 留了上下内边距（实测每行 26px），逐条压掉，一屏多出近三成行。 -->
    <Style Selector="ListBox.logList ListBoxItem">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Margin" Value="0" />
      <!-- 日志是只读阅读面，行不该跟着鼠标横向滑。更关键的是：列表项会被虚拟化反复回收/重建，
           全局 ListBoxItem 样式给 RenderTransform 挂了弹簧过渡，快速拖动滚动条时每个复用容器都在开合成动画，
           合成层来不及失效就会在原地留下错位的半透明「鬼影」行。这里只保留背景色过渡。 -->
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationFast}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.logList ListBoxItem:pointerover">
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    </Style>
    <!-- 级别字形：颜色 + 形状双通道 -->
    <Style Selector="TextBlock.glyph">
      <Setter Property="Width" Value="18" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.glyph.warn">
      <Setter Property="Foreground" Value="{DynamicResource CkanWarningBrush}" />
    </Style>
    <Style Selector="TextBlock.glyph.error">
      <Setter Property="Foreground" Value="{DynamicResource CkanDangerBrush}" />
    </Style>
    <Style Selector="TextBlock.glyph.fatal">
      <Setter Property="Foreground" Value="{DynamicResource CkanTextInverseBrush}" />
      <Setter Property="Background" Value="{DynamicResource CkanDangerBrush}" />
    </Style>
    <Style Selector="TextBlock.glyph.user">
      <Setter Property="Foreground" Value="{DynamicResource CkanInfoBrush}" />
    </Style>
    <Style Selector="TextBlock.glyph.trace">
      <Setter Property="Foreground" Value="{DynamicResource CkanTextTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.glyph.debug">
      <Setter Property="Foreground" Value="{DynamicResource CkanTextTertiaryBrush}" />
    </Style>
    <!-- 游戏日志（KSP.log）：模块标签换成强调色，一眼看出是哪家插件在说话；
         续行（堆栈/Unity 附注）压暗；错误/警告行在左缘加形状通道色条，色弱也能分辨。 -->
    <Style Selector="Border.familyTag.gameTag">
      <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.logRow.continuation">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="Border.logRow.levelWarn">
      <Setter Property="BorderBrush" Value="{DynamicResource CkanWarningBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="Border.logRow.levelError">
      <Setter Property="BorderBrush" Value="{DynamicResource CkanDangerBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <!-- 族标签 -->
    <Style Selector="Border.familyTag">
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 搜索命中与当前命中 -->
    <Style Selector="Border.hit">
      <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.current">
      <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <!-- 时间轴柱 -->
    <Style Selector="Border.bar">
      <Setter Property="Background" Value="{DynamicResource CkanTextTertiaryBrush}" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.bar.warn">
      <Setter Property="Background" Value="{DynamicResource CkanWarningBrush}" />
    </Style>
    <Style Selector="Border.bar.error">
      <Setter Property="Background" Value="{DynamicResource CkanDangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <Button Classes="CkanHelper" VerticalAlignment="Center"
                ToolTip.Tip="{DynamicResource Ui_LogPage_Header_Tip}">
          <PathIcon Data="{StaticResource CkanIconHelp}" />
        </Button>
      </StackPanel>
      <TextBlock Text="{DynamicResource Ui_LogPage_Subtitle}" Classes="CkanCaption" TextWrapping="Wrap" />
    </StackPanel>

    <!--
      工具条：一条主行 + 可折叠的筛选抽屉。
      原来 14 个复选 + 14 个按钮全部摊在 5 行里，把 800px 高的窗口啃掉一半，
      日志本身反而成了次要内容。现在只留搜索、命中导航、三个状态开关和两个真正的主操作，
      低频动作（刷新 / AI 分析 / 仅错误 / 恢复默认 / 清空）收进「更多」。
    -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card" Margin="0,0,0,12">
      <StackPanel Spacing="10">
        <!-- 分档开关：CKAN 界面日志 ↔ 当前实例的游戏日志（KSP.log）。
             放最上面是因为「这次是 CKAN 坏了还是游戏坏了」是排障的第一个问题。 -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      ToolTip.Tip="{DynamicResource Ui_LogPage_Channel_Tip}">
            <ToggleButton x:Name="LogChannelGuiButton" Classes="CkanPill"
                          Content="{DynamicResource Ui_LogPage_Channel_Gui}"
                          IsChecked="{Binding IsGuiChannel, Mode=OneWay}"
                          Command="{Binding ShowGuiLogCommand}" />
            <ToggleButton x:Name="LogChannelGameButton" Classes="CkanPill"
                          Content="{DynamicResource Ui_LogPage_Channel_Game}"
                          IsChecked="{Binding IsGameChannel, Mode=OneWay}"
                          Command="{Binding ShowGameLogCommand}" />
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="GameLogStatusText" Classes="caption"
                     Text="{Binding GameLogStatusText}" Margin="10,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" IsVisible="{Binding IsGameChannel}" />
          <Button Grid.Column="2" x:Name="ImportGameLogButton" Classes="CkanSecondary"
                  Content="{DynamicResource Ui_LogPage_Game_Import}"
                  Command="{Binding ImportGameLogCommand}"
                  IsVisible="{Binding IsGameChannel}" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Classes="CkanSearchBox"
                   Text="{Binding Filters.SearchText}" MinHeight="32"
                   PlaceholderText="{DynamicResource Ui_LogPage_Search_Placeholder}"
                   AutomationProperties.Name="{DynamicResource Ui_LogPage_Search}" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                      Margin="10,0,0,0" VerticalAlignment="Center">
            <Button Classes="CkanIcon" Command="{Binding FindPreviousCommand}"
                    ToolTip.Tip="{DynamicResource Ui_LogPage_FindPrev_Tip}">
              <PathIcon Data="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
            </Button>
            <Button Classes="CkanIcon" Command="{Binding FindNextCommand}"
                    ToolTip.Tip="{DynamicResource Ui_LogPage_FindNext_Tip}">
              <PathIcon Data="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z" />
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="48">
              <TextBlock Classes="caption" Text="{DynamicResource Ui_LogPage_MatchPrefix}" />
              <TextBlock Classes="caption" Text="{Binding CurrentMatchOrdinal, StringFormat=' {0}'}" />
            </StackPanel>

            <Border Classes="Divider" />

            <ToggleButton Classes="CkanPill" Content="{DynamicResource Ui_LogPage_FollowTail}"
                          IsChecked="{Binding IsFollowTail, Mode=OneWay}"
                          Command="{Binding ToggleFollowTailCommand}"
                          ToolTip.Tip="{DynamicResource Ui_LogPage_FollowTail_Tip}" />
            <ToggleButton Classes="CkanPill" Content="{DynamicResource Ui_LogPage_Aggregate}"
                          IsChecked="{Binding IsAggregated, Mode=OneWay}"
                          Command="{Binding ToggleAggregateCommand}"
                          ToolTip.Tip="{DynamicResource Ui_LogPage_Aggregate_Tip}" />

            <Button Classes="CkanPrimary" Content="{DynamicResource Ui_Cmd_Action_ExportDiagnostics}"
                    Command="{Binding ExportDefaultCommand}"
                    ToolTip.Tip="{DynamicResource Ui_LogPage_ExportZip_Tip}" />
            <Button Classes="CkanSecondary" Content="{DynamicResource Ui_Common_More}">
              <Button.Flyout>
                <ui:FAMenuFlyout>
                  <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_Common_Refresh}" Command="{Binding RefreshCommand}" />
                  <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_LogPage_AiAnalyze}" Command="{Binding RequestAiAnalysisCommand}" />
                  <ui:FAMenuFlyoutSeparator />
                  <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_LogPage_ErrorsOnly}" Command="{Binding ShowOnlyErrorsCommand}" />
                  <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_LogPage_ResetFilters}" Command="{Binding ResetFiltersCommand}" />
                  <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_LogPage_ClearSearch}" Command="{Binding Filters.ClearSearchCommand}" />
                  <ui:FAMenuFlyoutSeparator />
                  <ui:FAMenuFlyoutItem Text="{DynamicResource Ui_LogPage_ClearBuffer}" Command="{Binding ClearCommand}" />
                </ui:FAMenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>

        <!-- 筛选默认收起：默认全选就是「什么都看」，不占版面；要看某一族再展开 -->
        <Expander IsExpanded="False" HorizontalAlignment="Stretch"
                  ToolTip.Tip="{DynamicResource Ui_LogPage_FilterDrawer_Tip}">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Ui_Common_Filter}" Classes="caption" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Filters.Description}" Classes="caption"
                         MaxWidth="620" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Expander.Header>

          <StackPanel Spacing="6" Margin="0,6,0,0">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Classes="caption" Text="{DynamicResource Ui_LogPage_Source}" Margin="0,0,8,0" Width="34" />
              <ItemsControl ItemsSource="{Binding Filters.Sources}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Classes="facet" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </WrapPanel>

            <WrapPanel Orientation="Horizontal">
              <TextBlock Classes="caption" Text="{DynamicResource Ui_LogPage_Level}" Margin="0,0,8,0" Width="34" />
              <ItemsControl ItemsSource="{Binding Filters.Levels}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Classes="facet" IsChecked="{Binding IsSelected}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Glyph}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Label}" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </WrapPanel>

            <WrapPanel Orientation="Horizontal">
              <TextBlock Classes="caption" Text="{DynamicResource Ui_LogPage_Family}" Margin="0,0,8,0" Width="34" />
              <ItemsControl ItemsSource="{Binding Filters.Families}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Classes="facet" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </WrapPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <!-- 主区：列表 / 聚合 + 右缘时间轴 + 详情面板 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,28,340">

      <Grid Grid.Column="0" RowDefinitions="*">
        <!-- 主列表（虚拟化，等高 20px）-->
        <ListBox Grid.Row="0" x:Name="LogList" Classes="logList" ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow}" IsVisible="{Binding !IsAggregated}">
          <!-- 日志行不做虚拟化：行数上限就是 LogPageViewModel.RowLimit = 500、行高固定 20px，
               全部实现出来的成本可控；而虚拟化在快速拖滚动条时来不及回收/新建容器，会出现整段空白
               （用户连报两次「拖动后显示丢失」）。这里用普通 StackPanel 一次实现到底。 -->
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="logRow"
                      Classes.hit="{Binding IsHighlighted}" Classes.current="{Binding IsCurrentMatch}"
                      Classes.continuation="{Binding IsContinuation}"
                      Classes.levelWarn="{Binding IsWarning}"
                      Classes.levelError="{Binding IsError}"
                      Padding="2,0">
                <Grid ColumnDefinitions="56,88,20,Auto,*" Height="20">
                  <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Seq}"
                             Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TimeText}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <TextBlock Grid.Column="2" Classes="glyph"
                             Classes.warn="{Binding IsWarning}"
                             Classes.error="{Binding IsError}"
                             Classes.user="{Binding IsUser}"
                             Text="{Binding Glyph}" />
                  <Border Grid.Column="3" Classes="familyTag" Classes.gameTag="{Binding IsGame}">
                    <TextBlock Text="{Binding TagLabel}" FontSize="{DynamicResource CkanFontSizeCaption}"
                               TextTrimming="CharacterEllipsis" />
                  </Border>
                  <TextBlock Grid.Column="4" Classes="mono" Text="{Binding Message}"
                             TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 聚合视图（连续相同指纹折叠 ×N，§4.2④）-->
        <ListBox Grid.Row="0" Classes="logList" ItemsSource="{Binding Groups}"
                 IsVisible="{Binding IsAggregated}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="56,20,Auto,*,56" Height="20">
                <TextBlock Grid.Column="0" Classes="mono" Text="{Binding FirstSeq}"
                           Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                <TextBlock Grid.Column="1" Classes="glyph"
                           Classes.error="{Binding IsError}"
                           Text="{Binding Glyph}" />
                <Border Grid.Column="2" Classes="familyTag">
                  <TextBlock Text="{Binding FamilyLabel}" FontSize="{DynamicResource CkanFontSizeCaption}" />
                </Border>
                <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Sample}"
                           TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                <TextBlock Grid.Column="4" Classes="mono" Text="{Binding CountText}"
                           TextAlignment="Right" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <Border Grid.Row="0" IsVisible="{Binding ShowEmptyState}"
                Classes="CkanEmptyStateCard" VerticalAlignment="Center"
                HorizontalAlignment="Center" MaxWidth="460">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
              <PathIcon Data="M4 4h16v2H4V4zm0 5h16v2H4V9zm0 5h10v2H4v-2zm0 5h7v2H4v-2z" />
            </Border>
            <TextBlock Text="{Binding EmptyHint}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeBody}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- 右缘时间轴（§4.2⑤）：错误柱红、警告柱黄，点击柱子在列表里定位 -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" Margin="2,20,0,0">
        <ItemsControl ItemsSource="{Binding Timeline}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="bar"
                      Classes.warn="{Binding HasWarning}"
                      Classes.error="{Binding HasError}"
                      Height="{Binding BarHeight}"
                      ToolTip.Tip="{Binding TipText}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 详情面板（§4.2③ 选中行显示原文含 Detail 异常栈；§4.3 对象联动）-->
      <Border Grid.Column="2" BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}" Padding="12" Margin="8,20,0,0">
        <Grid>
          <!-- 未选中时给出明确的下一步，而不是一行孤零零的灰字 -->
          <StackPanel IsVisible="{Binding !HasSelection}" Spacing="10" MaxWidth="230"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Classes="CkanIconTile Muted" HorizontalAlignment="Center">
              <PathIcon Data="M4 4h16v2H4V4zm0 5h16v2H4V9zm0 5h10v2H4v-2zm0 5h7v2H4v-2z" />
            </Border>
            <TextBlock Text="{DynamicResource Ui_Logs_NoSelection}" HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          </StackPanel>

          <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,Auto,Auto,*">
          <TextBlock Grid.Row="0" Text="{Binding SelectedHeader}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Classes="caption" Text="{Binding SelectedSourceText}"
                     Margin="0,4,0,6" TextWrapping="Wrap" />
          <ItemsControl Grid.Row="2" ItemsSource="{Binding SelectedLinks}" Margin="0,0,0,6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="chip" Content="{Binding Text}"
                        Command="{Binding $parent[UserControl].DataContext.ActivateLinkCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SelectedMessage}" TextWrapping="Wrap"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="{Binding SelectedDetail}" TextWrapping="Wrap" Classes="mono"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>
          </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- 状态条：一条细带，只在真的有提示时才长出「×」 -->
    <Border Grid.Row="3" Classes="CkanStatusStrip" Margin="0,12,0,0"
            Padding="10,5" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding BadgeText}" Classes="Value"
                   IsVisible="{Binding HasBadge}" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
          <TextBlock Text="{Binding AggregateHint}" IsVisible="{Binding IsAggregated}"
                     Foreground="{DynamicResource CkanTextTertiaryBrush}" />
          <Button Classes="CkanIcon" Width="20" Height="20" Command="{Binding DismissMessageCommand}"
                  IsVisible="{Binding HasMessage}" ToolTip.Tip="{DynamicResource Ui_LogPage_DismissBanner_Tip}">
            <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- AI 排障面板（14 篇 §6）：右侧浮层，不挤占日志列宽。
         纪律：先看预览再发送——日志会离开本机，这一步不能省。 -->
    <Border x:Name="AiDiagnosisPanel" Grid.RowSpan="4"
            IsVisible="{Binding Ai.IsOpen}"
            HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Width="420" Margin="12,0,0,0" Padding="14"
            Background="{DynamicResource CkanDialogBackgroundBrush}"
            BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}" BoxShadow="{DynamicResource CkanElevationHigh}">
      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{DynamicResource Ui_LogPage_AiPanel_Title}"
                     FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <Button Grid.Column="1" Classes="CkanIcon" Width="22" Height="22"
                  Command="{Binding Ai.CloseCommand}"
                  ToolTip.Tip="{DynamicResource Ui_LogPage_AiClose_Tip}">
            <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
          </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
          <TextBox x:Name="AiBaseUrlBox" Text="{Binding Ai.BaseUrl, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource Ui_LogPage_AiBaseUrl}" />
          <TextBox x:Name="AiModelBox" Text="{Binding Ai.Model, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource Ui_LogPage_AiModel}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" x:Name="AiApiKeyBox" Text="{Binding Ai.ApiKey, Mode=TwoWay}"
                     PasswordChar="●" PlaceholderText="{DynamicResource Ui_LogPage_AiApiKey}" />
            <Button x:Name="AiSaveButton" Grid.Column="1" Classes="CkanSecondary" Margin="6,0,0,0"
                    Content="{DynamicResource Ui_LogPage_AiSave}" Command="{Binding Ai.SaveConfigurationCommand}" />
          </Grid>
          <TextBlock x:Name="AiStatusText" Classes="caption" Text="{Binding Ai.StatusText}"
                     TextWrapping="Wrap" IsVisible="{Binding Ai.HasStatus}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4">
          <TextBlock Text="{DynamicResource Ui_LogPage_AiPreview}" Classes="caption"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBox x:Name="AiPreviewBox" Text="{Binding Ai.PreviewText, Mode=OneWay}" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="120" Classes="mono"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
          <Button x:Name="AiSendButton" Classes="CkanPrimary" HorizontalAlignment="Left"
                  Content="{DynamicResource Ui_LogPage_AiSend}" Command="{Binding Ai.SendCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3">
          <StackPanel Spacing="8">
            <TextBlock x:Name="AiSummaryText" Text="{Binding Ai.Summary}" TextWrapping="Wrap"
                       IsVisible="{Binding Ai.HasResult}" FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <ItemsControl x:Name="AiHypothesesList" ItemsSource="{Binding Ai.Hypotheses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="stagger-card" Padding="8" Margin="0,0,0,6"
                          Background="{DynamicResource CkanSubtleBackgroundBrush}"
                          CornerRadius="{DynamicResource CkanCornerRadiusSmall}">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Cause}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" Margin="6,0,0,0"
                                   FontFeatures="tnum" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                      </Grid>
                      <TextBlock Text="{Binding Explain}" TextWrapping="Wrap" Classes="caption" />
                      <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" Classes="caption"
                                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                      <TextBlock Text="{Binding EvidenceText}" Classes="caption"
                                 Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>
