<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CkanUI.ViewModels.Dialogs;assembly=CkanUI.ViewModels"
             xmlns:relations="clr-namespace:CkanUI.App.Views.Relations"
             xmlns:vmtree="clr-namespace:CkanUI.ViewModels.Relations;assembly=CkanUI.ViewModels"
             xmlns:conv="using:CkanUI.App.Converters"
             x:Class="CkanUI.App.Views.Dialogs.ModDetailsView"
             x:DataType="vm:ModDetailsViewModel">
  <UserControl.Resources>
    <conv:BytesToBitmapConverter x:Key="BytesToBitmap" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 列表行：沿用 ReposPageView 的做法，hover 与选中都用语义 token（3 篇 §9 不只靠颜色表达状态）。
         全局 ListBoxItem 只管背景，这里补圆角与内边距，让版本行/文件行读起来像列表条目。 -->
    <Style Selector="ListBoxItem">
      <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="RenderTransform" Value="translate(2px, 0px)" />
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
    </Style>

    <!-- 状态横幅：中性态走无边框的浅底，只有失败态才上危险色。
         早期中性态用信息色描边，400px 栏里读起来像聚焦中的输入框；现在中性态只留一层浅底，
         红框仍然是「有事发生」的唯一强信号（文案另带成功/失败措辞，不靠颜色单一通道）。 -->
    <Style Selector="Border.StatusBanner">
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.StatusBanner.Error">
      <Setter Property="Background" Value="{DynamicResource CkanDangerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanDangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.StatusBanner TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.StatusBanner.Error TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CkanDangerBrush}" />
    </Style>

    <!-- 页签条：详情面板默认 400px 宽，四个页签要压在一行内，不能折行吃掉可视高度 -->
    <Style Selector="TabItem">
      <!-- 12px（Caption 字号，不再压缩）+ 2/4 内边距：
           实测 400px 默认栏与 320px 极窄栏下四个页签都排得进一行（文字墨迹止于 ~234px），
           所以字号是主要阅读通道，不为了省宽度把 12px 缩回 11px 的注释感 -->

      <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
      <Setter Property="Padding" Value="2,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,0,1,0" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- 空状态（03 篇 §10：每页必须有空状态） -->
    <StackPanel Classes="view-layer" Classes.is-active="{Binding IsEmpty}"
                IsVisible="{Binding IsEmpty}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Margin="32">
      <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
        <PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" />
      </Border>
      <TextBlock Text="{Binding EmptyText}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource CkanTextPrimaryBrush}"
                 HorizontalAlignment="Center"
                 TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource Ui_ModDetails_SelectModHint}"
                 Classes="CkanCaption"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 MaxWidth="260"
                 TextWrapping="Wrap" />
    </StackPanel>

    <!-- 四个页签：内联 TabItem 声明（不是 ItemsSource），切换页签时控件实例不重建，
         滚动位置与列表选中项自然保持；选中态下划线由 FluentStyles 的 TabItem:selected 提供。 -->
    <TabControl Classes="view-layer" Classes.is-active="{Binding HasSelection}"
                IsVisible="{Binding HasSelection}"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                Background="Transparent"
                Padding="0">

      <!-- 页签一：元数据与简介 -->
      <TabItem Header="{Binding MetadataTabHeaderText}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,8,12,12" Spacing="10">
            <TextBlock Text="{Binding Name}"
                       FontSize="{DynamicResource CkanFontSizeTitle}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="{Binding AuthorText}"
                         Margin="0,0,8,0"
                         Opacity="0.7"
                         FontSize="{DynamicResource CkanFontSizeCaption}" />
              <Border Classes="CkanBadge"
                      Classes.Success="{Binding IsInstalled}"
                      Classes.Danger="{Binding !IsCompatible}"
                      Margin="0,0,6,2">
                <TextBlock Text="{Binding CompatibilityText}" />
              </Border>
            </WrapPanel>

            <!-- 分类徽章单独一行：和作者、兼容状态挤一行时它必然被裁剪成「生存、科研与生…」，
                 分类信息就废了；独占一行后能完整显示（极端长的分类允许折行）。 -->
            <Border Classes="CkanBadge Info"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding CategoryBadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    ToolTip.Tip="{Binding CategoryDescription}">
              <TextBlock Text="{Binding CategoryBadgeText}" TextWrapping="Wrap" />
            </Border>

            <!-- 摘要：译文命中时右侧挂「已译」徽标（沿用全局 CkanBadge，颜色走主题 token，不写死） -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAbstract}">
              <TextBlock Grid.Column="0"
                         Text="{Binding AbstractText}"
                         TextWrapping="Wrap"
                         Opacity="0.85"
                         FontStyle="Italic"
                         FontSize="{DynamicResource CkanFontSizeCaption}" />
              <Border Grid.Column="1"
                      Classes="CkanBadge Success"
                      Padding="6,1"
                      Margin="8,0,0,0"
                      VerticalAlignment="Top"
                      IsVisible="{Binding IsAbstractTranslated}">
                <TextBlock Text="{Binding TranslationBadgeText}" />
              </Border>
            </Grid>

            <!-- 译文过期：原文已更新而译文仍是旧版时给可见警告（文案在 VM，颜色不是唯一通道） -->
            <Border Classes="CkanBadge Warning"
                    Padding="8,3"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding HasStaleTranslation}">
              <TextBlock Text="{Binding StaleTranslationNotice}" TextWrapping="Wrap" />
            </Border>

            <!-- 联动：该模组与某个内置 GUI 插件配套时给「推荐安装 / 去哪用」的说明（清单见 ModsCompanionCatalog） -->
            <Border Classes="CkanSubtleCard" Padding="10,8" IsVisible="{Binding HasCompanionLink}">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding CompanionTitle}"
                             FontWeight="SemiBold"
                             FontSize="{DynamicResource CkanFontSizeCaption}" />
                  <Border Classes="CkanBadge Info" Padding="6,0">
                    <TextBlock Text="{Binding CompanionPluginName}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding CompanionBenefit}"
                           Classes="CkanCaption"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Text="{Binding CompanionHint}"
                           Classes="CkanCaption"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              </StackPanel>
            </Border>

            <!-- 元数据键值（标签与格式都在 VM 内集中，03 篇 §11） -->
            <Border Classes="CkanSubtleCard" Padding="10,8">
              <ItemsControl ItemsSource="{Binding MetadataItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DiagnosticItem">
                    <Grid ColumnDefinitions="64,*" Margin="0,1">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Name}"
                                 Foreground="{DynamicResource CkanTextSecondaryBrush}"
                                 FontSize="{DynamicResource CkanFontSizeCaption}" />
                      <SelectableTextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           Foreground="{DynamicResource CkanTextPrimaryBrush}"
                                           FontSize="{DynamicResource CkanFontSizeCaption}"
                                           TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <!-- SpaceDock 官方页面引导卡片（不爬取外部图片，减免客户端网络开销与速率限制，纯净直达官方） -->
            <Border Classes="CkanSubtleCard" Padding="12,10" IsVisible="{Binding HasSpacedockUrl}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding SpacedockSectionTitle}"
                             FontWeight="SemiBold"
                             FontSize="{DynamicResource CkanFontSizeBody}" />
                  <TextBlock Text="{Binding SpacedockLazyHintText}"
                             Classes="CkanCaption"
                             Foreground="{DynamicResource CkanTextTertiaryBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="CkanChip"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Content="{Binding SpacedockOpenButtonText}"
                        Command="{Binding OpenSpacedockUrlCommand}"
                        ToolTip.Tip="{Binding SpacedockUrl}" />
              </Grid>
            </Border>

            <!-- 单模组稳定性容忍度覆盖（F-13 / UI-07 / UI-29） -->
            <TextBlock Text="{Binding StabilityToleranceHeaderText}"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0" />
            <ComboBox ItemsSource="{Binding StabilityToleranceOptions}"
                      SelectedItem="{Binding SelectedStabilityToleranceOverride, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:StabilityToleranceOption">
                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource CkanFontSizeCaption}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 描述（Markdown 原文；渲染由后续 Markdown 控件接入，UI-03 遗留项） -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
              <TextBlock Text="{Binding DescriptionHeaderText}" FontWeight="SemiBold" />
              <Border Classes="CkanBadge Success"
                      Padding="6,1"
                      IsVisible="{Binding IsDescriptionTranslated}">
                <TextBlock Text="{Binding TranslationBadgeText}" />
              </Border>
            </StackPanel>
            <Border Classes="CkanSubtleCard" Padding="12,10">
              <SelectableTextBlock Text="{Binding DescriptionText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource CkanTextSecondaryBrush}"
                                   FontSize="{DynamicResource CkanFontSizeCaption}" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 页签二：依赖关系 -->
      <TabItem Header="{Binding RelationsTabHeaderText}">
        <Panel>
          <!-- 关系视图占满页签可用高度：关系树自带滚动，关系网按可用尺寸自适应缩放。
               不要再套 ScrollViewer > StackPanel —— 自绘控件会拿到 0 高度而塌陷成一条色带。 -->
          <Grid IsVisible="{Binding HasRelations}"
                RowDefinitions="Auto,*"
                Margin="12,10,12,12">
            <!-- 依赖状态横幅：只在「有依赖缺失」时出现。
                 全部满足时不再复读一遍计数——分类胶囊已经写了「依赖 4」，树里每行还带着状态，
                 再叠一条横幅只会把可视高度从树里挤出去（用户反馈：这段太紧凑）。 -->
            <Border Grid.Row="0"
                    Classes="StatusBanner"
                    Classes.Error="{Binding HasMissingDependencies}"
                    IsVisible="{Binding HasMissingDependencies}"
                    Margin="0,0,0,10">
              <TextBlock Text="{Binding DependencySummaryText}" />
            </Border>

            <!-- 关系树（默认）与关系网（可选）的切换由 RelationTreeView 自身承担 -->
            <ContentControl Grid.Row="1"
                            Content="{Binding RelationTree}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vmtree:RelationTreeViewModel">
                  <relations:RelationTreeView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Grid>

          <Border Classes="CkanEmptyStateCard"
                  IsVisible="{Binding !HasRelations}"
                  VerticalAlignment="Top"
                  Margin="16,8,16,16">
            <TextBlock Text="{Binding RelationsEmptyText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </Border>
        </Panel>
      </TabItem>

      <!-- 页签三：全部版本（F-30） -->
      <TabItem Header="{Binding VersionsTabHeaderText}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="16,8,16,0">
          <TextBlock Grid.Row="0"
                     Text="{Binding VersionsCountText}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Margin="0,0,0,6" />

          <Border Grid.Row="1" Classes="StatusBanner" Classes.Error="{Binding InstallStatusIsError}"
                  IsVisible="{Binding HasInstallStatusText}">
            <TextBlock Text="{Binding InstallStatusText}" />
          </Border>

          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Versions}"
                   IsVisible="{Binding HasVersions}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModVersionItemDto">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding VersionText}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource CkanFontSizeBody}"
                               VerticalAlignment="Center" />
                    <Border Classes="CkanBadge"
                            Classes.Success="{Binding IsInstalled}"
                            Classes.Danger="{Binding !IsCompatible}">
                      <TextBlock Text="{Binding CompatibilityBadgeText}" />
                    </Border>
                    <Border Classes="CkanBadge" Classes.Warning="{Binding IsUnstable}">
                      <TextBlock Text="{Binding StabilityBadgeText}" />
                    </Border>
                  </StackPanel>

                  <Button Grid.Row="0"
                          Grid.Column="1"
                          Grid.RowSpan="2"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Classes="CkanChip"
                          Content="{DynamicResource Ui_ModDetails_InstallThisVersion}"
                          IsVisible="{Binding !IsInstalled}"
                          Command="{Binding $parent[ListBox].((vm:ModDetailsViewModel)DataContext).InstallVersionCommand}"
                          CommandParameter="{Binding}" />

                  <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                    <TextBlock Text="{Binding ReleaseDateText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Text="{Binding DownloadSizeText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Text="{Binding CompatibilityText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2"
                  Classes="CkanEmptyStateCard"
                  IsVisible="{Binding !HasVersions}"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding VersionsEmptyText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </Border>
        </Grid>
      </TabItem>

      <!-- 页签四：文件与内容（F-26 / F-29） -->
      <TabItem Header="{Binding ContentsTabHeaderText}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16,8,16,0">
          <Border Grid.Row="0" Classes="CkanCard" Padding="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ContentPreviewHintText}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <Button Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Classes="CkanPrimary"
                      Content="{Binding ContentPreviewButtonText}"
                      Command="{Binding NavigateToContentPreviewCommand}" />
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  Classes="StatusBanner"
                  Margin="0,8,0,8"
                  IsVisible="{Binding HasContentNavigationStatusText}">
            <TextBlock Text="{Binding ContentNavigationStatusText}" />
          </Border>

          <TextBlock Grid.Row="2"
                     Text="{Binding InstalledFilesCountText}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Margin="0,0,0,6" />

          <ListBox Grid.Row="3"
                   ItemsSource="{Binding InstalledFileRows}"
                   IsVisible="{Binding HasInstalledFiles}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InstalledFileItem">
                <StackPanel Orientation="Vertical" Spacing="1">
                  <TextBlock Text="{Binding FileName}"
                             FontSize="{DynamicResource CkanFontSizeBody}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DirectoryText}"
                             IsVisible="{Binding HasDirectory}"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextTertiaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="3"
                  Classes="CkanEmptyStateCard"
                  IsVisible="{Binding !HasInstalledFiles}"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding ContentsEmptyText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Panel>
</UserControl>
