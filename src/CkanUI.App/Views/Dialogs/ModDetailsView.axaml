<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CkanUI.ViewModels.Dialogs;assembly=CkanUI.ViewModels"
             x:Class="CkanUI.App.Views.Dialogs.ModDetailsView"
             x:DataType="vm:ModDetailsViewModel">
  <UserControl.Styles>
    <!-- 列表行：沿用 ReposPageView 的做法，hover 与选中都用语义 token（3 篇 §9 不只靠颜色表达状态）。
         全局 ListBoxItem 只管背景，这里补圆角与内边距，让版本行/文件行读起来像列表条目。 -->
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
    </Style>

    <!-- 状态横幅：中性/成功走信息色，失败走危险色（文案另带成功/失败措辞，不靠颜色单一通道） -->
    <Style Selector="Border.StatusBanner">
      <Setter Property="Background" Value="{DynamicResource CkanInfoBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanInfoBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.StatusBanner.Error">
      <Setter Property="Background" Value="{DynamicResource CkanDangerBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CkanDangerBrush}" />
    </Style>
    <Style Selector="Border.StatusBanner TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.StatusBanner.Error TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CkanDangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- 空状态（03 篇 §10：每页必须有空状态） -->
    <TextBlock Text="{Binding EmptyText}"
               IsVisible="{Binding IsEmpty}"
               Opacity="0.6"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextWrapping="Wrap" />

    <!-- 四个页签：内联 TabItem 声明（不是 ItemsSource），切换页签时控件实例不重建，
         滚动位置与列表选中项自然保持；选中态下划线由 FluentStyles 的 TabItem:selected 提供。 -->
    <TabControl IsVisible="{Binding HasSelection}"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                Background="Transparent"
                Padding="0">

      <!-- 页签一：元数据与简介 -->
      <TabItem Header="{Binding MetadataTabHeaderText}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,8,16,16" Spacing="12">
            <TextBlock Text="{Binding Name}"
                       FontSize="{DynamicResource CkanFontSizeTitle}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding AuthorText}"
                         Opacity="0.7"
                         FontSize="{DynamicResource CkanFontSizeCaption}" />
              <Border Classes="CkanBadge"
                      Classes.Success="{Binding IsInstalled}"
                      Classes.Danger="{Binding !IsCompatible}">
                <TextBlock Text="{Binding CompatibilityText}" />
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding AbstractText}"
                       IsVisible="{Binding HasAbstract}"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       FontStyle="Italic"
                       FontSize="{DynamicResource CkanFontSizeCaption}" />

            <!-- 元数据键值（标签与格式都在 VM 内集中，03 篇 §11） -->
            <ItemsControl ItemsSource="{Binding MetadataItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiagnosticItem">
                  <Grid ColumnDefinitions="96,*" Margin="0,1">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               Opacity="0.6"
                               FontSize="{DynamicResource CkanFontSizeCaption}" />
                    <SelectableTextBlock Grid.Column="1"
                                         Text="{Binding Value}"
                                         FontSize="{DynamicResource CkanFontSizeCaption}"
                                         TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 单模组稳定性容忍度覆盖（F-13 / UI-07 / UI-29） -->
            <TextBlock Text="{Binding StabilityToleranceHeaderText}"
                       FontWeight="SemiBold"
                       Margin="0,6,0,0" />
            <ComboBox ItemsSource="{Binding StabilityToleranceOptions}"
                      SelectedItem="{Binding SelectedStabilityToleranceOverride, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:StabilityToleranceOption">
                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource CkanFontSizeCaption}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 描述（Markdown 原文；渲染由后续 Markdown 控件接入，UI-03 遗留项） -->
            <TextBlock Text="{Binding DescriptionHeaderText}" FontWeight="SemiBold" Margin="0,6,0,0" />
            <SelectableTextBlock Text="{Binding DescriptionText}"
                                 TextWrapping="Wrap"
                                 FontSize="{DynamicResource CkanFontSizeCaption}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 页签二：依赖关系 -->
      <TabItem Header="{Binding RelationsTabHeaderText}">
        <Panel>
          <ScrollViewer IsVisible="{Binding HasRelations}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,8,16,16" Spacing="12">
              <!-- 依赖树：文字 + 状态双通道（03 篇 §9 不靠颜色单一通道） -->
              <TextBlock Text="{Binding DependenciesHeaderText}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DependencySummaryText}"
                         Opacity="0.7"
                         FontSize="{DynamicResource CkanFontSizeCaption}" />
              <ItemsControl ItemsSource="{Binding Dependencies}" IsVisible="{Binding HasDependencies}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModRelationItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding DisplayText}"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding StatusText}"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Opacity="0.7" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding RecommendationsHeaderText}"
                         FontWeight="SemiBold"
                         IsVisible="{Binding HasRecommendations}"
                         Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding Recommendations}" IsVisible="{Binding HasRecommendations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModRelationItem">
                    <TextBlock Text="{Binding DisplayText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding ConflictsHeaderText}"
                         FontWeight="SemiBold"
                         IsVisible="{Binding HasConflicts}"
                         Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding Conflicts}" IsVisible="{Binding HasConflicts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModRelationItem">
                    <TextBlock Text="{Binding DisplayText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Border Classes="CkanEmptyStateCard"
                  IsVisible="{Binding !HasRelations}"
                  VerticalAlignment="Top"
                  Margin="16,8,16,16">
            <TextBlock Text="{Binding RelationsEmptyText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </Border>
        </Panel>
      </TabItem>

      <!-- 页签三：全部版本（F-30） -->
      <TabItem Header="{Binding VersionsTabHeaderText}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="16,8,16,0">
          <TextBlock Grid.Row="0"
                     Text="{Binding VersionsCountText}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Margin="0,0,0,6" />

          <Border Grid.Row="1" Classes="StatusBanner" Classes.Error="{Binding InstallStatusIsError}"
                  IsVisible="{Binding HasInstallStatusText}">
            <TextBlock Text="{Binding InstallStatusText}" />
          </Border>

          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Versions}"
                   IsVisible="{Binding HasVersions}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModVersionItemDto">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding VersionText}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource CkanFontSizeBody}"
                               VerticalAlignment="Center" />
                    <Border Classes="CkanBadge"
                            Classes.Success="{Binding IsInstalled}"
                            Classes.Danger="{Binding !IsCompatible}">
                      <TextBlock Text="{Binding CompatibilityBadgeText}" />
                    </Border>
                    <Border Classes="CkanBadge" Classes.Warning="{Binding IsUnstable}">
                      <TextBlock Text="{Binding StabilityBadgeText}" />
                    </Border>
                  </StackPanel>

                  <Button Grid.Row="0"
                          Grid.Column="1"
                          Grid.RowSpan="2"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Classes="CkanChip"
                          Content="安装此版本"
                          IsVisible="{Binding !IsInstalled}"
                          Command="{Binding $parent[ListBox].((vm:ModDetailsViewModel)DataContext).InstallVersionCommand}"
                          CommandParameter="{Binding}" />

                  <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                    <TextBlock Text="{Binding ReleaseDateText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Text="{Binding DownloadSizeText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Text="{Binding CompatibilityText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2"
                  Classes="CkanEmptyStateCard"
                  IsVisible="{Binding !HasVersions}"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding VersionsEmptyText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </Border>
        </Grid>
      </TabItem>

      <!-- 页签四：文件与内容（F-26 / F-29） -->
      <TabItem Header="{Binding ContentsTabHeaderText}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16,8,16,0">
          <Border Grid.Row="0" Classes="CkanCard" Padding="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ContentPreviewHintText}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <Button Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Classes="CkanPrimary"
                      Content="{Binding ContentPreviewButtonText}"
                      Command="{Binding NavigateToContentPreviewCommand}" />
            </Grid>
          </Border>

          <Border Grid.Row="1"
                  Classes="StatusBanner"
                  Margin="0,8,0,8"
                  IsVisible="{Binding HasContentNavigationStatusText}">
            <TextBlock Text="{Binding ContentNavigationStatusText}" />
          </Border>

          <TextBlock Grid.Row="2"
                     Text="{Binding InstalledFilesCountText}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Margin="0,0,0,6" />

          <ListBox Grid.Row="3"
                   ItemsSource="{Binding InstalledFileRows}"
                   IsVisible="{Binding HasInstalledFiles}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InstalledFileItem">
                <StackPanel Orientation="Vertical" Spacing="1">
                  <TextBlock Text="{Binding FileName}"
                             FontSize="{DynamicResource CkanFontSizeBody}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DirectoryText}"
                             IsVisible="{Binding HasDirectory}"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextTertiaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="3"
                  Classes="CkanEmptyStateCard"
                  IsVisible="{Binding !HasInstalledFiles}"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding ContentsEmptyText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Panel>
</UserControl>
