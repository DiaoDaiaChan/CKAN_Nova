<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CkanUI.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        x:Class="CkanUI.App.Views.Dialogs.UpdateAvailableDialogView"
        x:DataType="vm:UpdateAvailableDialogViewModel"
        Width="520" Height="480"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="{Binding Title}"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="{DynamicResource CkanPagePadding}">

        <!-- 顶部标题与提示 -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}"
                       FontSize="{DynamicResource CkanFontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />

            <TextBlock Text="{Binding UpdatePromptText}"
                       FontSize="{DynamicResource CkanFontSizeBody}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <Border Height="1" Background="{DynamicResource CkanBorderBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 更新日志 / Release Notes -->
        <Border Grid.Row="1"
                Background="{DynamicResource CkanSidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CkanBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
                Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Panel>
                    <TextBlock Text="{DynamicResource Ui_UpdateAvailableDialog_NoReleaseNotes}"
                               IsVisible="{Binding ReleaseNotes, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                               FontSize="{DynamicResource CkanFontSizeBody}"
                               Foreground="{DynamicResource CkanTextTertiaryBrush}"
                               TextWrapping="Wrap" />
                    <SelectableTextBlock Text="{Binding ReleaseNotes}"
                                         IsVisible="{Binding ReleaseNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         FontSize="{DynamicResource CkanFontSizeBody}"
                                         Foreground="{DynamicResource CkanTextPrimaryBrush}"
                                         TextWrapping="Wrap" />
                </Panel>
            </ScrollViewer>
        </Border>

        <!-- 安装区：可用性说明 / 下载校验替换进度 / 失败原因 / 重启提示 -->
        <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
            <TextBlock Text="{Binding InstallAvailabilityText}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       TextWrapping="Wrap" />

            <StackPanel Spacing="4" IsVisible="{Binding ShowInstallProgress}">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding InstallPercent}" Height="6" />
                <TextBlock Text="{Binding InstallStatusText}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border IsVisible="{Binding HasInstallError}"
                    Background="{DynamicResource CkanDangerBackgroundBrush}"
                    BorderBrush="{DynamicResource CkanDangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                    Padding="8,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding InstallErrorText}"
                               Foreground="{DynamicResource CkanDangerBrush}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InstallErrorDetail}"
                               Foreground="{DynamicResource CkanDangerBrush}"
                               Opacity="0.8"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               TextWrapping="Wrap"
                               MaxHeight="60" />
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Ui_UpdateAvailableDialog_Subtitle}"
                       IsVisible="{Binding HasRestartHint}"
                       Foreground="{DynamicResource CkanSuccessBrush}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <!-- 校验 / 提示信息 -->
            <TextBlock Text="{Binding ValidationError}"
                       IsVisible="{Binding HasValidationError}"
                       Foreground="{DynamicResource CkanWarningBrush}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 底部操作按钮 -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,16,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui_UpdateAvailableDialog_NewVersionPrefix}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}"
                           FontSize="{DynamicResource CkanFontSizeCaption}" />
                <TextBlock Text="{Binding LatestVersion}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}"
                           FontSize="{DynamicResource CkanFontSizeCaption}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{DynamicResource Ui_UpdateAvailableDialog_InstallUpdate}"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding CanInstall}"
                    ToolTip.Tip="{DynamicResource Ui_UpdateAvailableDialog_InstallUpdate_Tip}"
                    Margin="0,0,8,0" />

            <Button Grid.Column="2"
                    Content="{DynamicResource Ui_UpdateAvailableDialog_CancelInstall}"
                    Command="{Binding CancelInstallCommand}"
                    IsVisible="{Binding CanCancelInstall}"
                    Margin="0,0,8,0" />

            <Button Grid.Column="3"
                    Content="{DynamicResource Ui_UpdateAvailableDialog_OpenRelease}"
                    Command="{Binding OpenReleaseUrlCommand}"
                    Margin="0,0,8,0" />

            <Button Grid.Column="4"
                    Content="{Binding PrimaryButtonText}"
                    Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>
