<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CkanUI.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        x:Class="CkanUI.App.Views.Dialogs.UpdateAvailableDialogView"
        x:DataType="vm:UpdateAvailableDialogViewModel"
        Width="520" Height="420"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Title="{Binding Title}"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="{DynamicResource CkanPagePadding}">

        <!-- 顶部标题与提示 -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}"
                       FontSize="{DynamicResource CkanFontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />

            <TextBlock Text="{Binding UpdatePromptText}"
                       FontSize="{DynamicResource CkanFontSizeBody}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <Border Height="1" Background="{DynamicResource CkanBorderBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 更新日志 / Release Notes -->
        <Border Grid.Row="1"
                Background="{DynamicResource CkanSidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CkanBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
                Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock Text="{Binding ReleaseNotes, TargetNullValue='暂无更新日志说明。'}"
                                     FontSize="{DynamicResource CkanFontSizeBody}"
                                     Foreground="{DynamicResource CkanTextPrimaryBrush}"
                                     TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!-- 校验 / 提示信息 -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ValidationError}"
                   IsVisible="{Binding HasValidationError}"
                   Foreground="{DynamicResource CkanWarningBrush}"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <!-- 底部操作按钮 -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding LatestVersion, StringFormat='新版本: {0}'}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       FontSize="{DynamicResource CkanFontSizeCaption}" />

            <Button Grid.Column="1"
                    Content="前往下载 / 查看 Release"
                    Command="{Binding OpenReleaseUrlCommand}"
                    Margin="0,0,8,0" />

            <Button Grid.Column="2"
                    Content="{Binding PrimaryButtonText}"
                    Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>
