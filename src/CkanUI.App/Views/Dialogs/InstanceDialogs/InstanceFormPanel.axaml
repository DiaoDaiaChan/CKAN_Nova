<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                x:Class="CkanUI.App.Views.Dialogs.InstanceDialogs.InstanceFormPanel"
                x:CompileBindings="False">
  <!-- 实例表单（03 篇 §8 D-06）：新增 / 克隆 / 重命名共用；提交与取消都落到 InstanceFormViewModel 的命令上。 -->
  <!--
    校验失败时轻轻抖一下（20 篇 P-10）。
    第二阶段只留状态锚点：RenderTransform 写成字符串平移，配 Classes.is-invalid（样式见 FluentStyles），
    第三阶段直接给它挂关键帧即可。父容器不能 ClipToBounds，否则左右 ±8px 的位移会被切掉。
  -->
  <Border x:Name="FormCard" Padding="16" CornerRadius="8" MinWidth="420"
          RenderTransform="translate(0px, 0px)"
          Classes.is-invalid="{Binding HasValidationError}"
          ClipToBounds="False"
          Background="{DynamicResource CkanCardBackgroundBrush}"
          BorderBrush="{DynamicResource CkanCardBorderBrush}"
          BorderThickness="1">
    <StackPanel Spacing="10">
      <TextBlock Text="{Binding Title}" FontSize="18" />

      <TextBlock Text="{Binding SourceSummary}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                 IsVisible="{Binding ShowsSource}" />

      <!-- 实例名称 -->
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Ui_InstanceForm_InstanceName}" FontSize="12" Opacity="0.7" />
        <TextBox Text="{Binding Name, Mode=TwoWay}" MinWidth="380"
                 PlaceholderText="{DynamicResource Ui_InstanceForm_InstanceName_Placeholder}" />
      </StackPanel>

      <!-- 游戏目录（仅新增模式可填） -->
      <StackPanel Spacing="4" IsVisible="{Binding ShowsPath}">
        <TextBlock Text="{DynamicResource Ui_InstanceForm_GameDirectory}" FontSize="12" Opacity="0.7" />
        <TextBox Text="{Binding Path, Mode=TwoWay}" MinWidth="380"
                 PlaceholderText="{DynamicResource Ui_InstanceForm_GameDirectory_Placeholder}" />
      </StackPanel>

      <TextBlock Text="{Binding HintText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxWidth="420" />

      <!-- 校验错误（03 篇 §8：红字，主按钮不提交） -->
      <TextBlock Text="{Binding ValidationError}" Foreground="#D13438" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding HasValidationError}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{DynamicResource Ui_Common_Cancel}" Command="{Binding CancelCommand}" />
        <Button Content="{Binding PrimaryButtonText}" Command="{Binding SubmitCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
