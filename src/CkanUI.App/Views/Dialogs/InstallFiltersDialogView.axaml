<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CkanUI.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="550"
        x:Class="CkanUI.App.Views.Dialogs.InstallFiltersDialogView"
        x:DataType="vm:InstallFiltersDialogViewModel"
        Width="500" Height="550"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{Binding Title}"
        Background="{DynamicResource CkanDialogBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24">

        <!-- Header & Description -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="安装文件过滤规则"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBlock Text="配置在模组安装或更新过程中需要自动忽略跳过的文件或路径模式（支持子串与通配符，如 *.pdb、README.md）。"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />

            <!-- Input Row -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBox Grid.Column="0"
                         Text="{Binding NewFilterText, Mode=TwoWay}"
                         PlaceholderText="输入过滤模式（例如 *.pdb、.git、Thumbs.db）"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddFilterCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Content="添加规则"
                        Command="{Binding AddFilterCommand}"
                        Classes="accent" />
            </Grid>
        </StackPanel>

        <!-- Rules List -->
        <Border Grid.Row="1"
                Background="{DynamicResource CkanCardBackgroundBrush}"
                BorderBrush="{DynamicResource CkanBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
            <ListBox ItemsSource="{Binding Filters}"
                     SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterItemViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="4,2">
                            <!-- Icon / Bullet -->
                            <PathIcon Grid.Column="0"
                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Width="12" Height="12"
                                      Foreground="{DynamicResource CkanTextTertiaryBrush}"
                                      Margin="4,0,8,0"
                                      Opacity="0.5" />

                            <!-- Pattern Text -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Pattern}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas,Menlo,Monospace"
                                       FontSize="13"
                                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />

                            <!-- Delete Button -->
                            <Button Grid.Column="2"
                                    Command="{Binding RemoveCommand}"
                                    Content="删除"
                                    Padding="8,4"
                                    Classes="subtle"
                                    Foreground="{DynamicResource CkanDangerBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Validation / Error Info -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ValidationError}"
                   IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource CkanDangerBrush}"
                   FontSize="12"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
            <!-- Reset to Defaults Button -->
            <Button Grid.Column="0"
                    Content="恢复默认规则"
                    Command="{Binding ResetDefaultsCommand}"
                    Classes="subtle" />

            <!-- Spacer -->
            <Panel Grid.Column="1" />

            <!-- Secondary / Cancel -->
            <Button Grid.Column="2"
                    Content="{Binding SecondaryButtonText}"
                    Command="{Binding SecondaryCommand}"
                    Margin="0,0,8,0" />

            <!-- Primary / Save -->
            <Button Grid.Column="3"
                    Content="{Binding PrimaryButtonText}"
                    Command="{Binding PrimaryCommand}"
                    Classes="accent" />
        </Grid>

    </Grid>
</Window>
