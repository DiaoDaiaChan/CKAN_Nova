<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CkanUI.App.Views.ModPacksPageView"
             x:CompileBindings="False">
  <!-- 导入导出页（03 篇 §6 V-11 / 06 篇 UI-20 / UI-24，F-39..F-42 / F-45）：
       导出卡片 + 「导入 .ckan」与「实例对比」两个页签。全部颜色走 Tokens.axaml 的语义 token，间距一律 4 的倍数。 -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui_NavRail_ModPacks}" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_ModPacksPage_Header_Tip}">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
        </StackPanel>
        <TextBlock Text="{DynamicResource Ui_ModPacksPage_Subtitle}"
                   Classes="CkanCaption" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Column="1" Classes="CkanBadge" VerticalAlignment="Center"
              IsVisible="{Binding HasInstance}">
        <TextBlock Text="{Binding InstanceTitleText}" />
      </Border>
      <Border Grid.Column="1" Classes="CkanBadge Warning" VerticalAlignment="Center"
              IsVisible="{Binding !HasInstance}"
              ToolTip.Tip="{Binding InstanceTitleText}">
        <TextBlock Text="{DynamicResource Ui_ModPacksPage_NoInstanceSelected}" />
      </Border>
    </Grid>

    <!-- 左右分栏：左侧「导出配置」，右侧「导入与校验 / 实例对比」（06 篇 UI-20：消灭纵向四层框线嵌套） -->
    <Grid Grid.Row="1" ColumnDefinitions="340,12,*">

    <!-- 导出卡片 -->
    <Border Grid.Column="0" Classes="CkanCard stagger-card" Padding="{DynamicResource CkanToolbarPadding}"
            VerticalAlignment="Top">
      <StackPanel Spacing="10">
        <!-- 标题行统一走 CkanHelper 悬浮帮助（20 项页头同一范式），副标下沉到 ToolTip -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{DynamicResource Ui_ModPacksPage_ExportConfigHeader}" Classes="CkanCardTitle" VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_ModPacksPage_Export_Tip}">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource Ui_ModPacksPage_TargetPath}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBox Text="{Binding ExportForm.TargetPath, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource Ui_ModPacksPage_TargetPath_Placeholder}"
                   ToolTip.Tip="{Binding ExportForm.PathHint}" />
          <TextBlock Text="{Binding ExportForm.ValidationText}"
                     IsVisible="{Binding ExportForm.HasValidation}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanDangerBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource Ui_ModPacksPage_ExportFormat}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <ComboBox ItemsSource="{Binding ExportForm.FormatOptions}"
                    SelectedItem="{Binding ExportForm.SelectedFormatOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
        <!-- 选项竖排（左栏只有 340px），主操作独占一行 -->
        <StackPanel Spacing="2" IsEnabled="{Binding ExportForm.CanConfigureModpackOptions}">
          <CheckBox Content="{DynamicResource Ui_ModPacksPage_LockVersions}" IsChecked="{Binding ExportForm.WithVersions, Mode=TwoWay}"
                    ToolTip.Tip="{DynamicResource Ui_ModPacksPage_LockVersions_Tip}" />
          <CheckBox Content="{DynamicResource Ui_ModPacksPage_BundleZips}" IsChecked="{Binding ExportForm.BundleDownloads, Mode=TwoWay}"
                    ToolTip.Tip="{DynamicResource Ui_ModPacksPage_BundleZips_Tip}" />
          <CheckBox Content="{DynamicResource Ui_ModPacksPage_UseRecommends}" IsChecked="{Binding ExportForm.UseRecommends, Mode=TwoWay}"
                    ToolTip.Tip="{DynamicResource Ui_ModPacksPage_UseRecommends_Tip}" />
        </StackPanel>
        <Button Content="{DynamicResource Ui_Common_Export}" Command="{Binding ExportCommand}"
                Classes="CkanPrimary" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsEnabled="{Binding CanExport}"
                ToolTip.Tip="{DynamicResource Ui_ModPacksPage_ExportButton_Tip}" />
        <TextBlock Text="{Binding ExportResultText}" IsVisible="{Binding HasExportResult}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <StackPanel Spacing="4" IsVisible="{Binding HasProgress}">
          <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4"
                       CornerRadius="{DynamicResource CkanCornerRadiusPill}" />
          <TextBlock Text="{Binding ProgressText}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 导入 / 对比 -->
    <TabControl Grid.Column="2" Background="Transparent">

      <!-- 导入 .ckan：先预览再执行 -->
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="{DynamicResource Ui_ModPacksPage_ImportTabHeader}" />
        </TabItem.Header>
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">

          <Border Grid.Row="0" Classes="CkanCard" Padding="12">
            <StackPanel Spacing="8">
              <!-- 原「要导入的 .ckan 文件（每行一个，也接受分号分隔）」一句 24 字说明 → 三步流程条，
                   三个圆点各绑一个真实状态，替掉散落的文字提示。 -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="CkanStepDot" Classes.Active="{Binding IsIdle}">
                  <TextBlock Text="1" />
                </Border>
                <TextBlock Text="{DynamicResource Ui_ModPacksPage_StepFillPath}" Classes="CkanStepLabel" />
                <TextBlock Classes="CkanStepArrow" />
                <Border Classes="CkanStepDot" Classes.Active="{Binding HasPreviewRows}">
                  <TextBlock Text="2" />
                </Border>
                <TextBlock Text="{DynamicResource Ui_ModPacksPage_StepPreview}" Classes="CkanStepLabel" />
                <TextBlock Classes="CkanStepArrow" />
                <Border Classes="CkanStepDot" Classes.Active="{Binding CanImport}">
                  <TextBlock Text="3" />
                </Border>
                <TextBlock Text="{DynamicResource Ui_ModPacksPage_StepExecute}" Classes="CkanStepLabel" />
              </StackPanel>
              <TextBox Text="{Binding ImportPathText, Mode=TwoWay}"
                       AcceptsReturn="True" Height="72"
                       TextWrapping="Wrap"
                       PlaceholderText="{DynamicResource Ui_ModPacksPage_ImportPath_Placeholder}"
                       ToolTip.Tip="{DynamicResource Ui_ModPacksPage_ImportPath_Tip}" />
              <WrapPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Ui_ModPacksPage_PreviewImport}" Command="{Binding PreviewImportCommand}"
                        Classes="CkanSecondary"
                        IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"
                        ToolTip.Tip="{DynamicResource Ui_ModPacksPage_PreviewImport_Tip}" />
                <Button Content="{DynamicResource Ui_ModPacksPage_ExecuteImport}" Command="{Binding ImportCommand}"
                        Classes="CkanPrimary"
                        IsEnabled="{Binding CanImport}" Margin="0,0,8,0"
                        ToolTip.Tip="{DynamicResource Ui_ModPacksPage_ExecuteImport_Tip}" />
              </WrapPanel>
              <TextBlock Text="{Binding PreviewSummaryText}" IsVisible="{Binding HasPreviewSummary}"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding PreviewWarningText}" IsVisible="{Binding HasPreviewWarning}"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanWarningBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding ImportResultText}" IsVisible="{Binding HasImportResult}"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- 预览表 -->
          <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,8,0,0">
            <Border Grid.Row="0" Padding="8,4"
                    IsVisible="{Binding HasPreviewRows}"
                    BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
              <Grid Grid.Column="0" ColumnDefinitions="40,*,2*,88,2*,2*">
                <TextBlock Grid.Column="0" Text="{DynamicResource Ui_Common_CheckCol}" FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource Ui_ModPacksPage_ModIdCol}" FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{DynamicResource Ui_ModPacksPage_SourceFileCol}" FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{DynamicResource Ui_Common_Status}" FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="{DynamicResource Ui_Common_Version}" FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="5" Text="{DynamicResource Ui_Common_ReasonCol}" FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              </Grid>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="{Binding PreviewCountText}" VerticalAlignment="Center"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                <Button Content="{DynamicResource Ui_Common_SelectAll}" Command="{Binding SelectAllEntriesCommand}"
                        Classes="CkanGhost CkanSmall"
                        IsEnabled="{Binding HasPreviewRows}" />
                <Button Content="{DynamicResource Ui_ModPacksPage_ClearChecks}" Command="{Binding ClearSelectionCommand}"
                        Classes="CkanGhost CkanSmall"
                        IsEnabled="{Binding HasPreviewRows}" />
              </StackPanel>
              </Grid>
            </Border>

            <ListBox Grid.Row="1" ItemsSource="{Binding PreviewRows}"
                     SelectedItem="{Binding SelectedPreviewRow, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     IsVisible="{Binding HasPreviewRows}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="40,*,2*,88,2*,2*" Height="{DynamicResource CkanRowHeight}">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Identifier}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding StateText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="{Binding ReasonText}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip.Tip="{Binding ReasonText}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态必须有「实体」：Flat 是全透明变体（FluentStyles.axaml:631 只为「嵌在已有卡片里的空态」准备），
                 独立摊在页签区时就是一片死黑 —— 这里升为 Elevated 实体卡 + 内嵌 glow + 图标底座 + 徽章行。 -->
            <Border Grid.Row="1" IsVisible="{Binding ShowPreviewEmptyState}"
                   Classes="CkanEmptyStateCard Elevated" Margin="0,4,0,0"
                   VerticalAlignment="Stretch">
              <Panel>
                <Border Classes="CkanEmptyStateGlow"
                        CornerRadius="{DynamicResource CkanCornerRadiusLarge}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="480" Margin="24,20">
                  <Border Classes="CkanIconTile Lg Muted" HorizontalAlignment="Center">
                    <PathIcon Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm0 2.5L18.5 9H14V4.5zM6 20V4h6v6h6v10H6z" />
                  </Border>
                  <TextBlock Text="{Binding PreviewEmptyStateTitle}"
                             HorizontalAlignment="Center"
                             FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <TextBlock Text="{Binding PreviewEmptyStateHint}" TextWrapping="Wrap" TextAlignment="Center"
                             FontSize="{DynamicResource CkanFontSizeBody}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <!-- 预览结果会告诉你什么：三枚静态徽章，把「点完能看到啥」提前交代 -->
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Border Classes="CkanBadge"><TextBlock Text="{DynamicResource Ui_ModPacksPage_WillInstallOrUpgrade}" /></Border>
                    <Border Classes="CkanBadge"><TextBlock Text="{DynamicResource Ui_ModPacksPage_WillConflict}" /></Border>
                    <Border Classes="CkanBadge"><TextBlock Text="{DynamicResource Ui_ModPacksPage_NotFound}" /></Border>
                  </StackPanel>
                </StackPanel>
              </Panel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- 实例对比 -->
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="{DynamicResource Ui_ModPacksPage_InstanceDiffTabHeader}" />
        </TabItem.Header>
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">

          <Border Grid.Row="0" Classes="CkanCard" Padding="12">
            <StackPanel Spacing="8">
              <!-- 与「导入 .ckan」页签同构的三步流程条，圆点绑真实状态 -->
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="CkanStepDot" Classes.Active="{Binding IsIdle}">
                  <TextBlock Text="1" />
                </Border>
                <TextBlock Text="{DynamicResource Ui_ModPacksPage_StepSelectTwo}" Classes="CkanStepLabel" />
                <TextBlock Classes="CkanStepArrow" />
                <Border Classes="CkanStepDot" Classes.Active="{Binding CanCompare}">
                  <TextBlock Text="2" />
                </Border>
                <TextBlock Text="{DynamicResource Ui_ModPacksPage_StartDiff}" Classes="CkanStepLabel" />
                <TextBlock Classes="CkanStepArrow" />
                <Border Classes="CkanStepDot" Classes.Active="{Binding HasDiffRows}">
                  <TextBlock Text="3" />
                </Border>
                <TextBlock Text="{DynamicResource Ui_ModPacksPage_StepViewDiff}" Classes="CkanStepLabel" />
              </StackPanel>
              <WrapPanel Orientation="Horizontal">
                <StackPanel Spacing="4" Margin="0,0,16,0" MinWidth="200">
                  <TextBlock Text="{DynamicResource Ui_ModPacksPage_LeftInstance}" FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <ComboBox ItemsSource="{Binding InstanceNames}"
                            SelectedItem="{Binding LeftInstance, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="4" Margin="0,0,16,0" MinWidth="200">
                  <TextBlock Text="{DynamicResource Ui_ModPacksPage_RightInstance}" FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <ComboBox ItemsSource="{Binding InstanceNames}"
                            SelectedItem="{Binding RightInstance, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                  <Button Content="{DynamicResource Ui_ModPacksPage_StartDiff}" Command="{Binding CompareCommand}"
                          Classes="CkanPrimary"
                          IsEnabled="{Binding CanCompare}"
                          ToolTip.Tip="{DynamicResource Ui_ModPacksPage_InstanceDiff_Tip}" />
                  <Button Content="{DynamicResource Ui_ModPacksPage_ReloadInstances}" Command="{Binding RefreshInstancesCommand}"
                          Classes="CkanSecondary"
                          IsEnabled="{Binding IsIdle}" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="{Binding DiffSummaryText}" IsVisible="{Binding HasDiffSummary}"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,8,0,0">
            <Border Grid.Row="0" Padding="8,4"
                    BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,96,2*">
                <TextBlock Grid.Column="0" Text="{DynamicResource Ui_ModPacksPage_ModIdCol}" FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{DynamicResource Ui_Common_Difference}" FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{DynamicResource Ui_ModPacksPage_VersionLeftToRight}" FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              </Grid>
            </Border>

            <ListBox Grid.Row="1" ItemsSource="{Binding DiffRows}"
                     BorderThickness="0" Background="Transparent"
                     IsVisible="{Binding HasDiffRows}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,96,2*" Height="{DynamicResource CkanRowHeight}">
                    <TextBlock Grid.Column="0" Text="{Binding Identifier}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding KindText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding VersionsText}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" IsVisible="{Binding ShowDiffEmptyState}"
                   Classes="CkanEmptyStateCard Elevated" Margin="0,4,0,0"
                   VerticalAlignment="Stretch">
              <Panel>
                <Border Classes="CkanEmptyStateGlow"
                        CornerRadius="{DynamicResource CkanCornerRadiusLarge}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="480" Margin="24,20">
                  <Border Classes="CkanIconTile Lg Muted" HorizontalAlignment="Center">
                    <PathIcon Data="M6.99 11 3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 15V9z" />
                  </Border>
                  <TextBlock Text="{Binding DiffEmptyStateTitle}"
                             HorizontalAlignment="Center"
                             FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                <TextBlock Text="{Binding DiffEmptyStateHint}" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="{DynamicResource CkanFontSizeBody}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <TextBlock Text="{Binding DiffCountText}" HorizontalAlignment="Center"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                  <!-- 对比结果的三种口径，先看得到再点得到 -->
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Border Classes="CkanBadge"><TextBlock Text="{DynamicResource Ui_ModPacksPage_LeftOnly}" /></Border>
                    <Border Classes="CkanBadge"><TextBlock Text="{DynamicResource Ui_ModPacksPage_RightOnly}" /></Border>
                    <Border Classes="CkanBadge"><TextBlock Text="{DynamicResource Ui_ModPacksPage_VersionMismatch}" /></Border>
                  </StackPanel>
                </StackPanel>
              </Panel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
    </Grid>

    <!-- 错误条 + 状态栏 -->
    <StackPanel Grid.Row="2" Spacing="8" Margin="0,8,0,0">
      <Border Classes="CkanInfoBanner Danger" Padding="12,8"
              IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                       FontSize="{DynamicResource CkanFontSizeBody}"
                       Foreground="{DynamicResource CkanDangerBrush}" />
            <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                       IsVisible="{Binding HasErrorDetail}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Content="{DynamicResource Ui_Cmd_Shortcuts_Close}" Command="{Binding ClearErrorCommand}"
                  Classes="CkanGhost CkanSmall"
                  VerticalAlignment="Top" Margin="8,0,0,0" />
        </Grid>
      </Border>
      <Border Classes="CkanPageFooter" Margin="0,4,0,0">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </StackPanel>

    <!-- 进行中遮罩（03 篇 §10：非模态操作条） -->
    <Border Grid.RowSpan="3" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanStatusBarBackgroundBrush}" Opacity="0.9">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
        <ProgressBar IsIndeterminate="True" Width="240" />
        <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="{DynamicResource CkanFontSizeBody}"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
