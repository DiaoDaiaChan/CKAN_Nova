<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CkanUI.App.Views.ModPackEditorPageView"
             x:CompileBindings="False">
  <!-- modpack 编辑器（06 篇 UI-24 的编辑部分）：基础表单 + 关系表 + 校验问题栏 + 状态栏。
       颜色只用 Tokens.axaml 的语义 token，间距一律 4 的倍数。 -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="16"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="modpack 编辑器"
                   FontSize="{DynamicResource CkanFontSizeTitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        <TextBlock Text="编辑一个 .ckan 元数据包：标识、说明、许可证与依赖关系，保存后可直接被 CKAN / 启动器消费。"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="有未保存的改动" IsVisible="{Binding IsDirty}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource CkanWarningBrush}"
                 FontSize="{DynamicResource CkanFontSizeCaption}" />
    </Grid>

    <!-- 工具条 -->
    <Border Grid.Row="1" Padding="{DynamicResource CkanToolbarPadding}"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            BorderBrush="{DynamicResource CkanBorderBrush}"
            BorderThickness="1">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <Button Content="打开" Command="{Binding LoadCommand}"
                  IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0"
                  ToolTip.Tip="读取下面路径的 .ckan 文件到表单" />
          <Button Content="新建" Command="{Binding NewDocumentCommand}"
                  IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0"
                  ToolTip.Tip="清空表单，从零写一个 modpack" />
          <Button Content="校验" Command="{Binding ValidateCommand}"
                  IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0"
                  ToolTip.Tip="只检查不写盘，逐条列出中文原因" />
          <Button Content="保存" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="先校验再写盘；有错误时拒绝保存" />
        </WrapPanel>
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Text="保存路径" VerticalAlignment="Center"
                     Margin="0,0,8,0"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBox Grid.Column="1" Text="{Binding FilePath}"
                   PlaceholderText="例如 C:\\Mods\\my-modpack.ckan" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 错误 + 校验问题 -->
    <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
      <Border IsVisible="{Binding HasError}"
              Padding="{DynamicResource CkanToolbarPadding}"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
              BorderBrush="{DynamicResource CkanDangerBrush}"
              BorderThickness="1">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding ErrorText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanDangerBrush}" />
            <Button Grid.Column="1" Content="关闭" Command="{Binding ValidateCommand}"
                    ToolTip.Tip="重新校验以刷新错误栏" />
          </Grid>
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding HasIssues}"
              Padding="{DynamicResource CkanToolbarPadding}"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
              BorderBrush="{DynamicResource CkanBorderBrush}"
              BorderThickness="1">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding IssueSummary}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <ItemsControl ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 基础表单 -->
    <Border Grid.Row="3" Margin="0,8,0,0"
            Padding="{DynamicResource CkanToolbarPadding}"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            BorderBrush="{DynamicResource CkanBorderBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="88,*,88,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="6" ColumnSpacing="8">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="标识" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Identifier}"
                 PlaceholderText="小写字母 / 数字 / 连字符" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="名称" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Name}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="版本" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Version}" PlaceholderText="例如 1.0.0" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="规范版本" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SpecVersion}"
                 PlaceholderText="留空则由 CKAN 自动推导" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="发布状态" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ReleaseStatusOptions}"
                  SelectedItem="{Binding ReleaseStatus}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="包类型" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding KindOptions}"
                  SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="游戏版本" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KspVersion}" PlaceholderText="例如 1.12.5" />
        <TextBlock Grid.Row="3" Grid.Column="2" Text="版本下限" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding KspVersionMin}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="版本上限" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding KspVersionMax}" />
        <TextBlock Grid.Row="4" Grid.Column="2" Text="下载地址" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding DownloadUrl}"
                 PlaceholderText="kind=package 时必填" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="摘要" VerticalAlignment="Center"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Abstract}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="描述" VerticalAlignment="Top" Margin="0,4,0,0"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Description}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

        <Grid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="作者" FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0" Text="{Binding NewAuthor}" PlaceholderText="按回车或点「加」" />
              <Button Grid.Column="1" Content="加" Command="{Binding AddAuthorCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Authors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Height="{DynamicResource CkanRowHeight}">
                    <TextBlock Grid.Column="0" Text="{Binding DisplayText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                    <Button Grid.Column="1" Content="删"
                            Command="{Binding $parent[ItemsControl].DataContext.RemoveAuthorCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="许可证" FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0" Text="{Binding NewLicense}" PlaceholderText="例如 MIT、GPL-3.0、unknown" />
              <Button Grid.Column="1" Content="加" Command="{Binding AddLicenseCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Licenses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Height="{DynamicResource CkanRowHeight}">
                    <TextBlock Grid.Column="0" Text="{Binding DisplayText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                    <Button Grid.Column="1" Content="删"
                            Command="{Binding $parent[ItemsControl].DataContext.RemoveLicenseCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- 关系表 -->
    <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="关系（依赖 / 推荐 / 建议 / 冲突 / 支持）"
                   FontSize="{DynamicResource CkanFontSizeSubtitle}"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        <Button Grid.Column="1" Content="添加关系" Command="{Binding AddRelationCommand}"
                ToolTip.Tip="追加一行，再选择关系类型与语义模式" />
      </Grid>

      <Border Grid.Row="1" Padding="8,4"
              CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
              BorderBrush="{DynamicResource CkanBorderBrush}"
              BorderThickness="1"
              Background="{DynamicResource CkanStatusBarBackgroundBrush}">
        <Grid ColumnDefinitions="110,110,*,160,56">
          <TextBlock Grid.Column="0" Text="类型"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBlock Grid.Column="1" Text="语义"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBlock Grid.Column="2" Text="目标模组"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBlock Grid.Column="3" Text="版本范围"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </Grid>
      </Border>

      <ListBox Grid.Row="2" ItemsSource="{Binding Relations}"
               BorderBrush="{DynamicResource CkanBorderBrush}"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="110,110,*,160,56" Height="{DynamicResource CkanRowHeight}">
              <ComboBox Grid.Column="0" Margin="0,0,6,0"
                        ItemsSource="{Binding $parent[ListBox].DataContext.RelationTypeOptions}"
                        SelectedItem="{Binding RelationType}" />
              <ComboBox Grid.Column="1" Margin="0,0,6,0"
                        ItemsSource="{Binding $parent[ListBox].DataContext.ModeOptions}"
                        SelectedItem="{Binding Mode}" />

              <TextBox Grid.Column="2" Margin="0,0,6,0" IsVisible="{Binding IsSingleMode}"
                       Text="{Binding Name}" PlaceholderText="小写模组标识，例如 modulemanager" />
              <TextBox Grid.Column="2" Margin="0,0,6,0" IsVisible="{Binding IsCandidateMode}"
                       Text="{Binding CandidatesText}" PlaceholderText="候选标识，逗号分隔" />

              <Grid Grid.Column="3" ColumnDefinitions="*,*" ColumnSpacing="4" IsVisible="{Binding IsSingleMode}">
                <TextBox Grid.Column="0" Text="{Binding MinVersion}" PlaceholderText="下限" />
                <TextBox Grid.Column="1" Text="{Binding MaxVersion}" PlaceholderText="上限" />
              </Grid>
              <TextBlock Grid.Column="3" Text="{Binding VersionText}" VerticalAlignment="Center"
                         IsVisible="{Binding IsCandidateMode}"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />

              <Button Grid.Column="4" Content="删除"
                      Command="{Binding $parent[ListBox].DataContext.RemoveRelationCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="3" IsVisible="{Binding ShowEmptyRelations}"
              Margin="0,6,0,0"
              Padding="{DynamicResource CkanToolbarPadding}"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
              BorderBrush="{DynamicResource CkanBorderBrush}"
              BorderThickness="1">
        <TextBlock Text="还没有关系行：modpack 通常至少依赖所包含的核心模组。"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
      </Border>
    </Grid>

    <!-- 状态栏 -->
    <Grid Grid.Row="5" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
      <TextBlock Grid.Column="0" Text="{Binding BusyText}" IsVisible="{Binding IsBusy}"
                 Margin="0,0,8,0"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanAccentTextBrush}" />
      <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}" />
    </Grid>
  </Grid>
</UserControl>
