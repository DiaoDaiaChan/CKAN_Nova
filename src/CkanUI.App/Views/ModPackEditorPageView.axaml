<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CkanUI.App.Views.ModPackEditorPageView"
             x:CompileBindings="False">
  <!-- modpack 编辑器（06 篇 UI-24 的编辑部分）：基础表单 + 关系表 + 校验问题栏 + 状态栏。
       颜色只用 Tokens.axaml 的语义 token，间距一律 4 的倍数。 -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui_NavRail_ModPackEditor}" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_ModPackEditorPage_Header_Tip}">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
        </StackPanel>
        <TextBlock Text="{DynamicResource Ui_ModPackEditorPage_Subtitle}"
                   Classes="CkanCaption" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Column="1" Classes="CkanBadge Warning" IsVisible="{Binding IsDirty}" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Ui_ModPackEditorPage_UnsavedChanges}" />
      </Border>
    </Grid>

    <!-- 工具条（一级卡片，预留错峰入场锚点） -->
    <Border Grid.Row="1" Padding="{DynamicResource CkanToolbarPadding}"
            Classes="CkanCard stagger-card"
            RenderTransform="translate(0px, 0px)">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <Button Content="{DynamicResource Ui_Common_Open}" Command="{Binding LoadCommand}"
                  Classes="CkanSecondary"
                  IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0"
                  ToolTip.Tip="{DynamicResource Ui_ModPackEditorPage_Open_Tip}" />
          <Button Content="{DynamicResource Ui_Common_New}" Command="{Binding NewDocumentCommand}"
                  Classes="CkanSecondary"
                  IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0"
                  ToolTip.Tip="{DynamicResource Ui_ModPackEditorPage_New_Tip}" />
          <Button Content="{DynamicResource Ui_Common_Validate}" Command="{Binding ValidateCommand}"
                  Classes="CkanSecondary"
                  IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0"
                  ToolTip.Tip="{DynamicResource Ui_ModPackEditorPage_Validate_Tip}" />
          <Button Content="{DynamicResource Ui_Common_Save}" Command="{Binding SaveCommand}"
                  Classes="CkanPrimary"
                  IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="{DynamicResource Ui_ModPackEditorPage_Save_Tip}" />
        </WrapPanel>
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Text="{DynamicResource Ui_ModPackEditorPage_SavePath}" VerticalAlignment="Center"
                     Margin="0,0,8,0"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBox Grid.Column="1" Tag="FilePath" Text="{Binding FilePath, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource Ui_ModPackEditorPage_SavePath_Placeholder}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 错误 + 校验问题 -->
    <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
      <Border IsVisible="{Binding HasError}"
              Classes="CkanInfoBanner Danger"
              Padding="{DynamicResource CkanToolbarPadding}">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding ErrorText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource CkanDangerBrush}" />
            <Button Grid.Column="1" Content="{DynamicResource Ui_ModPackEditorPage_Revalidate}" Command="{Binding ValidateCommand}"
                    Classes="CkanGhost CkanSmall"
                    ToolTip.Tip="{DynamicResource Ui_ModPackEditorPage_Revalidate_Tip}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding HasIssues}"
              Classes="CkanInfoBanner Warning"
              Padding="{DynamicResource CkanToolbarPadding}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding IssueSummary}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <ItemsControl ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 基础表单 -->
    <!-- 可滚动内容区：三张元数据卡 + 关系表 -->
    <ScrollViewer Grid.Row="3" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled">
    <!-- 左：可编辑表单（三段式卡片 + 关系表）；右：实时 JSON 预览（Studio 式对照） -->
    <Grid ColumnDefinitions="*,12,340">
    <StackPanel Grid.Column="0" Spacing="12">

    <!-- 基础表单拆成三张语义卡（标识与版本 / 说明 / 作者与许可证），避免一张长表 8 行平铺 -->
    <StackPanel Spacing="12">

      <!-- ① 标识与版本 -->
      <Border Classes="CkanCard" Padding="{DynamicResource CkanToolbarPadding}">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource Ui_ModPackEditorPage_SectionIdVersion}" Classes="CkanSectionTitle" />
          <Grid ColumnDefinitions="88,*,88,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="8" ColumnSpacing="8">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Ui_Common_Identifier}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="0" Grid.Column="1" Tag="Identifier" Text="{Binding Identifier, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Ui_ModPackEditorPage_Id_Placeholder}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Ui_Common_Name}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="0" Grid.Column="3" Tag="Name" Text="{Binding Name, Mode=TwoWay}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Ui_Common_Version}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="1" Grid.Column="1" Tag="Version" Text="{Binding Version, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_ModPackEditorPage_Version_Placeholder}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Ui_ModPackEditorPage_SpecVersion}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="1" Grid.Column="3" Tag="SpecVersion" Text="{Binding SpecVersion, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Ui_ModPackEditorPage_SpecVersion_Placeholder}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Ui_ModPackEditorPage_ReleaseStatus}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Tag="ReleaseStatus" ItemsSource="{Binding ReleaseStatusOptions}"
                      SelectedItem="{Binding ReleaseStatus, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource Ui_ModPackEditorPage_PackageKind}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <ComboBox Grid.Row="2" Grid.Column="3" Tag="Kind" ItemsSource="{Binding KindOptions}"
                      SelectedItem="{Binding Kind, Mode=TwoWay}" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Ui_Common_GameVersion}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="3" Grid.Column="1" Tag="KspVersion" Text="{Binding KspVersion, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_ModPackEditorPage_GameVersion_Placeholder}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{DynamicResource Ui_ModPackEditorPage_KspMin}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="3" Grid.Column="3" Tag="KspVersionMin" Text="{Binding KspVersionMin, Mode=TwoWay}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Ui_ModPackEditorPage_KspMax}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="4" Grid.Column="1" Tag="KspVersionMax" Text="{Binding KspVersionMax, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ② 说明与下载 -->
      <Border Classes="CkanCard stagger-card" Padding="{DynamicResource CkanToolbarPadding}">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource Ui_ModPackEditorPage_SectionInfoDownload}" Classes="CkanSectionTitle" />
          <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Ui_Common_Summary}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="0" Grid.Column="1" Tag="Abstract" Text="{Binding Abstract, Mode=TwoWay}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Ui_Common_Description}" VerticalAlignment="Top" Margin="0,4,0,0"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Ui_ModPackEditorPage_DownloadUrl}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBox Grid.Row="2" Grid.Column="1" Tag="DownloadUrl" Text="{Binding DownloadUrl, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Ui_ModPackEditorPage_DownloadUrl_Placeholder}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ③ 作者与许可证 -->
      <Border Classes="CkanCard stagger-card" Padding="{DynamicResource CkanToolbarPadding}">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource Ui_ModPackEditorPage_SectionAuthorLicense}" Classes="CkanSectionTitle" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{DynamicResource Ui_ModPackEditor_LabelAuthor}" FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding NewAuthor, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_ModPackEditorPage_Author_Placeholder}" />
                <Button Grid.Column="1" Content="{DynamicResource Ui_Common_Add}" Classes="CkanSecondary CkanSmall" Command="{Binding AddAuthorCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Authors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Height="{DynamicResource CkanRowHeight}">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayText}" VerticalAlignment="Center"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                      <Button Grid.Column="1" Content="{DynamicResource Ui_Common_Delete}" Classes="CkanGhost CkanSmall"
                              Command="{Binding $parent[ItemsControl].DataContext.RemoveAuthorCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{DynamicResource Ui_ModPackEditor_LabelLicense}" FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding NewLicense, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_ModPackEditorPage_License_Placeholder}" />
                <Button Grid.Column="1" Content="{DynamicResource Ui_Common_Add}" Classes="CkanSecondary CkanSmall" Command="{Binding AddLicenseCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Licenses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Height="{DynamicResource CkanRowHeight}">
                      <TextBlock Grid.Column="0" Text="{Binding DisplayText}" VerticalAlignment="Center"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                      <Button Grid.Column="1" Content="{DynamicResource Ui_Common_Delete}" Classes="CkanGhost CkanSmall"
                              Command="{Binding $parent[ItemsControl].DataContext.RemoveLicenseCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 关系表 -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          Classes="stagger-card"
          RenderTransform="translate(0px, 0px)">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui_ModPackEditorPage_SectionRelationships}"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}"
                     VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_ModPackEditorPage_Relationships_Tip}">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
        </StackPanel>
        <Button Grid.Column="1" Content="{DynamicResource Ui_ModPackEditorPage_AddRelationship}" Classes="CkanPrimary" Command="{Binding AddRelationCommand}"
                ToolTip.Tip="{DynamicResource Ui_ModPackEditorPage_AddRelationship_Tip}" />
      </Grid>

      <Border Grid.Row="1" Padding="8,4" IsVisible="{Binding !ShowEmptyRelations}"
              CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
              BorderBrush="{DynamicResource CkanBorderBrush}"
              BorderThickness="1"
              Background="{DynamicResource CkanStatusBarBackgroundBrush}">
        <Grid ColumnDefinitions="110,110,*,160,56">
          <TextBlock Grid.Column="0" Text="{DynamicResource Ui_Common_Type}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Ui_ModPackEditorPage_Semantics}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBlock Grid.Column="2" Text="{DynamicResource Ui_ModPackEditorPage_TargetMod}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBlock Grid.Column="3" Text="{DynamicResource Ui_ModPackEditorPage_VersionRange}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </Grid>
      </Border>

      <ListBox Grid.Row="2" Height="200" ItemsSource="{Binding Relations}"
               BorderBrush="{DynamicResource CkanBorderBrush}"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="110,110,*,160,56" Height="{DynamicResource CkanRowHeight}">
              <ComboBox Grid.Column="0" Margin="0,0,6,0"
                        ItemsSource="{Binding $parent[ListBox].DataContext.RelationTypeOptions}"
                        SelectedItem="{Binding RelationType, Mode=TwoWay}" />
              <ComboBox Grid.Column="1" Margin="0,0,6,0"
                        ItemsSource="{Binding $parent[ListBox].DataContext.ModeOptions}"
                        SelectedItem="{Binding Mode, Mode=TwoWay}" />

              <TextBox Grid.Column="2" Margin="0,0,6,0" IsVisible="{Binding IsSingleMode}"
                       Text="{Binding Name, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_ModPackEditorPage_TargetMod_Placeholder}" />
              <TextBox Grid.Column="2" Margin="0,0,6,0" IsVisible="{Binding IsCandidateMode}"
                       Text="{Binding CandidatesText, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_ModPackEditorPage_ChoiceMods_Placeholder}" />

              <Grid Grid.Column="3" ColumnDefinitions="*,*" ColumnSpacing="4" IsVisible="{Binding IsSingleMode}">
                <TextBox Grid.Column="0" Text="{Binding MinVersion, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_Common_MinBound}" />
                <TextBox Grid.Column="1" Text="{Binding MaxVersion, Mode=TwoWay}" PlaceholderText="{DynamicResource Ui_Common_MaxBound}" />
              </Grid>
              <TextBlock Grid.Column="3" Text="{Binding VersionText}" VerticalAlignment="Center"
                         IsVisible="{Binding IsCandidateMode}"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />

              <Button Grid.Column="4" Content="{DynamicResource Ui_Common_Delete}" Classes="CkanGhost CkanSmall"
                      Command="{Binding $parent[ListBox].DataContext.RemoveRelationCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="3" IsVisible="{Binding ShowEmptyRelations}"
              Margin="0,6,0,0"
              Classes="CkanEmptyStateCard"
              Padding="{DynamicResource CkanToolbarPadding}">
        <TextBlock Text="{DynamicResource Ui_ModPackEditorPage_NoRelationshipsNotice}"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
      </Border>
    </Grid>
    </StackPanel>

    <!-- 实时 JSON 预览：只读镜像，随表单即时刷新 -->
    <Border Grid.Column="2" Classes="CkanCard" Padding="12"
            VerticalAlignment="Top">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{DynamicResource Ui_ModPackEditorPage_RealtimeJsonHeader}" Classes="CkanSectionTitle" VerticalAlignment="Center" />
          <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                    Data="{StaticResource CkanIconHelp}"
                    Foreground="{DynamicResource CkanTextTertiaryBrush}"
                    ToolTip.Tip="{DynamicResource Ui_ModPackEditorPage_RealtimeJson_Tip}" />
        </StackPanel>
        <Border Background="{DynamicResource CkanSubtleBackgroundBrush}"
                BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource CkanCornerRadiusSmall}" Padding="10,8">
          <SelectableTextBlock Text="{Binding JsonPreviewText}"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </Border>
      </StackPanel>
    </Border>
    </Grid>
    </ScrollViewer>

    <!-- 状态栏 -->
    <Border Grid.Row="4" Classes="CkanPageFooter" Margin="0,12,0,0">
    <Grid ColumnDefinitions="Auto,*">
      <TextBlock Grid.Column="0" Text="{Binding BusyText}" IsVisible="{Binding IsBusy}"
                 Margin="0,0,8,0"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanAccentBrush}" />
      <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}" />
    </Grid>
    </Border>
  </Grid>
</UserControl>
