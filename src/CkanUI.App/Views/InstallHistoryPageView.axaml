<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CkanUI.App.Views.InstallHistoryPageView"
             x:CompileBindings="False">
  <!-- 安装历史页（03 篇 §6 / 12 篇 F-44 / UI-23 / 04 篇 §5）：
       左侧是每次安装/卸载/升级的时间戳列表，右侧是该时间点的已装集合分组（已装 / 未装），
       底部「从历史重装」把当前实例回退到选中的时间点。颜色/圆角全部走 Tokens.axaml 的语义 token。 -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="安装历史"
                   FontSize="{DynamicResource CkanFontSizeTitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
        <TextBlock Text="每次安装、卸载、升级都会记一条（含当时的已装集合快照）。选中某条历史可以把它重装回来；重装只按该时间点的模组集合计算变更，不会卸载快照之外的模组。"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding InstanceTitleText}"
                 VerticalAlignment="Center"
                 MaxWidth="360" TextWrapping="Wrap"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}" />
    </Grid>

    <!-- 工具条：刷新 + 重装 -->
    <Border Grid.Row="1" Padding="{DynamicResource CkanToolbarPadding}"
            CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
            BorderBrush="{DynamicResource CkanBorderBrush}"
            BorderThickness="1">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <Button Content="刷新" Command="{Binding LoadCommand}"
                  IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"
                  ToolTip.Tip="重新读取当前实例的 install_history.jsonl" />
          <Button Content="从历史重装" Command="{Binding RestoreCommand}"
                  IsEnabled="{Binding CanRestore}" Margin="0,0,16,0"
                  ToolTip.Tip="把当前实例的已装集合回退到左侧选中的时间点（走变更集 + 安装流水线）" />
          <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Margin="0,0,12,0"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <TextBlock Text="{Binding RestoreHintText}" VerticalAlignment="Center"
                     MaxWidth="640" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </WrapPanel>
        <StackPanel Spacing="4" IsVisible="{Binding HasProgress}">
          <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" />
          <TextBlock Text="{Binding ProgressText}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 左：历史列表；右：该时间点的已装集合 -->
    <Grid Grid.Row="2" ColumnDefinitions="360,*" Margin="0,8,0,0">

      <Grid Grid.Column="0" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="8,4"
                BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="时间点 / 操作 / 结果"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="变更数"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </Grid>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent"
                 IsVisible="{Binding HasEntries}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2" Margin="0,2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding TimestampText}"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                  <Border Grid.Column="1" Padding="6,0"
                          CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                          Background="{DynamicResource CkanStatusBarBackgroundBrush}"
                          IsVisible="{Binding IsFailure}">
                    <TextBlock Text="失败"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanDangerBrush}" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                <TextBlock Text="{Binding MessageText}" IsVisible="{Binding HasMessage}"
                           TextWrapping="Wrap" MaxLines="2"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanDangerBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" IsVisible="{Binding ShowEmptyState}" Padding="16">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="320">
            <TextBlock Text="还没有安装历史"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeSubtitle}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBlock Text="装、卸、升级任意模组后会自动记一条（含当时的已装集合快照），之后就能从这里回退。"
                       TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="{DynamicResource CkanFontSizeBody}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            <Button Content="刷新" Command="{Binding LoadCommand}"
                    IsEnabled="{Binding IsIdle}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- 右侧详情 -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="16,0,0,0">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
          <TextBlock Text="{Binding SelectionTitleText}"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectionSummaryText}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding RestorePreviewText}" IsVisible="{Binding HasRestorePreview}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding RestoreResultText}" IsVisible="{Binding HasRestoreResult}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanSuccessBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">

            <!-- 已装分组 -->
            <StackPanel Spacing="4" IsVisible="{Binding HasInstalledModules}">
              <TextBlock Text="{Binding InstalledGroupTitle}"
                         FontSize="{DynamicResource CkanFontSizeSubtitle}"
                         Foreground="{DynamicResource CkanSuccessBrush}" />
              <ItemsControl ItemsSource="{Binding InstalledModules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="2*,Auto,2*" Height="{DynamicResource CkanRowHeight}">
                      <TextBlock Grid.Column="0" Text="{Binding Identifier}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding StateText}" Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding VersionText}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 未装 / 版本不同分组 -->
            <StackPanel Spacing="4" IsVisible="{Binding HasMissingModules}">
              <TextBlock Text="{Binding MissingGroupTitle}"
                         FontSize="{DynamicResource CkanFontSizeSubtitle}"
                         Foreground="{DynamicResource CkanWarningBrush}" />
              <ItemsControl ItemsSource="{Binding MissingModules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="2*,Auto,2*" Height="{DynamicResource CkanRowHeight}">
                      <TextBlock Grid.Column="0" Text="{Binding Identifier}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding StateText}" Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Foreground="{DynamicResource CkanWarningBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding VersionText}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- 状态栏 / 错误 -->
    <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,4"
            CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
            Background="{DynamicResource CkanStatusBarBackgroundBrush}">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanDangerBrush}" />
        <TextBlock Text="{Binding ErrorDetail}" IsVisible="{Binding HasErrorDetail}" TextWrapping="Wrap"
                   FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
