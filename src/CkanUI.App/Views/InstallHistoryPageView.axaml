<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.Ui.Theming"
             x:Class="CkanUI.App.Views.InstallHistoryPageView"
             x:CompileBindings="False">
  <!-- 安装历史页（03 篇 §6 / 12 篇 F-44 / UI-23 / 04 篇 §5）：
       左侧是每次安装/卸载/升级的时间戳列表，右侧是该时间点的已装集合分组（已装 / 未装），
       底部「从历史重装」把当前实例回退到选中的时间点。颜色/圆角全部走 Tokens.axaml 的语义 token。
       视觉规范：卡片/工具条/空态/错误条/骨架屏统一复用 FluentStyles 的 Ckan* 类。 -->
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="{DynamicResource CkanRowHeight}" />
    </Style>
    <!-- 选中行左侧 3px 强调条（沿用导航栏 navIndicator 的做法） -->
    <Style Selector="Rectangle.SelectionBar">
      <Setter Property="Width" Value="3" />
      <Setter Property="RadiusX" Value="1.5" />
      <Setter Property="RadiusY" Value="1.5" />
      <Setter Property="Fill" Value="{DynamicResource CkanAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="2,4" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected Rectangle.SelectionBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui_NavRail_InstallHistory}" Classes="CkanPageTitle" VerticalAlignment="Center" />
          <Button Classes="CkanHelper" VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Ui_InstallHistoryPage_Header_Tip}">
            <PathIcon Data="{StaticResource CkanIconHelp}" />
          </Button>
        </StackPanel>
        <TextBlock Text="{DynamicResource Ui_InstallHistoryPage_Subtitle}"
                   Classes="CkanCaption" TextWrapping="Wrap" />
      </StackPanel>
      <!-- 没有实例时这句由页面级空态卡承担，页头不再重复一遍 -->
      <TextBlock Grid.Column="1" Text="{Binding InstanceTitleText}" Classes="CkanCaption"
                 TextWrapping="Wrap" MaxWidth="360" Margin="12,0,0,0"
                 TextAlignment="Right" VerticalAlignment="Center"
                 IsVisible="{Binding HasActiveInstance}"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}" />
    </Grid>

    <!-- 工具条：刷新 + 重装 -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <Button Content="{DynamicResource Ui_Common_Refresh}" Command="{Binding LoadCommand}"
                  IsEnabled="{Binding IsIdle}" Classes="CkanPrimary" Margin="0,0,8,0"
                  ToolTip.Tip="{DynamicResource Ui_InstallHistoryPage_Refresh_Tip}" />
          <Button Content="{DynamicResource Ui_InstallHistoryPage_ReinstallFromHistory}" Command="{Binding RestoreCommand}"
                  IsEnabled="{Binding CanRestore}" Classes="CkanSecondary" Margin="0,0,8,0"
                  ToolTip.Tip="{DynamicResource Ui_InstallHistoryPage_Reinstall_Tip}" />
          <Button Content="{DynamicResource Ui_CachePage_DeleteSelected}" Command="{Binding DeleteSelectedCommand}"
                  IsEnabled="{Binding CanDeleteSelected}" Classes="CkanDanger" Margin="0,0,8,0"
                  ToolTip.Tip="{DynamicResource Ui_InstallHistoryPage_Delete_Tip}" />
          <Button Content="{DynamicResource Ui_InstallHistoryPage_ClearAll}" Command="{Binding ClearHistoryCommand}"
                  IsEnabled="{Binding CanClearHistory}" Classes="CkanDanger" Margin="0,0,16,0"
                  ToolTip.Tip="{DynamicResource Ui_InstallHistoryPage_ClearAll_Tip}" />
        </WrapPanel>
        <!-- 重装的附加开关：勾上才把快照之外的模组也卸掉（默认只按快照里的模组算变更）。
             只在选中了某条历史时出现——没有选中项时这个开关没有作用对象。 -->
        <CheckBox Content="{DynamicResource Ui_InstallHistoryPage_UninstallOthers}"
                  IsChecked="{Binding RemoveExtras, Mode=TwoWay}"
                  IsVisible="{Binding HasSelection}"
                  IsEnabled="{Binding HasSelection}"
                  ToolTip.Tip="{DynamicResource Ui_InstallHistoryPage_UninstallOthers_Tip}" />
        <TextBlock Text="{Binding RestoreHintText}" TextWrapping="Wrap" Classes="CkanCaption"
                   Foreground="{DynamicResource CkanTextTertiaryBrush}" IsVisible="{Binding HasActiveInstance}" />
        <StackPanel Spacing="4" IsVisible="{Binding HasProgress}">
          <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" />
          <TextBlock Text="{Binding ProgressText}" Classes="CkanCaption" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 页面级错误条 -->
    <Border Grid.Row="2" Margin="0,12,0,0" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0"
                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="Medium"
                     Foreground="{DynamicResource CkanDangerBrush}" />
          <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" MaxHeight="48"
                     IsVisible="{Binding HasErrorDetail}"
                     FontSize="{DynamicResource CkanFontSizeCaption}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="{DynamicResource Ui_Common_Retry}" Command="{Binding LoadCommand}" IsEnabled="{Binding IsIdle}"
                  Classes="CkanSmall" ToolTip.Tip="{DynamicResource Ui_InstallHistoryPage_ReloadHistory_Tip}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 左：历史列表；右：该时间点的已装集合 -->
    <Grid Grid.Row="3" ColumnDefinitions="360,*" Margin="0,12,0,0">

      <!-- 没有选中实例时整页只留一张空态卡：左卡右卡同时消失，避免两条"先选实例"叠在一起 -->
      <Border Grid.Column="0" Grid.ColumnSpan="2" Classes="CkanEmptyStateCard Elevated" Margin="0"
              IsVisible="{Binding !HasActiveInstance}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
          <Border Classes="CkanIconTile Lg Muted" HorizontalAlignment="Center">
            <PathIcon Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" />
          </Border>
          <TextBlock Text="{DynamicResource Ui_InstallHistoryPage_NoInstanceTitle}" HorizontalAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource Ui_InstallHistoryPage_NoInstanceSubtitle}"
                     TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          <Button Content="{DynamicResource Ui_ModConfigPage_GoToInstancesPage}" Classes="CkanSecondary" HorizontalAlignment="Center"
                  Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                  CommandParameter="instances" />
        </StackPanel>
      </Border>

      <Border Grid.Column="0" Classes="CkanCard" Padding="0" IsVisible="{Binding HasActiveInstance}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Padding="10,7" IsVisible="{Binding !ShowEmptyState}"
                  Background="{DynamicResource CkanSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource CkanBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{DynamicResource Ui_InstallHistoryPage_ColTimeOpResult}" Classes="CkanCaption" />
              <TextBlock Grid.Column="1" Text="{DynamicResource Ui_InstallHistoryPage_ColChanges}" Classes="CkanCaption" />
            </Grid>
          </Border>

          <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" Padding="4"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent"
                   IsVisible="{Binding HasEntries}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,Auto,*">
                  <Rectangle Grid.Column="0" Classes="SelectionBar" />
                  <!-- 时间轴：竖线贯穿每行，圆点标记结果（失败用危险色） -->
                  <Panel Grid.Column="1" Width="18">
                    <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                               Fill="{DynamicResource CkanBorderBrush}" />
                    <Border Width="9" Height="9" CornerRadius="5"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                            Background="{DynamicResource CkanAccentBrush}"
                            BorderBrush="{DynamicResource CkanSurfaceBackgroundBrush}" BorderThickness="2"
                            IsVisible="{Binding !IsFailure}" />
                    <Border Width="9" Height="9" CornerRadius="5"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                            Background="{DynamicResource CkanDangerBrush}"
                            BorderBrush="{DynamicResource CkanSurfaceBackgroundBrush}" BorderThickness="2"
                            IsVisible="{Binding IsFailure}" />
                  </Panel>
                  <StackPanel Grid.Column="2" Spacing="2" Margin="2,4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding TimestampText}"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                      <Border Grid.Column="1" Classes="CkanBadge Danger" IsVisible="{Binding IsFailure}">
                        <TextBlock Text="{DynamicResource Ui_Common_Failed}" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Text="{Binding MessageText}" IsVisible="{Binding HasMessage}"
                               TextWrapping="Wrap" MaxLines="2"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanDangerBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="1" Classes="CkanEmptyStateCard Flat" Margin="12"
                  IsVisible="{Binding ShowEmptyState}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="320">
              <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
                <PathIcon Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" />
              </Border>
              <TextBlock Text="{DynamicResource Ui_InstallHistoryPage_EmptyTitle}" HorizontalAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="{DynamicResource Ui_InstallHistoryPage_EmptySubtitle}"
                         ToolTip.Tip="{DynamicResource Ui_InstallHistoryPage_EmptyHint_Tip}"
                         TextWrapping="Wrap" TextAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeBody}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              <Button Content="{DynamicResource Ui_Common_Refresh}" Command="{Binding LoadCommand}"
                      IsEnabled="{Binding IsIdle}"
                      Classes="CkanPrimary" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- 右侧详情 -->
      <Border Grid.Column="1" Margin="12,0,0,0" Classes="CkanCard" IsVisible="{Binding HasActiveInstance}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10" IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding SelectionTitleText}" Classes="CkanCardTitle" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectionSummaryText}" Classes="CkanCaption" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RestorePreviewText}" IsVisible="{Binding HasRestorePreview}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <Border Classes="CkanBadge Success" HorizontalAlignment="Left"
                    IsVisible="{Binding HasRestoreResult}">
              <TextBlock Text="{Binding RestoreResultText}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <!-- 未选中时的空态：右栏只剩一个空壳，容易读成"加载失败" -->
          <Border Grid.Row="1" Classes="CkanEmptyStateCard Flat" Margin="0,12,0,0"
                  IsVisible="{Binding !HasSelection}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="320">
              <Border Classes="CkanIconTile Lg Muted" HorizontalAlignment="Center">
                <PathIcon Data="M4 5h16v2H4V5zm0 6h16v2H4v-2zm0 6h10v2H4v-2z" />
              </Border>
              <TextBlock Text="{DynamicResource Ui_InstallHistory_Selection_None}" HorizontalAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="{DynamicResource Ui_InstallHistoryPage_SelectInstanceFirst_Tip}"
                         TextWrapping="Wrap" TextAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeBody}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}"
                         IsVisible="{Binding !HasActiveInstance}" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="12">

              <!-- 已装分组 -->
              <StackPanel Spacing="6" IsVisible="{Binding HasInstalledModules}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding InstalledGroupTitle}" Classes="CkanSectionTitle"
                             VerticalAlignment="Center" />
                  <Border Classes="CkanBadge Success" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Ui_ManageMods_FilterInstalled}" />
                  </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding InstalledModules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2*,Auto,2*" MinHeight="{DynamicResource CkanRowHeight}">
                        <TextBlock Grid.Column="0" Text="{Binding Identifier}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource CkanFontSizeCaption}"
                                   Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding VersionText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeCaption}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- 未装 / 版本不同分组 -->
              <StackPanel Spacing="6" IsVisible="{Binding HasMissingModules}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding MissingGroupTitle}" Classes="CkanSectionTitle"
                             VerticalAlignment="Center" />
                  <Border Classes="CkanBadge Warning" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Ui_InstallHistoryPage_PendingReinstall}" />
                  </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding MissingModules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2*,Auto,2*" MinHeight="{DynamicResource CkanRowHeight}">
                        <TextBlock Grid.Column="0" Text="{Binding Identifier}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource CkanFontSizeCaption}"
                                   Foreground="{DynamicResource CkanWarningBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding VersionText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeCaption}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="4" Margin="0,12,0,0" Classes="CkanPageFooter">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextWrapping="Wrap" Classes="CkanCaption"
                   IsVisible="{Binding HasActiveInstance}" />
        <TextBlock Grid.Column="1" Text="{Binding CountText}" Margin="12,0,0,0"
                   IsVisible="{Binding !ShowEmptyState}"
                   Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeCaption}"
                   Foreground="{DynamicResource CkanTextTertiaryBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 进行中遮罩：无历史时骨架屏，有历史时进度条（同一时刻只有一个脉动元素） -->
    <Border Grid.RowSpan="5" IsVisible="{Binding IsBusy}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Grid>
        <StackPanel IsVisible="{Binding !HasEntries}" IsHitTestVisible="False"
                    app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="180" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasEntries}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
