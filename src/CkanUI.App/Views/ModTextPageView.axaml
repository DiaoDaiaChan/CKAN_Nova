<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CkanUI.ViewModels.Pages"
             xmlns:modtext="using:CkanUI.ViewModels.Pages.ModText"
             x:Class="CkanUI.App.Views.ModTextPageView"
             x:CompileBindings="False">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16"
        Background="{DynamicResource CkanSurfaceBackgroundBrush}">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="模组翻译"
                 FontSize="{DynamicResource CkanFontSizeTitle}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
      <TextBlock Text="与 UniversalI18n (UI18n.Core) 深度联动。管理与查看 packs/&lt;lang&gt;/*.jsonl 词库及 overrides.jsonl 覆盖层，支持条目检索与实时热重载。"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <!-- 工具栏 -->
    <Border Grid.Row="1"
            Background="{DynamicResource CkanSubtleBackgroundBrush}"
            BorderBrush="{DynamicResource CkanBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
            Padding="12,8"
            Margin="0,0,0,12">
      <Grid ColumnDefinitions="Auto,120,16,*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Text="语言："
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}"
                   Margin="0,0,6,0" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" />

        <TextBox Grid.Column="3"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 PlaceholderText="搜索源文、译文、Mod ID 或上下文..."
                 VerticalContentAlignment="Center"
                 Margin="0,0,12,0" />

        <CheckBox Grid.Column="4"
                  Content="仅看人工覆盖"
                  IsChecked="{Binding FilterOverrideOnly, Mode=TwoWay}"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0" />

        <Button Grid.Column="5"
                Content="同步 UniversalI18n"
                Command="{Binding SyncFromUniversalI18nCommand}"
                CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                Padding="12,6"
                Margin="0,0,8,0" />

        <Button Grid.Column="6"
                Content="重新加载"
                Command="{Binding ReloadCommand}"
                CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                Padding="12,6"
                Margin="0,0,8,0" />

        <Button Grid.Column="7"
                Content="打开目录"
                Command="{Binding OpenFolderCommand}"
                CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                Padding="12,6" />
      </Grid>
    </Border>

    <!-- 主工作区：左侧文件与条目列表，右侧人工覆盖编辑面板 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,16,400">

      <!-- 左栏：语言包文件与词条列表 -->
      <Grid Grid.Column="0" RowDefinitions="Auto,8,*">
        <!-- 文件概览折叠条 -->
        <Border Grid.Row="0"
                Background="{DynamicResource CkanSubtleBackgroundBrush}"
                BorderBrush="{DynamicResource CkanBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                Padding="10,6">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="当前加载文件清单："
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding PackFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding RelativePath}"
                               FontSize="11" Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding EntryCount, StringFormat='{}条目: {0}'}"
                               FontSize="11" Foreground="{DynamicResource CkanTextSecondaryBrush}"
                               Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding LastModifiedUtc, StringFormat='{}修改: {0:yyyy-MM-dd HH:mm}'}"
                               FontSize="11" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <!-- 条目列表 -->
        <Border Grid.Row="2"
                Background="{DynamicResource CkanSubtleBackgroundBrush}"
                BorderBrush="{DynamicResource CkanBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                Padding="4">
          <ListBox ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid RowDefinitions="Auto,Auto,Auto" Margin="4,4">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Identifier}"
                                 FontWeight="SemiBold"
                                 FontSize="{DynamicResource CkanFontSizeBody}"
                                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                      <TextBlock Text="{Binding Field}"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Foreground="{DynamicResource CkanTextTertiaryBrush}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource CkanBorderBrush}"
                            CornerRadius="4" Padding="6,1">
                      <TextBlock Text="{Binding SourceBadge}"
                                 FontSize="10"
                                 Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    </Border>
                  </Grid>

                  <TextBlock Grid.Row="1" Text="{Binding Source, StringFormat='{}源文: {0}'}"
                             FontSize="{DynamicResource CkanFontSizeCaption}"
                             Foreground="{DynamicResource CkanTextSecondaryBrush}"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                             Margin="0,2,0,0" />

                  <TextBlock Grid.Row="2" Text="{Binding Translation, StringFormat='{}译文: {0}'}"
                             FontSize="{DynamicResource CkanFontSizeBody}"
                             Foreground="{DynamicResource CkanAccentBrush}"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                             Margin="0,2,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <!-- 右栏：人工覆盖编辑面板 -->
      <Border Grid.Column="2"
              Background="{DynamicResource CkanSubtleBackgroundBrush}"
              BorderBrush="{DynamicResource CkanBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
              Padding="16">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="人工覆盖翻译 (Override)"
                       FontSize="{DynamicResource CkanFontSizeSubtitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />

            <TextBlock Text="在此输入或修改条目翻译，保存后将写入 overrides.jsonl。优先于通用词典生效并实时热应用。"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       TextWrapping="Wrap" />

            <Separator Background="{DynamicResource CkanBorderBrush}" Height="1" Margin="0,4" />

            <TextBlock Text="Mod 标识符 (Identifier)："
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBox Text="{Binding EditIdentifier, Mode=TwoWay}"
                     PlaceholderText="例如 MechJeb2" />

            <TextBlock Text="字段类型："
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBox Text="{Binding EditField, Mode=TwoWay}"
                     PlaceholderText="abstract 或 description" />

            <TextBlock Text="英文源文 (Source)："
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBox Text="{Binding EditSource, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="70"
                     PlaceholderText="请输入待翻译的模组英文原文..." />

            <TextBlock Text="本地化译文 (Translation)："
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBox Text="{Binding EditTranslation, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="70"
                     PlaceholderText="请输入中文翻译..." />

            <Button Content="保存至 overrides.jsonl 并生效"
                    Command="{Binding SaveOverrideCommand}"
                    Background="{DynamicResource CkanAccentBrush}"
                    Foreground="{DynamicResource CkanTextInverseBrush}"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="12,8"
                    Margin="0,8,0,0" />

            <Button Content="删除此条目覆盖 (Delete Override)"
                    Command="{Binding DeleteOverrideCommand}"
                    Background="Transparent"
                    BorderBrush="{DynamicResource CkanBorderBrush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource CkanErrorBrush}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="12,6"
                    Margin="0,6,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- 页脚状态栏 -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
      <TextBlock Grid.Column="0" Text="{Binding SummaryText}"
                 FontSize="12" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
      <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                 FontSize="12" Foreground="{DynamicResource CkanTextTertiaryBrush}"
                 Margin="16,0" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="2" Text="{Binding StorageDirectory, StringFormat='{}存放路径: {0}'}"
                 FontSize="11" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
    </Grid>
  </Grid>
</UserControl>
