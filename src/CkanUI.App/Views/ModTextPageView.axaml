<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CkanUI.ViewModels.Pages"
             xmlns:modtext="using:CkanUI.ViewModels.Pages.ModText"
             x:Class="CkanUI.App.Views.ModTextPageView"
             x:CompileBindings="False">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource Ui_ModText_Title}" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <Button Classes="CkanHelper" VerticalAlignment="Center"
                ToolTip.Tip="{DynamicResource Ui_ModTextPage_Header_Tip}">
          <PathIcon Data="{StaticResource CkanIconHelp}" />
        </Button>
      </StackPanel>
      <TextBlock Text="{DynamicResource Ui_ModTextPage_Subtitle}"
                 Classes="CkanCaption" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 工具栏 -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card" Margin="0,0,0,12">
      <Grid ColumnDefinitions="Auto,120,16,*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Text="{DynamicResource Ui_ModTextPage_LanguageLabel}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource CkanTextPrimaryBrush}"
                   Margin="0,0,6,0" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" />

        <TextBox Grid.Column="3"
                 Text="{Binding SearchQuery, Mode=TwoWay}"
                 Classes="CkanSearchBox"
                 PlaceholderText="{DynamicResource Ui_ModTextPage_Search_Placeholder}"
                 VerticalContentAlignment="Center"
                 Margin="0,0,12,0" />

        <CheckBox Grid.Column="4"
                  Content="{DynamicResource Ui_ModTextPage_OverridesOnly}"
                  IsChecked="{Binding FilterOverrideOnly, Mode=TwoWay}"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0" />

        <Button Grid.Column="5"
                Content="{DynamicResource Ui_ModTextPage_SyncUi18n}"
                Classes="CkanSecondary"
                Command="{Binding SyncFromUniversalI18nCommand}"
                Margin="0,0,8,0" />

        <Button Grid.Column="6"
                Content="{DynamicResource Ui_ModTextPage_Reload}"
                Classes="CkanSecondary"
                Command="{Binding ReloadCommand}"
                Margin="0,0,8,0" />

        <Button Grid.Column="7"
                Content="{DynamicResource Ui_Settings_Auxiliary_OpenFolder}"
                Classes="CkanGhost"
                Command="{Binding OpenFolderCommand}" />
      </Grid>
    </Border>

    <!-- 主工作区：左侧文件与条目列表，右侧人工覆盖编辑面板 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,6,400">

      <!-- 左栏：语言包文件与词条列表 -->
      <Grid Grid.Column="0" RowDefinitions="Auto,8,*">
        <!-- 文件概览折叠条 -->
        <Border Grid.Row="0" Classes="CkanCard" Padding="10,8"
                IsVisible="{Binding HasPackFiles}">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Ui_ModTextPage_LoadedFiles}"
                       Classes="CkanSectionTitle"
                       Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding PackFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding RelativePath}"
                               FontSize="{DynamicResource CkanFontSizeCaption}"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="8,0">
                      <TextBlock Text="{DynamicResource Ui_ModTextPage_EntriesPrefix}" FontSize="{DynamicResource CkanFontSizeCaption}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                      <TextBlock Text="{Binding EntryCount}" FontSize="{DynamicResource CkanFontSizeCaption}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="{DynamicResource Ui_ModTextPage_ModifiedPrefix}" FontSize="{DynamicResource CkanFontSizeCaption}" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                      <TextBlock Text="{Binding LastModifiedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="{DynamicResource CkanFontSizeCaption}" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <!-- 条目列表 -->
        <Border Grid.Row="2" Classes="CkanCard" Padding="4"
                IsVisible="{Binding HasEntries}">
          <ListBox ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid RowDefinitions="Auto,Auto,Auto" Margin="6,6">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Identifier}"
                                 FontWeight="SemiBold"
                                 FontSize="{DynamicResource CkanFontSizeBody}"
                                 Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                      <TextBlock Text="{Binding Field}"
                                 FontSize="{DynamicResource CkanFontSizeCaption}"
                                 Foreground="{DynamicResource CkanTextTertiaryBrush}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="CkanBadge" Padding="6,1">
                      <TextBlock Text="{Binding SourceBadge}"
                                 FontSize="{DynamicResource CkanFontSizeCaption}" />
                    </Border>
                  </Grid>

                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" Margin="0,3,0,0">
                    <TextBlock Text="{DynamicResource Ui_ModTextPage_SourcePrefix}" FontSize="{DynamicResource CkanFontSizeCaption}" Foreground="{DynamicResource CkanTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Source}" FontSize="{DynamicResource CkanFontSizeCaption}" Foreground="{DynamicResource CkanTextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" Margin="0,3,0,0">
                    <TextBlock Text="{DynamicResource Ui_ModTextPage_TranslationPrefix}" FontSize="{DynamicResource CkanFontSizeBody}" Foreground="{DynamicResource CkanAccentBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Translation}" FontSize="{DynamicResource CkanFontSizeBody}" Foreground="{DynamicResource CkanAccentBrush}" FontWeight="Medium" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- 空态：没有匹配条目 -->
        <Border Grid.Row="2" Classes="CkanEmptyStateCard Elevated stagger-card" Margin="0"
                IsVisible="{Binding !HasEntries}">
          <Grid>
            <Border Classes="CkanEmptyStateGlow" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="380">
              <Border Classes="CkanIconTile Lg Muted" HorizontalAlignment="Center">
                <PathIcon Data="M4 5h16v2H4V5zm0 6h16v2H4v-2zm0 6h10v2H4v-2z" />
              </Border>
              <TextBlock Text="{DynamicResource Ui_ModTextPage_NoMatchesTitle}" HorizontalAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource CkanTextPrimaryBrush}" />
              <TextBlock Text="{DynamicResource Ui_ModTextPage_NoMatchesSubtitle}"
                         ToolTip.Tip="{DynamicResource Ui_ModTextPage_SavedOverridesUnaffected_Tip}"
                         TextWrapping="Wrap" TextAlignment="Center"
                         FontSize="{DynamicResource CkanFontSizeBody}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- 分割条（GridSplitter） -->
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />

      <!-- 右栏：人工覆盖编辑面板 -->
      <Border Grid.Column="2" Classes="CkanCard stagger-card" Padding="16" MinWidth="300" MaxWidth="600">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource Ui_ModTextPage_ManualOverrideTitle}"
                       FontSize="{DynamicResource CkanFontSizeSubtitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />

            <TextBlock Text="{DynamicResource Ui_ModTextPage_ManualOverrideSubtitle}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       ToolTip.Tip="{DynamicResource Ui_ModTextPage_OverrideTip_Tip}" />

            <Separator Background="{DynamicResource CkanBorderBrush}" Height="1" Margin="0,4" />

            <TextBlock Text="{DynamicResource Ui_ModTextPage_ModIdentifier}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBox Text="{Binding EditIdentifier, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Ui_ModTextPage_ModId_Placeholder}" />

            <TextBlock Text="{DynamicResource Ui_ModTextPage_FieldType}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <ComboBox SelectedItem="{Binding EditField, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="{DynamicResource Ui_ModTextPage_SelectField_Placeholder}">
              <ComboBox.Items>
                <x:String>abstract</x:String>
                <x:String>description</x:String>
              </ComboBox.Items>
            </ComboBox>

            <TextBlock Text="{DynamicResource Ui_ModTextPage_SourceText}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBox Text="{Binding EditSource, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="70"
                     FontFamily="Consolas, Menlo, monospace"
                     ToolTip.Tip="{DynamicResource Ui_ModTextPage_MonoSource_Tip}"
                     PlaceholderText="{DynamicResource Ui_ModTextPage_SourceText_Placeholder}" />

            <TextBlock Text="{DynamicResource Ui_ModTextPage_LocalizedText}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextPrimaryBrush}" />
            <TextBox Text="{Binding EditTranslation, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="70"
                     FontFamily="Consolas, Menlo, monospace"
                     ToolTip.Tip="{DynamicResource Ui_ModTextPage_MonoTranslation_Tip}"
                     PlaceholderText="{DynamicResource Ui_ModTextPage_LocalizedText_Placeholder}" />

            <Button Content="{DynamicResource Ui_ModTextPage_SaveAndApply}"
                    Command="{Binding SaveOverrideCommand}"
                    Classes="CkanPrimary"
                    ToolTip.Tip="{DynamicResource Ui_ModTextPage_SaveAndApply_Tip}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="12,8"
                    Margin="0,8,0,0" />

            <Button Content="{DynamicResource Ui_ModTextPage_DeleteOverride}"
                    Command="{Binding DeleteOverrideCommand}"
                    Classes="CkanDanger"
                    ToolTip.Tip="{DynamicResource Ui_ModTextPage_DeleteOverride_Tip}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="12,6"
                    Margin="0,6,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- 页脚状态栏 -->
    <Border Grid.Row="3" Classes="CkanPageFooter" Margin="0,10,0,0">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBlock Grid.Column="0" Text="{Binding SummaryText}" IsVisible="{Binding HasEntries}"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextSecondaryBrush}" />
      <TextBlock Grid.Column="0" Text="{DynamicResource Ui_ModTextPage_NoEntriesFound}" IsVisible="{Binding !HasEntries}"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextTertiaryBrush}" />
      <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" IsVisible="{Binding HasEntries}"
                 FontSize="{DynamicResource CkanFontSizeCaption}"
                 Foreground="{DynamicResource CkanTextTertiaryBrush}"
                 Margin="16,0" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
        <TextBlock Text="{DynamicResource Ui_ModTextPage_StorageDirectoryPrefix}" FontSize="{DynamicResource CkanFontSizeCaption}" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
        <TextBlock Text="{Binding StorageDirectory}" FontSize="{DynamicResource CkanFontSizeCaption}" Foreground="{DynamicResource CkanTextTertiaryBrush}" />
      </StackPanel>
    </Grid>
    </Border>
  </Grid>
</UserControl>
