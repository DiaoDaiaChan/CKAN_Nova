<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CkanUI.App.Views.Relations"
             x:Class="CkanUI.App.Views.Relations.RelationTreeView"
             x:CompileBindings="False">

  <UserControl.Resources>
    <!-- 九色图例语义画刷定义（对齐 Tokens.axaml，高对比与深浅色模式自动适配） -->
    <SolidColorBrush x:Key="CkanRelationDependsBrush" Color="#0A66C2" />
    <SolidColorBrush x:Key="CkanRelationRecommendsBrush" Color="#1B7F3B" />
    <SolidColorBrush x:Key="CkanRelationSuggestsBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="CkanRelationSupportsBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="CkanRelationConflictsBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="CkanRelationProvidesBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="CkanRelationVirtualBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="CkanRelationIncompatibleBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="CkanRelationInstalledBrush" Color="#16A34A" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*" Margin="0">
    <!-- 紧凑工具栏：视图模式分段切换 + 方向切换 + 关系网缩放（F-28 / UI-18） -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <WrapPanel Grid.Column="0" Orientation="Horizontal">
        <!-- 视图模式分段切换：详情面板默认树状图，关系网为可选增强 -->
        <Button Classes="CkanChip"
                Classes.Active="{Binding IsTreeView}"
                Command="{Binding ShowTreeViewCommand}"
                Margin="0,0,4,0"
                Content="树状图"
                ToolTip.Tip="{DynamicResource Ui_RelationTree_ToggleViewMode_Tip}" />
        <Button Classes="CkanChip"
                Classes.Active="{Binding IsGraphView}"
                Command="{Binding ShowGraphViewCommand}"
                Margin="0,0,4,0"
                Content="关系网"
                ToolTip.Tip="{DynamicResource Ui_RelationTree_ToggleViewMode_Tip}" />

        <!-- 正向/反向关系切换：仅在多模组图谱中可用 -->
        <Button Classes="CkanChip"
                Classes.Active="{Binding IsReverse}"
                Command="{Binding ToggleDirectionCommand}"
                Content="{Binding DirectionChipText}"
                IsVisible="{Binding CanToggleDirection}"
                Margin="0,0,4,0"
                ToolTip.Tip="{Binding DirectionStatusText}" />

        <!-- 关系网特有缩放控制组 -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    IsVisible="{Binding IsGraphView}"
                    VerticalAlignment="Center">
          <Button Click="OnZoomInClick" Classes="CkanSmall" Padding="8,4"
                  ToolTip.Tip="{DynamicResource Ui_RelationTree_ZoomIn_Tip}">
            <TextBlock Text="+" FontWeight="Bold" />
          </Button>
          <Button Click="OnZoomOutClick" Classes="CkanSmall" Padding="8,4"
                  ToolTip.Tip="{DynamicResource Ui_RelationTree_ZoomOut_Tip}">
            <TextBlock Text="-" FontWeight="Bold" />
          </Button>
          <Button Click="OnResetViewClick" Classes="CkanSmall" Padding="8,4"
                  ToolTip.Tip="{DynamicResource Ui_RelationTree_ResetView_Tip}">
            <TextBlock Text="⟲" />
          </Button>
        </StackPanel>
      </WrapPanel>

      <TextBlock Grid.Column="1"
                 Text="{Binding StatusText}"
                 Foreground="{DynamicResource CkanWarningBrush}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </Grid>

    <!-- 分类计数胶囊：仅展示当前存在的分类，点击就地筛选 -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding KindChips}"
                  IsVisible="{Binding HasKindChips}" Margin="0,0,0,10">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Command="{Binding $parent[UserControl].DataContext.FilterKindCommand}"
                  CommandParameter="{Binding Kind}"
                  Classes="CkanChip"
                  Classes.Active="{Binding IsActive}"
                  Margin="0,0,8,6" Padding="9,4"
                  ToolTip.Tip="{Binding ToolTipText}">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{Binding Kind, Converter={x:Static local:RelationKindToBrushConverter.Instance}}" />
              <TextBlock Text="{Binding Label}"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding CountText}"
                         FontSize="{DynamicResource CkanFontSizeCaption}"
                         Foreground="{DynamicResource CkanTextSecondaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 主展示区：层级树（默认）与天体轨道关系网（可选） -->
    <Panel Grid.Row="2">
      <!-- 1. 层级树：分类分组 + 状态徽标，双击节点跳转模组 -->
      <TreeView IsVisible="{Binding IsTreeView}"
                ItemsSource="{Binding Roots}"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.Styles>
          <!-- 默认展开：依赖关系一进来就该看见条目，而不是让用户先点开根节点。
               行距按「松而不散」调：400px 栏里 10 条关系仍装得下，但相邻两行不再贴在一起，
               双击跳转的热区也跟着变高（用户反馈：这块太紧凑）。 -->
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,*,Auto" DoubleTapped="OnNodeDoubleTapped" Margin="0,2">
              <!-- 分类行：语义圆点 + 分类名 + 计数 -->
              <Ellipse Grid.Column="0" IsVisible="{Binding IsCategory}"
                       Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                       Fill="{Binding Kind, Converter={x:Static local:RelationKindToBrushConverter.Instance}}" />
              <!-- 叶子行：语义圆点 -->
              <Ellipse Grid.Column="0" IsVisible="{Binding ShowDot}"
                       Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                       Fill="{Binding Kind, Converter={x:Static local:RelationKindToBrushConverter.Instance}}" />

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Name}"
                           IsVisible="{Binding IsCategory}"
                           FontSize="{DynamicResource CkanFontSizeBody}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                <TextBlock Text="{Binding Name}"
                           IsVisible="{Binding !IsCategory}"
                           FontSize="{DynamicResource CkanFontSizeBody}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource CkanTextPrimaryBrush}" />
                <TextBlock Text="{Binding IdentifierText}"
                           IsVisible="{Binding ShowIdentifier}"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource CkanTextTertiaryBrush}" />
              </StackPanel>

              <!-- 分类计数 -->
              <Border Grid.Column="2" IsVisible="{Binding ShowCount}"
                      Margin="8,0,0,0" Padding="7,1"
                      CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                      Background="{DynamicResource CkanSidebarBackgroundBrush}"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding CountText}"
                           FontSize="{DynamicResource CkanFontSizeCaption}"
                           Foreground="{DynamicResource CkanTextSecondaryBrush}" />
              </Border>

              <!-- 缺失依赖警示 -->
              <Border Grid.Column="2" IsVisible="{Binding ShowMissing}"
                      Classes="CkanBadge Danger"
                      Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="缺失" />
              </Border>
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <!-- 2. 可视化星轨关系网控件（自适应缩放到可用尺寸） -->
      <Border IsVisible="{Binding IsGraphView}"
              MinHeight="320"
              BorderBrush="{DynamicResource CkanBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource CkanCornerRadiusMedium}"
              ClipToBounds="True">
        <Panel>
          <local:RelationNetworkControl x:Name="NetworkControl"
                                        Nodes="{Binding GraphNodes}"
                                        Edges="{Binding GraphEdges}"
                                        SelectedNode="{Binding SelectedGraphNode, Mode=TwoWay}"
                                        NavigateCommand="{Binding NavigateByIdCommand}" />

          <!-- 右下角交互指引提示浮层 -->
          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="12" Padding="8,4"
                  Background="{DynamicResource CkanSurfaceBackgroundBrush}"
                  BorderBrush="{DynamicResource CkanBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CkanCornerRadiusSmall}"
                  Opacity="0.85">
            <TextBlock Text="{DynamicResource Ui_RelationTree_InteractionHint}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanTextSecondaryBrush}" />
          </Border>
        </Panel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
