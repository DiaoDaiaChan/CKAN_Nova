<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:CkanUI.App.Theming"
             xmlns:controls="using:CkanUI.App.Controls"
             xmlns:dtos="using:CkanUI.Services.Abstractions.Dtos"
             xmlns:conv="using:CkanUI.App.Converters"
             x:Class="CkanUI.App.Views.DownloadStatsPageView"
             x:CompileBindings="False">
  <!-- 下载统计页（规格 F-47 / 06 篇 UI-25）：环形图 + 图例 + 可排序明细表。
       颜色只用 Tokens.axaml 的语义 token；页面只读，唯一的写操作是「刷新」。
       视觉规范：工具条/卡片/空态/错误条/骨架屏统一复用 FluentStyles 的 Ckan* 类。 -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- 页内 chip 复用全局 CkanChip，仅补右间距 -->
    <Style Selector="Button.CkanChip">
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="{DynamicResource CkanPagePadding}"
        Background="Transparent">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" Classes="CkanPageTitle" VerticalAlignment="Center" />
        <Button Classes="CkanHelper" VerticalAlignment="Center"
                ToolTip.Tip="按本地仓库索引与下载缓存聚合，不联网；下载量缺字段的模组按 0 计。">
          <PathIcon Data="{StaticResource CkanIconHelp}" />
        </Button>
      </StackPanel>
      <TextBlock Text="缓存占用与热度的排行视图" Classes="CkanCaption" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 工具条：分组维度 + 排序 + 刷新 -->
    <Border Grid.Row="1" Classes="CkanToolbar stagger-card">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="分组" VerticalAlignment="Center" Margin="0,0,8,0" Classes="CkanCaption" />
          <Button Classes="CkanChip" Content="按模组"
                  Classes.Active="{Binding Dimension, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Mods}"
                  Command="{Binding SwitchDimensionCommand}"
                  CommandParameter="{x:Static dtos:DownloadStatsDimension.Mods}" />
          <Button Classes="CkanChip" Content="按标签"
                  Classes.Active="{Binding Dimension, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Tags}"
                  Command="{Binding SwitchDimensionCommand}"
                  CommandParameter="{x:Static dtos:DownloadStatsDimension.Tags}" />
          <Button Classes="CkanChip" Content="按安装状态"
                  Classes.Active="{Binding Dimension, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Installed}"
                  Command="{Binding SwitchDimensionCommand}"
                  CommandParameter="{x:Static dtos:DownloadStatsDimension.Installed}" />
          <Button Classes="CkanChip" Content="按仓库"
                  Classes.Active="{Binding Dimension, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Repositories}"
                  Command="{Binding SwitchDimensionCommand}"
                  CommandParameter="{x:Static dtos:DownloadStatsDimension.Repositories}" />
          <TextBlock Text="排序" VerticalAlignment="Center" Margin="16,0,8,0" Classes="CkanCaption" />
          <Button Classes="CkanChip" Content="下载量"
                  Classes.Active="{Binding Sort, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Downloads}"
                  Command="{Binding SetSortCommand}"
                  CommandParameter="{x:Static dtos:DownloadStatsSortColumn.Downloads}" />
          <Button Classes="CkanChip" Content="缓存占用"
                  Classes.Active="{Binding Sort, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Cache}"
                  Command="{Binding SetSortCommand}"
                  CommandParameter="{x:Static dtos:DownloadStatsSortColumn.Cache}" />
          <Button Classes="CkanChip" Content="名称"
                  Classes.Active="{Binding Sort, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Name}"
                  Command="{Binding SetSortCommand}"
                  CommandParameter="{x:Static dtos:DownloadStatsSortColumn.Name}" />
          <Button Content="刷新" Command="{Binding RefreshCommand}"
                  Classes="CkanPrimary" Margin="16,0,0,0"
                  ToolTip.Tip="重新读取仓库索引与缓存清单" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- 三项指标卡：从工具条里搬出来，数字有了自己的容器，不再和 chip 挤作一团 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
      <Border Classes="CkanStatCard" MinWidth="168">
        <StackPanel Spacing="4">
          <TextBlock Classes="CkanEyebrow" Text="模组数" />
          <TextBlock Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeHeading}"
                     Text="{Binding ModuleCountText}" />
        </StackPanel>
      </Border>
      <Border Classes="CkanStatCard" MinWidth="168">
        <StackPanel Spacing="4">
          <TextBlock Classes="CkanEyebrow" Text="下载合计" />
          <TextBlock Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeHeading}"
                     Text="{Binding TotalDownloadsText}" />
        </StackPanel>
      </Border>
      <Border Classes="CkanStatCard" MinWidth="168">
        <StackPanel Spacing="4">
          <TextBlock Classes="CkanEyebrow" Text="缓存合计" />
          <TextBlock Classes="CkanNumeric" FontSize="{DynamicResource CkanFontSizeHeading}"
                     Text="{Binding CacheTotalText}" />
        </StackPanel>
      </Border>
      <TextBlock Classes="CkanCaption" Text="{Binding TakenAt, StringFormat='统计于 {0:HH:mm:ss}'}"
                 IsVisible="{Binding TakenAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                 VerticalAlignment="Bottom" Margin="4,0,0,4" />
    </StackPanel>

    <!-- 页面级错误条 -->
    <Border Grid.Row="3" Margin="0,12,0,0" Classes="CkanInfoBanner"
            Background="{DynamicResource CkanDangerBackgroundBrush}"
            BorderBrush="{DynamicResource CkanDangerBrush}" BorderThickness="1"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Grid.Column="0"
                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                  Width="18" Height="18" Margin="0,0,12,0"
                  Foreground="{DynamicResource CkanDangerBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ErrorText}" TextWrapping="Wrap"
                   FontSize="{DynamicResource CkanFontSizeBody}" FontWeight="Medium"
                   Foreground="{DynamicResource CkanDangerBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="重试" Command="{Binding RefreshCommand}" Classes="CkanSmall"
                  ToolTip.Tip="重新读取仓库索引与缓存清单" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体：左图例 + 右明细 -->
    <Grid Grid.Row="4" ColumnDefinitions="280,*" Margin="0,12,0,0">

      <Border Grid.Column="0" Margin="0,0,12,0" Classes="CkanCard"
              IsVisible="{Binding !ShowEmptyState}">
        <Grid RowDefinitions="Auto,*">
          <controls:DonutChart Height="180" RingThickness="22"
                               Slices="{Binding ChartSlices}"
                               CenterText="{Binding ModuleCountText}"
                               CenterCaption="个模组" />
          <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Slices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="2" Margin="0,0,0,8">
                    <TextBlock Text="{Binding DisplayText}"
                               FontSize="{DynamicResource CkanFontSizeBody}"
                               Foreground="{DynamicResource CkanTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailText}" Classes="CkanCaption" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <!-- 数据不全的提示：语义底色 + 图标，不靠透明度传达 -->
        <Border Grid.Row="0" Margin="0,0,0,12" Classes="CkanInfoBanner"
                Background="{DynamicResource CkanWarningBackgroundBrush}"
                BorderBrush="{DynamicResource CkanWarningBrush}" BorderThickness="1"
                ToolTip.Tip="部分模组没有下载量数据（多为本地或刚入库的模组），这些行按 0 计。"
                IsVisible="{Binding HasUnavailableDownloads}">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Grid.Column="0"
                      Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                      Width="18" Height="18" Margin="0,0,12,0"
                      Foreground="{DynamicResource CkanWarningBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding UnavailableHint}"
                       FontSize="{DynamicResource CkanFontSizeCaption}"
                       Foreground="{DynamicResource CkanWarningBrush}" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <DataGrid ItemsSource="{Binding Rows}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserSortColumns="False"
                    CanUserResizeColumns="True"
                    RowHeight="{DynamicResource CkanRowHeight}"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsVisible="{Binding !ShowEmptyState}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="模组" Binding="{Binding Name}" Width="260" />
              <DataGridTextColumn Header="标识符" Binding="{Binding Identifier}" Width="220" />
              <DataGridTemplateColumn Header="下载量" Width="190">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <!-- 同列内给下载量一条相对条：一眼看出头部模组与长尾的差距 -->
                    <Grid ColumnDefinitions="74,*" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="{Binding DownloadsText}" Classes="CkanNumeric"
                                 VerticalAlignment="Center" />
                      <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Height="4" Margin="6,0,10,0"
                                   Value="{Binding DownloadPercent}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource CkanAccentBrush}"
                                   Background="{DynamicResource CkanSubtleBackgroundBrush}"
                                   ToolTip.Tip="{Binding DownloadsText}" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="缓存" Binding="{Binding CacheText}" Width="90" />
              <DataGridTextColumn Header="状态" Binding="{Binding InstalledText}" Width="80" />
            </DataGrid.Columns>
          </DataGrid>

        </Grid>
      </Grid>

      <!-- 空态：跨两列居中，避免左侧图例卡在空态下仍占 280px 变成空壳 -->
      <Border Grid.Column="0" Grid.ColumnSpan="2" Classes="CkanEmptyStateCard Elevated"
              IsVisible="{Binding ShowEmptyState}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="460">
          <Border Classes="CkanIconTile Lg" HorizontalAlignment="Center">
            <PathIcon Data="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z" />
          </Border>
          <TextBlock Text="还没有可统计的模组" HorizontalAlignment="Center"
                     FontSize="{DynamicResource CkanFontSizeSubtitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource CkanTextPrimaryBrush}" />
          <TextBlock Text="先刷新仓库索引，或到仓库页添加索引后重试。"
                     TextWrapping="Wrap" TextAlignment="Center" Classes="CkanCaption" />
          <Button Content="刷新" Command="{Binding RefreshCommand}"
                  Classes="CkanPrimary" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 加载中遮罩：骨架屏 + 说明（同一时刻只有一个脉动元素） -->
    <Border Grid.RowSpan="4" IsVisible="{Binding IsLoading}"
            Background="{DynamicResource CkanBlockingScrimBrush}">
      <Grid>
        <StackPanel IsHitTestVisible="False" app:SkeletonPulse.IsEnabled="True"
                    VerticalAlignment="Top" Spacing="12" Margin="18,24">
          <Border Classes="CkanSkeleton" Height="16" Width="180" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" Width="360" HorizontalAlignment="Left" />
          <Border Classes="CkanSkeletonLine" />
          <Border Classes="CkanSkeletonLine" Width="280" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Text="正在统计下载量…" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="{DynamicResource CkanFontSizeBody}"
                     Foreground="{DynamicResource CkanTextInverseBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
