<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="using:CkanUI.App">

  <!--
    THM-01 语义 token 基线（Fluent/WinUI 3 风格现代设计系统）。
    铁律：视图里禁止出现颜色字面量、圆角字面量，只能用本文件提供的 key。
    所有 token 在 Light / Dark / HighContrast 三种主题变体下均有完备映射。
  -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- 基础表面与背景：画布 → 卡片 → 内凹输入，三级明度分层（ELV-01） -->
      <SolidColorBrush x:Key="CkanSurfaceBackgroundBrush" Color="#E8F3F5F9" />
      <SolidColorBrush x:Key="CkanCanvasBackgroundBrush" Color="#F3F5F9" />
      <SolidColorBrush x:Key="CkanSidebarBackgroundBrush" Color="#CCE9EDF3" />
      <!-- FluentAvalonia 导航栏面板背景（DynamicResource 取自本字典，见 FANavigationView 模板）。 -->
      <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="CkanSidebarBackgroundBrush" />
      <SolidColorBrush x:Key="CkanStatusBarBackgroundBrush" Color="#E9EDF3" />
      <SolidColorBrush x:Key="CkanCardBackgroundBrush" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="CkanElevatedCardHoverBrush" Color="#FAFBFD" />
      <SolidColorBrush x:Key="CkanRecessedInputBrush" Color="#EEF1F6" />
      <SolidColorBrush x:Key="CkanDialogBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CkanSubtleBackgroundBrush" Color="#EEF1F6" />
      <SolidColorBrush x:Key="CkanAccentSubtleBrush" Color="#E3EDFC" />
      <SolidColorBrush x:Key="CkanNavigationSelectionBrush" Color="#DCE8F8" />
      <SolidColorBrush x:Key="CkanMutedBackgroundBrush" Color="#E8EBF0" />

      <!--
        表面分层阶梯（ELV-01）：画布 → 表面 → 卡片 → 悬浮，逐级 +1 档明度。
        视图里只准引用 CkanLayer*，不要再散写 Surface/Card，否则分层会漂。
      -->
      <StaticResource x:Key="CkanLayerCanvasBrush" ResourceKey="CkanCanvasBackgroundBrush" />
      <StaticResource x:Key="CkanLayerSurfaceBrush" ResourceKey="CkanSurfaceBackgroundBrush" />
      <StaticResource x:Key="CkanLayerCardBrush" ResourceKey="CkanCardBackgroundBrush" />
      <StaticResource x:Key="CkanLayerRecessedBrush" ResourceKey="CkanRecessedInputBrush" />
      <SolidColorBrush x:Key="CkanLayerElevatedBrush" Color="#FFFFFF" />
      <!-- 1px 顶光描边（替代灰实线）：卡片上缘给一道极淡的受光线 -->
      <SolidColorBrush x:Key="CkanHairlineBrush" Color="#17000000" />

      <!-- 磨砂玻璃 / 亚克力基底（MAT）：半透明填充 + 顶光内描边 + 柔影，按钮与交互行统一取这一套 -->
      <SolidColorBrush x:Key="CkanGlassFillBrush" Color="#8CFFFFFF" />
      <SolidColorBrush x:Key="CkanGlassFillHoverBrush" Color="#B8FFFFFF" />
      <LinearGradientBrush x:Key="CkanGlassBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0.0" Color="#B3FFFFFF" />
        <GradientStop Offset="0.45" Color="#33000000" />
        <GradientStop Offset="1.0" Color="#1A000000" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="CkanGlassBorderHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0.0" Color="#7A275DAD" />
        <GradientStop Offset="1.0" Color="#3D275DAD" />
      </LinearGradientBrush>
      <BoxShadows x:Key="CkanGlassShadow">inset 0 1 0 0 #CCFFFFFF, 0 2 6 0 #14000000, 0 8 20 0 #0F000000</BoxShadows>
      <BoxShadows x:Key="CkanGlassShadowHover">inset 0 1 0 0 #E6FFFFFF, 0 6 18 0 #1A000000, 0 10 28 0 #12000000</BoxShadows>
      <BoxShadows x:Key="CkanGlassShadowAccent">inset 0 1 0 0 #B3FFFFFF, 0 6 16 0 #33275DAD, 0 2 6 0 #1A000000</BoxShadows>
      <RadialGradientBrush x:Key="CkanEmptyStateGlowBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="70%" RadiusY="70%">
        <GradientStop Offset="0" Color="#33275DAD" />
        <GradientStop Offset="1" Color="#00275DAD" />
      </RadialGradientBrush>

      <!-- 边框与分割线：卡片描边改用顶光渐变，替掉全屏 1px 实线（ELV-02） -->
      <SolidColorBrush x:Key="CkanBorderBrush" Color="#DFE3E9" />
      <LinearGradientBrush x:Key="CkanCardBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0.0" Color="#1F000000" />
        <GradientStop Offset="0.18" Color="#0E000000" />
        <GradientStop Offset="1.0" Color="#07000000" />
      </LinearGradientBrush>

      <!-- 文字色 -->
      <SolidColorBrush x:Key="CkanTextPrimaryBrush" Color="#11161D" />
      <SolidColorBrush x:Key="CkanTextSecondaryBrush" Color="#5A6472" />
      <SolidColorBrush x:Key="CkanTextTertiaryBrush" Color="#8B949E" />
      <SolidColorBrush x:Key="CkanTextInverseBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CkanTextOnAccentBrush" Color="#FFFFFF" />

      <!-- 强调与语义色 -->
      <SolidColorBrush x:Key="CkanAccentBrush" Color="#275DAD" />
      <SolidColorBrush x:Key="CkanPrimaryBrush" Color="#275DAD" />
      <SolidColorBrush x:Key="CkanAccentTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CkanSuccessBrush" Color="#1B7F3B" />
      <SolidColorBrush x:Key="CkanWarningBrush" Color="#B26A00" />
      <SolidColorBrush x:Key="CkanWarningBackgroundBrush" Color="#FFF8E1" />
      <SolidColorBrush x:Key="CkanDangerBrush" Color="#B3261E" />
      <SolidColorBrush x:Key="CkanDangerBackgroundBrush" Color="#FFEBEE" />
      <SolidColorBrush x:Key="CkanInfoBrush" Color="#0969DA" />
      <SolidColorBrush x:Key="CkanInfoBackgroundBrush" Color="#EBF5FF" />

      <!-- 遮罩 -->
      <SolidColorBrush x:Key="CkanScrimBrush" Color="#99000000" />
      <SolidColorBrush x:Key="CkanBlockingScrimBrush" Color="#B3000000" />

      <!-- 海拔（20 篇 P-08）：双层漫射+主光阴影（低/中/高）；统一从 token 取，禁止各页写字面量阴影 -->
      <BoxShadows x:Key="CkanElevationLow">0 1 2 0 #0C000000, 0 2 6 0 #08000000</BoxShadows>
      <BoxShadows x:Key="CkanElevationMedium">0 3 8 0 #12000000, 0 8 20 0 #0D000000</BoxShadows>
      <BoxShadows x:Key="CkanElevationHigh">0 6 16 0 #18000000, 0 16 36 0 #15000000</BoxShadows>
      <BoxShadows x:Key="CkanElevationNone">0 0 0 0 #00000000</BoxShadows>

      <!-- 焦点环、状态叠加层与骨架屏底色（键盘可达性 THM-09） -->
      <SolidColorBrush x:Key="CkanFocusRingBrush" Color="#275DAD" />
      <SolidColorBrush x:Key="CkanHoverOverlayBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="CkanPressedOverlayBrush" Color="#1F000000" />
      <SolidColorBrush x:Key="CkanAccentHoverBrush" Color="#1F4E96" />
      <SolidColorBrush x:Key="CkanSuccessBackgroundBrush" Color="#E7F6EC" />
      <SolidColorBrush x:Key="CkanSkeletonBrush" Color="#E9ECF1" />
      <RadialGradientBrush x:Key="CkanAmbientGlowBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="65%" RadiusY="65%">
        <GradientStop Offset="0" Color="#40275DAD" />
        <GradientStop Offset="1" Color="#00275DAD" />
      </RadialGradientBrush>
      <SolidColorBrush x:Key="CkanOrbitalLineBrush" Color="#18275DAD" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- 基础表面与背景：画布 → 卡片 → 内凹输入，三级明度分层（ELV-01） -->
      <SolidColorBrush x:Key="CkanSurfaceBackgroundBrush" Color="#E60F1218" />
      <SolidColorBrush x:Key="CkanCanvasBackgroundBrush" Color="#0B0E14" />
      <SolidColorBrush x:Key="CkanSidebarBackgroundBrush" Color="#C0141820" />
      <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="CkanSidebarBackgroundBrush" />
      <SolidColorBrush x:Key="CkanStatusBarBackgroundBrush" Color="#D912161E" />
      <SolidColorBrush x:Key="CkanCardBackgroundBrush" Color="#D820232B" />
      <SolidColorBrush x:Key="CkanElevatedCardHoverBrush" Color="#262C37" />
      <SolidColorBrush x:Key="CkanRecessedInputBrush" Color="#0A0D12" />
      <SolidColorBrush x:Key="CkanDialogBackgroundBrush" Color="#1B2029" />
      <SolidColorBrush x:Key="CkanSubtleBackgroundBrush" Color="#C81A202A" />
      <SolidColorBrush x:Key="CkanAccentSubtleBrush" Color="#142B48" />
      <SolidColorBrush x:Key="CkanNavigationSelectionBrush" Color="#1C3555" />
      <SolidColorBrush x:Key="CkanMutedBackgroundBrush" Color="#252B36" />

      <!--
        表面分层阶梯（ELV-01）：深色下每级 +6~8 明度，肉眼能数出三层，不再"一黑到底"。
        底板 #0B0E14 → 表面 #101319 → 卡片 #20232B → 悬浮 #2A313D，输入框反而下凹到 #0A0D12。
      -->
      <StaticResource x:Key="CkanLayerCanvasBrush" ResourceKey="CkanCanvasBackgroundBrush" />
      <StaticResource x:Key="CkanLayerSurfaceBrush" ResourceKey="CkanSurfaceBackgroundBrush" />
      <StaticResource x:Key="CkanLayerCardBrush" ResourceKey="CkanCardBackgroundBrush" />
      <StaticResource x:Key="CkanLayerRecessedBrush" ResourceKey="CkanRecessedInputBrush" />
      <SolidColorBrush x:Key="CkanLayerElevatedBrush" Color="#2A313D" />
      <!-- 1px 顶光描边：卡片上缘 8% 白光，是深色下唯一能读出"边缘"的东西 -->
      <SolidColorBrush x:Key="CkanHairlineBrush" Color="#14FFFFFF" />

      <!-- 磨砂玻璃 / 亚克力基底（MAT）：8% 白填充 + 顶光内描边 + 深柔影；强调色按钮走 ShadowAccent -->
      <SolidColorBrush x:Key="CkanGlassFillBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="CkanGlassFillHoverBrush" Color="#24FFFFFF" />
      <LinearGradientBrush x:Key="CkanGlassBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0.0" Color="#33FFFFFF" />
        <GradientStop Offset="0.5" Color="#12FFFFFF" />
        <GradientStop Offset="1.0" Color="#0AFFFFFF" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="CkanGlassBorderHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0.0" Color="#6672A7FF" />
        <GradientStop Offset="1.0" Color="#2A72A7FF" />
      </LinearGradientBrush>
      <BoxShadows x:Key="CkanGlassShadow">inset 0 1 0 0 #1FFFFFFF, 0 2 6 0 #0E000000, 0 8 20 0 #0A000000</BoxShadows>
      <BoxShadows x:Key="CkanGlassShadowHover">inset 0 1 0 0 #33FFFFFF, 0 6 18 0 #1F000000, 0 10 28 0 #12000000</BoxShadows>
      <BoxShadows x:Key="CkanGlassShadowAccent">inset 0 1 0 0 #4DFFFFFF, 0 6 16 0 #3372A7FF, 0 2 6 0 #26000000</BoxShadows>
      <RadialGradientBrush x:Key="CkanEmptyStateGlowBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="70%" RadiusY="70%">
        <GradientStop Offset="0" Color="#2E72A7FF" />
        <GradientStop Offset="1" Color="#0072A7FF" />
      </RadialGradientBrush>

      <!-- 边框与分割线：卡片描边改用顶光渐变（上缘 8% 白光 → 下缘 2%）（ELV-02） -->
      <SolidColorBrush x:Key="CkanBorderBrush" Color="#293140" />
      <LinearGradientBrush x:Key="CkanCardBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0.0" Color="#16FFFFFF" />
        <GradientStop Offset="0.15" Color="#08FFFFFF" />
        <GradientStop Offset="1.0" Color="#05FFFFFF" />
      </LinearGradientBrush>

      <!-- 文字色 -->
      <SolidColorBrush x:Key="CkanTextPrimaryBrush" Color="#E8ECF2" />
      <SolidColorBrush x:Key="CkanTextSecondaryBrush" Color="#9AA4B2" />
      <SolidColorBrush x:Key="CkanTextTertiaryBrush" Color="#6E7681" />
      <SolidColorBrush x:Key="CkanTextInverseBrush" Color="#11161D" />
      <SolidColorBrush x:Key="CkanTextOnAccentBrush" Color="#0B1220" />

      <!-- 强调与语义色 -->
      <SolidColorBrush x:Key="CkanAccentBrush" Color="#72A7FF" />
      <SolidColorBrush x:Key="CkanPrimaryBrush" Color="#72A7FF" />
      <SolidColorBrush x:Key="CkanAccentTextBrush" Color="#0B1220" />
      <SolidColorBrush x:Key="CkanSuccessBrush" Color="#4FD07A" />
      <SolidColorBrush x:Key="CkanWarningBrush" Color="#E8A33D" />
      <SolidColorBrush x:Key="CkanWarningBackgroundBrush" Color="#332800" />
      <SolidColorBrush x:Key="CkanDangerBrush" Color="#FF6B5E" />
      <SolidColorBrush x:Key="CkanDangerBackgroundBrush" Color="#381414" />
      <SolidColorBrush x:Key="CkanInfoBrush" Color="#58A6FF" />
      <SolidColorBrush x:Key="CkanInfoBackgroundBrush" Color="#16283D" />

      <!-- 遮罩 -->
      <SolidColorBrush x:Key="CkanScrimBrush" Color="#99000000" />
      <SolidColorBrush x:Key="CkanBlockingScrimBrush" Color="#B3000000" />

      <!-- 海拔（20 篇 P-08）：深色下双层阴影营造层次感 -->
      <BoxShadows x:Key="CkanElevationLow">0 1 3 0 #38000000, 0 3 8 0 #44000000</BoxShadows>
      <BoxShadows x:Key="CkanElevationMedium">0 4 12 0 #4C000000, 0 10 24 0 #60000000</BoxShadows>
      <BoxShadows x:Key="CkanElevationHigh">0 8 20 0 #5A000000, 0 18 42 0 #7A000000</BoxShadows>
      <BoxShadows x:Key="CkanElevationNone">0 0 0 0 #00000000</BoxShadows>

      <!-- 焦点环、状态叠加层与骨架屏底色 -->
      <SolidColorBrush x:Key="CkanFocusRingBrush" Color="#72A7FF" />
      <SolidColorBrush x:Key="CkanHoverOverlayBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="CkanPressedOverlayBrush" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="CkanAccentHoverBrush" Color="#8AB6FF" />
      <SolidColorBrush x:Key="CkanSuccessBackgroundBrush" Color="#14301F" />
      <SolidColorBrush x:Key="CkanSkeletonBrush" Color="#2A303C" />
      <RadialGradientBrush x:Key="CkanAmbientGlowBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="65%" RadiusY="65%">
        <GradientStop Offset="0" Color="#2672A7FF" />
        <GradientStop Offset="1" Color="#0072A7FF" />
      </RadialGradientBrush>
      <SolidColorBrush x:Key="CkanOrbitalLineBrush" Color="#1872A7FF" />
    </ResourceDictionary>

    <!-- 高对比度：THM-10 要求高对比度强制压过一切，只保留纯黑/纯白 + 高对比黄。 -->
    <ResourceDictionary x:Key="{x:Static app:ThemeHost.HighContrastVariant}">
      <!-- 基础表面与背景：高对比度不做明度分层，层次只靠纯白描边（ELV-03） -->
      <SolidColorBrush x:Key="CkanSurfaceBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanCanvasBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanSidebarBackgroundBrush" Color="#000000" />
      <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="CkanSidebarBackgroundBrush" />
      <SolidColorBrush x:Key="CkanStatusBarBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanCardBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanElevatedCardHoverBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanRecessedInputBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanDialogBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanSubtleBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanAccentSubtleBrush" Color="#333300" />
      <SolidColorBrush x:Key="CkanNavigationSelectionBrush" Color="#FFFF00" />
      <SolidColorBrush x:Key="CkanMutedBackgroundBrush" Color="#222222" />

      <!-- 高对比度不做明度分层：层次只能靠纯白描边，任何"淡一点的白"都会破坏对比度 -->
      <SolidColorBrush x:Key="CkanLayerCanvasBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanLayerSurfaceBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanLayerCardBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanLayerElevatedBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanLayerRecessedBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanHairlineBrush" Color="#FFFFFF" />

      <!-- 高对比度不透明：玻璃只保留纯白描边，不引入任何半透明填充（THM-10） -->
      <SolidColorBrush x:Key="CkanGlassFillBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanGlassFillHoverBrush" Color="#111111" />
      <SolidColorBrush x:Key="CkanGlassBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CkanGlassBorderHoverBrush" Color="#FFFF00" />
      <BoxShadows x:Key="CkanGlassShadow">0 0 0 0 #00000000</BoxShadows>
      <BoxShadows x:Key="CkanGlassShadowHover">0 0 0 0 #00000000</BoxShadows>
      <BoxShadows x:Key="CkanGlassShadowAccent">0 0 0 0 #00000000</BoxShadows>
      <RadialGradientBrush x:Key="CkanEmptyStateGlowBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="70%" RadiusY="70%">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="1" Color="#00000000" />
      </RadialGradientBrush>

      <!-- 边框与分割线 -->
      <SolidColorBrush x:Key="CkanBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CkanCardBorderBrush" Color="#FFFFFF" />

      <!-- 文字色 -->
      <SolidColorBrush x:Key="CkanTextPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CkanTextSecondaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CkanTextTertiaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CkanTextInverseBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanTextOnAccentBrush" Color="#000000" />

      <!-- 强调与语义色 -->
      <SolidColorBrush x:Key="CkanAccentBrush" Color="#FFFF00" />
      <SolidColorBrush x:Key="CkanPrimaryBrush" Color="#FFFF00" />
      <SolidColorBrush x:Key="CkanAccentTextBrush" Color="#000000" />
      <SolidColorBrush x:Key="CkanSuccessBrush" Color="#00FF66" />
      <SolidColorBrush x:Key="CkanWarningBrush" Color="#FFFF00" />
      <SolidColorBrush x:Key="CkanWarningBackgroundBrush" Color="#333300" />
      <SolidColorBrush x:Key="CkanDangerBrush" Color="#FF5050" />
      <SolidColorBrush x:Key="CkanDangerBackgroundBrush" Color="#440000" />
      <SolidColorBrush x:Key="CkanInfoBrush" Color="#00FFFF" />
      <SolidColorBrush x:Key="CkanInfoBackgroundBrush" Color="#001133" />

      <!-- 遮罩 -->
      <SolidColorBrush x:Key="CkanScrimBrush" Color="#99000000" />
      <SolidColorBrush x:Key="CkanBlockingScrimBrush" Color="#B3000000" />

      <!-- 高对比度不要任何柔和阴影：层次只靠纯白描边表达 -->
      <BoxShadows x:Key="CkanElevationLow">0 0 0 0 #00000000</BoxShadows>
      <BoxShadows x:Key="CkanElevationMedium">0 0 0 0 #00000000</BoxShadows>
      <BoxShadows x:Key="CkanElevationHigh">0 0 0 0 #00000000</BoxShadows>
      <BoxShadows x:Key="CkanElevationNone">0 0 0 0 #00000000</BoxShadows>

      <!-- 高对比度下焦点环必须用高对比黄，且不依赖透明度 -->
      <SolidColorBrush x:Key="CkanFocusRingBrush" Color="#FFFF00" />
      <SolidColorBrush x:Key="CkanHoverOverlayBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="CkanPressedOverlayBrush" Color="#66FFFFFF" />
      <SolidColorBrush x:Key="CkanAccentHoverBrush" Color="#FFFF66" />
      <SolidColorBrush x:Key="CkanSuccessBackgroundBrush" Color="#003300" />
      <SolidColorBrush x:Key="CkanSkeletonBrush" Color="#555555" />
      <RadialGradientBrush x:Key="CkanAmbientGlowBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="65%" RadiusY="65%">
        <GradientStop Offset="0" Color="#00FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
      </RadialGradientBrush>
      <SolidColorBrush x:Key="CkanOrbitalLineBrush" Color="#00FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- 密度与字号 -->
  <x:Double x:Key="CkanFontSizeCaption">12</x:Double>
  <x:Double x:Key="CkanFontSizeBody">13</x:Double>
  <x:Double x:Key="CkanFontSizeSubtitle">15</x:Double>
  <x:Double x:Key="CkanFontSizeHeading">17</x:Double>
  <x:Double x:Key="CkanFontSizeTitle">26</x:Double>
  <x:Double x:Key="CkanRowHeight">28</x:Double>

  <!--
    字体回退链（16 篇 §7.1）：拉丁用 Inter，缺字逐项下探到中/日/韩字体，最后落 Segoe UI。
    整链写在一条 FontFamily 里，Avalonia 按逗号顺序探测，任何一档缺失都不会出豆腐块。
  -->
  <FontFamily x:Key="CkanUiFontFamily">Inter, Microsoft YaHei UI, Microsoft YaHei, SimSun, Yu Gothic UI, Meiryo, Malgun Gothic, Segoe UI</FontFamily>

  <Thickness x:Key="CkanPagePadding">16</Thickness>
  <Thickness x:Key="CkanToolbarPadding">12,8</Thickness>
  <CornerRadius x:Key="CkanCornerRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="CkanCornerRadiusMedium">12</CornerRadius>
  <CornerRadius x:Key="CkanCornerRadiusLarge">18</CornerRadius>
  <CornerRadius x:Key="CkanCornerRadiusPill">8</CornerRadius>

  <!--
    8pt 间距刻度（20 篇 P-05）：所有页面的 Margin/Padding 从这里取，跨页面节奏才一致。
    只做 Thickness，因为唯一的消费者就是 Margin/Padding/Spacing 三处。
  -->
  <Thickness x:Key="CkanSpacingXs">4</Thickness>
  <Thickness x:Key="CkanSpacingSm">8</Thickness>
  <Thickness x:Key="CkanSpacingMd">12</Thickness>
  <Thickness x:Key="CkanSpacingLg">16</Thickness>
  <Thickness x:Key="CkanSpacingXl">24</Thickness>
  <Thickness x:Key="CkanSpacingGutter">16,12</Thickness>
  <Thickness x:Key="CkanSpacingStack">0,0,0,8</Thickness>

  <!-- 控件尺寸与焦点环：键盘可达性（THM-09）统一 2px 焦点环，不随字号缩放而变粗细 -->
  <x:Double x:Key="CkanIconSizeSmall">14</x:Double>
  <x:Double x:Key="CkanIconSizeMedium">16</x:Double>
  <x:Double x:Key="CkanControlHeightSmall">28</x:Double>
  <x:Double x:Key="CkanControlHeightMedium">34</x:Double>
  <Thickness x:Key="CkanFocusRingThickness">2</Thickness>
  <x:Double x:Key="CkanOverlayCardWidth">480</x:Double>

