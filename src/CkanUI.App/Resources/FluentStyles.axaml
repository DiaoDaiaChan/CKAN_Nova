<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">

  <!--
    全局字体回退链（16 篇 §7.1）：From Window 继承到所有子控件，中/日/韩文案不会退化成方框。
    用 DynamicResource 而非字面量，方便主题层将来整体换字体（20 篇 P-09 只缩放字号，不改字体）。
  -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource CkanUiFontFamily}" />
  </Style>

  <!-- ========================================== -->
  <!-- 全局按钮现代化 Fluent 交互与平滑过渡动画      -->
  <!-- ========================================== -->
  <Style Selector="Button">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CkanMotionDurationBase}" />
        <!--
          松手回弹走「档位 3 高刚度微反馈」（MAT-02）：m=1, k=320, c=24（ζ≈0.67，微欠阻尼）。
          归一化终点 Ease(1)=0.99999，且尾部斜率≈0，动画结束的最后一帧不会跳变
          （由 SpringConvergenceTests 把 XAML 里所有 SpringEasing 参数扫一遍做门禁）。
          时长取动效 token：关闭动效时长度归零，缩放瞬间完成、不再缓动。
        -->
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationSpringCrisp}">
          <TransformOperationsTransition.Easing>
            <SpringEasing Mass="1" Stiffness="320" Damping="24" InitialVelocity="0" />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>

  <!--
    按下方向刻意不等弹簧：80-90ms 的线性冲刺保证首帧跟手（物理弹簧在高刚度下仍然要几十毫秒才明显），
    松手时这条 :pressed 样式失效、上面那条弹簧过渡接管，从当前 0.96 直接弹回 1（可中途打断）。
  -->
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96, 0.96)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationFast}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationFast}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationFast}" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- 重点操作主按钮 (Accent / Primary) 现代高光 -->
  <Style Selector="Button.CkanPrimary">
    <Setter Property="Background" Value="{DynamicResource CkanAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CkanAccentTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
  </Style>

  <Style Selector="Button.CkanPrimary:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanAccentHoverBrush}" />
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>

  <Style Selector="Button.CkanPrimary:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- ========================================== -->
  <!-- Fluent / WinUI 3 风格卡片容器 (Cards)       -->
  <!-- ========================================== -->
  <Style Selector="Border.CkanCard">
    <Setter Property="Background" Value="{DynamicResource CkanCardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusMedium}" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="BoxShadow" Value="{DynamicResource CkanElevationLow}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.CkanSubtleCard">
    <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusMedium}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.CkanToolbar">
    <Setter Property="Background" Value="{DynamicResource CkanCardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusMedium}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BoxShadow" Value="{DynamicResource CkanElevationLow}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <!-- ========================================== -->
  <!-- 现代轻量化筛选胶囊 (Filter Chips)            -->
  <!-- ========================================== -->
  <Style Selector="Button.CkanChip">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
    <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CkanMotionDurationBase}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationFast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.CkanChip:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>

  <Style Selector="Button.CkanChip:pressed">
    <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <!-- 选中态 Chip -->
  <Style Selector="Button.CkanChip.Active">
    <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CkanAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ========================================== -->
  <!-- 现代化输入框 (TextBox & SearchBox)          -->
  <!-- ========================================== -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <!-- 内凹材质（ELV-04）：底色比卡片更深，形成物理凹陷，边框退到 1px 低对比描边。 -->
    <Setter Property="Background" Value="{DynamicResource CkanRecessedInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanBorderBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
  </Style>

  <Style Selector="TextBox.CkanSearchBox">
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ========================================== -->
  <!-- 下拉框 (ComboBox) 现代化圆角与过渡           -->
  <!-- ========================================== -->
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <!-- 与 TextBox 同款内凹材质（ELV-04）。 -->
    <Setter Property="Background" Value="{DynamicResource CkanRecessedInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanBorderBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
  </Style>

  <!-- ========================================== -->
  <!-- 动效骨骼（第三阶段：给状态类注入物理弹簧）     -->
  <!-- ========================================== -->
  <!--
    这一节是弹簧参数的唯一落点。第二阶段已经把结构定死，这里只往状态类上挂 Transitions：
    1) 用 Opacity + RenderTransform 表达「显/隐」与「原位/偏移」，绝不改 Margin / Height / Width；
    2) 显隐一律走 Classes.is-open / Classes.is-active，IsVisible 不参与 —— IsVisible=False 会在第一帧
       把节点从渲染树里剔除，任何退场动画都会被直接截断；
    3) 位移一律写 TransformOperations 字符串语法（translate(...) / scale(...)）：配对的
       TransformOperationsTransition 只认这种类型，写 <TranslateTransform> 元素是另一套类型，两边对不上。

    弹簧参数的收敛前提（Avalonia 的 SpringEasing 把 Duration 归一化成 t∈[0,1] 再解微分方程）：
    轨道结束时位置必须已经收敛到 1，否则最后一帧会跳变。下面四组参数在 t=1 处的误差分别是
    1e-5 / 2e-5 / 3e-5 / 1.2e-3，全部 < 2e-3，由 SpringConvergenceTests 扫描本文件做门禁。
    它们是「档位」而不是「时长」：时长由 CkanMotionDurationSpring* token 给，关闭动效时归零。
  -->

  <!-- 底部日志抽屉：整条默认滑到视口下方，展开时归位。档位 2（微欠阻尼，m=1 k=220 c=22）。 -->
  <Style Selector="Border.overlay-drawer">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, 260px)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationSpringSlide}">
          <TransformOperationsTransition.Easing>
            <SpringEasing Mass="1" Stiffness="220" Damping="22" InitialVelocity="0" />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.overlay-drawer.is-open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
  </Style>

  <!--
    未保存悬浮条：从下方 40px 处微微缩小着浮上来。档位 2 变体（m=1 k=220 c=20，初速 -2）：
    给一点点初始冲量，浮条到位时会有一记极轻的「落定感」，不会像纯缓动那样软塌塌。
  -->
  <Style Selector="Border.floating-pill-bar">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, 40px) scale(0.96, 0.96)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationSpringSlide}">
          <TransformOperationsTransition.Easing>
            <SpringEasing Mass="1" Stiffness="220" Damping="20" InitialVelocity="-2" />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.floating-pill-bar.is-open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1, 1)" />
  </Style>

  <!--
    同格叠放的视图层（空态 ↔ 数据态、未选中实例 ↔ 已选中实例）。档位 1（临界阻尼，m=1 k=180 c=26）：
    阅读区域（表格文字）绝不能过冲，落位必须干脆，否则等文字静止时还在晃。
    两层始终都在可视化树里，只切 is-active；隐藏层的 IsHitTestVisible 由视图绑成 false，
    鼠标事件会穿透到可见层，不需要靠 IsVisible 硬切。
  -->
  <Style Selector="Control.view-layer">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="scale(0.98, 0.98) translate(0px, 6px)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationSpringSoft}">
          <TransformOperationsTransition.Easing>
            <SpringEasing Mass="1" Stiffness="180" Damping="26" InitialVelocity="0" />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Control.view-layer.is-active">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1, 1) translate(0px, 0px)" />
  </Style>

  <!--
    卡片入场锚点：默认就位（页面上没有错峰行为的场合保持静止）。
    错峰由 App/Animations/StaggerAnimator 在页面切换时临时挂 .stagger-prepare 再逐个摘除来驱动。
  -->
  <Style Selector="Control.stagger-card">
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationSpringSoft}">
          <TransformOperationsTransition.Easing>
            <SpringEasing Mass="1" Stiffness="180" Damping="26" InitialVelocity="0" />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!--
    「预备态」：Transitions 必须置空（x:Null），否则挂上这个类的瞬间卡片的 14px 位移会自己缓动起来，
    那就不是「从下方滑入」而是「慢慢飘到下方再滑回来」。摘掉这个类的瞬间才把过渡装回去，
    于是摘除动作本身走弹簧 —— 这是整套错峰入场的全部机制。
  -->
  <Style Selector="Control.stagger-card.stagger-prepare">
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, 14px)" />
  </Style>

  <!--
    校验错误锚点：档位 4（强欠阻尼冲量，m=1 k=650 c=14，初速 30）。
    机制与错峰相反 —— 先挂 .shake-impulse 把控件瞬间拉偏 8px（Transitions 置空，不走过渡），
    下一帧摘掉它，弹簧从「偏 8px + 初速」的状态释放，自然衰减轻颤三四次后归位，不需要任何关键帧。
  -->
  <Style Selector="Control.is-invalid">
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationSpringImpulse}">
          <TransformOperationsTransition.Easing>
            <SpringEasing Mass="1" Stiffness="650" Damping="14" InitialVelocity="30" />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBox.is-invalid, ComboBox.is-invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource CkanDangerBrush}" />
  </Style>

  <Style Selector="Control.shake-impulse">
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="RenderTransform" Value="translate(8px, 0px)" />
  </Style>

  <!--
    左侧导航项：选中切换时给「被点中的那一项」一记追赶位移（.nav-catch-up 由 MainWindow 挂 110ms）。
    指示器本身的滑动是 FluentAvalonia 内部 600ms 的组合动画（FANavigationView.AnimateSelectionChanged），
    不可配时长也不吃我们的 token；这里补的是「跟手感」——点击瞬间这一行先弹一下再归位。
  -->
  <Style Selector="ui|FANavigationViewItem">
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationSpringSlide}">
          <TransformOperationsTransition.Easing>
            <SpringEasing Mass="1" Stiffness="220" Damping="22" InitialVelocity="0" />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ui|FANavigationViewItem.nav-catch-up">
    <Setter Property="RenderTransform" Value="translate(4px, 0px)" />
  </Style>

  <!-- ========================================== -->
  <!-- 表格 (DataGrid) 现代流畅微交互与视觉优化     -->
  <!-- ========================================== -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="None" />
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="SeparatorBrush" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Margin" Value="2,1" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="DataGridRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
  </Style>

  <Style Selector="DataGridRow:selected">
    <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
  </Style>

  <!-- ========================================== -->
  <!-- 普通列表项 (ListBoxItem) 统一现代化平滑悬浮     -->
  <!-- ========================================== -->
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Margin" Value="2,1" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationFast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
  </Style>

  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
  </Style>

  <!-- ========================================== -->
  <!-- 空状态容器 (Empty State)                    -->
  <!-- ========================================== -->
  <Style Selector="Border.CkanEmptyStateCard">
    <Setter Property="Background" Value="{DynamicResource CkanCardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusMedium}" />
    <Setter Property="Padding" Value="32,24" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <!-- ========================================== -->
  <!-- 页面级警告/通知 Banner 平滑展示               -->
  <!-- ========================================== -->
  <Style Selector="Border.CkanInfoBanner">
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
      </Transitions>
    </Setter>
  </Style>

  <!-- ========================================== -->
  <!-- 键盘可达性：可见焦点环（THM-09）             -->
  <!-- 只在 :focus-visible 下加环（鼠标点击不弹环）， -->
  <!-- 粗细与颜色全部走 token，高对比度下自动换成高对比黄。 -->
  <!-- ========================================== -->
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource CkanFocusRingBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource CkanFocusRingThickness}" />
  </Style>

  <Style Selector="TextBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource CkanFocusRingBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource CkanFocusRingThickness}" />
  </Style>

  <Style Selector="ComboBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource CkanFocusRingBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource CkanFocusRingThickness}" />
  </Style>

  <Style Selector="ListBoxItem:focus-visible">
    <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanFocusRingBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="DataGridRow:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource CkanFocusRingBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ========================================== -->
  <!-- 按钮家族：主 / 次 / 幽灵 / 危险 / 图标 / 小  -->
  <!-- ========================================== -->
  <Style Selector="Button.CkanSecondary">
    <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="{DynamicResource CkanControlHeightMedium}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.CkanSecondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
  </Style>

  <Style Selector="Button.CkanSecondary:pressed">
    <Setter Property="Background" Value="{DynamicResource CkanNavigationSelectionBrush}" />
  </Style>

  <Style Selector="Button.CkanGhost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="{DynamicResource CkanControlHeightMedium}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.CkanGhost:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanHoverOverlayBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.CkanGhost:pressed">
    <Setter Property="Background" Value="{DynamicResource CkanPressedOverlayBrush}" />
  </Style>

  <Style Selector="Button.CkanDanger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanDangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource CkanDangerBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="{DynamicResource CkanControlHeightMedium}" />
  </Style>

  <Style Selector="Button.CkanDanger:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanDangerBackgroundBrush}" />
  </Style>

  <Style Selector="Button.CkanIcon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.CkanIcon:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanHoverOverlayBrush}" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- 小号按钮：表格行内操作、工具条次要动作 -->
  <Style Selector="Button.CkanSmall">
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="{DynamicResource CkanControlHeightSmall}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
  </Style>

  <!-- ========================================== -->
  <!-- 状态徽章（Badge）：语义色 + 药丸圆角         -->
  <!-- ========================================== -->
  <Style Selector="Border.CkanBadge">
    <Setter Property="Background" Value="{DynamicResource CkanSubtleBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusPill}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.CkanBadge TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.CkanBadge.Success">
    <Setter Property="Background" Value="{DynamicResource CkanSuccessBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanSuccessBrush}" />
  </Style>

  <Style Selector="Border.CkanBadge.Success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CkanSuccessBrush}" />
  </Style>

  <Style Selector="Border.CkanBadge.Warning">
    <Setter Property="Background" Value="{DynamicResource CkanWarningBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanWarningBrush}" />
  </Style>

  <Style Selector="Border.CkanBadge.Warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CkanWarningBrush}" />
  </Style>

  <Style Selector="Border.CkanBadge.Danger">
    <Setter Property="Background" Value="{DynamicResource CkanDangerBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanDangerBrush}" />
  </Style>

  <Style Selector="Border.CkanBadge.Danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CkanDangerBrush}" />
  </Style>

  <Style Selector="Border.CkanBadge.Info">
    <Setter Property="Background" Value="{DynamicResource CkanInfoBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanInfoBrush}" />
  </Style>

  <Style Selector="Border.CkanBadge.Info TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CkanInfoBrush}" />
  </Style>

  <Style Selector="Border.CkanBadge.Accent">
    <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
  </Style>

  <Style Selector="Border.CkanBadge.Accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CkanAccentBrush}" />
  </Style>

  <!-- ========================================== -->
  <!-- 文本层级：页面标题 / 小节标题 / 说明 / 数字  -->
  <!-- ========================================== -->
  <Style Selector="TextBlock.CkanPageTitle">
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="TextBlock.CkanSectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.CkanCardTitle">
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.CkanCaption">
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.CkanMuted">
    <Setter Property="Foreground" Value="{DynamicResource CkanTextTertiaryBrush}" />
  </Style>

  <!-- 统计数字：等宽数字（tnum）防止数值跳动时左右抖 -->
  <Style Selector="TextBlock.CkanNumeric">
    <Setter Property="FontFeatures" Value="tnum" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.CkanNumericLarge">
    <Setter Property="FontFeatures" Value="tnum" />
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
  </Style>

  <!-- ========================================== -->
  <!-- 可点击卡片：hover 抬升 + 阴影加深            -->
  <!-- ========================================== -->
  <Style Selector="Border.CkanCardInteractive">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CkanMotionDurationBase}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationBase}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationFast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.CkanCardInteractive:pointerover">
    <!-- 悬停只提亮表面 + 阴影加深，不再把描边刷成强调色（降噪：全屏蓝框比不动更吵）。 -->
    <Setter Property="Background" Value="{DynamicResource CkanElevatedCardHoverBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CkanElevationMedium}" />
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <Style Selector="Border.CkanCardInteractive:pressed">
    <Setter Property="RenderTransform" Value="scale(0.995)" />
  </Style>

  <!-- 选中态卡片：左边 3px 强调条由视图里的 Rectangle.SelectionBar 承担 -->
  <Style Selector="Border.CkanCardSelected">
    <Setter Property="BorderBrush" Value="{DynamicResource CkanAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
  </Style>

  <!-- ========================================== -->
  <!-- 骨架屏（加载态占位）：底色走 token，脉动由   -->
  <!-- CkanUI.App.Theming.SkeletonPulse 附加属性驱动 -->
  <!-- ========================================== -->
  <Style Selector="Border.CkanSkeleton">
    <Setter Property="Background" Value="{DynamicResource CkanSkeletonBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="MinHeight" Value="12" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="Border.CkanSkeletonLine">
    <Setter Property="Background" Value="{DynamicResource CkanSkeletonBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Height" Value="10" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- ========================================== -->
  <!-- 页签（TabControl / TabItem）：下划线指示器   -->
  <!-- 下划线用透明度 + 横向缩放两条过渡，时长走 token -->
  <!-- ========================================== -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextSecondaryBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
          <StackPanel Spacing="6">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
            <Border x:Name="PART_TabUnderline"
                    Height="2"
                    CornerRadius="1"
                    Background="{DynamicResource CkanAccentBrush}"
                    Opacity="0"
                    RenderTransform="scaleX(0.4)">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{DynamicResource CkanMotionDurationBase}" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CkanMotionDurationBase}" />
                </Transitions>
              </Border.Transitions>
            </Border>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource CkanAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TabItem:selected /template/ Border#PART_TabUnderline">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scaleX(1)" />
  </Style>

  <Style Selector="TabItem:focus-visible /template/ Border#PART_TabUnderline">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scaleX(1)" />
  </Style>

  <!-- ========================================== -->
  <!-- 工具提示（ToolTip）：浮层海拔 + 小字号        -->
  <!-- ========================================== -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource CkanDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
    <Setter Property="MaxWidth" Value="420" />
  </Style>

  <!-- ========================================== -->
  <!-- 右键菜单（ContextMenu / MenuItem）           -->
  <!-- ========================================== -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource CkanDialogBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CkanCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusMedium}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="{DynamicResource CkanCornerRadiusSmall}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="{DynamicResource CkanFontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource CkanTextPrimaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CkanMotionDurationFast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
  </Style>

  <!-- ========================================== -->
  <!-- 滚动条：细身、圆头、hover 才明显             -->
  <!-- ========================================== -->
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
  </Style>

  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="10" />
    <Setter Property="MinHeight" Value="10" />
  </Style>

  <!-- ========================================== -->
  <!-- 进度条：细高度 + 强调色 + 圆角              -->
  <!-- ========================================== -->
  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource CkanAccentBrush}" />
  </Style>

  <!-- ========================================== -->
  <!-- 分割线与栅格分隔条                          -->
  <!-- ========================================== -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource CkanBorderBrush}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="6" />
  </Style>

  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource CkanAccentSubtleBrush}" />
  </Style>

  <!-- ========================================== -->
  <!-- 禁用态：统一降透明度（可读但明显不可点）      -->
  <!-- ========================================== -->
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="RepeatButton:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="ComboBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="CheckBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="RadioButton:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Slider:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

</Styles>