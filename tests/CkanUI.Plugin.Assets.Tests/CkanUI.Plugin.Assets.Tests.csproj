<Project Sdk="Microsoft.NET.Sdk">

  <!-- 「Assets」页签插件的页面测试（docs/design/plugins.md §11.11）。
       页面已经搬进插件程序集，宿主测试工程看不到这些类型，所以跟着页面一起搬。 -->
  <PropertyGroup>
    <RootNamespace>CkanUI.Plugin.Assets.Tests</RootNamespace>
    <AssemblyName>CkanUI.Plugin.Assets.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- 飞船页的载具库选择器要在无头平台上真正装配一次，才能证明 XAML 绑定没有写错名字。 -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CkanUI.Plugin.Assets/CkanUI.Plugin.Assets.csproj" />
  </ItemGroup>

</Project>
