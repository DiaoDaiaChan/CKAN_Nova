<Project Sdk="Microsoft.NET.Sdk">

  <!-- 「RP-1 生涯日志」插件的测试：存档切片、定义解析、时间线合并与页面筛选。 -->
  <PropertyGroup>
    <RootNamespace>CkanUI.Plugin.Rp1.Tests</RootNamespace>
    <AssemblyName>CkanUI.Plugin.Rp1.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- 视图冒烟用例要装配可视树：无头平台 + 主题（控件模板与 DynamicResource 的来源）。 -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CkanUI.Plugin.Rp1/CkanUI.Plugin.Rp1.csproj" />
    <ProjectReference Include="../CkanUI.TestSupport/CkanUI.TestSupport.csproj" />
    <!-- CurveChart / GlyphIcon 在共享层；插件虽已传递引用，断言类型时显式引用更稳。 -->
    <ProjectReference Include="../../src/CkanUI.Ui/CkanUI.Ui.csproj" />
  </ItemGroup>

</Project>
