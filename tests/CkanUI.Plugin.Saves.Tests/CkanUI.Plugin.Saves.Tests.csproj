<Project Sdk="Microsoft.NET.Sdk">

  <!-- 「Saves」页签插件的页面测试（docs/design/plugins.md §11.11）。
       页面已经搬进插件程序集，宿主测试工程看不到这些类型，所以跟着页面一起搬。 -->
  <PropertyGroup>
    <RootNamespace>CkanUI.Plugin.Saves.Tests</RootNamespace>
    <AssemblyName>CkanUI.Plugin.Saves.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- 工作台窗口用例要在无头平台上真正 Show 一次窗口。 -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CkanUI.Plugin.Saves/CkanUI.Plugin.Saves.csproj" />
    <!-- 集成用例驱动真实编辑器（SaveEditorService）、临时目录用测试支撑库。 -->
    <ProjectReference Include="../../src/CkanUI.Services/CkanUI.Services.csproj" />
    <ProjectReference Include="../CkanUI.TestSupport/CkanUI.TestSupport.csproj" />
  </ItemGroup>

</Project>
