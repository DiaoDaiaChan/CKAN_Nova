<Project>

  <!-- external/ 下是只读上游 CKAN（21 篇 §3 ②）：不套用本仓库的规范，也不套用中央包管理。
       用项目名前缀判定而不是路径判定：external/CKAN 是目录联接，路径判定在 MSBuild 里要处理反斜杠转义，
       前缀判定简单且不会误伤。 -->
  <PropertyGroup>
    <NuGetAudit>false</NuGetAudit>
    <CkanIsOwnProject>false</CkanIsOwnProject>
    <CkanIsOwnProject Condition="$(MSBuildProjectName.StartsWith('CkanUI'))">true</CkanIsOwnProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CkanIsOwnProject)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 上游 Core 的传递依赖（System.Drawing.Common 4.7.0 等）不可在本仓库修复；
         漏洞审计与 NU1701 不作为构建错误，由 docs/ops 跟踪 -->
    <NoWarn>$(NoWarn);NU1701;NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CkanIsOwnProject)' != 'true'">
    <!-- 上游只读代码：警告一律不升级为错误，且不显示（NU1904 漏洞来自上游钉死的 System.Drawing.Common 4.7.0，
         SYSLIB0050 来自上游的 BinaryFormatter 序列化）。上游改造不在本计划范围内（00-index D5 不改 Core）。 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701;NU1901;NU1902;NU1903;NU1904;SYSLIB0050</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 只读上游 CKAN fork：本地用目录联接 external/CKAN 指向规格仓，CI 用 git submodule -->
    <CkanCoreRoot Condition="'$(CkanCoreRoot)' == ''">$(MSBuildThisFileDirectory)external/CKAN/</CkanCoreRoot>
    <CkanCoreProject>$(CkanCoreRoot)Core/CKAN-core.csproj</CkanCoreProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'CkanUI.App'">
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

</Project>